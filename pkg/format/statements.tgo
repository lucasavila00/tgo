package format

import (
	"bytes"

	"tgo/pkg/syntax"
)

func (p *printer) statement(value *syntax.Statement) {
	switch statementValue := *value; statementValue.Tag() {
	case syntax.StatementTagBad:
		item := statementValue.BadPayload().Value
		p.sourceSpan(item.Span)
	case syntax.StatementTagDeclaration:
		p.declaration(statementValue.DeclarationPayload().Value.Declaration)
	case syntax.StatementTagEmpty:
		item := statementValue.EmptyPayload().Value
		if !item.Implicit {
			p.token(item.Semicolon, ";")
		}
	case syntax.StatementTagLabeled:
		item := statementValue.LabeledPayload().Value
		p.before(item.Label.Start)
		p.indent--
		p.text(item.Label.Name)
		p.lastSource = item.Label.Start
		p.token(item.Colon, ":")
		previousCommentColumns := p.commentColumns
		p.commentColumns = nil
		p.trailingToken(item.Colon, 1)
		p.commentColumns = previousCommentColumns
		p.indent++
		gap := p.sourceGap(item.Colon, syntax.StatementPosition(item.Statement))
		p.newline()
		if gap.blank {
			p.blankline()
		}
		p.statement(item.Statement)
	case syntax.StatementTagExpression:
		p.expression(statementValue.ExpressionPayload().Value.Expression, 0)
	case syntax.StatementTagSend:
		item := statementValue.SendPayload().Value
		p.expression(item.Channel, 0)
		p.space()
		p.token(item.Arrow, "<-")
		p.space()
		p.expression(item.Value, 0)
	case syntax.StatementTagIncrement:
		item := statementValue.IncrementPayload().Value
		p.expression(item.Expression, 0)
		p.token(item.Token, item.Operator.String())
	case syntax.StatementTagAssignment:
		item := statementValue.AssignmentPayload().Value
		depth := 1
		if len(item.Left) > 1 && len(item.Right) > 1 {
			depth++
		}
		p.commaListAt(item.Left, depth, false)
		p.space()
		p.token(item.Token, item.Operator.String())
		if len(item.Right) > 0 && p.position(item.Token).Line <
			p.position(syntax.ExpressionPosition(item.Right[0])).Line {
			p.newline()
			p.indent++
			p.commaListAt(item.Right, depth, true)
			p.indent--
		} else {
			p.space()
			p.commaListAt(item.Right, depth, false)
		}
	case syntax.StatementTagGo:
		item := statementValue.GoPayload().Value
		p.token(item.Go, "go")
		p.space()
		p.expression(item.Call, 0)
	case syntax.StatementTagDefer:
		item := statementValue.DeferPayload().Value
		p.token(item.Defer, "defer")
		p.space()
		p.expression(item.Call, 0)
	case syntax.StatementTagReturn:
		item := statementValue.ReturnPayload().Value
		p.token(item.Return, "return")
		if len(item.FailureCommas) > 0 {
			p.space()
			for _, comma := range item.FailureCommas {
				p.token(comma, ",")
			}
		}
		if len(item.Results) > 0 {
			p.space()
			indent := p.indentReturnList(item.Results)
			if indent {
				p.indent++
			}
			p.commaListAt(item.Results, 1, indent)
			if indent {
				p.indent--
			}
		}
		if item.SuccessComma.IsValid() {
			p.token(item.SuccessComma, ",")
		}
	case syntax.StatementTagBranch:
		item := statementValue.BranchPayload().Value
		p.token(item.TokenPosition, item.Token.String())
		if item.Label != nil {
			p.space()
			p.token(item.Label.Start, item.Label.Name)
		}
	case syntax.StatementTagBlock:
		p.block(statementValue.BlockPayload().Value)
	case syntax.StatementTagIf:
		p.ifStatement(statementValue.IfPayload().Value)
	case syntax.StatementTagCase:
		p.caseClause(statementValue.CasePayload().Value)
	case syntax.StatementTagSwitch:
		p.switchStatement(statementValue.SwitchPayload().Value)
	case syntax.StatementTagTypeSwitch:
		p.typeSwitchStatement(statementValue.TypeSwitchPayload().Value)
	case syntax.StatementTagCommunication:
		p.communicationClause(statementValue.CommunicationPayload().Value)
	case syntax.StatementTagSelect:
		item := statementValue.SelectPayload().Value
		p.token(item.Select, "select")
		p.space()
		p.clauseBlock(item.Body)
	case syntax.StatementTagFor:
		p.forStatement(statementValue.ForPayload().Value)
	case syntax.StatementTagRange:
		p.rangeStatement(statementValue.RangePayload().Value)
	exhaustive:
	}
}

func (p *printer) statementList(values []%syntax.Statement) {
	printed := make([]%syntax.Statement, 0, len(values))
	for _, value := range values {
		if !implicitEmptyStatement(value) {
			printed = append(printed, value)
		}
	}
	values = printed
	commentColumns := p.statementCommentAlignment(values)
	for index, value := range values {
		sourceCommentIndent := false
		if index > 0 {
			previous := values[index-1]
			stop := syntax.StatementEnd(previous)
			start := syntax.StatementPosition(value)
			p.breakSourceGap(stop, start)
			sourceCommentIndent = clauseStatement(previous)
		}
		previousCommentColumns := p.commentColumns
		previousSourceCommentIndent := p.sourceCommentIndent
		p.commentColumns = commentColumns[index]
		p.sourceCommentIndent = sourceCommentIndent
		p.statement(value)
		p.trailingLine(syntax.StatementEnd(value))
		p.commentColumns = previousCommentColumns
		p.sourceCommentIndent = previousSourceCommentIndent
		p.newline()
	}
}

func implicitEmptyStatement(value *syntax.Statement) bool {
	switch statementValue := *value; statementValue.Tag() {
	case syntax.StatementTagEmpty:
		return statementValue.EmptyPayload().Value.Implicit
	default:
		return false
	}
}

func clauseStatement(value *syntax.Statement) bool {
	switch statementValue := *value; statementValue.Tag() {
	case syntax.StatementTagCase:
		return true
	case syntax.StatementTagCommunication:
		return true
	default:
		return false
	}
}

func (p *printer) indentReturnList(values []%syntax.Expression) bool {
	if len(values) < 2 {
		return false
	}
	first := p.position(syntax.ExpressionPosition(values[0])).Line
	last := p.position(syntax.ExpressionEnd(values[len(values)-1])).Line
	if first <= 0 || first >= last {
		return false
	}
	multiline := 0
	line := first
	for _, value := range values {
		start := p.position(syntax.ExpressionPosition(value)).Line
		stop := p.position(syntax.ExpressionEnd(value)).Line
		if line < start {
			return true
		}
		if start < stop && !compositeLiteralLike(value) {
			multiline++
		}
		line = stop
	}
	return multiline > 1
}

func compositeLiteralLike(value *syntax.Expression) bool {
	for {
		if syntax.CompositeLiteralOf(value) != nil {
			return true
		}
		if parenthesized := syntax.ParenthesizedExpressionOf(value); parenthesized != nil {
			value = parenthesized.Expression
			continue
		}
		unary := syntax.UnaryExpressionOf(value)
		if unary != nil && unary.Operator.String() == "&" {
			value = unary.Expression
			if parenthesized := syntax.ParenthesizedExpressionOf(value); parenthesized != nil {
				value = parenthesized.Expression
			}
			return syntax.CompositeLiteralOf(value) != nil
		}
		return false
	}
}

func (p *printer) block(value *syntax.BlockStatement) {
	p.token(value.Lbrace, "{")
	p.trailingToken(value.Lbrace, 1)
	if len(value.List) == 0 {
		if p.multiline(value.Lbrace, value.Rbrace) {
			p.indent++
			p.breakSourceGap(value.Lbrace, value.Rbrace)
			p.before(value.Rbrace)
			p.indent--
		}
		p.token(value.Rbrace, "}")
		return
	}
	p.newline()
	p.indent++
	p.breakSourceGap(value.Lbrace, syntax.StatementPosition(value.List[0]))
	p.statementList(value.List)
	p.breakSourceGap(syntax.StatementEnd(value.List[len(value.List)-1]), value.Rbrace)
	p.before(value.Rbrace)
	p.indent--
	p.token(value.Rbrace, "}")
}

func (p *printer) functionBody(value *syntax.BlockStatement, headerWidth int) {
	if p.compactFunctionBody(value, headerWidth) {
		p.token(value.Lbrace, "{")
		if len(value.List) > 0 {
			p.space()
			for index, statement := range value.List {
				if index > 0 {
					p.text(";")
					p.space()
				}
				p.statement(statement)
				p.trailingLine(syntax.StatementEnd(statement))
			}
			p.space()
		}
		p.token(value.Rbrace, "}")
		return
	}
	p.block(value)
}

func (p *printer) compactFunctionBody(value *syntax.BlockStatement, headerWidth int) bool {
	if p.multiline(value.Lbrace, value.Rbrace) || len(value.List) > 5 {
		return false
	}
	bodyWidth := 0
	for index, statement := range value.List {
		probe := p.newProbe(nil)
		probe.statement(statement)
		if bytes.IndexByte(probe.output.Bytes(), '\n') >= 0 {
			return false
		}
		if index > 0 {
			bodyWidth += 2
		}
		bodyWidth += probe.output.Len()
	}
	return headerWidth+bodyWidth <= 100
}

func (p *printer) clauseBlock(value *syntax.BlockStatement) {
	p.token(value.Lbrace, "{")
	p.trailingToken(value.Lbrace, 1)
	if len(value.List) == 0 {
		if p.multiline(value.Lbrace, value.Rbrace) {
			p.breakSourceGap(value.Lbrace, value.Rbrace)
			p.before(value.Rbrace)
		}
		p.token(value.Rbrace, "}")
		return
	}
	p.newline()
	p.breakSourceGap(value.Lbrace, syntax.StatementPosition(value.List[0]))
	p.statementList(value.List)
	last := syntax.StatementEnd(value.List[len(value.List)-1])
	p.breakSourceGap(last, value.Rbrace)
	previousSourceCommentIndent := p.sourceCommentIndent
	p.sourceCommentIndent = clauseStatement(value.List[len(value.List)-1])
	p.before(value.Rbrace)
	p.sourceCommentIndent = previousSourceCommentIndent
	p.token(value.Rbrace, "}")
}

func (p *printer) ifStatement(value *syntax.IfStatement) {
	p.token(value.If, "if")
	p.space()
	if value.Init != nil {
		p.statement(value.Init)
		p.text(";")
		p.space()
	}
	p.expression(value.Condition, 0)
	p.space()
	p.block(value.Body)
	if value.Else != nil {
		p.space()
		p.text("else")
		p.space()
		p.statement(value.Else)
	}
}

func (p *printer) caseClause(value *syntax.CaseClause) {
	if value.Exhaustive.IsValid() {
		p.token(value.Exhaustive, "exhaustive")
	} else if len(value.List) == 0 {
		p.token(value.Case, "default")
	} else {
		p.token(value.Case, "case")
		first := syntax.ExpressionPosition(value.List[0])
		if p.position(value.Case).Line < p.position(first).Line {
			p.indent++
			p.breakSourceGap(p.tokenEnd(value.Case, 4), first)
			comments := p.expressionListCommentAlignment(
				value.List,
				value.Case,
				value.Colon,
				p.indent*8,
			)
			p.commaListWithComments(value.List, 1, true, comments)
			p.indent--
		} else {
			p.space()
			p.commaList(value.List)
		}
	}
	p.token(value.Colon, ":")
	p.trailingToken(value.Colon, 1)
	if len(value.Body) == 0 {
		return
	}
	p.newline()
	p.indent++
	p.breakSourceGap(value.Colon, syntax.StatementPosition(value.Body[0]))
	p.statementList(value.Body)
	p.indent--
}

func (p *printer) switchStatement(value *syntax.SwitchStatement) {
	p.token(value.Switch, "switch")
	if value.Init != nil || value.Tag != nil {
		p.space()
	}
	if value.Init != nil {
		p.statement(value.Init)
		p.text(";")
		if value.Tag != nil {
			p.space()
		}
	}
	if value.Tag != nil {
		p.expression(value.Tag, 0)
	}
	p.space()
	p.clauseBlock(value.Body)
}

func (p *printer) typeSwitchStatement(value *syntax.TypeSwitchStatement) {
	p.token(value.Switch, "switch")
	p.space()
	if value.Init != nil {
		p.statement(value.Init)
		p.text(";")
		p.space()
	}
	p.statement(value.Assignment)
	p.space()
	p.clauseBlock(value.Body)
}

func (p *printer) communicationClause(value *syntax.CommunicationClause) {
	if value.Communication == nil {
		p.token(value.Case, "default")
	} else {
		p.token(value.Case, "case")
		p.space()
		p.statement(value.Communication)
	}
	p.token(value.Colon, ":")
	p.trailingToken(value.Colon, 1)
	if len(value.Body) == 0 {
		return
	}
	p.newline()
	p.indent++
	p.breakSourceGap(value.Colon, syntax.StatementPosition(value.Body[0]))
	p.statementList(value.Body)
	p.indent--
}

func (p *printer) forStatement(value *syntax.ForStatement) {
	p.token(value.For, "for")
	if value.Init != nil || value.Condition != nil || value.Post != nil {
		p.space()
	}
	if value.Init != nil || value.Post != nil {
		if value.Init != nil {
			p.statement(value.Init)
		}
		p.text(";")
		p.space()
		if value.Condition != nil {
			p.expression(value.Condition, 0)
		}
		p.text(";")
		p.space()
		if value.Post != nil {
			p.statement(value.Post)
		}
	} else if value.Condition != nil {
		p.expression(value.Condition, 0)
	}
	p.space()
	p.block(value.Body)
}

func (p *printer) rangeStatement(value *syntax.RangeStatement) {
	p.token(value.For, "for")
	p.space()
	if value.Key != nil {
		p.expression(value.Key, 0)
		if value.Value != nil {
			p.text(",")
			p.space()
			p.expression(value.Value, 0)
		}
		p.space()
		p.token(value.Token, value.Operator.String())
		p.space()
	}
	p.token(value.Range, "range")
	p.space()
	p.expression(value.Source, 0)
	p.space()
	p.block(value.Body)
}
