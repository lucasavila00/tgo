package format

import (
	"go/token"
	"strings"
	"unicode/utf8"

	"tgo/pkg/syntax"
)

func (p *printer) expression(value *syntax.Expression, parentPrecedence int) {
	p.expressionAt(value, parentPrecedence, 1)
}

func (p *printer) expressionAt(
	value *syntax.Expression,
	parentPrecedence int,
	depth int,
) {
	switch expressionValue := *value; expressionValue.Tag() {
	case syntax.ExpressionTagBad:
		item := expressionValue.BadPayload().Value
		p.sourceSpan(item.Span)
	case syntax.ExpressionTagIdentifier:
		item := expressionValue.IdentifierPayload().Value
		p.token(item.Start, item.Name)
	case syntax.ExpressionTagEllipsis:
		item := expressionValue.EllipsisPayload().Value
		p.token(item.Ellipsis, "...")
		if item.Element != nil {
			p.expressionAt(item.Element, token.UnaryPrec, depth)
		}
	case syntax.ExpressionTagBasicLiteral:
		item := expressionValue.BasicLiteralPayload().Value
		p.token(item.ValuePosition, item.Value)
		p.lastSource = item.Stop
	case syntax.ExpressionTagFunctionLiteral:
		item := expressionValue.FunctionLiteralPayload().Value
		p.token(item.Type.Function, "func")
		startColumn := p.outputColumn() - len("func")
		p.functionSignature(item.Type)
		headerWidth := p.outputColumn() - startColumn
		p.space()
		p.functionBody(item.Body, headerWidth)
	case syntax.ExpressionTagCompositeLiteral:
		p.compositeLiteral(expressionValue.CompositeLiteralPayload().Value)
	case syntax.ExpressionTagParenthesized:
		item := expressionValue.ParenthesizedPayload().Value
		p.token(item.Lparen, "(")
		p.expressionAt(item.Expression, 0, max(1, depth-1))
		p.token(item.Rparen, ")")
	case syntax.ExpressionTagSelector:
		item := expressionValue.SelectorPayload().Value
		p.expressionAt(item.Expression, token.HighestPrec, depth)
		p.text(".")
		lineBreak := p.position(syntax.ExpressionEnd(item.Expression)).Line <
			p.position(item.Selector.Start).Line
		if lineBreak {
			p.newline()
			p.indent++
		}
		p.token(item.Selector.Start, item.Selector.Name)
		if lineBreak {
			p.indent--
		}
	case syntax.ExpressionTagIndex:
		item := expressionValue.IndexPayload().Value
		p.expressionAt(item.Expression, token.HighestPrec, 1)
		p.token(item.Lbrack, "[")
		p.expressionAt(item.Index, 0, depth+1)
		p.token(item.Rbrack, "]")
	case syntax.ExpressionTagIndexList:
		item := expressionValue.IndexListPayload().Value
		p.expressionAt(item.Expression, token.HighestPrec, 1)
		p.token(item.Lbrack, "[")
		p.delimitedExpressions(item.Indices, item.Lbrack, item.Rbrack, false, depth+1)
		p.token(item.Rbrack, "]")
	case syntax.ExpressionTagSlice:
		p.sliceExpression(expressionValue.SlicePayload().Value, depth)
	case syntax.ExpressionTagTypeAssertion:
		item := expressionValue.TypeAssertionPayload().Value
		p.expressionAt(item.Expression, token.HighestPrec, depth)
		p.text(".")
		p.token(item.Lparen, "(")
		if item.Type == nil {
			p.text("type")
		} else {
			p.expression(item.Type, 0)
		}
		p.token(item.Rparen, ")")
	case syntax.ExpressionTagCall:
		p.callExpression(expressionValue.CallPayload().Value, depth)
	case syntax.ExpressionTagStar:
		item := expressionValue.StarPayload().Value
		p.token(item.Star, "*")
		p.expression(item.Expression, token.UnaryPrec)
	case syntax.ExpressionTagNonNilPointer:
		item := expressionValue.NonNilPointerPayload().Value
		p.token(item.Percent, "%")
		p.expressionAt(item.Type, token.UnaryPrec, depth)
	case syntax.ExpressionTagUnary:
		item := expressionValue.UnaryPayload().Value
		p.token(item.OperatorPosition, item.Operator.String())
		if unaryNeedsSpace(item.Operator, item.Expression) {
			p.space()
		}
		p.expressionAt(item.Expression, token.UnaryPrec, depth)
	case syntax.ExpressionTagBinary:
		p.binaryExpressionAt(expressionValue.BinaryPayload().Value, parentPrecedence, depth)
	case syntax.ExpressionTagKeyValue:
		item := expressionValue.KeyValuePayload().Value
		p.expression(item.Key, 0)
		p.token(item.Colon, ":")
		p.space()
		p.expression(item.Value, 0)
	case syntax.ExpressionTagArrayType:
		item := expressionValue.ArrayTypePayload().Value
		p.token(item.Lbrack, "[")
		if item.Length != nil {
			p.expression(item.Length, 0)
		}
		p.text("]")
		p.expression(item.Element, token.UnaryPrec)
	case syntax.ExpressionTagStructType:
		item := expressionValue.StructTypePayload().Value
		p.token(item.Struct, "struct")
		if p.multiline(item.Fields.Opening, item.Fields.Closing) {
			p.space()
		}
		p.fieldBlock(item.Fields)
	case syntax.ExpressionTagFunctionType:
		item := expressionValue.FunctionTypePayload().Value
		if item.Function.IsValid() {
			p.token(item.Function, "func")
		}
		p.functionSignature(item)
	case syntax.ExpressionTagInterfaceType:
		item := expressionValue.InterfaceTypePayload().Value
		p.token(item.Interface, "interface")
		if p.multiline(item.Methods.Opening, item.Methods.Closing) {
			p.space()
		}
		p.fieldBlock(item.Methods)
	case syntax.ExpressionTagMapType:
		item := expressionValue.MapTypePayload().Value
		p.token(item.Map, "map")
		p.text("[")
		p.expression(item.Key, 0)
		p.text("]")
		p.expression(item.Value, token.UnaryPrec)
	case syntax.ExpressionTagChannelType:
		p.channelType(expressionValue.ChannelTypePayload().Value)
	case syntax.ExpressionTagDefault:
		item := expressionValue.DefaultPayload().Value
		p.token(item.FirstDot, "..default")
	case syntax.ExpressionTagPropagation:
		item := expressionValue.PropagationPayload().Value
		p.expression(item.Expression, token.UnaryPrec)
		p.token(item.Bang, "!")
		if item.SecondBang != token.NoPos {
			p.token(item.SecondBang, "!")
		}
	case syntax.ExpressionTagComprehension:
		p.comprehension(expressionValue.ComprehensionPayload().Value)
	exhaustive:
	}
}

func unaryNeedsSpace(operator token.Token, operand *syntax.Expression) bool {
	inner := syntax.UnaryExpressionOf(operand)
	if inner == nil {
		return false
	}
	return operator == token.ADD && inner.Operator == token.ADD ||
		operator == token.SUB && inner.Operator == token.SUB ||
		operator == token.AND &&
			(inner.Operator == token.AND || inner.Operator == token.XOR)
}

func (p *printer) sliceExpression(value *syntax.SliceExpression, depth int) {
	p.expressionAt(value.Expression, token.HighestPrec, 1)
	p.token(value.Lbrack, "[")
	indices := []*syntax.Expression{value.Low, value.High}
	if value.Slice3 {
		indices = append(indices, value.Max)
	}
	count := 0
	hasBinary := false
	for _, index := range indices {
		if index != nil {
			count++
			hasBinary = hasBinary || syntax.BinaryExpressionOf(index) != nil
		}
	}
	spaces := depth <= 1 && count > 1 && hasBinary
	if value.Low != nil {
		p.expressionAt(value.Low, 0, depth+1)
	}
	if value.Low != nil && spaces {
		p.space()
	}
	p.text(":")
	if value.High != nil {
		if spaces {
			p.space()
		}
		p.expressionAt(value.High, 0, depth+1)
	}
	if value.Slice3 {
		if value.High != nil && spaces {
			p.space()
		}
		p.text(":")
		if value.Max != nil {
			if spaces {
				p.space()
			}
			p.expressionAt(value.Max, 0, depth+1)
		}
	}
	p.token(value.Rbrack, "]")
}

func (p *printer) callExpression(value *syntax.CallExpression, depth int) {
	if len(value.Args) > 1 {
		depth++
	}
	p.expressionAt(value.Callee, token.HighestPrec, depth)
	p.token(value.Lparen, "(")
	p.trailingToken(value.Lparen, 1)
	p.expressionList(value.Args, value.Lparen, value.Rparen, value.Ellipsis, depth)
	p.token(value.Rparen, ")")
}

func (p *printer) compositeLiteral(value *syntax.CompositeLiteral) {
	if value.Type != nil {
		p.expression(value.Type, token.HighestPrec)
	}
	p.token(value.Lbrace, "{")
	p.trailingToken(value.Lbrace, 1)
	if len(value.Elements) == 0 {
		gap := p.sourceGap(value.Lbrace, value.Rbrace)
		if gap.leadingComment {
			p.indent++
			p.breakSourceGap(value.Lbrace, value.Rbrace)
			p.before(value.Rbrace)
			p.indent--
		}
		if p.hasInlineCommentBetween(value.Lbrace, value.Rbrace) {
			p.space()
		}
		p.token(value.Rbrace, "}")
		return
	}
	columns, commentColumns := p.compositeAlignment(
		value.Elements,
		value.Lbrace,
		value.Rbrace,
	)
	previous := value.Lbrace
	indented := false
	for index, element := range value.Elements {
		start := syntax.ExpressionPosition(element)
		gap := p.sourceGap(previous, start)
		if gap.lineBreak {
			if !indented {
				p.indent++
				indented = true
			}
			p.breakSourceGap(previous, start)
		} else if index > 0 {
			p.space()
		}
		previousCommentColumns := p.commentColumns
		p.commentColumns = commentColumns[index]
		p.compositeElement(element, columns[index])
		previous = syntax.ExpressionEnd(element)
		following := value.Rbrace
		if index+1 < len(value.Elements) {
			following = syntax.ExpressionPosition(value.Elements[index+1])
		}
		if index+1 < len(value.Elements) ||
			p.position(previous).Line < p.position(value.Rbrace).Line {
			previous = p.comma(previous, following)
			p.trailingLine(previous)
		}
		p.commentColumns = previousCommentColumns
	}
	gap := p.sourceGap(previous, value.Rbrace)
	if gap.leadingComment && gap.lineBreak && !indented {
		p.indent++
		indented = true
	}
	p.breakClosingGap(previous, value.Rbrace)
	if indented {
		p.before(value.Rbrace)
		p.indent--
	}
	p.token(value.Rbrace, "}")
}

func (p *printer) compositeElement(value *syntax.Expression, columns []int) {
	keyValue := syntax.KeyValueExpressionOf(value)
	if keyValue == nil || len(columns) == 0 {
		p.expression(value, 0)
		return
	}
	p.expression(keyValue.Key, 0)
	p.token(keyValue.Colon, ":")
	p.alignmentSpace(columns, 0)
	p.expression(keyValue.Value, 0)
}

func (p *printer) field(value *syntax.Field) {
	p.alignedField(value, 0)
}

func (p *printer) alignedField(value *syntax.Field, nameWidth int) {
	p.fieldContent(value, nameWidth, nil, false)
	p.trailingLine(fieldContentEnd(value))
}

func (p *printer) alignedFieldColumns(value *syntax.Field, columns []int) {
	p.fieldContent(value, 0, columns, true)
	p.trailingLine(fieldContentEnd(value))
}

func (p *printer) fieldContent(
	value *syntax.Field,
	nameWidth int,
	columns []int,
	alreadyIndented bool,
) {
	column := 0
	if len(value.Names) > 0 {
		p.identifiersAt(value.Names, alreadyIndented)
		functionType := syntax.FunctionTypeExpressionOf(value.Type)
		if functionType == nil || functionType.Function.IsValid() {
			if columns != nil {
				p.alignmentSpace(columns, column)
				column++
			} else {
				padding := 1
				if width := fieldNameWidth(value); nameWidth > width {
					padding += nameWidth - width
				}
				p.text(strings.Repeat(" ", padding))
			}
		}
	}
	p.expression(value.Type, 0)
	if value.Tag != nil {
		if columns == nil {
			p.space()
		} else {
			if len(value.Names) > 0 {
				p.alignmentSpace(columns, column)
				column++
			}
			p.alignmentSpace(columns, column)
		}
		p.token(value.Tag.ValuePosition, value.Tag.Value)
	}
}

func fieldContentEnd(value *syntax.Field) token.Pos {
	if value.Tag != nil {
		return value.Tag.Stop
	}
	return syntax.ExpressionEnd(value.Type)
}

func fieldNameWidth(value *syntax.Field) int {
	return identifierWidth(value.Names)
}

func identifierWidth(values []%syntax.Identifier) int {
	width := 0
	for index, value := range values {
		if index > 0 {
			width += 2
		}
		width += utf8.RuneCountInString(value.Name)
	}
	return width
}

func (p *printer) formattedExpressionWidth(value *syntax.Expression) int {
	return p.formattedExpressionWidthAt(value, 1)
}

func (p *printer) formattedExpressionWidthAt(
	value *syntax.Expression,
	depth int,
) int {
	probe := p.newProbe(nil)
	probe.expressionAt(value, 0, depth)
	return probe.outputColumn()
}

func (p *printer) fieldBlock(value *syntax.FieldList) {
	p.token(value.Opening, "{")
	p.trailingToken(value.Opening, 1)
	if len(value.List) == 0 {
		if p.multiline(value.Opening, value.Closing) {
			p.breakSourceGap(value.Opening, value.Closing)
			p.before(value.Closing)
		}
		p.token(value.Closing, "}")
		return
	}
	if !p.multiline(value.Opening, value.Closing) {
		p.space()
		for index, item := range value.List {
			if index > 0 {
				p.text(";")
				p.space()
			}
			p.field(item)
		}
		p.space()
		p.token(value.Closing, "}")
		return
	}
	p.newline()
	p.indent++
	p.breakSourceGap(value.Opening, value.List[0].Start)
	columns := p.fieldAlignment(value.List)
	for index, item := range value.List {
		if index > 0 {
			p.breakSourceGap(value.List[index-1].Stop, item.Start)
		}
		previousCommentColumn := p.commentColumn
		if !p.multilineFieldType(item) &&
			p.hasTrailingComment(fieldContentEnd(item)) && len(columns[index]) > 0 {
			p.commentColumn = p.indent*8 + columns[index][len(columns[index])-1]
		}
		p.alignedFieldColumns(item, columns[index])
		p.commentColumn = previousCommentColumn
		p.newline()
	}
	p.breakClosingGap(value.List[len(value.List)-1].Stop, value.Closing)
	p.before(value.Closing)
	p.indent--
	p.token(value.Closing, "}")
}

func (p *printer) fieldList(value *syntax.FieldList, opening string, closing string) {
	p.token(value.Opening, opening)
	p.trailingToken(value.Opening, len(opening))
	if len(value.List) == 0 {
		gap := p.sourceGap(value.Opening, value.Closing)
		if gap.leadingComment {
			p.breakSourceGap(value.Opening, value.Closing)
			p.before(value.Closing)
		}
		p.token(value.Closing, closing)
		return
	}
	if p.multiline(value.Opening, value.Closing) {
		previous := value.Opening
		indented := false
		for index, item := range value.List {
			gap := p.sourceGap(previous, item.Start)
			if gap.lineBreak {
				if !indented {
					p.indent++
					indented = true
				}
				p.breakSourceGap(previous, item.Start)
			} else if index > 0 {
				p.space()
			}
			p.fieldContent(item, 0, nil, indented)
			following := value.Closing
			if index+1 < len(value.List) {
				following = value.List[index+1].Start
			}
			previous = item.Stop
			if index+1 < len(value.List) ||
				p.position(item.Stop).Line < p.position(value.Closing).Line {
				previous = p.comma(item.Stop, following)
				p.trailingLine(previous)
			}
		}
		gap := p.sourceGap(previous, value.Closing)
		if gap.leadingComment && gap.lineBreak && !indented {
			p.indent++
			indented = true
		}
		p.breakClosingGap(previous, value.Closing)
		if indented {
			p.before(value.Closing)
			p.indent--
		}
		p.token(value.Closing, closing)
		return
	}
	for index, item := range value.List {
		if index > 0 {
			p.text(",")
			p.space()
		}
		p.field(item)
	}
	p.token(value.Closing, closing)
}

func (p *printer) functionSignature(value *syntax.FunctionType) {
	if value.TypeParams != nil {
		p.fieldList(value.TypeParams, "[", "]")
	}
	p.fieldList(value.Params, "(", ")")
	if value.Results == nil {
		return
	}
	p.space()
	if value.Results.Opening == token.NoPos {
		p.field(value.Results.List[0])
		return
	}
	p.fieldList(value.Results, "(", ")")
}

func (p *printer) channelType(value *syntax.ChannelType) {
	switch direction := value.Direction; direction.Tag() {
	case syntax.ChannelDirectionTagSendReceive:
		p.token(value.Begin, "chan")
		p.space()
	case syntax.ChannelDirectionTagSendOnly:
		p.token(value.Begin, "chan")
		p.token(value.Arrow, "<-")
		p.space()
	case syntax.ChannelDirectionTagReceiveOnly:
		p.token(value.Arrow, "<-")
		p.token(value.Begin, "chan")
		p.space()
	exhaustive:
	}
	p.expression(value.Value, token.UnaryPrec)
}

func (p *printer) comprehension(value *syntax.ComprehensionExpression) {
	p.expression(value.Type, token.HighestPrec)
	p.token(value.Lbrace, "{")
	for _, clause := range value.Clauses {
		switch clauseValue := clause; clauseValue.Tag() {
		case syntax.ComprehensionClauseTagRange:
			item := clauseValue.RangePayload().Value
			p.token(item.For, "for")
			p.space()
			p.identifiers(item.Bindings)
			p.space()
			p.token(item.Define, ":=")
			p.space()
			p.token(item.Range, "range")
			p.space()
			p.expression(item.Source, 0)
			p.space()
			p.token(item.Lbrace, "{")
			p.newline()
			p.indent++
		case syntax.ComprehensionClauseTagFilter:
			item := clauseValue.FilterPayload().Value
			p.token(item.If, "if")
			p.space()
			p.expression(item.Condition, 0)
			p.space()
			p.token(item.Lbrace, "{")
			p.newline()
			p.indent++
		exhaustive:
		}
	}
	if value.Result.Key != nil {
		p.expression(value.Result.Key, 0)
		p.token(value.Result.Colon, ":")
		p.space()
	}
	p.expression(value.Result.Value, 0)
	p.trailingLine(syntax.ExpressionEnd(value.Result.Value))
	p.newline()
	for index := len(value.Clauses) - 1; index >= 0; index-- {
		p.indent--
		p.text("}")
		if index > 0 {
			p.newline()
		}
	}
	p.token(value.Rbrace, "}")
}
