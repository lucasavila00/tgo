package fixtures

import (
	"fmt"
	alias "strings"
)

type Positive int where value > 0

const (
	one = 1
	two
)

var global int = 2

type Number = int

type Set[T comparable] map[T]struct{}

type Text interface { String() string; ~string }

func all[T any](values []T, channel chan<- T, input <-chan T) (result int) {
label:
	;
	_ = label
	go fmt.Println(values)
	defer fmt.Println(result)
	if value := len(values); value > 0 {
		result = value
	} else {
		result = 0
	}
	for index := 0; index < len(values); index++ {
		channel <- values[index]
	}
	for index, value := range values {
		_ = index
		_ = value
	}
	switch result {
	case 1, 2:
		result++
	default:
		result--
	}
	var item any = result
	switch value := item.(type) {
	case int:
		result = value
	}
	array := [2]int{0: 1, 1: 2}
	_ = array[:1:2]
	_ = alias.TrimSpace(" x ")
	_ = func(value int) int {
		return value
	}(result)
	return
}
