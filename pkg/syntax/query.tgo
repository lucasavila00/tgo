package syntax

// IdentifierOf returns an identifier node payload.
func IdentifierOf(node *Node) (*Identifier, bool) {
	if node == nil { return nil, false }
	match *node {
	case Identifier(value): return value.Value, true
	case Expression(value):
		match *value.Value {
		case Identifier(item): return item.Value, true
		case Bad(_): return nil, false
		case Ellipsis(_): return nil, false
		case BasicLiteral(_): return nil, false
		case FunctionLiteral(_): return nil, false
		case CompositeLiteral(_): return nil, false
		case Parenthesized(_): return nil, false
		case Selector(_): return nil, false
		case Index(_): return nil, false
		case IndexList(_): return nil, false
		case Slice(_): return nil, false
		case TypeAssertion(_): return nil, false
		case Call(_): return nil, false
		case Star(_): return nil, false
		case Unary(_): return nil, false
		case Binary(_): return nil, false
		case KeyValue(_): return nil, false
		case ArrayType(_): return nil, false
		case StructType(_): return nil, false
		case FunctionType(_): return nil, false
		case InterfaceType(_): return nil, false
		case MapType(_): return nil, false
		case ChannelType(_): return nil, false
		case Default(_): return nil, false
		case Propagation(_): return nil, false
		}
	case File(_): return nil, false
	case Declaration(_): return nil, false
	case Specification(_): return nil, false
	case Statement(_): return nil, false
	case Field(_): return nil, false
	case FieldList(_): return nil, false
	case TGoField(_): return nil, false
	case EnumVariant(_): return nil, false
	case MatchCase(_): return nil, false
	case Comment(_): return nil, false
	case CommentGroup(_): return nil, false
	}
}

// EnumDeclarationOf returns an enum declaration payload.
func EnumDeclarationOf(value *Declaration) (*EnumDeclaration, bool) {
	if value == nil { return nil, false }
	match *value {
	case Enum(item): return item.Value, true
	case Bad(_): return nil, false
	case General(_): return nil, false
	case Function(_): return nil, false
	case Struct(_): return nil, false
	case Checked(_): return nil, false
	}
}

// StructDeclarationOf returns a TGo struct declaration payload.
func StructDeclarationOf(value *Declaration) (*StructDeclaration, bool) {
	if value == nil { return nil, false }
	match *value {
	case Struct(item): return item.Value, true
	case Bad(_): return nil, false
	case General(_): return nil, false
	case Function(_): return nil, false
	case Enum(_): return nil, false
	case Checked(_): return nil, false
	}
}

// CheckedDeclarationOf returns a checked declaration payload.
func CheckedDeclarationOf(value *Declaration) (*CheckedDeclaration, bool) {
	if value == nil { return nil, false }
	match *value {
	case Checked(item): return item.Value, true
	case Bad(_): return nil, false
	case General(_): return nil, false
	case Function(_): return nil, false
	case Enum(_): return nil, false
	case Struct(_): return nil, false
