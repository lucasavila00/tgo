// ExpressionKind returns the closed expression variant name.
func ExpressionKind(value *Expression) string {
	match *value {
	case Bad(_): return "Bad"
	case Identifier(_): return "Identifier"
	case Ellipsis(_): return "Ellipsis"
	case BasicLiteral(_): return "BasicLiteral"
	case FunctionLiteral(_): return "FunctionLiteral"
	case CompositeLiteral(_): return "CompositeLiteral"
	case Parenthesized(_): return "Parenthesized"
	case Selector(_): return "Selector"
	case Index(_): return "Index"
	case IndexList(_): return "IndexList"
	case Slice(_): return "Slice"
	case TypeAssertion(_): return "TypeAssertion"
	case Call(_): return "Call"
	case Star(_): return "Star"
	case Unary(_): return "Unary"
	case Binary(_): return "Binary"
	case KeyValue(_): return "KeyValue"
	case ArrayType(_): return "ArrayType"
	case StructType(_): return "StructType"
	case FunctionType(_): return "FunctionType"
	case InterfaceType(_): return "InterfaceType"
	case MapType(_): return "MapType"
	case ChannelType(_): return "ChannelType"
	case Default(_): return "Default"
	case Propagation(_): return "Propagation"
	}
}

// StatementKind returns the closed statement variant name.
func StatementKind(value *Statement) string {
	match *value {
	case Bad(_): return "Bad"
	case Declaration(_): return "Declaration"
	case Empty(_): return "Empty"
	case Labeled(_): return "Labeled"
	case Expression(_): return "Expression"
	case Send(_): return "Send"
	case Increment(_): return "Increment"
	case Assignment(_): return "Assignment"
	case Go(_): return "Go"
	case Defer(_): return "Defer"
	case Return(_): return "Return"
	case Branch(_): return "Branch"
	case Block(_): return "Block"
	case If(_): return "If"
	case Case(_): return "Case"
	case Switch(_): return "Switch"
	case TypeSwitch(_): return "TypeSwitch"
	case Communication(_): return "Communication"
	case Select(_): return "Select"
	case For(_): return "For"
	case Range(_): return "Range"
	case Match(_): return "Match"
	}
}

// DeclarationKind returns the closed declaration variant name.
func DeclarationKind(value *Declaration) string {
	match *value {
	case Bad(_): return "Bad"
	case General(_): return "General"
	case Function(_): return "Function"
	case Enum(_): return "Enum"
	case Struct(_): return "Struct"
	case Checked(_): return "Checked"
	}
}

// SpecificationKind returns the closed specification variant name.
func SpecificationKind(value *Specification) string {
	match *value {
	case Import(_): return "Import"
	case Value(_): return "Value"
	case Type(_): return "Type"
	}
}

// StaticCallName returns the source name for a supported static call.
func StaticCallName(value *Expression) (string, bool) {
	if value == nil { return "", false }
	match *value {
	case Identifier(item): return item.Value.Name, true
	case Selector(item):
		prefix, ok := StaticCallName(item.Value.Expression)
		if !ok { return "", false }
		return prefix + "." + item.Value.Selector.Name, true
	case Index(item): return StaticCallName(item.Value.Expression)
	case IndexList(item): return StaticCallName(item.Value.Expression)
	case Parenthesized(item): return StaticCallName(item.Value.Expression)
	case Star(item): return StaticCallName(item.Value.Expression)
	case Bad(_): return "", false
	case Ellipsis(_): return "", false
	case BasicLiteral(_): return "", false
	case FunctionLiteral(_): return "", false
	case CompositeLiteral(_): return "", false
	case Slice(_): return "", false
	case TypeAssertion(_): return "", false
	case Call(_): return "", false
	case Unary(_): return "", false
	case Binary(_): return "", false
	case KeyValue(_): return "", false
	case ArrayType(_): return "", false
	case StructType(_): return "", false
	case FunctionType(_): return "", false
	case InterfaceType(_): return "", false
	case MapType(_): return "", false
	case ChannelType(_): return "", false
	case Default(_): return "", false
	case Propagation(_): return "", false
	}
}





