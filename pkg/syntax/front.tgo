// Package syntax parses tgo source files.
// Parsed trees are read-only. Mutation makes the traversal indexes invalid.
package syntax

import (
	"go/ast"
	"go/token"
)

// frontSpan is a half-open source range.
type frontSpan struct {
	Start token.Pos
	Stop  token.Pos
}

// Pos returns the first position in the range.
func (s frontSpan) Pos() token.Pos { return s.Start }

// End returns the first position after the range.
func (s frontSpan) End() token.Pos { return s.Stop }

// frontNode is a Go or tgo syntax node.
type frontNode interface {
	Pos() token.Pos
	End() token.Pos
}

// frontExtension is a tgo syntax node.
type frontExtension interface {
	frontNode
	extensionNode()
}

// frontFile is one parsed tgo source file.
type frontFile struct {
	frontSpan
	Doc       *ast.CommentGroup
	Package   token.Pos
	Name      *ast.Ident
	Decls     []frontNode
	Imports   []*ast.ImportSpec
	Comments  []*ast.CommentGroup
	GoVersion string

	goFile     *ast.File
	children   map[frontNode][]frontNode
	parents    map[frontNode]frontNode
	extensions []frontExtension
	attached   map[frontNode][]*ast.CommentGroup
	nonNil    map[token.Pos]bool
}

// frontEnumDecl declares a closed enum.
type frontEnumDecl struct {
	frontSpan
	Doc      *ast.CommentGroup
	Type     token.Pos
	Name     *ast.Ident
	Enum     token.Pos
	Lbrace   token.Pos
	Variants []*frontVariantDecl
	Rbrace   token.Pos
	Comment  *ast.CommentGroup
}

func (*frontEnumDecl) extensionNode() {}

// frontVariantDecl declares one enum payload.
type frontVariantDecl struct {
	frontSpan
	Doc     *ast.CommentGroup
	Name    *ast.Ident
	Struct  token.Pos
	Lbrace  token.Pos
	Fields  []*frontFieldDecl
	Rbrace  token.Pos
	Comment *ast.CommentGroup
}

func (*frontVariantDecl) extensionNode() {}

// frontStructDecl declares a tgo struct.
type frontStructDecl struct {
	frontSpan
	Doc     *ast.CommentGroup
	Type    token.Pos
	Name    *ast.Ident
	Struct  token.Pos
	Lbrace  token.Pos
	Fields  []*frontFieldDecl
	Rbrace  token.Pos
	Comment *ast.CommentGroup
}

func (*frontStructDecl) extensionNode() {}

// frontCheckedDecl declares a type and its construction predicate.
type frontCheckedDecl struct {
	frontSpan
	Doc       *ast.CommentGroup
	Type      token.Pos
	Name      *ast.Ident
	Base      ast.Expr
	Where     token.Pos
	Predicate ast.Expr
	Comment   *ast.CommentGroup
}

func (*frontCheckedDecl) extensionNode() {}

// frontFieldDecl is one tgo field group and its optional default.
type frontFieldDecl struct {
	frontSpan
	Doc     *ast.CommentGroup
	Field   *ast.Field
	Assign  token.Pos
	Default ast.Expr
	Comment *ast.CommentGroup
}

func (*frontFieldDecl) extensionNode() {}

// frontLabeledStmt is an ordinary label whose statement is a tgo node.
type frontLabeledStmt struct {
	frontSpan
	Label *ast.Ident
	Colon token.Pos
	Stmt  frontNode
}

// frontMatchStmt selects one enum variant.
type frontMatchStmt struct {
	frontSpan
	Match   token.Pos
	Subject ast.Expr
	Lbrace  token.Pos
	Cases   []*frontMatchCase
	Rbrace  token.Pos
}

func (*frontMatchStmt) extensionNode() {}

// frontMatchCase binds one enum payload.
type frontMatchCase struct {
	frontSpan
	Case     token.Pos
	Variant  *ast.Ident
	Lparen   token.Pos
	Binding  *ast.Ident
	Rparen   token.Pos
	Colon    token.Pos
	Body     []frontNode
	Comments []*ast.CommentGroup
}

func (*frontMatchCase) extensionNode() {}

// frontDefaultMarker selects all omitted fields that have defaults.
type frontDefaultMarker struct {
	frontSpan
	FirstDot token.Pos
	LastDot  token.Pos
	Default  token.Pos
}

func (*frontDefaultMarker) extensionNode() {}

// frontPropagateExpr returns a wrapped Go error from the current function.
type frontPropagateExpr struct {
	frontSpan
	Expression ast.Expr
	Call       *ast.CallExpr
	Bang       token.Pos
}

func (*frontPropagateExpr) extensionNode() {}


