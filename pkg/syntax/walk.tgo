package syntax

import "go/token"

// SourceText returns the source text in one syntax span.
func SourceText(file *File, span Span) string {
	if file == nil || file.front == nil || file.front.tokenFile == nil ||
		span.Start < file.front.tokenFile.Pos(0) || span.Stop < span.Start {
		return ""
	}
	start := file.front.tokenFile.Offset(span.Start)
	stop := file.front.tokenFile.Offset(span.Stop)
	if start < 0 || stop < start || stop > len(file.front.source) {
		return ""
	}
	return string(file.front.source[start:stop])
}

// Visitor visits each node in source order.
type Visitor interface {
	Visit(*Node) Visitor
}

// Children returns direct children in source order.
func Children(file *File, node *Node) []%Node {
	if file == nil || node == nil {
		return nil
	}
	values := file.children[*node]
	result := make([]%Node, 0, len(values))
	for _, value := range values {
		item := value
		result = append(result, &item)
	}
	return result
}

// Parent returns the direct parent.
func Parent(file *File, node *Node) *Node {
	if file == nil || node == nil {
		return nil
	}
	if value, ok := file.parents[*node]; ok {
		return &value
	}
	return nil
}

// Extensions returns TGo-specific nodes in source order.
func Extensions(file *File) []%Node {
	if file == nil {
		return nil
	}
	result := make([]%Node, 0, len(file.extensions))
	for _, value := range file.extensions {
		item := value
		result = append(result, &item)
	}
	return result
}

// ExtensionAt returns the smallest TGo node at a position.
func ExtensionAt(file *File, position token.Pos) *Node {
	var result *Node = nil
	for _, node := range Extensions(file) {
		start := NodePosition(node)
		end := NodeEnd(node)
		if start <= position && position < end &&
			(result == nil || end-start < NodeEnd(result)-NodePosition(result)) {
			result = node
		}
	}
	return result
}

// AttachedComments returns comments attached to a node.
func AttachedComments(file *File, node *Node) []%CommentGroup {
	if file == nil || node == nil {
		return nil
	}
	var result []%CommentGroup = nil
	for _, comment := range file.attached[*node] {
		result = append(result, comment)
	}
	return result
}

// Walk visits a complete file tree.
func Walk(visitor Visitor, file *File) {
	if visitor == nil || file == nil {
		return
	}
	root := nodeFile(file)
	walkPublic(visitor, file, &root)
}

func walkPublic(visitor Visitor, file *File, node *Node) {
	next := visitor.Visit(node)
	if next == nil {
		return
	}
	for _, child := range Children(file, node) {
		walkPublic(next, file, child)
	}
	next.Visit(nil)
}

// Inspect calls visit for each node. False skips its children.
func Inspect(file *File, visit func(*Node) bool) {
	if file == nil || visit == nil {
		return
	}
	Walk(publicInspector(visit), file)
}

type publicInspector func(*Node) bool

func (visit publicInspector) Visit(node *Node) Visitor {
	if node == nil || visit(node) {
		return visit
	}
	return nil
}

// NodePosition returns the first source position of a node.
func NodePosition(node *Node) token.Pos {
	if node == nil {
		return token.NoPos
	}
	switch nodeValue := *node; nodeValue.Tag() {
	case NodeTagFile:
		value := nodeValue.FilePayload()
		return value.Value.Start
	case NodeTagDeclaration:
		value := nodeValue.DeclarationPayload()
		return DeclarationPosition(value.Value)
	case NodeTagSpecification:
		value := nodeValue.SpecificationPayload()
		return SpecificationPosition(value.Value)
	case NodeTagStatement:
		value := nodeValue.StatementPayload()
		return StatementPosition(value.Value)
	case NodeTagExpression:
		value := nodeValue.ExpressionPayload()
		return ExpressionPosition(value.Value)
	case NodeTagField:
		value := nodeValue.FieldPayload()
		return value.Value.Start
	case NodeTagFieldList:
		value := nodeValue.FieldListPayload()
		return value.Value.Start
	case NodeTagTGoField:
		value := nodeValue.TGoFieldPayload()
		return value.Value.Start
	case NodeTagEnumVariant:
		value := nodeValue.EnumVariantPayload()
		return value.Value.Start
	case NodeTagIdentifier:
		value := nodeValue.IdentifierPayload()
		return value.Value.Start
	case NodeTagComment:
		value := nodeValue.CommentPayload()
		return value.Value.Start
	case NodeTagCommentGroup:
		value := nodeValue.CommentGroupPayload()
		return value.Value.Start
	exhaustive:
	}
}

// NodeEnd returns the first source position after a node.
func NodeEnd(node *Node) token.Pos {
	if node == nil {
		return token.NoPos
	}
	switch nodeValue := *node; nodeValue.Tag() {
	case NodeTagFile:
		value := nodeValue.FilePayload()
		return value.Value.Stop
	case NodeTagDeclaration:
		value := nodeValue.DeclarationPayload()
		return DeclarationEnd(value.Value)
	case NodeTagSpecification:
		value := nodeValue.SpecificationPayload()
		return SpecificationEnd(value.Value)
	case NodeTagStatement:
		value := nodeValue.StatementPayload()
		return StatementEnd(value.Value)
	case NodeTagExpression:
		value := nodeValue.ExpressionPayload()
		return ExpressionEnd(value.Value)
	case NodeTagField:
		value := nodeValue.FieldPayload()
		return value.Value.Stop
	case NodeTagFieldList:
		value := nodeValue.FieldListPayload()
		return value.Value.Stop
	case NodeTagTGoField:
		value := nodeValue.TGoFieldPayload()
		return value.Value.Stop
	case NodeTagEnumVariant:
		value := nodeValue.EnumVariantPayload()
		return value.Value.Stop
	case NodeTagIdentifier:
		value := nodeValue.IdentifierPayload()
		return value.Value.Stop
	case NodeTagComment:
		value := nodeValue.CommentPayload()
		return value.Value.Stop
	case NodeTagCommentGroup:
		value := nodeValue.CommentGroupPayload()
		return value.Value.Stop
	exhaustive:
	}
}

// ExpressionPosition returns the first expression position.
