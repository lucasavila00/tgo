package syntax

import "go/token"

// Visitor visits each node in source order.
type Visitor interface {
	Visit(*Node) Visitor
}

// Children returns direct children in source order.
func Children(file *File, node *Node) []*Node {
	if file == nil || node == nil {
		return nil
	}
	values := file.children[*node]
	result := make([]*Node, 0, len(values))
	for _, value := range values {
		item := value
		result = append(result, &item)
	}
	return result
}

// Parent returns the direct parent.
func Parent(file *File, node *Node) *Node {
	if file == nil || node == nil {
		return nil
	}
	if value, ok := file.parents[*node]; ok {
		return &value
	}
	return nil
}

// Extensions returns TGo-specific nodes in source order.
func Extensions(file *File) []*Node {
	if file == nil {
		return nil
	}
	result := make([]*Node, 0, len(file.extensions))
	for _, value := range file.extensions {
		item := value
		result = append(result, &item)
	}
	return result
}

// ExtensionAt returns the smallest TGo node at a position.
func ExtensionAt(file *File, position token.Pos) *Node {
	var result *Node = nil
	for _, node := range Extensions(file) {
		start := NodePosition(node)
		end := NodeEnd(node)
		if start <= position && position < end &&
			(result == nil || end-start < NodeEnd(result)-NodePosition(result)) {
			result = node
		}
	}
	return result
}

// AttachedComments returns comments attached to a node.
func AttachedComments(file *File, node *Node) []*CommentGroup {
	if file == nil || node == nil {
		return nil
	}
	return append([]*CommentGroup(nil), file.attached[*node]...)
}

// Walk visits a complete file tree.
func Walk(visitor Visitor, file *File) {
	if visitor == nil || file == nil {
		return
	}
	root := nodeFile(file)
	walkPublic(visitor, file, &root)
}

func walkPublic(visitor Visitor, file *File, node *Node) {
	next := visitor.Visit(node)
	if next == nil {
		return
	}
	for _, child := range Children(file, node) {
		walkPublic(next, file, child)
	}
	next.Visit(nil)
}

// Inspect calls visit for each node. False skips its children.
func Inspect(file *File, visit func(*Node) bool) {
	if file == nil || visit == nil {
		return
	}
	Walk(publicInspector(visit), file)
}

type publicInspector func(*Node) bool

func (visit publicInspector) Visit(node *Node) Visitor {
	if node == nil || visit(node) {
		return visit
	}
	return nil
}

// NodePosition returns the first source position of a node.
func NodePosition(node *Node) token.Pos {
	if node == nil {
		return token.NoPos
	}
	match *node {
	case File(value): return value.Value.Start
	case Declaration(value): return DeclarationPosition(value.Value)
	case Specification(value): return SpecificationPosition(value.Value)
	case Statement(value): return StatementPosition(value.Value)
	case Expression(value): return ExpressionPosition(value.Value)
	case Field(value): return value.Value.Start
	case FieldList(value): return value.Value.Start
	case TGoField(value): return value.Value.Start
	case EnumVariant(value): return value.Value.Start
	case MatchCase(value): return value.Value.Start
	case Identifier(value): return value.Value.Start
	case Comment(value): return value.Value.Start
	case CommentGroup(value): return value.Value.Start
	}
}

// NodeEnd returns the first source position after a node.
func NodeEnd(node *Node) token.Pos {
	if node == nil {
		return token.NoPos
	}
	match *node {
	case File(value): return value.Value.Stop
	case Declaration(value): return DeclarationEnd(value.Value)
	case Specification(value): return SpecificationEnd(value.Value)
	case Statement(value): return StatementEnd(value.Value)
	case Expression(value): return ExpressionEnd(value.Value)
	case Field(value): return value.Value.Stop
	case FieldList(value): return value.Value.Stop
	case TGoField(value): return value.Value.Stop
	case EnumVariant(value): return value.Value.Stop
	case MatchCase(value): return value.Value.Stop
	case Identifier(value): return value.Value.Stop
	case Comment(value): return value.Value.Stop
	case CommentGroup(value): return value.Value.Stop
	}
}

// ExpressionPosition returns the first expression position.
func ExpressionPosition(value *Expression) token.Pos {
	if value == nil { return token.NoPos }
	match *value {
	case Bad(item): return item.Value.Start
	case Identifier(item): return item.Value.Start
	case Ellipsis(item): return item.Value.Start
	case BasicLiteral(item): return item.Value.Start
	case FunctionLiteral(item): return item.Value.Start
	case CompositeLiteral(item): return item.Value.Start
	case Parenthesized(item): return item.Value.Start
	case Selector(item): return item.Value.Start
	case Index(item): return item.Value.Start
	case IndexList(item): return item.Value.Start
	case Slice(item): return item.Value.Start
	case TypeAssertion(item): return item.Value.Start
	case Call(item): return item.Value.Start
	case Star(item): return item.Value.Start
	case Unary(item): return item.Value.Start
	case Binary(item): return item.Value.Start
	case KeyValue(item): return item.Value.Start
	case ArrayType(item): return item.Value.Start
	case StructType(item): return item.Value.Start
	case FunctionType(item): return item.Value.Start
	case InterfaceType(item): return item.Value.Start
	case MapType(item): return item.Value.Start
	case ChannelType(item): return item.Value.Start
	case Default(item): return item.Value.Start
	case Propagation(item): return item.Value.Start
	}
}

// ExpressionEnd returns the first position after an expression.
func ExpressionEnd(value *Expression) token.Pos {
	if value == nil { return token.NoPos }
	match *value {
	case Bad(item): return item.Value.Stop
	case Identifier(item): return item.Value.Stop
	case Ellipsis(item): return item.Value.Stop
	case BasicLiteral(item): return item.Value.Stop
	case FunctionLiteral(item): return item.Value.Stop
	case CompositeLiteral(item): return item.Value.Stop
	case Parenthesized(item): return item.Value.Stop
	case Selector(item): return item.Value.Stop
	case Index(item): return item.Value.Stop
	case IndexList(item): return item.Value.Stop
	case Slice(item): return item.Value.Stop
	case TypeAssertion(item): return item.Value.Stop
	case Call(item): return item.Value.Stop
	case Star(item): return item.Value.Stop
	case Unary(item): return item.Value.Stop
	case Binary(item): return item.Value.Stop
	case KeyValue(item): return item.Value.Stop
	case ArrayType(item): return item.Value.Stop
	case StructType(item): return item.Value.Stop
	case FunctionType(item): return item.Value.Stop
	case InterfaceType(item): return item.Value.Stop
	case MapType(item): return item.Value.Stop
	case ChannelType(item): return item.Value.Stop
	case Default(item): return item.Value.Stop
	case Propagation(item): return item.Value.Stop
	}
}

// StatementPosition returns the first statement position.
func StatementPosition(value *Statement) token.Pos {
	return statementSpan(value).Start
}

// StatementEnd returns the first position after a statement.
func StatementEnd(value *Statement) token.Pos {
	return statementSpan(value).Stop
}

func statementSpan(value *Statement) Span {
	if value == nil { return Span{Start: token.NoPos, Stop: token.NoPos} }
	match *value {
	case Bad(item): return item.Value.Span
	case Declaration(item): return item.Value.Span
	case Empty(item): return item.Value.Span
	case Labeled(item): return item.Value.Span
	case Expression(item): return item.Value.Span
	case Send(item): return item.Value.Span
	case Increment(item): return item.Value.Span
	case Assignment(item): return item.Value.Span
	case Go(item): return item.Value.Span
	case Defer(item): return item.Value.Span
	case Return(item): return item.Value.Span
	case Branch(item): return item.Value.Span
	case Block(item): return item.Value.Span
	case If(item): return item.Value.Span
	case Case(item): return item.Value.Span
	case Switch(item): return item.Value.Span
	case TypeSwitch(item): return item.Value.Span
	case Communication(item): return item.Value.Span
	case Select(item): return item.Value.Span
	case For(item): return item.Value.Span
	case Range(item): return item.Value.Span
	case Match(item): return item.Value.Span
	}
}

// DeclarationPosition returns the first declaration position.
func DeclarationPosition(value *Declaration) token.Pos {
	return declarationSpan(value).Start
}

// DeclarationEnd returns the first position after a declaration.
func DeclarationEnd(value *Declaration) token.Pos {
	return declarationSpan(value).Stop
}

func declarationSpan(value *Declaration) Span {
	if value == nil { return Span{Start: token.NoPos, Stop: token.NoPos} }
	match *value {
	case Bad(item): return item.Value.Span
	case General(item): return item.Value.Span
	case Function(item): return item.Value.Span
	case Enum(item): return item.Value.Span
	case Struct(item): return item.Value.Span
	case Checked(item): return item.Value.Span
	}
}

// SpecificationPosition returns the first specification position.
func SpecificationPosition(value *Specification) token.Pos {
	return specificationSpan(value).Start
}

// SpecificationEnd returns the first position after a specification.
func SpecificationEnd(value *Specification) token.Pos {
	return specificationSpan(value).Stop
}

func specificationSpan(value *Specification) Span {
	if value == nil { return Span{Start: token.NoPos, Stop: token.NoPos} }
	match *value {
	case Import(item): return item.Value.Span
	case Value(item): return item.Value.Span
	case Type(item): return item.Value.Span
	}
}

func nodeFile(value *File) Node {
	return Node.File{Value: value}
}
func nodeDeclaration(value *Declaration) Node {
	return Node.Declaration{Value: value}
}
func nodeSpecification(value *Specification) Node {
	return Node.Specification{Value: value}
}
func nodeStatement(value *Statement) Node {
	return Node.Statement{Value: value}
}
func nodeExpression(value *Expression) Node {
	return Node.Expression{Value: value}
}
func nodeField(value *Field) Node { return Node.Field{Value: value} }
func nodeFieldList(value *FieldList) Node { return Node.FieldList{Value: value} }
func nodeTGoField(value *TGoField) Node { return Node.TGoField{Value: value} }
func nodeEnumVariant(value *EnumVariant) Node {
	return Node.EnumVariant{Value: value}
}
func nodeMatchCase(value *MatchCase) Node { return Node.MatchCase{Value: value} }
func nodeIdentifier(value *Identifier) Node {
	return Node.Identifier{Value: value}
}
func nodeComment(value *Comment) Node { return Node.Comment{Value: value} }
func nodeCommentGroup(value *CommentGroup) Node {
	return Node.CommentGroup{Value: value}
}

func appendNode(values []Node, value Node, present bool) []Node {
	if present { return append(values, value) }
	return values
}

func buildPublicIndex(file *File) {
	file.children = make(map[Node][]Node)
	file.parents = make(map[Node]Node)
	file.extensions = nil
	file.attached = make(map[Node][]*CommentGroup)
	root := nodeFile(file)
	var add func(Node) = nil
	add = func(node Node) {
		children := publicChildren(node)
		file.children[node] = children
		if isExtension(node) {
			file.extensions = append(file.extensions, node)
		}
		for _, child := range children {
			if _, exists := file.parents[child]; exists {
				continue
			}
			file.parents[child] = node
			add(child)
		}
	}
	add(root)
}

func isExtension(node Node) bool {
	match node {
	case Declaration(value):
		match *value.Value {
		case Bad(_): return false
		case General(_): return false
		case Function(_): return false
		case Enum(_): return true
		case Struct(_): return true
		case Checked(_): return true
		}
	case Statement(value):
		match *value.Value {
		case Bad(_): return false
		case Declaration(_): return false
		case Empty(_): return false
		case Labeled(_): return false
		case Expression(_): return false
		case Send(_): return false
		case Increment(_): return false
		case Assignment(_): return false
		case Go(_): return false
		case Defer(_): return false
		case Return(_): return false
		case Branch(_): return false
		case Block(_): return false
		case If(_): return false
		case Case(_): return false
		case Switch(_): return false
		case TypeSwitch(_): return false
		case Communication(_): return false
		case Select(_): return false
		case For(_): return false
		case Range(_): return false
		case Match(_): return true
		}
	case Expression(value):
		match *value.Value {
		case Bad(_): return false
		case Identifier(_): return false
		case Ellipsis(_): return false
		case BasicLiteral(_): return false
		case FunctionLiteral(_): return false
		case CompositeLiteral(_): return false
		case Parenthesized(_): return false
		case Selector(_): return false
		case Index(_): return false
		case IndexList(_): return false
		case Slice(_): return false
		case TypeAssertion(_): return false
		case Call(_): return false
		case Star(_): return false
		case Unary(_): return false
		case Binary(_): return false
		case KeyValue(_): return false
		case ArrayType(_): return false
		case StructType(_): return false
		case FunctionType(_): return false
		case InterfaceType(_): return false
		case MapType(_): return false
		case ChannelType(_): return false
		case Default(_): return true
		case Propagation(_): return true
		}
	case TGoField(_): return true
	case EnumVariant(_): return true
	case MatchCase(_): return true
	case File(_): return false
	case Specification(_): return false
	case Field(_): return false
	case FieldList(_): return false
	case Identifier(_): return false
	case Comment(_): return false
	case CommentGroup(_): return false
	}
}

func publicChildren(node Node) []Node {
	match node {
	case File(value): return fileChildren(value.Value)
	case Declaration(value): return declarationChildren(value.Value)
	case Specification(value): return specificationChildren(value.Value)
	case Statement(value): return statementChildren(value.Value)
	case Expression(value): return expressionChildren(value.Value)
	case Field(value): return fieldChildren(value.Value)
	case FieldList(value): return fieldListChildren(value.Value)
	case TGoField(value): return tgoFieldChildren(value.Value)
	case EnumVariant(value): return enumVariantChildren(value.Value)
	case MatchCase(value): return matchCaseChildren(value.Value)
	case Identifier(_): return nil
	case Comment(_): return nil
	case CommentGroup(value):
		result := make([]Node, 0, len(value.Value.List))
		for _, item := range value.Value.List {
			result = append(result, nodeComment(item))
		}
		return result
	}
}

func fileChildren(value *File) []Node {
	result := []Node(nil)
	result = appendNode(result, nodeIdentifier(value.Name), value.Name != nil)
	for _, item := range value.Declarations {
		result = append(result, nodeDeclaration(item))
	}
	for _, item := range value.Comments {
		result = append(result, nodeCommentGroup(item))
	}
	return result
}

func expressionChildren(value *Expression) []Node {
	result := []Node(nil)
	addExpression := func(item *Expression) { if item != nil {
		result = append(result, nodeExpression(item))
	} }
	addExpressions := func(items []*Expression) { for _, item := range items {
		addExpression(item)
	} }
	match *value {
	case Bad(_): return result
	case Identifier(_): return result
	case BasicLiteral(_): return result
	case Default(_): return result
	case Ellipsis(item): addExpression(item.Value.Element)
	case FunctionLiteral(item):
		addExpression(expressionValue(item.Value.Type))
		result = appendNode(result, nodeStatement(statementValue(item.Value.Body)),
			item.Value.Body != nil)
	case CompositeLiteral(item):
		addExpression(item.Value.Type); addExpressions(item.Value.Elements)
	case Parenthesized(item): addExpression(item.Value.Expression)
	case Selector(item):
		addExpression(item.Value.Expression)
		result = appendNode(result, nodeIdentifier(item.Value.Selector),
			item.Value.Selector != nil)
	case Index(item):
		addExpression(item.Value.Expression); addExpression(item.Value.Index)
	case IndexList(item):
		addExpression(item.Value.Expression); addExpressions(item.Value.Indices)
	case Slice(item):
		addExpression(item.Value.Expression); addExpression(item.Value.Low)
		addExpression(item.Value.High); addExpression(item.Value.Max)
	case TypeAssertion(item):
		addExpression(item.Value.Expression); addExpression(item.Value.Type)
	case Call(item):
		addExpression(item.Value.Callee); addExpressions(item.Value.Args)
	case Star(item): addExpression(item.Value.Expression)
	case Unary(item): addExpression(item.Value.Expression)
	case Binary(item):
		addExpression(item.Value.Left); addExpression(item.Value.Right)
	case KeyValue(item):
		addExpression(item.Value.Key); addExpression(item.Value.Value)
	case ArrayType(item):
		addExpression(item.Value.Length); addExpression(item.Value.Element)
	case StructType(item):
		result = appendNode(result, nodeFieldList(item.Value.Fields),
			item.Value.Fields != nil)
	case FunctionType(item):
		result = appendNode(result, nodeFieldList(item.Value.TypeParams),
			item.Value.TypeParams != nil)
		result = appendNode(result, nodeFieldList(item.Value.Params),
			item.Value.Params != nil)
		result = appendNode(result, nodeFieldList(item.Value.Results),
			item.Value.Results != nil)
	case InterfaceType(item):
		result = appendNode(result, nodeFieldList(item.Value.Methods),
			item.Value.Methods != nil)
	case MapType(item):
		addExpression(item.Value.Key); addExpression(item.Value.Value)
	case ChannelType(item): addExpression(item.Value.Value)
	case Propagation(item):
		addExpression(item.Value.Expression)
	}
	return result
}

func statementChildren(value *Statement) []Node {
	result := []Node(nil)
	addStatement := func(item *Statement) { if item != nil {
		result = append(result, nodeStatement(item))
	} }
	addStatements := func(items []*Statement) { for _, item := range items {
		addStatement(item)
	} }
	addExpression := func(item *Expression) { if item != nil {
		result = append(result, nodeExpression(item))
	} }
	addExpressions := func(items []*Expression) { for _, item := range items {
		addExpression(item)
	} }
	match *value {
	case Bad(_): return result
	case Empty(_): return result
	case Declaration(item):
		result = appendNode(result, nodeDeclaration(item.Value.Declaration),
			item.Value.Declaration != nil)
	case Labeled(item):
		result = appendNode(result, nodeIdentifier(item.Value.Label),
			item.Value.Label != nil)
		addStatement(item.Value.Statement)
	case Expression(item): addExpression(item.Value.Expression)
	case Send(item):
		addExpression(item.Value.Channel); addExpression(item.Value.Value)
	case Increment(item): addExpression(item.Value.Expression)
	case Assignment(item):
		addExpressions(item.Value.Left); addExpressions(item.Value.Right)
	case Go(item):
		addExpression(item.Value.Call)
	case Defer(item):
		addExpression(item.Value.Call)
	case Return(item): addExpressions(item.Value.Results)
	case Branch(item):
		result = appendNode(result, nodeIdentifier(item.Value.Label),
			item.Value.Label != nil)
	case Block(item): addStatements(item.Value.List)
	case If(item):
		addStatement(item.Value.Init); addExpression(item.Value.Condition)
		addStatement(statementValue(item.Value.Body)); addStatement(item.Value.Else)
	case Case(item):
		addExpressions(item.Value.List); addStatements(item.Value.Body)
	case Switch(item):
		addStatement(item.Value.Init); addExpression(item.Value.Tag)
		addStatement(statementValue(item.Value.Body))
	case TypeSwitch(item):
		addStatement(item.Value.Init); addStatement(item.Value.Assignment)
		addStatement(statementValue(item.Value.Body))
	case Communication(item):
		addStatement(item.Value.Communication); addStatements(item.Value.Body)
	case Select(item): addStatement(statementValue(item.Value.Body))
	case For(item):
		addStatement(item.Value.Init); addExpression(item.Value.Condition)
		addStatement(item.Value.Post); addStatement(statementValue(item.Value.Body))
	case Range(item):
		addExpression(item.Value.Key); addExpression(item.Value.Value)
		addExpression(item.Value.Source); addStatement(statementValue(item.Value.Body))
	case Match(item):
		addExpression(item.Value.Subject)
		for _, value := range item.Value.Cases {
			result = append(result, nodeMatchCase(value))
		}
	}
	return result
}

func declarationChildren(value *Declaration) []Node {
	result := []Node(nil)
	match *value {
	case Bad(_): return result
	case General(item):
		result = addComment(result, item.Value.Doc)
		for _, spec := range item.Value.Specs {
			result = append(result, nodeSpecification(spec))
		}
	case Function(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeFieldList(item.Value.Receiver),
			item.Value.Receiver != nil)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		result = appendNode(result, nodeExpression(expressionValue(item.Value.Type)),
			item.Value.Type != nil)
		result = appendNode(result, nodeStatement(statementValue(item.Value.Body)),
			item.Value.Body != nil)
	case Enum(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		for _, variant := range item.Value.Variants {
			result = append(result, nodeEnumVariant(variant))
		}
		result = addComment(result, item.Value.Comment)
	case Struct(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		for _, field := range item.Value.Fields {
			result = append(result, nodeTGoField(field))
		}
		result = addComment(result, item.Value.Comment)
	case Checked(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		result = appendNode(result, nodeExpression(item.Value.Base),
			item.Value.Base != nil)
		result = appendNode(result, nodeExpression(item.Value.Predicate),
			item.Value.Predicate != nil)
		result = addComment(result, item.Value.Comment)
	}
	return result
}

func specificationChildren(value *Specification) []Node {
	result := []Node(nil)
	match *value {
	case Import(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		result = appendNode(result, nodeExpression(expressionValue(item.Value.Path)),
			item.Value.Path != nil)
		result = addComment(result, item.Value.Comment)
	case Value(item):
		result = addComment(result, item.Value.Doc)
		for _, name := range item.Value.Names {
			result = append(result, nodeIdentifier(name))
		}
		result = appendNode(result, nodeExpression(item.Value.Type),
			item.Value.Type != nil)
		for _, expression := range item.Value.Values {
			result = append(result, nodeExpression(expression))
		}
		result = addComment(result, item.Value.Comment)
	case Type(item):
		result = addComment(result, item.Value.Doc)
		result = appendNode(result, nodeIdentifier(item.Value.Name),
			item.Value.Name != nil)
		result = appendNode(result, nodeFieldList(item.Value.TypeParams),
			item.Value.TypeParams != nil)
		result = appendNode(result, nodeExpression(item.Value.Type),
			item.Value.Type != nil)
		result = addComment(result, item.Value.Comment)
	}
	return result
}

func fieldChildren(value *Field) []Node {
	result := addComment(nil, value.Doc)
	for _, name := range value.Names {
		result = append(result, nodeIdentifier(name))
	}
	result = appendNode(result, nodeExpression(value.Type), value.Type != nil)
	result = appendNode(result, nodeExpression(expressionValue(value.Tag)),
		value.Tag != nil)
	return addComment(result, value.Comment)
}

func fieldListChildren(value *FieldList) []Node {
	result := []Node(nil)
	for _, field := range value.List { result = append(result, nodeField(field)) }
	return result
}

func tgoFieldChildren(value *TGoField) []Node {
	result := []Node(nil)
	result = appendNode(result, nodeField(value.Field), value.Field != nil)
	result = appendNode(result, nodeExpression(value.Default), value.Default != nil)
	return result
}

func enumVariantChildren(value *EnumVariant) []Node {
	result := addComment(nil, value.Doc)
	result = appendNode(result, nodeIdentifier(value.Name), value.Name != nil)
	for _, field := range value.Fields {
		result = append(result, nodeTGoField(field))
	}
	return addComment(result, value.Comment)
}

func matchCaseChildren(value *MatchCase) []Node {
	result := []Node(nil)
	result = appendNode(result, nodeIdentifier(value.Variant), value.Variant != nil)
	result = appendNode(result, nodeIdentifier(value.Binding), value.Binding != nil)
	for _, statement := range value.Body {
		result = append(result, nodeStatement(statement))
	}
	for _, comment := range value.Comments {
		result = append(result, nodeCommentGroup(comment))
	}
	return result
}

func addComment(values []Node, value *CommentGroup) []Node {
	return appendNode(values, nodeCommentGroup(value), value != nil)
}





