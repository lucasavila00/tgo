}

// StatementPosition returns the first statement position.
func StatementPosition(value *Statement) token.Pos {
	return statementSpan(value).Start
}

// StatementEnd returns the first position after a statement.
func StatementEnd(value *Statement) token.Pos {
	return statementSpan(value).Stop
}

func statementSpan(value *Statement) Span {
	if value == nil {
		return Span{Start: token.NoPos, Stop: token.NoPos}
	}
	switch statementValue := *value; statementValue.Tag() {
	case StatementTagBad:
		item := statementValue.BadPayload()
		return item.Value.Span
	case StatementTagDeclaration:
		item := statementValue.DeclarationPayload()
		return item.Value.Span
	case StatementTagEmpty:
		item := statementValue.EmptyPayload()
		return item.Value.Span
	case StatementTagLabeled:
		item := statementValue.LabeledPayload()
		return item.Value.Span
	case StatementTagExpression:
		item := statementValue.ExpressionPayload()
		return item.Value.Span
	case StatementTagSend:
		item := statementValue.SendPayload()
		return item.Value.Span
	case StatementTagIncrement:
		item := statementValue.IncrementPayload()
		return item.Value.Span
	case StatementTagAssignment:
		item := statementValue.AssignmentPayload()
		return item.Value.Span
	case StatementTagGo:
		item := statementValue.GoPayload()
		return item.Value.Span
	case StatementTagDefer:
		item := statementValue.DeferPayload()
		return item.Value.Span
	case StatementTagReturn:
		item := statementValue.ReturnPayload()
		return item.Value.Span
	case StatementTagBranch:
		item := statementValue.BranchPayload()
		return item.Value.Span
	case StatementTagBlock:
		item := statementValue.BlockPayload()
		return item.Value.Span
	case StatementTagIf:
		item := statementValue.IfPayload()
		return item.Value.Span
	case StatementTagCase:
		item := statementValue.CasePayload()
		return item.Value.Span
	case StatementTagSwitch:
		item := statementValue.SwitchPayload()
		return item.Value.Span
	case StatementTagTypeSwitch:
		item := statementValue.TypeSwitchPayload()
		return item.Value.Span
	case StatementTagCommunication:
		item := statementValue.CommunicationPayload()
		return item.Value.Span
	case StatementTagSelect:
		item := statementValue.SelectPayload()
		return item.Value.Span
	case StatementTagFor:
		item := statementValue.ForPayload()
		return item.Value.Span
	case StatementTagRange:
		item := statementValue.RangePayload()
		return item.Value.Span
	exhaustive:
	}
}

// DeclarationPosition returns the first declaration position.
func DeclarationPosition(value *Declaration) token.Pos {
	return declarationSpan(value).Start
}

// DeclarationEnd returns the first position after a declaration.
func DeclarationEnd(value *Declaration) token.Pos {
	return declarationSpan(value).Stop
}

func declarationSpan(value *Declaration) Span {
	if value == nil {
		return Span{Start: token.NoPos, Stop: token.NoPos}
	}
	switch declarationValue := *value; declarationValue.Tag() {
	case DeclarationTagBad:
		item := declarationValue.BadPayload()
		return item.Value.Span
	case DeclarationTagGeneral:
		item := declarationValue.GeneralPayload()
		return item.Value.Span
	case DeclarationTagFunction:
		item := declarationValue.FunctionPayload()
		return item.Value.Span
	case DeclarationTagEnum:
		item := declarationValue.EnumPayload()
		return item.Value.Span
	case DeclarationTagStruct:
		item := declarationValue.StructPayload()
		return item.Value.Span
	exhaustive:
	}
}

// SpecificationPosition returns the first specification position.
func SpecificationPosition(value *Specification) token.Pos {
	return specificationSpan(value).Start
}

// SpecificationEnd returns the first position after a specification.
func SpecificationEnd(value *Specification) token.Pos {
	return specificationSpan(value).Stop
}

func specificationSpan(value *Specification) Span {
	if value == nil {
		return Span{Start: token.NoPos, Stop: token.NoPos}
	}
	switch specificationValue := *value; specificationValue.Tag() {
	case SpecificationTagImport:
		item := specificationValue.ImportPayload()
		return item.Value.Span
	case SpecificationTagValue:
		item := specificationValue.ValuePayload()
		return item.Value.Span
	case SpecificationTagType:
		item := specificationValue.TypePayload()
		return item.Value.Span
	exhaustive:
	}
}

func nodeFile(value %File) Node {
	return Node.File{Value: value}
}

func nodeDeclaration(value %Declaration) Node {
	return Node.Declaration{Value: value}
}

func nodeSpecification(value %Specification) Node {
	return Node.Specification{Value: value}
}

func nodeStatement(value %Statement) Node {
	return Node.Statement{Value: value}
}

func nodeExpression(value %Expression) Node {
	return Node.Expression{Value: value}
}

func nodeField(value %Field) Node {
	return Node.Field{Value: value}
}

func nodeFieldList(value %FieldList) Node {
	return Node.FieldList{Value: value}
}

func nodeTGoField(value %TGoField) Node {
	return Node.TGoField{Value: value}
}

func nodeEnumVariant(value %EnumVariant) Node {
	return Node.EnumVariant{Value: value}
}

func nodeIdentifier(value %Identifier) Node {
	return Node.Identifier{Value: value}
}

func nodeComment(value %Comment) Node {
	return Node.Comment{Value: value}
}

func nodeCommentGroup(value %CommentGroup) Node {
	return Node.CommentGroup{Value: value}
}
