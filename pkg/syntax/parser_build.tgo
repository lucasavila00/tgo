package syntax

import (
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
)

// anchorPropagations replaces each call with its tgo expression in the public tree.
func (p %sourceParser) anchorPropagations(file %frontFile, anchors map[frontNode]frontNode) {
	parents := make(map[frontNode]frontNode)
	anchoredChildren := make(map[frontNode][]frontNode, len(anchors))
	for child, parent := range anchors {
		anchoredChildren[parent] = append(anchoredChildren[parent], child)
	}
	var visit func(frontNode) = nil
	visit = func(node frontNode) {
		children := syntaxChildren(file, node)
		children = append(children, anchoredChildren[node]...)
		for _, child := range children {
			if child == nil {
				continue
			}
			parents[child] = node
			visit(child)
		}
	}
	visit(file)
	for _, item := range p.propagations {
		parent := parents[item.node.Expression]
		if parent == nil {
			continue
		}
		anchors[item.node] = parent
		anchors[item.node.Expression] = item.node
	}
}

// anchorComprehensions replaces each empty Go projection with its TGo expression.
func (p %sourceParser) anchorComprehensions(file %frontFile, anchors map[frontNode]frontNode) {
	parents := make(map[frontNode]frontNode)
	var visit func(frontNode) = nil
	visit = func(node frontNode) {
		for _, child := range syntaxChildren(file, node) {
			if child == nil {
				continue
			}
			parents[child] = node
			visit(child)
		}
	}
	visit(file)
	for _, item := range p.comprehensions {
		parent := parents[item.node.Projection]
		if parent == nil {
			continue
		}
		anchors[item.node] = parent
		anchors[item.node.Projection] = item.node
	}
}

func (p %sourceParser) makeComprehension(
	raw *rawComprehension,
	projection *ast.CompositeLit,
	defaultAt map[token.Pos]%frontDefaultMarker,
) (*frontComprehensionExpr, map[frontNode]frontNode, error) {
	anchors := make(map[frontNode]frontNode)
	result := &frontComprehensionExpr{
		frontSpan:  frontSpan{Start: p.pos(raw.start), Stop: p.pos(raw.end)},
		Projection: projection,
		Type:       projection.Type,
		Lbrace:     p.pos(p.tokens[raw.open].start),
		Clauses:    nil,
		Result: frontComprehensionResult{
			frontSpan: frontSpan{Start: token.NoPos, Stop: token.NoPos},
			Key:       nil,
			Colon:     token.NoPos,
			Value:     nil,
		},
		Rbrace: p.pos(p.tokens[raw.close].start),
	}
	for _, clause := range raw.clauses {
		switch rawClause := *clause; rawClause.Tag() {
		case rawComprehensionClauseTagRange:
			rawRange := rawClause.RangePayload()
			source, found := p.parseExpression(
				p.tokens[rawRange.sourceStart].start,
				p.tokens[rawRange.sourceEnd].start,
				defaultAt,
			)!!
			for child, parent := range found {
				anchors[child] = parent
			}
			bindings := []*ast.Ident(nil)
			for _, binding := range rawRange.bindings {
				bindings = append(
					bindings,
					&ast.Ident{
						NamePos: p.pos(p.tokens[binding].start),
						Name:    p.tokens[binding].text,
						Obj:     nil,
					},
				)
			}
			item := frontComprehensionClause.Range{
				frontSpan: frontSpan{
					Start: p.pos(p.tokens[rawRange.start].start),
					Stop:  p.pos(p.tokens[rawRange.end-1].end),
				},
				For:      p.pos(p.tokens[rawRange.forToken].start),
				Bindings: bindings,
				Define:   p.pos(p.tokens[rawRange.define].start),
				Range:    p.pos(p.tokens[rawRange.rangeToken].start),
				Source:   source,
				Lbrace:   p.pos(p.tokens[rawRange.open].start),
				Rbrace:   p.pos(p.tokens[rawRange.close].start),
			}
			result.Clauses = append(result.Clauses, item)
		case rawComprehensionClauseTagFilter:
			rawFilter := rawClause.FilterPayload()
			condition, found := p.parseExpression(
				p.tokens[rawFilter.conditionStart].start,
				p.tokens[rawFilter.conditionEnd].start,
				defaultAt,
			)!!
			for child, parent := range found {
				anchors[child] = parent
			}
			item := frontComprehensionClause.Filter{
				frontSpan: frontSpan{
					Start: p.pos(p.tokens[rawFilter.start].start),
					Stop:  p.pos(p.tokens[rawFilter.end-1].end),
				},
				If:        p.pos(p.tokens[rawFilter.ifToken].start),
				Condition: condition,
				Lbrace:    p.pos(p.tokens[rawFilter.open].start),
				Rbrace:    p.pos(p.tokens[rawFilter.close].start),
			}
			result.Clauses = append(result.Clauses, item)
		exhaustive:
		}
	}
	rawResult := raw.result
	value, found, err := p.parseExpression(
		p.tokens[rawResult.valueStart].start,
		p.tokens[rawResult.valueEnd-1].end,
		defaultAt,
	)
	if err != nil {
		return ,, err
	}
	for child, parent := range found {
		anchors[child] = parent
	}
	var key ast.Expr = nil
	colon := token.NoPos
	if rawResult.colon >= 0 {
		key, found, err = p.parseExpression(
			p.tokens[rawResult.keyStart].start,
			p.tokens[rawResult.keyEnd-1].end,
			defaultAt,
		)
		if err != nil {
			return ,, err
		}
		for child, parent := range found {
			anchors[child] = parent
		}
		colon = p.pos(p.tokens[rawResult.colon].start)
	}
	result.Result = frontComprehensionResult{
		frontSpan: frontSpan{
			Start: p.pos(p.tokens[rawResult.start].start),
			Stop:  p.pos(p.tokens[rawResult.end-1].end),
		},
		Key:   key,
		Colon: colon,
		Value: value,
	}
	return result, anchors,
}

func (p %sourceParser) makeDeclaration(
	raw *rawDecl,
	defaultAt map[token.Pos]%frontDefaultMarker,
) (frontNode, map[frontNode]frontNode, error) {
	anchors := make(map[frontNode]frontNode)
	var node frontNode = nil
	switch declaration := *raw; declaration.Tag() {
	case rawDeclTagEnum:
		rawEnum := declaration.EnumPayload()
		name := &ast.Ident{
			NamePos: p.pos(p.tokens[rawEnum.name].start),
			Name:    p.tokens[rawEnum.name].text,
			Obj:     nil,
		}
		node := &frontEnumDecl{
			frontSpan: frontSpan{Start: p.pos(rawEnum.start), Stop: p.pos(rawEnum.end)},
			Doc:       nil,
			Type:      p.pos(p.tokens[rawEnum.typeToken].start),
			Name:      name,
			Enum:      p.pos(p.tokens[rawEnum.keyword].start),
			Tag:       p.enumTag(rawEnum.tag),
			Lbrace:    p.pos(p.tokens[rawEnum.open].start),
			Variants:  nil,
			Rbrace:    p.pos(p.tokens[rawEnum.close].start),
			Comment:   nil,
		}
		for _, rawVariant := range rawEnum.variants {
			fields, fieldAnchors := p.makeFields(rawVariant.fields, defaultAt)!!
			variant := &frontVariantDecl{
				frontSpan: frontSpan{
					Start: p.pos(rawVariant.start),
					Stop:  p.pos(rawVariant.end),
				},
				Doc: nil,
				Name: &ast.Ident{
					NamePos: p.pos(p.tokens[rawVariant.name].start),
					Name:    p.tokens[rawVariant.name].text,
					Obj:     nil,
				},
				Struct:  p.pos(p.tokens[rawVariant.structToken].start),
				Tag:     p.enumTag(rawVariant.tag),
				Lbrace:  p.pos(p.tokens[rawVariant.open].start),
				Fields:  fields,
				Rbrace:  p.pos(p.tokens[rawVariant.close].start),
				Comment: nil,
			}
			node.Variants = append(node.Variants, variant)
			for extension, parent := range fieldAnchors {
				anchors[extension] = parent
			}
		}
		return node, anchors,
	case rawDeclTagStruct:
		rawStruct := declaration.StructPayload()
		name := &ast.Ident{
			NamePos: p.pos(p.tokens[rawStruct.name].start),
			Name:    p.tokens[rawStruct.name].text,
			Obj:     nil,
		}
		fields, fieldAnchors := p.makeFields(rawStruct.fields, defaultAt)!!
		checked := token.NoPos
		if rawStruct.checked >= 0 {
			checked = p.pos(p.tokens[rawStruct.checked].start)
		}
		for extension, parent := range fieldAnchors {
			anchors[extension] = parent
		}
		node = &frontStructDecl{
			frontSpan: frontSpan{Start: p.pos(rawStruct.start), Stop: p.pos(rawStruct.end)},
			Doc:       nil,
			Type:      p.pos(p.tokens[rawStruct.typeToken].start),
			Name:      name,
			Struct:    p.pos(p.tokens[rawStruct.keyword].start),
			Lbrace:    p.pos(p.tokens[rawStruct.open].start),
			Fields:    fields,
			Rbrace:    p.pos(p.tokens[rawStruct.close].start),
			Checked:   checked,
			Comment:   nil,
		}
	exhaustive:
	}
	return node, anchors,
}

func (p %sourceParser) makeFields(
	rawFields []*rawField,
	defaultAt map[token.Pos]%frontDefaultMarker,
) ([]*frontFieldDecl, map[frontNode]frontNode, error) {
	fields := make([]*frontFieldDecl, 0, len(rawFields))
	anchors := make(map[frontNode]frontNode)
	for _, raw := range rawFields {
		declarationEnd := raw.end
		if raw.assign >= 0 {
			declarationEnd = raw.assign
		}
		field := p.parseField(raw.start, declarationEnd)!!
		var defaultValue ast.Expr = nil
		assign := token.NoPos
		if raw.assign >= 0 {
			if len(field.Names) == 0 {
				failure := p.tokenError(raw.start, "embedded fields cannot have defaults")
				return ,, failure
			}
			assign = p.pos(p.tokens[raw.assign].start)
			parsedDefault, expressionAnchors := p.parseExpression(
				p.tokens[raw.assign+1].start,
				p.tokens[raw.end-1].end,
				defaultAt,
			)!!
			defaultValue = parsedDefault
			for extension, parent := range expressionAnchors {
				anchors[extension] = parent
			}
		}
		item := &frontFieldDecl{
			frontSpan: frontSpan{
				Start: p.pos(p.tokens[raw.start].start),
				Stop:  p.pos(p.tokens[raw.end-1].end),
			},
			Doc:     field.Doc,
			Field:   field,
			Assign:  assign,
			Default: defaultValue,
			Comment: field.Comment,
		}
		fields = append(fields, item)
	}
	return fields, anchors,
}

func (p %sourceParser) parseField(start int, end int) (*ast.Field, error) {
	const prefix = "package p\ntype _ struct {\n"
	from := p.tokens[start].start
	to := p.tokens[end-1].end
	projection := p.project(from, to, p.editsInRange(from, to))
	wrapped := prefix + string(projection) + "\n}"
	set := token.NewFileSet()
	file, err := parser.ParseFile(
		set,
		p.filename+" (field)",
		wrapped,
		parser.ParseComments|parser.SkipObjectResolution,
	)
	if err != nil {
		return , p.mapFragmentError(
			err,
			len(prefix),
			p.tokens[start].start,
			p.tokens[end-1].end,
		)
	}
	general := file.Decls[0].(*ast.GenDecl)
	typeSpec := general.Specs[0].(*ast.TypeSpec)
	structure := typeSpec.Type.(*ast.StructType)
	if len(structure.Fields.List) != 1 {
		return , p.tokenError(start, "field declaration must define one field group")
	}
	field := structure.Fields.List[0]
	temporary := set.File(file.Package)
	delta := int(p.pos(p.tokens[start].start)) - int(temporary.Pos(len(prefix)))
	shiftTokenPositions(field, delta)
	p.sanitize(
		field,
		make(map[token.Pos]%frontDefaultMarker),
		make(map[frontNode]frontNode),
	)
	return field,
}

func (p %sourceParser) parseExpression(
	start int,
	end int,
	defaultAt map[token.Pos]%frontDefaultMarker,
) (ast.Expr, map[frontNode]frontNode, error) {
	if start >= end {
		return ,, fmt.Errorf("empty expression")
	}
	const prefix = "package p\nvar _ = "
	edits := p.editsInRange(start, end)
	projection := p.project(start, end, edits)
	wrapped := append([]byte(prefix), projection...)
	set := token.NewFileSet()
	file, err := parser.ParseFile(
		set,
		p.filename+" (expression)",
		wrapped,
		parser.ParseComments|parser.SkipObjectResolution,
	)
	if err != nil {
		failure := p.mapFragmentError(err, len(prefix), start, end)
		return ,, failure
	}
	general := file.Decls[0].(*ast.GenDecl)
	value := general.Specs[0].(*ast.ValueSpec).Values[0]
	temporary := set.File(file.Package)
	delta := int(p.pos(start)) - int(temporary.Pos(len(prefix)))
	shiftTokenPositions(value, delta)
	anchors := make(map[frontNode]frontNode)
	p.sanitize(value, defaultAt, anchors)
	return value, anchors,
}

func (p %sourceParser) enumTag(index int) *ast.BasicLit {
	if index < 0 {
		return nil
	}
	return &ast.BasicLit{
		ValuePos: p.pos(p.tokens[index].start),
		Kind:     token.STRING,
		Value:    p.tokens[index].text,
		ValueEnd: token.NoPos,
	}
}
