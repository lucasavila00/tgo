package syntax

import (
	"go/ast"
	"go/parser"
	"go/token"
)

type comprehensionCandidate struct {
	open  int
	close int
}

// discoverComprehensions finds collection literals whose only element is a range clause.
func (p %sourceParser) discoverComprehensions() error {
	return p.discoverComprehensionsIn(1, len(p.tokens))
}

// discoverComprehensionsIn classifies sibling candidates with one Go parse.
func (p %sourceParser) discoverComprehensionsIn(start int, limit int) error {
	candidates := []comprehensionCandidate(nil)
	for cursor := start; cursor < limit; cursor++ {
		if p.tokens[cursor].kind != token.FOR ||
			p.tokens[cursor-1].kind != token.LBRACE {
			continue
		}
		open := cursor - 1
		close := p.closeToken(open)!!
		candidates = append(candidates, comprehensionCandidate{open: open, close: close})
		cursor = close
	}
	if len(candidates) == 0 {
		return nil
	}
	starts := p.compositeLiteralStarts(candidates)
	for _, item := range candidates {
		literalStart, isLiteral := starts[item.open]
		if !isLiteral {
			if err := p.discoverComprehensionsIn(item.open+2, item.close); err != nil {
				return err
			}
			continue
		}
		comprehension := p.rawComprehension(literalStart, item.open, item.close)!!
		p.comprehensions = append(p.comprehensions, comprehension)
		p.edits = append(p.edits, sourceEdit{
			start: p.tokens[item.open].end,
			end:   p.tokens[item.close].start,
			text:  "",
		})
	}
	return nil
}

// compositeLiteralStarts distinguishes literal bodies from statement blocks.
func (p %sourceParser) compositeLiteralStarts(
	candidates []comprehensionCandidate,
) map[int]int {
	edits := append([]sourceEdit(nil), p.edits...)
	for _, item := range candidates {
		edits = append(edits, sourceEdit{
			start: p.tokens[item.open].end,
			end:   p.tokens[item.close].start,
			text:  "",
		})
	}
	set := token.NewFileSet()
	file, _ := parser.ParseFile(
		set,
		p.filename,
		p.project(0, len(p.source), edits),
		parser.SkipObjectResolution|parser.AllErrors,
	)
	if file == nil {
		return nil
	}
	tokenFile := set.File(file.Package)
	starts := make(map[int]int, len(candidates))
	byOffset := make(map[int]int, len(candidates))
	for _, item := range candidates {
		byOffset[p.tokens[item.open].start] = item.open
	}
	ast.Inspect(file, func(node ast.Node) bool {
		literal, ok := node.(*ast.CompositeLit)
		if !ok {
			return true
		}
		open, found := byOffset[tokenFile.Offset(literal.Lbrace)]
		if found {
			starts[open] = tokenFile.Offset(literal.Pos())
		}
		return true
	})
	return starts
}

func (p %sourceParser) rawComprehension(
	start int,
	open int,
	close int,
) (*rawComprehension, error) {
	clauses, result := p.rawComprehensionBody(open+1, close)!!
	seenFilter := false
	for _, clause := range clauses {
		if clause.kind == "filter" {
			if seenFilter {
				return , p.tokenError(
					clause.keyword,
					"combine comprehension filters with &&",
				)
			}
			seenFilter = true
			continue
		}
		if seenFilter {
			return , p.tokenError(
				clause.keyword,
				"comprehension ranges must precede the filter",
			)
		}
	}
	return &rawComprehension{
		start: start,
		end: p.tokens[close].end,
		open: open,
		close: close,
		clauses: clauses,
		result: result,
		node: nil,
	},
}

func (p %sourceParser) rawComprehensionBody(
	start int,
	limit int,
) ([]*rawComprehensionClause, *rawComprehensionResult, error) {
	start, limit = p.trimComprehensionSemicolons(start, limit)
	if start >= limit {
		return , p.tokenError(limit, "comprehension block needs one item")
	}
	if p.tokens[start].kind != token.FOR && p.tokens[start].kind != token.IF {
		result, err := p.rawComprehensionResult(start, limit)
		return nil, result, err
	}
	bodyClose := limit - 1
	if p.tokens[bodyClose].kind != token.RBRACE {
		return , p.tokenError(start, "comprehension clause needs a block")
	}
	bodyOpen, err := p.openToken(bodyClose)
	if err != nil {
		return , err
	}
	clause, err := p.rawComprehensionClause(start, bodyOpen, bodyClose)
	if err != nil {
		return , err
	}
	children, result, err := p.rawComprehensionBody(bodyOpen+1, bodyClose)
	if err != nil {
		return , err
	}
	return append([]*rawComprehensionClause{clause}, children...), result,
}

func (p %sourceParser) rawComprehensionClause(
	start int,
	open int,
	close int,
) (*rawComprehensionClause, error) {
	if p.tokens[start].kind == token.IF {
		if start+1 >= open {
			return , p.tokenError(start, "comprehension if needs a condition")
		}
		return &rawComprehensionClause{
			kind: "filter", start: start, end: close + 1, keyword: start,
			bindings: nil, define: -1, rangeToken: -1,
			expressionStart: start + 1, expressionEnd: open,
			open: open, close: close,
		},
	}
	define, rangeToken := -1, -1
	for cursor := start + 1; cursor < open; cursor++ {
		if p.tokens[cursor].kind == token.DEFINE {
			define = cursor
		}
		if p.tokens[cursor].kind == token.RANGE {
			rangeToken = cursor
			break
		}
	}
	if define < 0 || rangeToken != define+1 {
		return , p.tokenError(start, "comprehension range must use :=")
	}
	bindings := p.comprehensionBindings(start+1, define)!!
	if rangeToken+1 >= open {
		return , p.tokenError(rangeToken, "comprehension range needs a source")
	}
	return &rawComprehensionClause{
		kind: "range", start: start, end: close + 1, keyword: start,
		bindings: bindings, define: define, rangeToken: rangeToken,
		expressionStart: rangeToken + 1, expressionEnd: open,
		open: open, close: close,
	},
}

func (p %sourceParser) comprehensionBindings(start int, end int) ([]int, error) {
	bindings := []int(nil)
	expectName := true
	for cursor := start; cursor < end; cursor++ {
		if expectName && p.tokens[cursor].kind == token.IDENT {
			bindings = append(bindings, cursor)
			expectName = false
			continue
		}
		if !expectName && p.tokens[cursor].kind == token.COMMA {
			expectName = true
			continue
		}
		return , p.tokenError(cursor, "comprehension range needs one or two names")
	}
	if expectName || len(bindings) == 0 || len(bindings) > 2 {
		return , p.tokenError(start, "comprehension range needs one or two names")
	}
	return bindings,
}

func (p %sourceParser) rawComprehensionResult(
	start int,
	end int,
) (*rawComprehensionResult, error) {
	colon := -1
	depth := 0
	for cursor := start; cursor < end; cursor++ {
		switch p.tokens[cursor].kind {
		case token.LPAREN, token.LBRACK, token.LBRACE:
			depth++
		case token.RPAREN, token.RBRACK, token.RBRACE:
			depth--
		case token.COLON:
			if depth == 0 {
				if colon >= 0 {
					return , p.tokenError(cursor, "comprehension result has two colons")
				}
				colon = cursor
			}
		}
	}
	result := &rawComprehensionResult{
		start: start, end: end, keyStart: -1, keyEnd: -1,
		colon: colon, valueStart: start, valueEnd: end,
	}
	if colon >= 0 {
		if colon == start || colon+1 == end {
			return , p.tokenError(colon, "map comprehension needs a key and value")
		}
		result.keyStart, result.keyEnd = start, colon
		result.valueStart = colon + 1
	}
	return result,
}

func (p %sourceParser) trimComprehensionSemicolons(start int, end int) (int, int) {
	for start < end && p.tokens[start].kind == token.SEMICOLON {
		start++
	}
	for start < end && p.tokens[end-1].kind == token.SEMICOLON {
		end--
	}
	return start, end
}

func (p %sourceParser) openToken(close int) (int, error) {
	depth := 0
	for cursor := close; cursor >= 0; cursor-- {
		switch p.tokens[cursor].kind {
		case token.RPAREN, token.RBRACK, token.RBRACE:
			depth++
		case token.LPAREN, token.LBRACK, token.LBRACE:
			depth--
			if depth == 0 {
				return cursor,
			}
		}
	}
	return , p.tokenError(close, "unmatched %s", p.tokens[close].text)
}
