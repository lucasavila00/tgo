package syntax

import (
	"fmt"
	"go/parser"
	"go/scanner"
	"go/token"
	"strings"
)

// Mode controls parser behavior.
type Mode uint

const (
	// ParseComments retains all source comments.
	ParseComments Mode = 1 << iota

	// AllErrors reports independent scanner and Go parser errors.
	// A tgo production error stops extension parsing at the first error.
	AllErrors

	// AllowInvalidModels keeps syntactically complete enum declarations when
	// their variant set is empty or has duplicate names.
	AllowInvalidModels
	goSource
)

type lexeme struct {
	kind  token.Token
	text  string
	start int
	end   int
}

type sourceEdit struct {
	start int
	end   int
	text  string
}

type rawField struct {
	start  int
	end    int
	assign int
}

type rawVariant struct {
	tag         int
	start       int
	end         int
	name        int
	structToken int
	open        int
	close       int
	fields      []*rawField
}

type rawDeclBase struct {
	start     int
	end       int
	typeToken int
	name      int
	keyword   int
	open      int
	close     int
}

type rawDecl enum {
	Enum struct {
		rawDeclBase
		tag      int
		variants []*rawVariant
	}
	Struct struct {
		rawDeclBase
		checked int
		fields  []*rawField
	}
}

type rawDefault struct {
	start int
	end   int
	first int
	last  int
	word  int
	node  *frontDefaultMarker
}

type rawPropagation struct {
	callEnd    int
	bang       int
	secondBang int
	node       *frontPropagateExpr
}

type rawSuccessReturn struct {
	keyword int
	comma   int
}

type rawFailureReturn struct {
	keyword int
	commas  []int
}

type rawComprehension struct {
	start   int
	end     int
	open    int
	close   int
	clauses []*rawComprehensionClause
	result  *rawComprehensionResult
	node    *frontComprehensionExpr
}

type rawComprehensionClause enum {
	Range struct {
		start       int
		end         int
		forToken    int
		bindings    []int
		define      int
		rangeToken  int
		sourceStart int
		sourceEnd   int
		open        int
		close       int
	}
	Filter struct {
		start          int
		end            int
		ifToken        int
		conditionStart int
		conditionEnd   int
		open           int
		close          int
	}
}

type rawComprehensionResult struct {
	start      int
	end        int
	keyStart   int
	keyEnd     int
	colon      int
	valueStart int
	valueEnd   int
}

type sourceParser struct {
	filename          string
	source            []byte
	tokens            []lexeme
	comments          []sourceEdit
	decls             []*rawDecl
	defaults          []*rawDefault
	exhaustiveOffsets []int
	propagations      []*rawPropagation
	successReturns    []*rawSuccessReturn
	failureReturns    []*rawFailureReturn
	comprehensions    []*rawComprehension
	nonNil            map[token.Pos]bool
	edits             []sourceEdit
	file              *token.File
	mode              Mode
}

// ParseFile parses one tgo source file.
func parseFrontFile(
	fset *token.FileSet,
	filename string,
	source []byte,
	mode Mode,
) (*frontFile, error) {
	if fset == nil {
		return , fmt.Errorf("parse %s: nil file set", filename)
	}
	tokens, comments, err := scanSource(filename, source, mode&AllErrors != 0)
	if err != nil {
		return , err
	}
	state := &sourceParser{
		filename:          filename,
		source:            append([]byte(nil), source...),
		tokens:            tokens,
		comments:          comments,
		decls:             nil,
		defaults:          nil,
		exhaustiveOffsets: nil,
		propagations:      nil,
		successReturns:    nil,
		failureReturns:    nil,
		comprehensions:    nil,
		nonNil:            make(map[token.Pos]bool),
		edits:             nil,
		file:              nil,
		mode:              mode,
	}
	if mode&goSource == 0 {
		if err := state.discoverDeclarations(); err != nil {
			return , state.error(err)
		}
		if err := state.discoverExtensions(); err != nil {
			return , state.error(err)
		}
	}
	projection := state.project(0, len(source), state.edits)
	parseMode := parser.SkipObjectResolution
	if mode&ParseComments != 0 {
		parseMode |= parser.ParseComments
	}
	if mode&AllErrors != 0 {
		parseMode |= parser.AllErrors
	}
	goFile, parseErr := parser.ParseFile(fset, filename, projection, parseMode)
	if goFile == nil {
		return , parseErr
	}
	state.file = fset.File(goFile.Package)
	if state.file == nil {
		return , fmt.Errorf("parse %s: missing token file", filename)
	}
	result, err := state.buildFile(goFile)
	if err != nil {
		return , state.error(err)
	}
	if parseErr != nil {
		return result, parseErr
	}
	return result,
}

func scanSource(
	filename string,
	source []byte,
	allErrors bool,
) ([]lexeme, []sourceEdit, error) {
	set := token.NewFileSet()
	file := set.AddFile(filename, -1, len(source))
	scan := new(scanner.Scanner)
	errors := make(scanner.ErrorList, 0)
	scan.Init(
		file,
		source,
		func(position token.Position, message string) {
			if allErrors || len(errors) == 0 {
				errors.Add(position, message)
			}
		},
		scanner.ScanComments,
	)
	tokens := []lexeme(nil)
	comments := []sourceEdit(nil)
	for {
		position, kind, literal := scan.Scan()
		if kind == token.EOF {
			break
		}
		start := file.Offset(position)
		text := literal
		if text == "" {
			text = kind.String()
		}
		end := start + len(text)
		if kind == token.SEMICOLON && literal == "\n" {
			end = start
		}
		if kind == token.COMMENT {
			comments = append(comments, sourceEdit{start: start, end: end, text: text})
			continue
		}
		tokens = append(tokens, lexeme{kind: kind, text: text, start: start, end: end})
	}
	if len(errors) > 0 {
		errors.Sort()
		return tokens, comments, errors
	}
	return tokens, comments,
}

func (p %sourceParser) error(err error) error {
	if strings.HasPrefix(err.Error(), p.filename+":") {
		return err
	}
	return fmt.Errorf("%s:%w", p.filename, err)
}

func (p %sourceParser) pos(offset int) token.Pos {
	return p.file.Pos(offset)
}

func (p %sourceParser) text(start int, end int) string {
	if start >= end {
		return ""
	}
	return string(p.source[p.tokens[start].start:p.tokens[end-1].end])
}

func (p %sourceParser) implicitSemicolon(index int) bool {
	return index >= 0 && index < len(p.tokens) &&
		p.tokens[index].kind == token.SEMICOLON &&
		p.tokens[index].start == p.tokens[index].end
}

func opening(kind token.Token) bool {
	return kind == token.LPAREN || kind == token.LBRACK || kind == token.LBRACE
}

func (p %sourceParser) closeToken(start int) (int, error) {
	stack := []token.Token(nil)
	for index := start; index < len(p.tokens); index++ {
		switch p.tokens[index].kind {
		case token.LPAREN:
			stack = append(stack, token.RPAREN)
		case token.LBRACK:
			stack = append(stack, token.RBRACK)
		case token.LBRACE:
			stack = append(stack, token.RBRACE)
		case token.RPAREN, token.RBRACK, token.RBRACE:
			if len(stack) == 0 || stack[len(stack)-1] != p.tokens[index].kind {
				return , p.tokenError(index, "unmatched %s", p.tokens[index].text)
			}
			stack = stack[:len(stack)-1]
			if len(stack) == 0 {
				return index,
			}
		}
	}
	return , p.tokenError(start, "unclosed %s", p.tokens[start].text)
}

func (p %sourceParser) tokenError(index int, pattern string, values ...any) error {
	message := fmt.Sprintf(pattern, values...)
	if index < 0 || index >= len(p.tokens) {
		return fmt.Errorf("%s", message)
	}
	position := token.NewFileSet().Position(token.NoPos)
	position.Filename = p.filename
	position.Offset = p.tokens[index].start
	line, column := lineColumn(p.source, p.tokens[index].start)
	position.Line = line
	position.Column = column
	return fmt.Errorf("%d:%d: %s", position.Line, position.Column, message)
}

func lineColumn(source []byte, offset int) (int, int) {
	line := 1
	column := 1
	for index := 0; index < offset && index < len(source); index++ {
		if source[index] == '\n' {
			line++
			column = 1
		} else {
			column++
		}
	}
	return line, column
}

func (p %sourceParser) discoverDeclarations() error {
	for cursor := 0; cursor < len(p.tokens); {
		if p.tokens[cursor].kind == token.TYPE && cursor+1 < len(p.tokens) &&
			p.tokens[cursor+1].kind == token.IDENT {
			declaration, next := p.declaration(cursor)!!
			if declaration != nil {
				p.decls = append(p.decls, declaration)
				declarationStart := 0
				declarationEnd := 0
				switch value := *declaration; value.Tag() {
				case rawDeclTagEnum:
					payload := value.EnumPayload()
					declarationStart = payload.start
					declarationEnd = payload.end
				case rawDeclTagStruct:
					payload := value.StructPayload()
					declarationStart = payload.start
					declarationEnd = payload.end
				exhaustive:
				}
				p.edits = append(
					p.edits,
					sourceEdit{
						start: declarationStart,
						end:   declarationEnd,
						text:  "var _ int",
					},
				)
				cursor = next
				continue
			}
		}
		if opening(p.tokens[cursor].kind) {
			end := p.closeToken(cursor)!!
			cursor = end + 1
			continue
		}
		cursor++
	}
	return nil
}

func (p %sourceParser) declaration(start int) (*rawDecl, int, error) {
	cursor := start + 2
	if cursor >= len(p.tokens) {
		return nil, start + 1,
	}
	if p.tokens[cursor].text == "enum" {
		open := cursor + 1
		if open < len(p.tokens) && p.tokens[open].kind == token.STRING {
			open++
		}
		if p.implicitSemicolon(open) {
			open++
		}
		if open < len(p.tokens) && p.tokens[open].kind == token.LBRACE {
			return p.enumDeclaration(start, cursor, open)
		}
	}
	declarationEnd := p.declarationEnd(cursor)!!
	ordinary := p.goDeclarationSyntax(start, declarationEnd)
	baseStart := cursor
	if ordinary && p.tokens[baseStart].kind != token.STRUCT {
		return nil, start + 1,
	}
	if p.tokens[baseStart].kind == token.STRUCT && baseStart+1 < len(p.tokens) &&
		p.tokens[baseStart+1].kind == token.LBRACE {
		return p.structDeclaration(start, baseStart, baseStart+1)
	}
	return nil, start + 1,
}

func (p %sourceParser) declarationEnd(start int) (int, error) {
	cursor := start
	for cursor < len(p.tokens) && p.tokens[cursor].kind != token.SEMICOLON {
		if opening(p.tokens[cursor].kind) {
			end := p.closeToken(cursor)!!
			cursor = end + 1
			continue
		}
		cursor++
	}
	return cursor,
}

func (p %sourceParser) goDeclarationSyntax(start int, end int) bool {
	if end <= start {
		return false
	}
	text := "package p\n" + p.text(start, end)
	_, err := parser.ParseFile(token.NewFileSet(), "", text, parser.SkipObjectResolution)
	return err == nil
}

func (p %sourceParser) enumDeclaration(
	start int,
	keyword int,
	open int,
) (*rawDecl, int, error) {
	closing := p.closeToken(open)!
	tag := -1
	if keyword+1 < open && p.tokens[keyword+1].kind == token.STRING {
		tag = keyword + 1
	}
	variants := []*rawVariant(nil)
	cursor := open + 1
	names := make(map[string]bool)
	for cursor < closing {
		if p.tokens[cursor].kind == token.SEMICOLON {
			cursor++
			continue
		}
		variant, next := p.variant(cursor, closing)!
		name := p.tokens[variant.name].text
		if names[name] && p.mode&AllowInvalidModels == 0 {
			failure := p.tokenError(variant.name, "duplicate variant %s", name)
			return ,, failure
		}
		names[name] = true
		variants = append(variants, variant)
		cursor = next
	}
	if len(variants) == 0 && p.mode&AllowInvalidModels == 0 {
		failure := p.tokenError(keyword, "enum %s has no variants", p.tokens[start+1].text)
		return ,, failure
	}
	declaration := rawDecl.Enum{
		rawDeclBase: rawDeclBase{
			start:     p.tokens[start].start,
			end:       p.tokens[closing].end,
			typeToken: start,
			name:      start + 1,
			keyword:   keyword,
			open:      open,
			close:     closing,
		},
		tag:      tag,
		variants: variants,
	}
	return &declaration, skipSemicolon(p.tokens, closing+1),
}

func (p %sourceParser) variant(start int, limit int) (*rawVariant, int, error) {
	if start+2 >= limit || p.tokens[start].kind != token.IDENT ||
		p.tokens[start+1].kind != token.STRUCT ||
		p.tokens[start+2].kind != token.LBRACE {
		failure := p.tokenError(start, "variant needs Name struct { fields }")
		return ,, failure
	}
	closing, err := p.closeToken(start + 2)
	if err != nil {
		return ,, err
	}
	fields, err := p.rawFields(start+2, closing)
	if err != nil {
		return ,, err
	}
	variant := new(rawVariant)
	variant.start = p.tokens[start].start
	variant.end = p.tokens[closing].end
	variant.name = start
	variant.structToken = start + 1
	variant.open = start + 2
	variant.close = closing
	variant.fields = fields
	variant.tag = -1
	next := closing + 1
	if next < limit && p.tokens[next].kind == token.STRING {
		variant.tag = next
		variant.end = p.tokens[next].end
		next++
	}
	return variant, skipSemicolon(p.tokens, next),
}

func (p %sourceParser) structDeclaration(
	start int,
	keyword int,
	open int,
) (*rawDecl, int, error) {
	closing, err := p.closeToken(open)
	if err != nil {
		return ,, err
	}
	fields, err := p.rawFields(open, closing)
	if err != nil {
		return ,, err
	}
	next := closing + 1
	checked := -1
	if next < len(p.tokens) && p.tokens[next].kind == token.IDENT &&
		p.tokens[next].text == "checked" {
		checked = next
		next++
	}
	end := p.tokens[closing].end
	if checked >= 0 {
		end = p.tokens[checked].end
	}
	declaration := rawDecl.Struct{
		rawDeclBase: rawDeclBase{
			start:     p.tokens[start].start,
			end:       end,
			typeToken: start,
			name:      start + 1,
			keyword:   keyword,
			open:      open,
			close:     closing,
		},
		checked: checked,
		fields:  fields,
	}
	return &declaration, skipSemicolon(p.tokens, next),
}

func (p %sourceParser) rawFields(open int, closing int) ([]*rawField, error) {
	fields := []*rawField(nil)
	cursor := open + 1
	for cursor < closing {
		if p.tokens[cursor].kind == token.SEMICOLON {
			cursor++
			continue
		}
		field := new(rawField)
		field.start = cursor
		field.assign = -1
		for cursor < closing && p.tokens[cursor].kind != token.SEMICOLON {
			if p.tokens[cursor].kind == token.ASSIGN {
				if field.assign >= 0 {
					return , p.tokenError(cursor, "field has more than one default assignment")
				}
				field.assign = cursor
			}
			if opening(p.tokens[cursor].kind) {
				end := p.closeToken(cursor)!!
				cursor = end + 1
				continue
			}
			cursor++
		}
		field.end = cursor
		if field.assign+1 == field.end {
			return , p.tokenError(field.assign, "missing field default")
		}
		fields = append(fields, field)
	}
	return fields,
}

func skipSemicolon(tokens []lexeme, cursor int) int {
	if cursor < len(tokens) && tokens[cursor].kind == token.SEMICOLON {
		return cursor + 1
	}
	return cursor
}
