package syntax

// functionTypeNode wraps one required function type as an expression.
func functionTypeNode(value %FunctionType) %Expression {
	result := Expression.FunctionType{Value: value}
	return &result
}

// basicLiteralNode wraps one required literal as an expression.
func basicLiteralNode(value %BasicLiteral) %Expression {
	result := Expression.BasicLiteral{Value: value}
	return &result
}

// blockStatementNode wraps one required block as a statement.
func blockStatementNode(value %BlockStatement) %Statement {
	result := Statement.Block{Value: value}
	return &result
}

func buildPublicIndex(file %File) {
	file.children = make(map[Node][]Node)
	file.parents = make(map[Node]Node)
	file.extensions = nil
	file.attached = make(map[Node][]%CommentGroup)
	root := nodeFile(file)
	var add func(Node) = nil
	add = func(node Node) {
		children := publicChildren(node)
		file.children[node] = children
		if isExtension(node) {
			file.extensions = append(file.extensions, node)
		}
		for _, child := range children {
			if _, exists := file.parents[child]; exists {
				continue
			}
			file.parents[child] = node
			add(child)
		}
	}
	add(root)
}

func isExtension(node Node) bool {
	match node {
	case Declaration(value):
		match *value.Value {
		case Bad(_): return false
		case General(_): return false
		case Function(_): return false
		case Enum(_): return true
		case Struct(_): return true
		case Checked(_): return true
		}
	case Statement(value):
		match *value.Value {
		case Bad(_): return false
		case Declaration(_): return false
		case Empty(_): return false
		case Labeled(_): return false
		case Expression(_): return false
		case Send(_): return false
		case Increment(_): return false
		case Assignment(_): return false
		case Go(_): return false
		case Defer(_): return false
		case Return(_): return false
		case Branch(_): return false
		case Block(_): return false
		case If(_): return false
		case Case(_): return false
		case Switch(_): return false
		case TypeSwitch(_): return false
		case Communication(_): return false
		case Select(_): return false
		case For(_): return false
		case Range(_): return false
		case Match(_): return true
		}
	case Expression(value):
		match *value.Value {
		case Bad(_): return false
		case Identifier(_): return false
		case Ellipsis(_): return false
		case BasicLiteral(_): return false
		case FunctionLiteral(_): return false
		case CompositeLiteral(_): return false
		case Parenthesized(_): return false
		case Selector(_): return false
		case Index(_): return false
		case IndexList(_): return false
		case Slice(_): return false
		case TypeAssertion(_): return false
		case Call(_): return false
		case Star(_): return false
		case NonNilPointer(_): return true
		case Unary(_): return false
		case Binary(_): return false
		case KeyValue(_): return false
		case ArrayType(_): return false
		case StructType(_): return false
		case FunctionType(_): return false
		case InterfaceType(_): return false
		case MapType(_): return false
		case ChannelType(_): return false
		case Default(_): return true
		case Propagation(_): return true
		case Comprehension(_): return true
		}
	case TGoField(_): return true
	case EnumVariant(_): return true
	case MatchCase(_): return true
	case File(_): return false
	case Specification(_): return false
	case Field(_): return false
	case FieldList(_): return false
	case Identifier(_): return false
	case Comment(_): return false
	case CommentGroup(_): return false
	}
}

func publicChildren(node Node) []Node {
	match node {
	case File(value): return fileChildren(value.Value)
	case Declaration(value): return declarationChildren(value.Value)
	case Specification(value): return specificationChildren(value.Value)
	case Statement(value): return statementChildren(value.Value)
	case Expression(value): return expressionChildren(value.Value)
	case Field(value): return fieldChildren(value.Value)
	case FieldList(value): return fieldListChildren(value.Value)
	case TGoField(value): return tgoFieldChildren(value.Value)
	case EnumVariant(value): return enumVariantChildren(value.Value)
	case MatchCase(value): return matchCaseChildren(value.Value)
	case Identifier(_): return nil
	case Comment(_): return nil
	case CommentGroup(value):
		result := make([]Node, 0, len(value.Value.List))
		for _, item := range value.Value.List {
			result = append(result, nodeComment(item))
		}
		return result
	}
}

func fileChildren(value %File) []Node {
	result := []Node(nil)
	result = append(result, nodeIdentifier(value.Name))
	for _, item := range value.Declarations {
		result = append(result, nodeDeclaration(item))
	}
	for _, item := range value.Comments {
		result = append(result, nodeCommentGroup(item))
	}
	return result
}

func expressionChildren(value %Expression) []Node {
	result := []Node(nil)
	addExpression := func(item %Expression) {
		result = append(result, nodeExpression(item))
	}
	addExpressions := func(items []%Expression) { for _, item := range items {
		result = append(result, nodeExpression(item))
	} }
	match *value {
	case Bad(_): return result
	case Identifier(_): return result
	case BasicLiteral(_): return result
	case Default(_): return result
	case Ellipsis(item):
		if item.Value.Element != nil { addExpression(item.Value.Element) }
	case FunctionLiteral(item):
		addExpression(functionTypeNode(item.Value.Type))
		result = append(
			result, nodeStatement(blockStatementNode(item.Value.Body)),
		)
	case CompositeLiteral(item):
		if item.Value.Type != nil { addExpression(item.Value.Type) }
		addExpressions(item.Value.Elements)
	case Parenthesized(item): addExpression(item.Value.Expression)
	case Selector(item):
		addExpression(item.Value.Expression)
		result = append(result, nodeIdentifier(item.Value.Selector))
	case Index(item):
		addExpression(item.Value.Expression); addExpression(item.Value.Index)
	case IndexList(item):
		addExpression(item.Value.Expression); addExpressions(item.Value.Indices)
	case Slice(item):
		addExpression(item.Value.Expression)
		if item.Value.Low != nil { addExpression(item.Value.Low) }
		if item.Value.High != nil { addExpression(item.Value.High) }
		if item.Value.Max != nil { addExpression(item.Value.Max) }
	case TypeAssertion(item):
		addExpression(item.Value.Expression)
		if item.Value.Type != nil { addExpression(item.Value.Type) }
	case Call(item):
		addExpression(item.Value.Callee); addExpressions(item.Value.Args)
	case Star(item): addExpression(item.Value.Expression)
	case NonNilPointer(item): addExpression(item.Value.Type)
	case Unary(item): addExpression(item.Value.Expression)
	case Binary(item):
		addExpression(item.Value.Left); addExpression(item.Value.Right)
	case KeyValue(item):
		addExpression(item.Value.Key); addExpression(item.Value.Value)
	case ArrayType(item):
		if item.Value.Length != nil { addExpression(item.Value.Length) }
		addExpression(item.Value.Element)
	case StructType(item):
		result = append(result, nodeFieldList(item.Value.Fields))
	case FunctionType(item):
		if item.Value.TypeParams != nil {
			result = append(result, nodeFieldList(item.Value.TypeParams))
		}
		result = append(result, nodeFieldList(item.Value.Params))
		if item.Value.Results != nil {
			result = append(result, nodeFieldList(item.Value.Results))
		}
	case InterfaceType(item):
		result = append(result, nodeFieldList(item.Value.Methods))
	case MapType(item):
		addExpression(item.Value.Key); addExpression(item.Value.Value)
	case ChannelType(item): addExpression(item.Value.Value)
	case Propagation(item):
		addExpression(item.Value.Expression)
	case Comprehension(item):
		addExpression(item.Value.Type)
		for _, clause := range item.Value.Clauses {
			match clause {
			case Range(value):
				for _, binding := range value.Value.Bindings {
					result = append(result, nodeIdentifier(binding))
				}
				addExpression(value.Value.Source)
			case Filter(value): addExpression(value.Value.Condition)
			}
		}
		if item.Value.Result.Key != nil {
			addExpression(item.Value.Result.Key)
		}
		addExpression(item.Value.Result.Value)
	}
	return result
}

func statementChildren(value %Statement) []Node {
	result := []Node(nil)
	addStatement := func(item %Statement) {
		result = append(result, nodeStatement(item))
	}
	addStatements := func(items []%Statement) { for _, item := range items {
		result = append(result, nodeStatement(item))
	} }
	addExpression := func(item %Expression) {
		result = append(result, nodeExpression(item))
	}
	addExpressions := func(items []%Expression) { for _, item := range items {
		result = append(result, nodeExpression(item))
	} }
	match *value {
	case Bad(_): return result
	case Empty(_): return result
	case Declaration(item):
		result = append(result, nodeDeclaration(item.Value.Declaration))
	case Labeled(item):
		result = append(result, nodeIdentifier(item.Value.Label))
		addStatement(item.Value.Statement)
	case Expression(item): addExpression(item.Value.Expression)
	case Send(item):
		addExpression(item.Value.Channel); addExpression(item.Value.Value)
	case Increment(item): addExpression(item.Value.Expression)
	case Assignment(item):
		addExpressions(item.Value.Left); addExpressions(item.Value.Right)
	case Go(item):
		addExpression(item.Value.Call)
	case Defer(item):
		addExpression(item.Value.Call)
	case Return(item): addExpressions(item.Value.Results)
	case Branch(item):
		if item.Value.Label != nil {
			result = append(result, nodeIdentifier(item.Value.Label))
		}
	case Block(item): addStatements(item.Value.List)
	case If(item):
		if item.Value.Init != nil { addStatement(item.Value.Init) }
		addExpression(item.Value.Condition)
		addStatement(blockStatementNode(item.Value.Body))
		if item.Value.Else != nil { addStatement(item.Value.Else) }
	case Case(item):
		addExpressions(item.Value.List); addStatements(item.Value.Body)
	case Switch(item):
		if item.Value.Init != nil { addStatement(item.Value.Init) }
		if item.Value.Tag != nil { addExpression(item.Value.Tag) }
		addStatement(blockStatementNode(item.Value.Body))
	case TypeSwitch(item):
		if item.Value.Init != nil { addStatement(item.Value.Init) }
		addStatement(item.Value.Assignment)
		addStatement(blockStatementNode(item.Value.Body))
	case Communication(item):
		if item.Value.Communication != nil {
			addStatement(item.Value.Communication)
		}
		addStatements(item.Value.Body)
	case Select(item): addStatement(blockStatementNode(item.Value.Body))
	case For(item):
		if item.Value.Init != nil { addStatement(item.Value.Init) }
		if item.Value.Condition != nil { addExpression(item.Value.Condition) }
		if item.Value.Post != nil { addStatement(item.Value.Post) }
		addStatement(blockStatementNode(item.Value.Body))
	case Range(item):
		if item.Value.Key != nil { addExpression(item.Value.Key) }
		if item.Value.Value != nil { addExpression(item.Value.Value) }
		addExpression(item.Value.Source); addStatement(blockStatementNode(item.Value.Body))
	case Match(item):
		addExpression(item.Value.Subject)
		for _, value := range item.Value.Cases {
			result = append(result, nodeMatchCase(value))
		}
	}
	return result
}

func declarationChildren(value %Declaration) []Node {
	result := []Node(nil)
	match *value {
	case Bad(_): return result
	case General(item):
		result = addComment(result, item.Value.Doc)
		for _, spec := range item.Value.Specs {
			result = append(result, nodeSpecification(spec))
		}
	case Function(item):
		result = addComment(result, item.Value.Doc)
		if item.Value.Receiver != nil {
			result = append(result, nodeFieldList(item.Value.Receiver))
		}
		result = append(result, nodeIdentifier(item.Value.Name))
		result = append(result, nodeExpression(functionTypeNode(item.Value.Type)))
		if item.Value.Body != nil {
			result = append(
				result, nodeStatement(blockStatementNode(item.Value.Body)),
			)
		}
	case Enum(item):
		result = addComment(result, item.Value.Doc)
		if item.Value.Tag != nil {
			tag := Expression.BasicLiteral{Value: item.Value.Tag}
			result = append(result, nodeExpression(&tag))
		}
		result = append(result, nodeIdentifier(item.Value.Name))
		for _, variant := range item.Value.Variants {
			result = append(result, nodeEnumVariant(variant))
		}
		result = addComment(result, item.Value.Comment)
	case Struct(item):
		result = addComment(result, item.Value.Doc)
		result = append(result, nodeIdentifier(item.Value.Name))
		for _, field := range item.Value.Fields {
			result = append(result, nodeTGoField(field))
		}
		result = addComment(result, item.Value.Comment)
	case Checked(item):
		result = addComment(result, item.Value.Doc)
		result = append(result, nodeIdentifier(item.Value.Name))
		result = append(result, nodeExpression(item.Value.Base))
		result = append(result, nodeExpression(item.Value.Predicate))
		result = addComment(result, item.Value.Comment)
	}
	return result
}

func specificationChildren(value %Specification) []Node {
	result := []Node(nil)
	match *value {
	case Import(item):
		result = addComment(result, item.Value.Doc)
		if item.Value.Name != nil {
			result = append(result, nodeIdentifier(item.Value.Name))
		}
		result = append(result, nodeExpression(basicLiteralNode(item.Value.Path)))
		result = addComment(result, item.Value.Comment)
	case Value(item):
		result = addComment(result, item.Value.Doc)
		for _, name := range item.Value.Names {
			result = append(result, nodeIdentifier(name))
		}
		if item.Value.Type != nil {
			result = append(result, nodeExpression(item.Value.Type))
		}
		for _, expression := range item.Value.Values {
			result = append(result, nodeExpression(expression))
		}
		result = addComment(result, item.Value.Comment)
	case Type(item):
		result = addComment(result, item.Value.Doc)
		result = append(result, nodeIdentifier(item.Value.Name))
		if item.Value.TypeParams != nil {
			result = append(result, nodeFieldList(item.Value.TypeParams))
		}
		result = append(result, nodeExpression(item.Value.Type))
		result = addComment(result, item.Value.Comment)
	}
	return result
}

func fieldChildren(value %Field) []Node {
	result := addComment(nil, value.Doc)
	for _, name := range value.Names {
		result = append(result, nodeIdentifier(name))
	}
	result = append(result, nodeExpression(value.Type))
	if value.Tag != nil {
		result = append(result, nodeExpression(basicLiteralNode(value.Tag)))
	}
	return addComment(result, value.Comment)
}

func fieldListChildren(value %FieldList) []Node {
	result := []Node(nil)
	for _, field := range value.List { result = append(result, nodeField(field)) }
	return result
}

func tgoFieldChildren(value %TGoField) []Node {
	result := []Node(nil)
	result = append(result, nodeField(value.Field))
	if value.Default != nil {
		result = append(result, nodeExpression(value.Default))
	}
	return result
}

func enumVariantChildren(value %EnumVariant) []Node {
	result := addComment(nil, value.Doc)
	if value.Tag != nil {
		tag := Expression.BasicLiteral{Value: value.Tag}
		result = append(result, nodeExpression(&tag))
	}
	result = append(result, nodeIdentifier(value.Name))
	for _, field := range value.Fields {
		result = append(result, nodeTGoField(field))
	}
	return addComment(result, value.Comment)
}

func matchCaseChildren(value %MatchCase) []Node {
	result := []Node(nil)
	result = append(result, nodeIdentifier(value.Variant))
	result = append(result, nodeIdentifier(value.Binding))
	for _, statement := range value.Body {
		result = append(result, nodeStatement(statement))
	}
	for _, comment := range value.Comments {
		result = append(result, nodeCommentGroup(comment))
	}
	return result
}

func addComment(values []Node, value *CommentGroup) []Node {
	if value == nil {
		return values
	}
	return append(values, nodeCommentGroup(value))
}
