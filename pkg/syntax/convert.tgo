package syntax

import (
	"fmt"
	"go/ast"
	"go/token"
)

// ParseFile parses one TGo source file and returns only TGo AST nodes.
func ParseFile(
	files *token.FileSet,
	filename string,
	source []byte,
	mode Mode,
) (*File, error) {
	front, err := parseFrontFile(files, filename, source, mode)
	if front == nil {
		return nil, err
	}
	conversion := newConverter(front)
	result := conversion.file()
	if err != nil {
		return result, err
	}
	return result, nil
}

// ParseGoFile parses one Go source file into the public syntax ADT.
func ParseGoFile(
	files *token.FileSet,
	filename string,
	source []byte,
	mode Mode,
) (*File, error) {
	return ParseFile(files, filename, source, mode|goSource)
}

type converter struct {
	front       %frontFile
	propagation map[ast.Expr]*frontPropagateExpr
	convertedPropagation map[%frontPropagateExpr]%Expression
	comprehension map[*ast.CompositeLit]*frontComprehensionExpr
	comments    map[%ast.Comment]%Comment
	groups      map[%ast.CommentGroup]%CommentGroup
	imports     map[%ast.ImportSpec]%ImportSpecification
}

func newConverter(front %frontFile) %converter {
	propagation := make(map[ast.Expr]*frontPropagateExpr)
	comprehension := make(map[*ast.CompositeLit]*frontComprehensionExpr)
	for _, extension := range front.extensions {
		item, ok := extension.(*frontPropagateExpr)
		if ok {
			propagation[item.Expression] = item
		}
		collection, ok := extension.(*frontComprehensionExpr)
		if ok {
			comprehension[collection.Projection] = collection
		}
	}
	return &converter{
		front:       front,
		propagation: propagation,
		convertedPropagation: make(map[%frontPropagateExpr]%Expression),
		comprehension: comprehension,
		comments:    make(map[%ast.Comment]%Comment),
		groups:      make(map[%ast.CommentGroup]%CommentGroup),
		imports:     make(map[%ast.ImportSpec]%ImportSpecification),
	}
}

func span(node interface{ Pos() token.Pos; End() token.Pos }) Span {
	return Span{Start: node.Pos(), Stop: node.End()}
}

func (c %converter) file() %File {
	result := &File{
		Span:          Span{Start: c.front.Pos(), Stop: c.front.End()},
		Doc:           c.commentGroup(c.front.Doc),
		Package:       c.front.Package,
		Name:          c.identifierRequired(c.front.Name),
		Declarations:  nil,
		Imports:       nil,
		Comments:      nil,
		GoVersion:     c.front.GoVersion,
		front:         c.front,
		children:      nil,
		parents:       nil,
		extensions:    nil,
		attached:      nil,
	}
	for _, item := range c.front.Decls {
		result.Declarations = append(result.Declarations, c.declarationMust(item))
	}
	for _, item := range c.front.Imports {
		result.Imports = append(result.Imports, c.importSpecificationRequired(item))
	}
	for _, item := range c.front.Comments {
		result.Comments = append(result.Comments, c.commentGroupRequired(item))
	}
	buildPublicIndex(result)
	return result
}

func (c %converter) identifier(value *ast.Ident) *Identifier {
	if value == nil {
		return nil
	}
	return c.identifierRequired(value)
}

func (c %converter) identifierRequired(value *ast.Ident) %Identifier {
	return &Identifier{Span: span(value), Name: value.Name}
}

func (c %converter) comment(value *ast.Comment) *Comment {
	if value == nil {
		return nil
	}
	if found, ok := c.comments[value]; ok {
		return found
	}
	result := &Comment{Span: span(value), Text: value.Text}
	c.comments[value] = result
	return result
}

func (c %converter) commentRequired(value *ast.Comment) %Comment {
	if found, ok := c.comments[value]; ok {
		return found
	}
	result := &Comment{Span: span(value), Text: value.Text}
	c.comments[value] = result
	return result
}

func (c %converter) commentGroup(value *ast.CommentGroup) *CommentGroup {
	if value == nil {
		return nil
	}
	return c.commentGroupRequired(value)
}

func (c %converter) commentGroupRequired(value *ast.CommentGroup) %CommentGroup {
	if found, ok := c.groups[value]; ok {
		return found
	}
	result := &CommentGroup{Span: span(value), List: nil}
	c.groups[value] = result
	for _, item := range value.List {
		result.List = append(result.List, c.commentRequired(item))
	}
	return result
}

func (c %converter) field(value *ast.Field) *Field {
	if value == nil {
		return nil
	}
	return c.fieldRequired(value)
}

func (c %converter) fieldRequired(value *ast.Field) %Field {
	result := &Field{
		Span:    span(value),
		Doc:     c.commentGroup(value.Doc),
		Names:   nil,
		Type:    c.expressionRequired(value.Type),
		Tag:     c.basicLiteral(value.Tag),
		Comment: c.commentGroup(value.Comment),
	}
	for _, name := range value.Names {
		result.Names = append(result.Names, c.identifierRequired(name))
	}
	return result
}

func (c %converter) fieldList(value *ast.FieldList) *FieldList {
	if value == nil {
		return nil
	}
	return c.fieldListRequired(value)
}

func (c %converter) fieldListRequired(value *ast.FieldList) %FieldList {
	result := &FieldList{
		Span:    span(value),
		Opening: value.Opening,
		List:    nil,
		Closing: value.Closing,
	}
	for _, item := range value.List {
		result.List = append(result.List, c.fieldRequired(item))
	}
	return result
}
func (c %converter) expression(value ast.Expr) *Expression {
	if value == nil {
		return nil
	}
	return c.expressionRequired(value)
}

func (c %converter) expressionRequired(value ast.Expr) %Expression {
	if literal, ok := value.(*ast.CompositeLit); ok {
		if item := c.comprehension[literal]; item != nil {
			return c.comprehensionExpression(item)
		}
	}
	if item := c.propagation[value]; item != nil {
		return c.propagationExpression(item)
	}
	return c.expressionRaw(value)
}

func (c %converter) comprehensionExpression(
	value %frontComprehensionExpr,
) %Expression {
	payload := &ComprehensionExpression{
		Span: Span{Start: value.Pos(), Stop: value.End()},
		Type: c.expressionRequired(value.Type),
		Lbrace: value.Lbrace,
		Clauses: nil,
		Result: ComprehensionResult{
			Span: Span{Start: value.Result.Pos(), Stop: value.Result.End()},
			Key: c.expression(value.Result.Key),
			Colon: value.Result.Colon,
			Value: c.expressionRequired(value.Result.Value),
		},
		Rbrace: value.Rbrace,
	}
	for _, clause := range value.Clauses {
		if clause.Kind == "range" {
			rangeClause := &ComprehensionRangeClause{
				Span: Span{Start: clause.Pos(), Stop: clause.End()},
				For: clause.Keyword, Bindings: nil,
				Define: clause.Define, Range: clause.Range,
				Source: c.expressionRequired(clause.Expression),
				Lbrace: clause.Lbrace, Rbrace: clause.Rbrace,
			}
			for _, binding := range clause.Bindings {
				rangeClause.Bindings = append(
					rangeClause.Bindings,
					c.identifierRequired(binding),
				)
			}
			payload.Clauses = append(
				payload.Clauses,
				ComprehensionClause.Range{Value: rangeClause},
			)
			continue
		}
		payload.Clauses = append(
			payload.Clauses,
			ComprehensionClause.Filter{Value: &ComprehensionFilterClause{
				Span: Span{Start: clause.Pos(), Stop: clause.End()},
				If: clause.Keyword,
				Condition: c.expressionRequired(clause.Expression),
				Lbrace: clause.Lbrace, Rbrace: clause.Rbrace,
			}},
		)
	}
	result := Expression.Comprehension{Value: payload}
	return &result
}

func (c %converter) expressionRaw(value ast.Expr) %Expression {
	switch item := value.(type) {
	case *ast.BadExpr:
		result := Expression.Bad{Value: &BadExpression{
			Span: span(item), From: item.From, To: item.To,
		}}
		return &result
	case *ast.Ident:
		result := Expression.Identifier{Value: c.identifierRequired(item)}
		return &result
	case *ast.Ellipsis:
		result := Expression.Ellipsis{Value: &EllipsisExpression{
			Span: span(item), Ellipsis: item.Ellipsis, Element: c.expression(item.Elt),
		}}
		return &result
	case *ast.BasicLit:
		result := Expression.BasicLiteral{Value: c.basicLiteralRequired(item)}
		return &result
	case *ast.FuncLit:
		result := Expression.FunctionLiteral{Value: &FunctionLiteral{
			Span: span(item), Type: c.functionTypeRequired(item.Type),
			Body: c.blockRequired(item.Body),
		}}
		return &result
	case *ast.CompositeLit:
		result := Expression.CompositeLiteral{Value: c.compositeLiteral(item)}
		return &result
	case *ast.ParenExpr:
		result := Expression.Parenthesized{Value: &ParenthesizedExpression{
			Span: span(item), Lparen: item.Lparen,
			Expression: c.expressionRequired(item.X), Rparen: item.Rparen,
		}}
		return &result
	case *ast.SelectorExpr:
		result := Expression.Selector{Value: &SelectorExpression{
			Span: span(item), Expression: c.expressionRequired(item.X),
			Selector: c.identifierRequired(item.Sel),
		}}
		return &result
	case *ast.IndexExpr:
		result := Expression.Index{Value: &IndexExpression{
			Span: span(item), Expression: c.expressionRequired(item.X),
			Lbrack: item.Lbrack, Index: c.expressionRequired(item.Index),
			Rbrack: item.Rbrack,
		}}
		return &result
	case *ast.IndexListExpr:
		value := &IndexListExpression{
			Span: span(item), Expression: c.expressionRequired(item.X),
			Lbrack: item.Lbrack, Indices: nil, Rbrack: item.Rbrack,
		}
		value.Indices = c.expressions(item.Indices)
		result := Expression.IndexList{Value: value}
		return &result
	case *ast.SliceExpr:
		result := Expression.Slice{Value: &SliceExpression{
			Span: span(item), Expression: c.expressionRequired(item.X),
			Lbrack: item.Lbrack, Low: c.expression(item.Low),
			High: c.expression(item.High), Max: c.expression(item.Max),
			Slice3: item.Slice3, Rbrack: item.Rbrack,
		}}
		return &result
	case *ast.TypeAssertExpr:
		result := Expression.TypeAssertion{Value: &TypeAssertionExpression{
			Span: span(item), Expression: c.expressionRequired(item.X),
			Lparen: item.Lparen, Type: c.expression(item.Type), Rparen: item.Rparen,
		}}
		return &result
	case *ast.CallExpr:
		result := Expression.Call{Value: c.callRequired(item)}
		return &result
	case *ast.StarExpr:
		if c.front.nonNil[item.Star] {
			result := Expression.NonNilPointer{Value: &NonNilPointerType{
				Span: span(item), Percent: item.Star,
				Type: c.expressionRequired(item.X),
			}}
			return &result
		}
		result := Expression.Star{Value: &StarExpression{
			Span: span(item), Star: item.Star,
			Expression: c.expressionRequired(item.X),
		}}
		return &result
	case *ast.UnaryExpr:
		result := Expression.Unary{Value: &UnaryExpression{
			Span: span(item), OperatorPosition: item.OpPos,
			Operator: item.Op, Expression: c.expressionRequired(item.X),
		}}
		return &result
	case *ast.BinaryExpr:
		result := Expression.Binary{Value: &BinaryExpression{
			Span: span(item), Left: c.expressionRequired(item.X),
			OperatorPosition: item.OpPos, Operator: item.Op,
			Right: c.expressionRequired(item.Y),
		}}
		return &result
	case *ast.KeyValueExpr:
		result := Expression.KeyValue{Value: &KeyValueExpression{
			Span: span(item), Key: c.expressionRequired(item.Key),
			Colon: item.Colon, Value: c.expressionRequired(item.Value),
		}}
		return &result
	case *ast.ArrayType:
		result := Expression.ArrayType{Value: &ArrayType{
			Span: span(item), Lbrack: item.Lbrack,
			Length: c.expression(item.Len), Element: c.expressionRequired(item.Elt),
		}}
		return &result
	case *ast.StructType:
		result := Expression.StructType{Value: &StructType{
			Span: span(item), Struct: item.Struct,
			Fields: c.fieldListRequired(item.Fields), Incomplete: item.Incomplete,
		}}
		return &result
	case *ast.FuncType:
		result := Expression.FunctionType{Value: c.functionTypeRequired(item)}
		return &result
	case *ast.InterfaceType:
		result := Expression.InterfaceType{Value: &InterfaceType{
			Span: span(item), Interface: item.Interface,
			Methods: c.fieldListRequired(item.Methods), Incomplete: item.Incomplete,
		}}
		return &result
	case *ast.MapType:
		result := Expression.MapType{Value: &MapType{
			Span: span(item), Map: item.Map,
			Key: c.expressionRequired(item.Key),
			Value: c.expressionRequired(item.Value),
		}}
		return &result
	case *ast.ChanType:
		result := Expression.ChannelType{Value: &ChannelType{
			Span: span(item), Begin: item.Begin, Arrow: item.Arrow,
			Direction: channelDirection(item.Dir),
			Value: c.expressionRequired(item.Value),
		}}
		return &result
	default:
		panic(fmt.Sprintf("unsupported go/ast expression %T", value))
	}
}

func (c %converter) expressions(values []ast.Expr) []%Expression {
	result := make([]%Expression, 0, len(values))
	for _, value := range values {
		result = append(result, c.expressionRequired(value))
	}
	return result
}

func (c %converter) basicLiteral(value *ast.BasicLit) *BasicLiteral {
	if value == nil {
		return nil
	}
	return c.basicLiteralRequired(value)
}

func (c %converter) basicLiteralRequired(value *ast.BasicLit) %BasicLiteral {
	return &BasicLiteral{
		Span: span(value), ValuePosition: value.ValuePos,
		Kind: value.Kind, Value: value.Value,
	}
}

func (c %converter) functionType(value *ast.FuncType) *FunctionType {
	if value == nil {
		return nil
	}
	return c.functionTypeRequired(value)
}

func (c %converter) functionTypeRequired(value *ast.FuncType) %FunctionType {
	return &FunctionType{
		Span: span(value), Function: value.Func,
		TypeParams: c.fieldList(value.TypeParams),
		Params: c.fieldListRequired(value.Params), Results: c.fieldList(value.Results),
	}
}

func (c %converter) call(value *ast.CallExpr) *CallExpression {
	if value == nil {
		return nil
	}
	return c.callRequired(value)
}

func (c %converter) callRequired(value *ast.CallExpr) %CallExpression {
	return &CallExpression{
		Span: span(value), Function: value.Fun.Pos(),
		Callee: c.expressionRequired(value.Fun),
		Lparen: value.Lparen, Args: c.expressions(value.Args),
		Ellipsis: value.Ellipsis, Rparen: value.Rparen,
	}
}

func channelDirection(value ast.ChanDir) ChannelDirection {
	if value == ast.SEND {
		return ChannelDirection.SendOnly{}
	}
	if value == ast.RECV {
		return ChannelDirection.ReceiveOnly{}
	}
	return ChannelDirection.SendReceive{}
}

func (c %converter) compositeLiteral(value *ast.CompositeLit) %CompositeLiteral {
	result := &CompositeLiteral{
		Span: span(value), Type: c.expression(value.Type), Lbrace: value.Lbrace,
		Elements: nil, Rbrace: value.Rbrace, Incomplete: value.Incomplete,
	}
	for _, element := range value.Elts {
		result.Elements = append(result.Elements, c.expressionRequired(element))
	}
	for _, child := range c.front.children[value] {
		marker, ok := child.(*frontDefaultMarker)
		if !ok {
			continue
		}
		expressionValue := &DefaultExpression{
			Span: Span{Start: marker.Pos(), Stop: marker.End()},
			FirstDot: marker.FirstDot, LastDot: marker.LastDot, Default: marker.Default,
		}
		expression := Expression.Default{Value: expressionValue}
		result.Elements = insertExpression(result.Elements, &expression)
	}
	return result
}

func insertExpression(values []%Expression, value %Expression) []%Expression {
	position := ExpressionPosition(value)
	for index, item := range values {
		if position < ExpressionPosition(item) {
			values = append(values, value)
			copy(values[index+1:], values[index:])
			values[index] = value
			return values
		}
	}
	return append(values, value)
}

func (c %converter) propagationExpression(value %frontPropagateExpr) %Expression {
	if result, ok := c.convertedPropagation[value]; ok {
		return result
	}
	payload := &PropagationExpression{
		Span: Span{Start: value.Pos(), Stop: value.End()},
		Expression: c.expressionRaw(value.Expression),
		Call: c.callRequired(value.Call), Bang: value.Bang,
	}
	result := Expression.Propagation{Value: payload}
	converted := &result
	c.convertedPropagation[value] = converted
	return converted
}

