package syntax

import (
	"fmt"
	"go/ast"
	"go/token"
)

// ParseFile parses one TGo source file and returns only TGo AST nodes.
func ParseFile(
	files *token.FileSet,
	filename string,
	source []byte,
	mode Mode,
) (*File, error) {
	front, err := parseFrontFile(files, filename, source, mode)
	if front == nil {
		return nil, err
	}
	result, conversionError := newConverter(front).file()
	if conversionError != nil {
		return nil, conversionError
	}
	if err != nil {
		return result, err
	}
	return result, nil
}

type converter struct {
	front       *frontFile
	propagation map[ast.Expr]*frontPropagateExpr
	convertedPropagation map[*frontPropagateExpr]*Expression
	comments    map[*ast.Comment]*Comment
	groups      map[*ast.CommentGroup]*CommentGroup
	imports     map[*ast.ImportSpec]*ImportSpecification
}

func newConverter(front *frontFile) *converter {
	value := &converter{
		front:       front,
		propagation: make(map[ast.Expr]*frontPropagateExpr),
		convertedPropagation: make(map[*frontPropagateExpr]*Expression),
		comments:    make(map[*ast.Comment]*Comment),
		groups:      make(map[*ast.CommentGroup]*CommentGroup),
		imports:     make(map[*ast.ImportSpec]*ImportSpecification),
	}
	for _, extension := range front.extensions {
		item, ok := extension.(*frontPropagateExpr)
		if ok {
			value.propagation[item.Expression] = item
		}
	}
	return value
}

func span(node interface{ Pos() token.Pos; End() token.Pos }) Span {
	return Span{Start: node.Pos(), Stop: node.End()}
}

func (c *converter) file() (*File, error) {
	result := &File{
		Span:          Span{Start: c.front.Pos(), Stop: c.front.End()},
		Doc:           c.commentGroup(c.front.Doc),
		Package:       c.front.Package,
		Name:          c.identifier(c.front.Name),
		Declarations:  nil,
		Imports:       nil,
		Comments:      nil,
		GoVersion:     c.front.GoVersion,
		front:         c.front,
		children:      nil,
		parents:       nil,
		extensions:    nil,
		attached:      nil,
	}
	for _, item := range c.front.Decls {
		declaration, err := c.declaration(item)
		if err != nil {
			return nil, err
		}
		result.Declarations = append(result.Declarations, declaration)
	}
	for _, item := range c.front.Imports {
		result.Imports = append(result.Imports, c.importSpecification(item))
	}
	for _, item := range c.front.Comments {
		result.Comments = append(result.Comments, c.commentGroup(item))
	}
	buildPublicIndex(result)
	return result, nil
}

func (c *converter) identifier(value *ast.Ident) *Identifier {
	if value == nil {
		return nil
	}
	return &Identifier{Span: span(value), Name: value.Name}
}

func (c *converter) comment(value *ast.Comment) *Comment {
	if value == nil {
		return nil
	}
	if found := c.comments[value]; found != nil {
		return found
	}
	result := &Comment{Span: span(value), Text: value.Text}
	c.comments[value] = result
	return result
}

func (c *converter) commentGroup(value *ast.CommentGroup) *CommentGroup {
	if value == nil {
		return nil
	}
	if found := c.groups[value]; found != nil {
		return found
	}
	result := &CommentGroup{Span: span(value), List: nil}
	c.groups[value] = result
	for _, item := range value.List {
		result.List = append(result.List, c.comment(item))
	}
	return result
}

func (c *converter) field(value *ast.Field) *Field {
	if value == nil {
		return nil
	}
	result := &Field{
		Span:    span(value),
		Doc:     c.commentGroup(value.Doc),
		Names:   nil,
		Type:    c.expression(value.Type),
		Tag:     c.basicLiteral(value.Tag),
		Comment: c.commentGroup(value.Comment),
	}
	for _, name := range value.Names {
		result.Names = append(result.Names, c.identifier(name))
	}
	return result
}

func (c *converter) fieldList(value *ast.FieldList) *FieldList {
	if value == nil {
		return nil
	}
	result := &FieldList{
		Span:    span(value),
		Opening: value.Opening,
		List:    nil,
		Closing: value.Closing,
	}
	for _, item := range value.List {
		result.List = append(result.List, c.field(item))
	}
	return result
}

func expressionValue(value any) *Expression {
	switch item := value.(type) {
	case *BadExpression:
		result := Expression.Bad{Value: item}
		return &result
	case *Identifier:
		result := Expression.Identifier{Value: item}
		return &result
	case *EllipsisExpression:
		result := Expression.Ellipsis{Value: item}
		return &result
	case *BasicLiteral:
		result := Expression.BasicLiteral{Value: item}
		return &result
	case *FunctionLiteral:
		result := Expression.FunctionLiteral{Value: item}
		return &result
	case *CompositeLiteral:
		result := Expression.CompositeLiteral{Value: item}
		return &result
	case *ParenthesizedExpression:
		result := Expression.Parenthesized{Value: item}
		return &result
	case *SelectorExpression:
		result := Expression.Selector{Value: item}
		return &result
	case *IndexExpression:
		result := Expression.Index{Value: item}
		return &result
	case *IndexListExpression:
		result := Expression.IndexList{Value: item}
		return &result
	case *SliceExpression:
		result := Expression.Slice{Value: item}
		return &result
	case *TypeAssertionExpression:
		result := Expression.TypeAssertion{Value: item}
		return &result
	case *CallExpression:
		result := Expression.Call{Value: item}
		return &result
	case *StarExpression:
		result := Expression.Star{Value: item}
		return &result
	case *NonNilPointerType:
		result := Expression.NonNilPointer{Value: item}
		return &result
	case *UnaryExpression:
		result := Expression.Unary{Value: item}
		return &result
	case *BinaryExpression:
		result := Expression.Binary{Value: item}
		return &result
	case *KeyValueExpression:
		result := Expression.KeyValue{Value: item}
		return &result
	case *ArrayType:
		result := Expression.ArrayType{Value: item}
		return &result
	case *StructType:
		result := Expression.StructType{Value: item}
		return &result
	case *FunctionType:
		result := Expression.FunctionType{Value: item}
		return &result
	case *InterfaceType:
		result := Expression.InterfaceType{Value: item}
		return &result
	case *MapType:
		result := Expression.MapType{Value: item}
		return &result
	case *ChannelType:
		result := Expression.ChannelType{Value: item}
		return &result
	case *DefaultExpression:
		result := Expression.Default{Value: item}
		return &result
	case *PropagationExpression:
		result := Expression.Propagation{Value: item}
		return &result
	default:
		panic(fmt.Sprintf("unsupported TGo expression %T", value))
	}
}

func (c *converter) expression(value ast.Expr) *Expression {
	if value == nil {
		return nil
	}
	if item := c.propagation[value]; item != nil {
		return c.propagationExpression(item)
	}
	return c.expressionRaw(value)
}

func (c *converter) expressionRaw(value ast.Expr) *Expression {
	if value == nil {
		return nil
	}
	switch item := value.(type) {
	case *ast.BadExpr:
		return expressionValue(&BadExpression{
			Span: span(item), From: item.From, To: item.To,
		})
	case *ast.Ident:
		return expressionValue(c.identifier(item))
	case *ast.Ellipsis:
		return expressionValue(&EllipsisExpression{
			Span: span(item), Ellipsis: item.Ellipsis, Element: c.expression(item.Elt),
		})
	case *ast.BasicLit:
		return expressionValue(c.basicLiteral(item))
	case *ast.FuncLit:
		return expressionValue(&FunctionLiteral{
			Span: span(item), Type: c.functionType(item.Type), Body: c.block(item.Body),
		})
	case *ast.CompositeLit:
		return expressionValue(c.compositeLiteral(item))
	case *ast.ParenExpr:
		return expressionValue(&ParenthesizedExpression{
			Span: span(item), Lparen: item.Lparen,
			Expression: c.expression(item.X), Rparen: item.Rparen,
		})
	case *ast.SelectorExpr:
		return expressionValue(&SelectorExpression{
			Span: span(item), Expression: c.expression(item.X),
			Selector: c.identifier(item.Sel),
		})
	case *ast.IndexExpr:
		return expressionValue(&IndexExpression{
			Span: span(item), Expression: c.expression(item.X), Lbrack: item.Lbrack,
			Index: c.expression(item.Index), Rbrack: item.Rbrack,
		})
	case *ast.IndexListExpr:
		result := &IndexListExpression{
			Span: span(item), Expression: c.expression(item.X),
			Lbrack: item.Lbrack, Indices: nil, Rbrack: item.Rbrack,
		}
		result.Indices = c.expressions(item.Indices)
		return expressionValue(result)
	case *ast.SliceExpr:
		return expressionValue(&SliceExpression{
			Span: span(item), Expression: c.expression(item.X), Lbrack: item.Lbrack,
			Low: c.expression(item.Low), High: c.expression(item.High),
			Max: c.expression(item.Max), Slice3: item.Slice3, Rbrack: item.Rbrack,
		})
	case *ast.TypeAssertExpr:
		return expressionValue(&TypeAssertionExpression{
			Span: span(item), Expression: c.expression(item.X),
			Lparen: item.Lparen, Type: c.expression(item.Type), Rparen: item.Rparen,
		})
	case *ast.CallExpr:
		return expressionValue(c.call(item))
	case *ast.StarExpr:
		if c.front.nonNil[item.Star] {
			return expressionValue(&NonNilPointerType{
				Span: span(item), Percent: item.Star, Type: c.expression(item.X),
			})
		}
		return expressionValue(&StarExpression{
			Span: span(item), Star: item.Star, Expression: c.expression(item.X),
		})
	case *ast.UnaryExpr:
		return expressionValue(&UnaryExpression{
			Span: span(item), OperatorPosition: item.OpPos,
			Operator: item.Op, Expression: c.expression(item.X),
		})
	case *ast.BinaryExpr:
		return expressionValue(&BinaryExpression{
			Span: span(item), Left: c.expression(item.X),
			OperatorPosition: item.OpPos, Operator: item.Op,
			Right: c.expression(item.Y),
		})
	case *ast.KeyValueExpr:
		return expressionValue(&KeyValueExpression{
			Span: span(item), Key: c.expression(item.Key),
			Colon: item.Colon, Value: c.expression(item.Value),
		})
	case *ast.ArrayType:
		return expressionValue(&ArrayType{
			Span: span(item), Lbrack: item.Lbrack,
			Length: c.expression(item.Len), Element: c.expression(item.Elt),
		})
	case *ast.StructType:
		return expressionValue(&StructType{
			Span: span(item), Struct: item.Struct,
			Fields: c.fieldList(item.Fields), Incomplete: item.Incomplete,
		})
	case *ast.FuncType:
		return expressionValue(c.functionType(item))
	case *ast.InterfaceType:
		return expressionValue(&InterfaceType{
			Span: span(item), Interface: item.Interface,
			Methods: c.fieldList(item.Methods), Incomplete: item.Incomplete,
		})
	case *ast.MapType:
		return expressionValue(&MapType{
			Span: span(item), Map: item.Map,
			Key: c.expression(item.Key), Value: c.expression(item.Value),
		})
	case *ast.ChanType:
		return expressionValue(&ChannelType{
			Span: span(item), Begin: item.Begin, Arrow: item.Arrow,
			Direction: channelDirection(item.Dir), Value: c.expression(item.Value),
		})
	default:
		panic(fmt.Sprintf("unsupported go/ast expression %T", value))
	}
}

func (c *converter) expressions(values []ast.Expr) []*Expression {
	result := make([]*Expression, 0, len(values))
	for _, value := range values {
		result = append(result, c.expression(value))
	}
	return result
}

func (c *converter) basicLiteral(value *ast.BasicLit) *BasicLiteral {
	if value == nil {
		return nil
	}
	return &BasicLiteral{
		Span: span(value), ValuePosition: value.ValuePos,
		Kind: value.Kind, Value: value.Value,
	}
}

func (c *converter) functionType(value *ast.FuncType) *FunctionType {
	if value == nil {
		return nil
	}
	return &FunctionType{
		Span: span(value), Function: value.Func,
		TypeParams: c.fieldList(value.TypeParams),
		Params: c.fieldList(value.Params), Results: c.fieldList(value.Results),
	}
}

func (c *converter) call(value *ast.CallExpr) *CallExpression {
	if value == nil {
		return nil
	}
	return &CallExpression{
		Span: span(value), Function: value.Fun.Pos(), Callee: c.expression(value.Fun),
		Lparen: value.Lparen, Args: c.expressions(value.Args),
		Ellipsis: value.Ellipsis, Rparen: value.Rparen,
	}
}

func channelDirection(value ast.ChanDir) ChannelDirection {
	if value == ast.SEND {
		return ChannelDirection.SendOnly{}
	}
	if value == ast.RECV {
		return ChannelDirection.ReceiveOnly{}
	}
	return ChannelDirection.SendReceive{}
}

func (c *converter) compositeLiteral(value *ast.CompositeLit) *CompositeLiteral {
	result := &CompositeLiteral{
		Span: span(value), Type: c.expression(value.Type), Lbrace: value.Lbrace,
		Elements: nil, Rbrace: value.Rbrace, Incomplete: value.Incomplete,
	}
	for _, element := range value.Elts {
		result.Elements = append(result.Elements, c.expression(element))
	}
	for _, child := range c.front.children[value] {
		marker, ok := child.(*frontDefaultMarker)
		if !ok {
			continue
		}
		expression := expressionValue(&DefaultExpression{
			Span: Span{Start: marker.Pos(), Stop: marker.End()},
			FirstDot: marker.FirstDot, LastDot: marker.LastDot, Default: marker.Default,
		})
		result.Elements = insertExpression(result.Elements, expression)
	}
	return result
}

func insertExpression(values []*Expression, value *Expression) []*Expression {
	position := ExpressionPosition(value)
	for index, item := range values {
		if position < ExpressionPosition(item) {
			values = append(values, nil)
			copy(values[index+1:], values[index:])
			values[index] = value
			return values
		}
	}
	return append(values, value)
}

func (c *converter) propagationExpression(value *frontPropagateExpr) *Expression {
	if result, ok := c.convertedPropagation[value]; ok {
		return result
	}
	result := expressionValue(&PropagationExpression{
		Span: Span{Start: value.Pos(), Stop: value.End()},
		Expression: c.expressionRaw(value.Expression),
		Call: c.call(value.Call),
		Bang: value.Bang,
	})
	c.convertedPropagation[value] = result
	return result
}

