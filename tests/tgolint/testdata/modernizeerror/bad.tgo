package modernizeerror

import (
	"fmt"
	"strconv"
)

type record struct{}

type store struct{}

func load() (*record, error) { return nil, }

func (store) Find() (*record, error) { return nil, }

func (store) Flush() error { return nil }

func zeroes() (
	bool,
	int,
	float64,
	complex128,
	string,
	record,
	[0]int,
	*record,
	error,
) {
	return false, 0, 0, 0, "", record{}, [0]int{}, nil,
}

func copyValue[T any](value T) (T, error) { return value, }

func useIdentifier() (*record, error) {
	value, err := load()
	if err != nil {
		return nil, fmt.Errorf("load: %w", err)
	}
	return value,
}

func useSelector(repository store) (*record, error) {
	value, err := repository.Find()
	if err != nil {
		return nil, fmt.Errorf("repository.Find: %w", err)
	}
	return value,
}

func useTransparent() (*record, error) {
	value, err := load()
	if err != nil {
		return nil, err
	}
	return value,
}

func useTransparentSelector(repository store) (*record, error) {
	value, err := repository.Find()
	if err != nil {
		return nil, err
	}
	return value,
}

func useQualifiedCall(text string) (int, error) {
	value, err := strconv.Atoi(text)
	if err != nil {
		return 0, fmt.Errorf("strconv.Atoi: %w", err)
	}
	return value,
}

func useErrorOnly(repository store) error {
	err := repository.Flush()
	if err != nil {
		return fmt.Errorf("repository.Flush: %w", err)
	}
	return nil
}

func useAllZeros() (
	bool,
	int,
	float64,
	complex128,
	string,
	record,
	[0]int,
	*record,
	error,
) {
	flag, count, ratio, number, text, item, array, pointer, err := zeroes()
	if err != nil {
		return false, 0, 0.0, 0i, "", record{}, [0]int{}, nil,
			fmt.Errorf("zeroes: %w", err)
	}
	return flag, count, ratio, number, text, item, array, pointer,
}

func useTypeArguments() (record, error) {
	value, err := copyValue[record](record{})
	if err != nil {
		return record{}, fmt.Errorf("copyValue: "+"%w", err)
	}
	return value,
}

func useLiteral() func() (int, error) {
	return func() (int, error) {
		value, err := strconv.Atoi("1")
		if err != nil {
			return 0, fmt.Errorf("strconv.Atoi: %w", err)
		}
		return value,
	}
}

func useNamedResult() (result *record, final error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w", err)
	}
	return value,
}

func useReusedNamedError() (result *record, err error) {
	value, err := load()
	if err != nil {
		return , err
	}
	return value,
}

func useReusedLocalError() (*record, error) {
	first, err := load()
	if err != nil {
		return , err
	}
	second, err := load()
	if err != nil {
		return , err
	}
	_ = first
	return second,
}

func useFailureComma() (*record, error) {
	value, err := load()
	if err != nil {
		return , err
	}
	return value,
}

func useInitializer(repository store) error {
	if err := repository.Flush(); err != nil {
		return fmt.Errorf("repository.Flush: %w", err)
	}
	return nil
}

func useTransparentInitializer(repository store) error {
	if err := repository.Flush(); err != nil {
		return err
	}
	return nil
}

func useIgnoredInitializer(text string) error {
	if _, err := strconv.Atoi(text); err != nil {
		return err
	}
	return nil
}

func useNamedResultAfterPriorUses() (result *record, err error) {
	err = nil
	defer func() {
		_ = err
	}()
	value, err := load()
	if err != nil {
		return , err
	}
	return value,
}
