package modernizeerrorgood

import (
	"errors"
	"fmt"
)

type record struct{}

type store struct {
	load func() (*record, error)
}

func load() (*record, error) { return nil, }

func loadSlice() ([]int, error) { return nil, }

func loadMap() (map[string]int, error) { return nil, }

func (store) Find() (*record, error) { return nil, }

func differentContext() (*record, error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load record: %w", err)
	}
	return value,
}

func shortSelector(repository store) (*record, error) {
	value, err := repository.Find()
	if err != nil {
		return , fmt.Errorf("Find: %w", err)
	}
	return value,
}

func wrongVerb() (*record, error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %v", err)
	}
	return value,
}

func extraArgument() (*record, error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w: %s", err, "failed")
	}
	return value,
}

func anotherWrapper() (*record, error) {
	value, err := load()
	if err != nil {
		return , errors.Join(err)
	}
	return value,
}

func extraStatement() (*record, error) {
	value, err := load()
	if err != nil {
		_ = err
		return , fmt.Errorf("load: %w", err)
	}
	return value,
}

func branchElse() (*record, error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w", err)
	} else {
		return value,
	}
}

func branchInitializer() (*record, error) {
	value, err := load()
	if checked := err; checked != nil {
		return , fmt.Errorf("load: %w", checked)
	}
	return value,
}

func changedSuccessValue() (*record, error) {
	value, err := load()
	if err != nil {
		return &record{}, fmt.Errorf("load: %w", err)
	}
	return value,
}

func normalAssignment() (*record, error) {
	var value *record = nil
	var err error = nil
	value, err = load()
	if err != nil {
		return , fmt.Errorf("load: %w", err)
	}
	return value,
}

func mixedDeclaration() (*record, error) {
	var value *record = nil
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w", err)
	}
	return value,
}

func dynamicCall() (*record, error) {
	loader := load
	value, err := loader()
	if err != nil {
		return , fmt.Errorf("loader: %w", err)
	}
	return value,
}

func functionField(repository store) (*record, error) {
	value, err := repository.load()
	if err != nil {
		return , fmt.Errorf("repository.load: %w", err)
	}
	return value,
}

func wrongError() (*record, error) {
	other := errors.New("other")
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w", other)
	}
	return value,
}

func reusedError() (*record, error) {
	value, err := load()
	if err != nil {
		return , fmt.Errorf("load: %w", err)
	}
	if err == nil {
		return value,
	}
	return , err
}

func nonzeroSlice() ([]int, error) {
	value, err := loadSlice()
	if err != nil {
		return []int{}, fmt.Errorf("loadSlice: %w", err)
	}
	return value,
}

func nonzeroMap() (map[string]int, error) {
	value, err := loadMap()
	if err != nil {
		return map[string]int{}, fmt.Errorf("loadMap: %w", err)
	}
	return value,
}

func propagated() (*record, error) {
	value := load()!
	return value,
}

func reusedNamedErrorAfterSuccess() (result *record, err error) {
	err = errors.New("old")
	value, err := load()
	if err != nil {
		return , err
	}
	if err != nil {
		return , err
	}
	return value,
}

func namedErrorCapturedBeforeSuccess() (result *record, err error) {
	err = errors.New("old")
	observe := func() {
		_ = err
	}
	value, err := load()
	if err != nil {
		return , err
	}
	observe()
	return value,
}

func namedErrorAddressedBeforeSuccess() (result *record, err error) {
	err = errors.New("old")
	pointer := &err
	value, err := load()
	if err != nil {
		return , err
	}
	_ = *pointer
	return value,
}

func namedErrorUsedByNakedReturn() (result *record, err error) {
	err = errors.New("old")
	value, err := load()
	if err != nil {
		return , err
	}
	result = value
	return
}

func namedErrorUsedByBackwardGoto() (result *record, err error) {
	result = nil
	err = errors.New("old")
	goto work
done:
	return
work:
	_ = result
	value, err := load()
	if err != nil {
		return , err
	}
	result = value
	goto done
}

func namedErrorDeferredAfterNonNil() (result *record, err error) {
	err = errors.New("old")
	defer func() {
		_ = err
	}()
	value, err := load()
	if err != nil {
		return , err
	}
	result = value
	panic("stop")
}
