package policygood

type Quantity struct{ value int } checked

type Choice enum {
	Text struct { Value string }
	Number struct { Value int }
}

func (value Quantity) check() (Quantity, error) { return value, }
func (value Quantity) Value() int               { return value.value }

type Request struct {
	ID   string
	Tags map[string]string = map[string]string{}
}

var request = Request{ID: "one", ..default}

var values = make([]Quantity, 0, 4)

var dense = [2]int{1, 2}

func assigned(flag bool) (result int) {
	if flag {
		result = 1
	} else {
		result = 2
	}
	return
}

func read(items map[string]Quantity, input any, channel <-chan Quantity) int {
	if value, ok := items["one"]; ok {
		return value.Value()
	}
	if value, ok := <-channel; ok {
		return value.Value()
	}
	if value, ok := input.(Quantity); ok {
		return value.Value()
	}
	return len(values[:len(values)])
}

func readChoice(value Choice) string {
	if value.Tag() != ChoiceTagText {
		return ""
	}
	return value.TextPayload().Value
}

func choicePayload(value Choice) func() ChoiceText {
	if ChoiceTagText != value.Tag() {
		return nil
	}
	return value.TextPayload
}
