package policygood

type Quantity struct{ value int } checked

type Choice enum {
	Text struct { Value string }
	Number struct { Value int }
}

func (value Quantity) check() (Quantity, error) { return value, }
func (value Quantity) Value() int               { return value.value }

type Request struct {
	ID   string
	Tags map[string]string = map[string]string{}
}

var request = Request{ID: "one", ..default}

var values = make([]Quantity, 0, 4)

var dense = [2]int{1, 2}

func assigned(flag bool) (result int) {
	if flag {
		result = 1
	} else {
		result = 2
	}
	return
}

func read(items map[string]Quantity, input any, channel <-chan Quantity) int {
	if value, ok := items["one"]; ok {
		return value.Value()
	}
	if value, ok := <-channel; ok {
		return value.Value()
	}
	if value, ok := input.(Quantity); ok {
		return value.Value()
	}
	return len(values[:len(values)])
}

func readChoice(value Choice) string {
	if value.Tag() != ChoiceTagText {
		return ""
	}
	return value.TextPayload().Value
}

func choicePayload(value Choice) string {
	if ChoiceTagText != value.Tag() {
		return ""
	}
	payload := value.TextPayload
	return payload().Value
}

type mutableDetails struct{ number int }

type nestedDetails struct {
	pointer       *mutableDetails
	slice         []int
	mapping       map[string]int
	pointerMiddle pointerMiddle
	pointerArray  [1]pointerMiddle
}

type promotedLeaf struct{ number int }
type pointerMiddle struct{ *promotedLeaf }

type NestedQuantity struct{ nestedDetails } checked

func (value NestedQuantity) check() (NestedQuantity, error) { return value, }

func changeNestedReferences(value *NestedQuantity) {
	value.pointer.number = 1
	value.nestedDetails.pointer.number = 2
	value.slice[0]++
	value.nestedDetails.slice[0] = 3
	value.mapping["one"] = 4
	value.nestedDetails.mapping["two"] = 5
	_ = &value.slice[0]
	value.pointerMiddle.number = 6
	value.pointerArray[0].number = 7
}

type pointedDetails struct{ number int }

type PointerQuantity struct{ *pointedDetails } checked

func (value PointerQuantity) check() (PointerQuantity, error) { return value, }

func changePromotedPointer(value *PointerQuantity) {
	value.number = 1
}
