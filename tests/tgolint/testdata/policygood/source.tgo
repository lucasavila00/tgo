package policygood

type Quantity struct{ value int } checked

type Choice enum {
	Text struct { Value string }
	Number struct { Value int }
}

func (value Quantity) check() (Quantity, error) { return value, }
func (value Quantity) Value() int               { return value.value }

type Request struct {
	ID   string
	Tags map[string]string = map[string]string{}
}

var request = Request{ID: "one", ..default}

var values = make([]Quantity, 0, 4)

var dense = [2]int{1, 2}

func assigned(flag bool) (result int) {
	if flag {
		result = 1
	} else {
		result = 2
	}
	return
}

func read(items map[string]Quantity, input any, channel <-chan Quantity) int {
	if value, ok := items["one"]; ok {
		return value.Value()
	}
	if value, ok := <-channel; ok {
		return value.Value()
	}
	if value, ok := input.(Quantity); ok {
		return value.Value()
	}
	return len(values[:len(values)])
}

func readChoice(value Choice) string {
	if value.Tag() != ChoiceTagText {
		return ""
	}
	return value.TextPayload().Value
}

func choicePayload(value Choice) string {
	if ChoiceTagText != value.Tag() {
		return ""
	}
	payload := value.TextPayload
	return payload().Value
}

type measured int

func (value measured) Value() int { return int(value) }
func (value *measured) Increment() { *value++ }

type inner struct{ number measured } checked

func (value inner) check() (inner, error) { return value, }

type NestedQuantity struct {
	number measured
	inner  inner
} checked

func (value NestedQuantity) check() (NestedQuantity, error) {
	value.number++
	value.number.Increment()
	increment := value.number.Increment
	increment()
	replacement := inner{number: 1}!
	value.inner = replacement
	return value,
}

type EmbeddedQuantity struct{ inner } checked

func (value EmbeddedQuantity) check() (EmbeddedQuantity, error) { return value, }

func checkedCopies(value NestedQuantity) int {
	copy := value
	copy = value
	_ = &copy
	return value.number.Value() + value.inner.number.Value()
}

func checkedPromotedRead(value EmbeddedQuantity) int {
	return value.number.Value()
}
