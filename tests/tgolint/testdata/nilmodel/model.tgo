package nilmodel

type Item struct {
	Name string
}

type Holder struct {
	Required %Item
	Optional *Item
}

type ItemMap = map[string]%Item
type MaybeMap = map[string]*Item
type ItemChan = chan %Item
type ItemSlice = []%Item
type ItemArray = [2]%Item
type OuterRequired = %*Item
type InnerRequired = *%Item
type BothRequired = %%Item

type RequiredHandler = func(%Item) %Item
type OptionalHandler = func(*Item) *Item

type Syntax enum {
	Item struct { Value %Item }
}

type SyntaxList = []%Syntax

func Need(value %Item) {}

func NeedHolder(value %Holder) {}

func NewHolder(item %Item) %Holder {
	return &Holder{Required: item, Optional: nil}
}

func NeedOuter(value OuterRequired) {}

func NeedInner(value InnerRequired) {}

func NeedBoth(value BothRequired) {}

func Give(value %Item) %Item {
	return value
}

func AcceptOptional(value *Item) %Item {
	if value == nil {
		return &Item{Name: ""}
	}
	return value
}

func RequireAndReturn(value %Item) *Item {
	return value
}

type Lookup struct {}

func NewLookup() %Lookup {
	return &Lookup{}
}

func (l %Lookup) Find(value %Item) *Item {
	return nil
}
