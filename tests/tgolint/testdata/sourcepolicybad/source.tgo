package sourcepolicybad

import "example.com/tgolint/model"

type Local enum {
	Ready struct { ID string }
}

type Port struct{ number int } checked

func (value Port) check() (Port, error) {
	value.number = 1
	other := value
	other.number = 2
	{
		value := Port{}
		value.number = 3
		_ = value
	}
	return value,
}

type LocalLayout struct {
	tgoTag   LocalTag
	tgoReady LocalReady
}

type DirectLocal Local
type DirectImported model.Event

type LocalTypes interface {
	Local
}

func localLiteral() Local {
	return Local{}
}

func localConstruction(value LocalLayout) Local {
	return Local(value)
}

func localExposure(value Local) LocalLayout {
	return LocalLayout(value)
}

func pointerExposure(value *Local) *LocalLayout {
	return (*LocalLayout)(value)
}

func genericConstruction[T LocalTypes](value LocalLayout) T {
	return T(value)
}

func genericExposure[T LocalTypes](value T) LocalLayout {
	return LocalLayout(value)
}

func anonymousExposure(value Local) LocalReady {
	var exposed struct {
		tgoTag   LocalTag
		tgoReady LocalReady
	} = value
	return exposed.tgoReady
}

type Embedded struct{ Local }

func promotedRepresentation(value Embedded) LocalTag {
	return value.tgoTag
}

func change(value Port) {
	value.number = 2
	value.number++
	_ = &value.number
	for value.number = range []int{1} {
	}
}

type measured int

func (value measured) Value() int { return int(value) }
func (value *measured) Increment() { *value++ }

type inner struct{ number measured } checked

func (value inner) check() (inner, error) { return value, }

type NestedPort struct {
	number measured
	inner  inner
} checked

func (value NestedPort) check() (NestedPort, error) {
	value.number++
	value.number.Increment()
	increment := value.number.Increment
	increment()
	replacement := inner{number: 1}!
	value.inner = replacement
	value.inner.number = 2
	_ = &value.inner.number
	value.inner.number.Increment()
	nestedIncrement := value.inner.number.Increment
	_ = nestedIncrement
	_ = value.inner.number.Value()
	return value,
}

type EmbeddedPort struct{ inner } checked

func (value EmbeddedPort) check() (EmbeddedPort, error) {
	value.number = 3
	_ = &value.number
	value.number.Increment()
	increment := value.number.Increment
	_ = increment
	_ = value.number.Value()
	return value,
}

func changeNested(value *NestedPort, replacement inner) {
	value.number = 4
	value.number++
	_ = &value.number
	for _, value.number = range []measured{5} {
	}
	value.number.Increment()
	increment := value.number.Increment
	_ = increment
	_ = value.number.Value()
	value.inner = replacement
	_ = &value.inner
}

type measuredAlias = measured

func (value *measured) Change() { *value = 99 }

type MethodPort struct{ measuredAlias } checked

type methodPortError struct{}

func (methodPortError) Error() string { return "invalid MethodPort" }
func (value MethodPort) check() (MethodPort, error) {
	value.Increment()
	change := value.Increment
	change()
	if value.measuredAlias != 2 { return , methodPortError{} }
	return value,
}

func (value *MethodPort) WholeMethod() {}

type methodPortAlias = MethodPort

type MethodOuter struct{ methodPortAlias } checked

func (value MethodOuter) check() (MethodOuter, error) { return value, }

func changePromotedMethods(value *MethodPort, outer *MethodOuter) {
	value.Change()
	change := value.Change
	change()
	outer.Change()
	outerChange := outer.Change
	outerChange()
	method := (*MethodPort).Change
	method(value)
	outerMethod := (*MethodOuter).Change
	outerMethod(outer)
	outer.WholeMethod()
	whole := outer.WholeMethod
	whole()
	_ = value.Value()
	_ = outer.Value()
}

var localConstructor = NewPort
var localCarrier = TgoPortInput{FieldNumber: 0}
var importedConstructor = model.NewCount
var importedCarrier = model.TgoCountInput{FieldValue: 0}
var localEnumConstructor = NewLocalReady
var importedEnumConstructor = model.NewEventStarted

func generatedEnumTypes(
	localPayload LocalReady,
	localCarrier TgoLocalReadyInput,
	importedPayload model.EventStarted,
	importedCarrier model.TgoEventStartedInput,
) {}

func importedLiteral() model.Event {
	return model.Event{}
}

func validChecked(number int) (Port, error) {
	return Port{number: number}
}

func validVariant(id string) Local {
	return Local.Ready{ID: id}
}

func (value LocalReady) Label() string { return value.ID }

func (value *LocalReady) Clear() { value.ID = "" }

type LocalAlias = Local
