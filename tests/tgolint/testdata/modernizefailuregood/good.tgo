package modernizefailuregood

type record struct{ Value int }

func nonzero(err error) (int, error) {
	return 1, err
}

func nonzeroValue(err error) (record, error) {
	return record{Value: 1}, err
}

func generic[T any](err error) (T, error) {
	zero := *new(T)
	return zero, err
}

func one(err error) error {
	return err
}

func alreadyElided(err error) (int, error) {
	return , err
}

func success() (int, error) {
	return 0,
}
