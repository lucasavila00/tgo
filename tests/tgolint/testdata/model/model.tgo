package model

type Count struct { value int } checked

type countError struct{}
func (countError) Error() string { return "invalid Count" }
func (value Count) check() (Count, error) {
	if value.value <= 0 { return , countError{} }
	return value,
}
func NewCount(value int) (Count, error) { return Count{value: value} }
func (value Count) Value() int { return value.value }

type Pair struct {
	Left, Right string `json:"pair"` = ""
}

type Event enum {
	Started struct { ID, Alias string `json:"event"` = "" }
	Stopped struct { Reason string }
}

type Signal enum {
	On struct{}
}

func Identity(value int) int { return value }
