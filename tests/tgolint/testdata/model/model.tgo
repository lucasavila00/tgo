package model

type Count struct { value int } checked

type countError struct{}
func (countError) Error() string { return "invalid Count" }
func (value Count) check() (Count, error) {
	if value.value <= 0 { return , countError{} }
	return value,
}
func (value Count) Value() int { return value.value }

type Pair struct {
	Left, Right string `json:"pair"` = ""
}

type Event enum {
	Started struct { ID, Alias string `json:"event"` = "" }
	Stopped struct { Reason string }
}

type Signal enum {
	On struct{}
}

func Identity(value int) int { return value }

type mutableDetails struct { Number int }

type checkedDetails struct {
	Number  int
	Values  [2]int
	Pointer *mutableDetails
	Slice   []int
	Map     map[string]int
}

type Nested struct { checkedDetails } checked

func (value Nested) check() (Nested, error) { return value, }

type pointedDetails struct { Number int }

type PointerNested struct { *pointedDetails } checked

func (value PointerNested) check() (PointerNested, error) { return value, }
