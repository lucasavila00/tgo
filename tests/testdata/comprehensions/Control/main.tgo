package main

import (
	"errors"
	"fmt"
)

var failure = errors.New("failed")

func read(value int) (int, error) {
	if value == 2 {
		return 0, failure
	}
	return value, nil
}

func propagate(wrapped bool) ([]int, error) {
	defer fmt.Println("deferred")
	if wrapped {
		return []int{read(x)!! for x := range 3}, nil
	}
	return []int{read(x)! for x := range 3}, nil
}

func returnValue() int {
	values := []int{if x == 1 {return 9} else {x} for x := range 3}
	return len(values)
}

func main() {
	for _, wrapped := range []bool{false, true} {
		values, err := propagate(wrapped)
		fmt.Println(values, err, errors.Is(err, failure), err == failure)
	}
	fmt.Println(returnValue())
	fmt.Println([]int{if x == 1 {continue} else {x} for x := range 3})
	fmt.Println([]int{x for x := range 3 if if x == 1 {continue} else {true}})
	fmt.Println([][2]int{[2]int{x, if y == 1 {break} else {y}} for x := range 2 for y := range 3})
	for i := range 2 {
		values := []int{x for x := range if i == 0 {continue} else {2}}
		fmt.Println("outer", i, values)
	}
outer:
	for i := range 2 {
		_ = []int{if x == 1 {break outer} else {x} for x := range 3}
		fmt.Println("unreached", i)
	}
	var result []int
	result = []int{if x == 1 {goto done} else {x} for x := range 3}
	fmt.Println("unreached")
done:
	fmt.Println(result)
}
