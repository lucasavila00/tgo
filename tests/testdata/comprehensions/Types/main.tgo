package main

import "fmt"

type Number int
type Numbers []Number
type Lookup map[int]Number

var initial = Numbers{Number(x) for x := range 3}

func twice[S ~[]E, E ~int](values S) S {
	return S{x * 2 for _, x := range values}
}

func copyMap[M ~map[K]V, K comparable, V any](values M) M {
	return M{k: v for k, v := range values}
}

func main() {
	xs := Numbers{2, 3}
	fmt.Println(initial, twice(xs), copyMap(Lookup{1: 2}))
	fmt.Println([]uint64{1 << n for n := range 2})
	fmt.Println([]*int{nil for range 2})
	fmt.Println([]any{if x > 2 {x} else {"small"} for _, x := range xs})
	fmt.Println(map[any]any{x: x for _, x := range xs})
	pointer := &Numbers{x for _, x := range xs}
	fmt.Println(*pointer)
	fmt.Println(Numbers{Numbers for _, Numbers := range xs})
	append := "outer"
	fmt.Println([]Number{x for _, x := range xs if x > 0}, append)
	fmt.Println([]int{append for append := range 2})
	fmt.Println([]int{len for len := range 2})
	fmt.Println([]int{make for make := range 2})
	var absent Lookup
	empty := Lookup{k: v for k, v := range absent}
	fmt.Println(empty == nil)
}
