package main

import "fmt"

var trace []string

func mark(label string, value int) int {
	trace = append(trace, label)
	return value
}

func mapPanic() {
	defer func() { fmt.Println(recover() != nil, trace); trace = nil }()
	_ = map[any]int{[]int{x}: mark("value before hash", x) for x := range 1}
}

func deferred() {
	fmt.Println([]int{if true {defer fmt.Println("visit", x); x} else {0} for x := range 3})
}

func main() {
	mapPanic()
	deferred()
	source := [3]int{1, 2, 3}
	mapping := map[string]int{"a": 1}
	retained := map[string]int{key: if true {delete(mapping, key); value} else {0} for key, value := range mapping}
	fmt.Println(retained, mapping)
	copied := []int{if x == 1 {source[1] = 9; x} else {x} for _, x := range source}
	fmt.Println(copied, source)
	outer := []int{1, 2}
	fmt.Println([]int{outer for _, outer := range outer})
	stores := [1][]int{}
	stores[mark("destination", 0)] = []int{mark("output", x) for x := range 2}
	fmt.Println(stores, trace)
	trace = nil
	channel := make(chan string, 1)
	go func(values []int) { channel <- fmt.Sprint(values) }([]int{mark("go argument", x) for x := range 2})
	fmt.Println(<-channel, trace)
	trace = nil
	ready := make(chan int, 1)
	ready <- 7
	select {
	case value := <-([]chan int{if true {trace = append(trace, "select operand"); ready} else {nil} for range 1})[0]:
		fmt.Println(value, trace)
	}
}
