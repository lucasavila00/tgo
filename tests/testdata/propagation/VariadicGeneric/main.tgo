package main

import (
	"errors"
	"fmt"
)

var sentinel = errors.New("failure")
var visits int

func next(failAt int) (int, error) {
	fmt.Print("N")
	visits++
	if visits == failAt {
		return 0, sentinel
	}
	return visits, nil
}

func consume[T any](f func(...T), channels chan (<-chan T), n int) {
	inner := <-channels
	value := <-inner
	fmt.Print("C", n, ":", value)
	f(value)
}

func run[T any](f func(...T), channels chan (<-chan T), failAt int) error {
	{
		T := 1
		_ = T
		consume(f, channels, next(failAt)!)
		consume(f, channels, next(failAt)!!)
	}
	return nil
}

func main() {
	for _, failAt := range []int{0, 1, 2} {
		visits = 0
		inner := make(chan int, 2)
		inner <- 7
		inner <- 8
		channels := make(chan (<-chan int), 2)
		channels <- inner
		channels <- inner
		err := run(func(...int) { fmt.Print("F") }, channels, failAt)
		switch {
		case err == nil:
			fmt.Print("S|")
		case err == sentinel:
			fmt.Print("E|")
		case errors.Is(err, sentinel):
			fmt.Print("W|")
		default:
			panic(err)
		}
	}
}
