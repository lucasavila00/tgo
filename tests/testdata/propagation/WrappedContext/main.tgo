package main

import (
	"errors"
	"fmt"
)

var failure = errors.New("failure")

func run() error {
	calls := map[string]func() error{
		"%s %w %%": func() error { return failure },
	}
	calls["%s %w %%"]()!!
	return nil
}

func main() {
	err := run()
	fmt.Printf("%v %t\n", err, errors.Is(err, failure))
}
