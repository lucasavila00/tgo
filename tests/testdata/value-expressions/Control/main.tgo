package main

import (
	"errors"
	"fmt"
)

var failure = errors.New("failure")

func next(fail bool) (int, error) {
	fmt.Print("N")
	if fail {
		return 0, failure
	}
	return 7, nil
}

func checked(wrap, fail bool) (int, error) {
	defer fmt.Print("D")
	value := if wrap {
		next(fail)!!
	} else {
		next(fail)!
	}
	return value, nil
}

func loop() int {
	total := 0
	for i := 0; i < 5; i++ {
		value := if i == 1 {
			fmt.Print("C")
			continue
		} else if i == 3 {
			fmt.Print("B")
			break
		} else {
			i
		}
		total += value
	}
	return total
}

func jump(skip bool) int {
	value := 0
	value = if skip {
		goto done
	} else {
		9
	}
	done:
	return value
}

func labelledValue() int {return 6}

func tail() int {
	return if true {
		goto value
		value: labelledValue()
	} else {
		0
	}
}

func deferred() int {
	return if true {
		defer fmt.Print("F")
		5
	} else {
		0
	}
}

func headers() int {
	total := 0
	condition:
	for i := 0; if i == 1 {
		break condition
	} else {
		i < 3
	}; i++ {
		total += i
	}
	checks := 0
	retry:
	for i := 0; if checks++; checks == 1 {
		continue retry
	} else {
		checks < 3
	}; i++ {
		total += i
	}
	post:
	for i := 0; i < 3; i += if i == 1 {
		break post
	} else {
		1
	} {
		total += i
	}
	for i := 0; i < 5; i++ {
		if value := if i == 1 {
			continue
		} else if i == 3 {
			break
		} else {
			i
		}; value >= 0 {
			total += value
		}
	}
	for i := 0; i < 5; i++ {
		total += if value := if i == 1 {
			continue
		} else if i == 3 {
			break
		} else {
			i
		}; value >= 0 {
			value
		} else {
			0
		}
	}
	return total
}

func labelledLoop() int {
	turns := 0
again:
	for i := if turns < 2 {
		turns++
		0
	} else {
		0
	}; i < 1; i++ {
		_ = int(if turns < 2 {
			goto again
		} else {
			break again
		})
	}
	return turns
}

func main() {
	if labelledLoop() != 2 {
		panic("loop label")
	}
	if headers() != 6 {
		panic("header jump target")
	}
	if tail() != 6 {panic("labelled value")}
	value, err := checked(false, false)
	if value != 7 || err != nil {
		panic("success")
	}
	fmt.Print(";")
	value, err = checked(false, true)
	if value != 0 || err != failure {
		panic("direct error identity")
	}
	fmt.Print(";")
	value, err = checked(true, true)
	if value != 0 || !errors.Is(err, failure) || err.Error() != "next: failure" {
		panic("wrapped error")
	}
	fmt.Print(";")
	fmt.Print("loop=", loop(), ";jump=", jump(true), ",", jump(false), ";defer=", deferred(), "\n")
}
