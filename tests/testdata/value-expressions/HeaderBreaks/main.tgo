package main

import "fmt"

func switchInit(skip bool) string {
	trace := ""
choice:
	switch value := if skip {
		trace += "I"
		break choice
	} else {
		trace += "I"
		1
	}; value {
	case 1:
		trace += "B"
	}
	return trace + "E"
}

func switchTag(skip bool) string {
	trace := ""
choice:
	switch if skip {
		trace += "T"
		break choice
	} else {
		trace += "T"
		1
	} {
	case 1:
		trace += "B"
		break choice
	}
	return trace + "E"
}

func switchCase(skip bool) string {
	trace := ""
	switch 1 {
	default:
		panic("default case")
	case if skip {
		trace += "C"
		break
	} else {
		trace += "C"
		1
	}:
		trace += "B"
		fallthrough
	case 2:
		trace += "F"
	case if true {
		trace += "L"
		3
	} else {
		4
	}:
		panic("later case")
	}
	return trace + "E"
}

func typeGuard(skip bool) string {
	trace := ""
choice:
	switch value := (if skip {
		trace += "T"
		break choice
	} else {
		trace += "T"
		any(1)
	}).(type) {
	case int:
		trace += fmt.Sprint(value)
	}
	return trace + "E"
}

func selectSend(skip bool) string {
	trace := ""
	channel := make(chan int, 1)
choice:
	select {
	case (if skip {
		trace += "C"
		break choice
	} else {
		trace += "C"
		channel
	}) <- if true {
		trace += "V"
		1
	} else {
		2
	}:
		trace += "B"
		break choice
	default:
		panic("blocked send")
	}
	return trace + fmt.Sprint(len(channel))
}

func selectStore(skip bool) []int {
	channel := make(chan int, 1)
	channel <- 5
	values := []int{0, 0}
choice:
	select {
	case values[if skip { break choice } else { 0 }] = <-channel:
		values[1]++
	}
	if len(channel) != 0 {
		panic("receive order")
	}
	return values
}

func continueReceive() int {
	channel := make(chan int, 1)
	channel <- 5
	total := 0
	for i := 0; i < 3; i++ {
		select {
		case <-if i == 0 { continue } else { channel }:
			total++
		default:
			total += 10
		}
	}
	return total
}

func restart() int {
	attempts := 0
again:
	switch if attempts++; attempts == 1 {
		goto again
	} else if attempts == 2 {
		break again
	} else {
		1
	} {
	case 1:
		panic("switch body")
	}
	return attempts
}

func rangeBreak(skip bool) string {
	trace := ""
choice:
	for _, value := range if skip {
		trace += "C"
		break choice
	} else {
		trace += "C"
		[]int{1, 2}
	} {
		trace += fmt.Sprint(value)
		if value == 2 {
			break choice
		}
	}
	return trace + "E"
}

func rangeBareBreak(skip bool) string {
	trace := ""
	for range if skip {
		trace += "C"
		break
	} else {
		trace += "C"
		[]int{1, 2}
	} {
		trace += "B"
		break
	}
	return trace + "E"
}

func rangeOuterContinue() int {
	total := 0
outer:
	for i := 0; i < 3; i++ {
		for _, value := range if i == 0 {
			continue outer
		} else {
			[]int{2}
		} {
			total += value
		}
	}
	return total
}

func main() {
	for _, skip := range []bool{false, true} {
		wantInit, wantTag, wantCase, wantType, wantSend := "IBE", "TBE", "CBFE", "T1E", "CVB1"
		if skip {
			wantInit, wantTag, wantCase, wantType, wantSend = "IE", "TE", "CE", "TE", "C0"
		}
		if switchInit(skip) != wantInit || switchTag(skip) != wantTag || switchCase(skip) != wantCase || typeGuard(skip) != wantType || selectSend(skip) != wantSend {
			panic("header break")
		}
		wantRange, wantBareRange := "C12E", "CBE"
		if skip {
			wantRange, wantBareRange = "CE", "CE"
		}
		if rangeBreak(skip) != wantRange || rangeBareBreak(skip) != wantBareRange {
			panic("range collection break")
		}
		values := selectStore(skip)
		if skip && (values[0] != 0 || values[1] != 0) || !skip && (values[0] != 5 || values[1] != 1) {
			panic("selected store break")
		}
	}
	if continueReceive() != 11 || restart() != 2 || rangeOuterContinue() != 4 {
		panic("other jump targets")
	}
	fmt.Println("ok")
}
