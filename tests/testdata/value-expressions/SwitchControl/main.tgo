package main

import (
	"errors"
	"fmt"
)

type failureType struct{}
func (*failureType) Error() string {return "failure"}
var failure = &failureType{}
func next(fail bool) (int,error) {fmt.Print("call ");if fail {return 0,failure};return 7,nil}
func checked(wrap,fail bool)(int,error) {
	value:=switch wrap {
	case true: defer fmt.Print("defer "); next(fail)!!
	default: defer fmt.Print("defer "); next(fail)!
	}
	fmt.Print("after ")
	return value,nil
}
func jump(skip bool) int {
	x:=0
	x=switch skip {case true: goto done;default:9}
	done: return x
}
func panics() {
	defer func(){fmt.Println("panic",recover()==failure)}()
	_ = nextValue() + switch true {case true: fmt.Print("branch ");panic(failure);default:0} + laterValue()
}
func nextValue() int {fmt.Print("before ");return 1}
func laterValue() int {fmt.Print("later ");return 2}
func dead(n int) int {return switch n {case 0: return 10;"unreachable";default:20}}
func main() {
	for _,tc:=range []struct{wrap,fail bool}{{false,false},{false,true},{true,true}} {
		value,err:=checked(tc.wrap,tc.fail)
		var typed *failureType
		fmt.Println(value,err==failure,errors.Is(err,failure),errors.As(err,&typed),typed==failure)
		if tc.wrap && err.Error()!="next: failure" {panic(err)}
	}
	fmt.Println(jump(true),jump(false),dead(0),dead(1))
	panics()
}
