package main

import "fmt"

func ready() chan int {
	channel := make(chan int, 1)
	channel <- 7
	return channel
}

func flowOnly(flag bool) int {
	channel := ready()
	return if flag {
		select {
		case (<-channel):
			return 1
		}
		0
	} else {
		2
	}
}

func bare(flag bool) int {
	channel := ready()
	var other chan int
	return if flag {
		select {
		case (<-channel):
			return 7
		case other <- if flag { 1 } else { 2 }:
			return 99
		}
		0
	} else {
		2
	}
}

func assigned(flag bool) int {
	channel := ready()
	var other chan int
	value := 0
	return if flag {
		select {
		case value = (<-channel):
			return value
		case other <- if flag { 1 } else { 2 }:
			return 99
		}
		0
	} else {
		2
	}
}

func declared(flag bool) int {
	channel := ready()
	var other chan int
	return if flag {
		select {
		case value, open := ((<-channel)):
			if !open { panic("closed receive") }
			return value
		case other <- if flag { 1 } else { 2 }:
			return 99
		}
		0
	} else {
		2
	}
}

func main() {
	for _, flag := range []bool{true, false} {
		fmt.Println(flag, flowOnly(flag), bare(flag), assigned(flag), declared(flag))
	}
}
