package invalid

type Account enum {
	Personal struct { Name string }
	Business struct { Company string }
}

func label(account Account, replacement Account) string {
	switch account.TgoTag() {
	case 1:
		account = replacement
		return account.TgoPersonal().Name
	case 2:
		return account.TgoBusiness().Company
	default:
		panic("invalid Account variant")
	}
}
