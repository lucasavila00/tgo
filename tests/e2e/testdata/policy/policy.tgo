package policy

var count int

type Request struct {
    ID string
    Count int
}

var request = Request{ID: "one"}
var array = [3]int{0: 1, 2: 3}
var slice = []int{2: 3}

func Named() (result int) { return }

type Quantity struct { value int } checked

func (value Quantity) check() (Quantity, error) { return value, nil }

var pointer = new(Quantity)
var values = make([]Quantity, 2)

func UnsafeRead(items map[string]Quantity, input any, size int) Quantity {
    clear(values)
    _ = values[:size]
    _ = input.(Quantity)
    return items["one"]
}
