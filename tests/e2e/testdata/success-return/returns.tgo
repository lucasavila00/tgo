package successreturn

import "errors"

var ErrFailure = errors.New("failure")

func load(ok bool) (int, error) {
	if !ok {
		return 0, ErrFailure
	}
	return 7,
}

func One() (int, error) {
	return 1,
}

func Many() (int, string, error) {
	return 2,
		"two",
}

func Commented() (string, error) {
	return "comment", // success
}

func Generic[T any](value T) (T, error) {
	return value,
}

func Named(value int) (result int, err error) {
	result = value
	return result,
}

type Loader struct{ Value int }

func (loader Loader) Load() (int, error) {
	return loader.Value,
}

func FromLiteral(value int) (int, error) {
	call := func() (int, error) {
		return value,
	}
	return call()!!,
}

func Wrapped(ok bool) (int, error) {
	return load(ok)!,
}

func Transparent(ok bool) (int, error) {
	return load(ok)!!,
}
