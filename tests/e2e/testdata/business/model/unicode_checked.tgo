package model

type UnicodePair struct {
	σ   int
	ς   int
	σ_1 int
} checked

func (value UnicodePair) check() (UnicodePair, error) {
	return value, nil
}

func MakeUnicodePair() (UnicodePair, error) {
	return UnicodePair{ς: 2, σ_1: 3, σ: 1}
}

func UnicodePairValues(value UnicodePair) (int, int, int) {
	return value.σ, value.ς, value.σ_1
}
