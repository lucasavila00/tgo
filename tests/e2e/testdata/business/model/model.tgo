package model

type Quantity int where value > 0

type AccountAlias = Account

type CounterRecord (struct {
    value int
})

type Point struct {
    X int
}

type Tagged struct {
    tgoTag uint8
}

type Account enum {
    Personal struct { Name string }
    Business struct {
        Company string
        Members []Account
        Tags map[string]string
    }
}

type Notice enum {
    Text struct {
        Body string
        Labels map[string]string = map[string]string{}
    }
}

type Request struct {
    ID string
    Tags map[string]string = map[string]string{}
}

type Message struct {
    ID string `json:"id"`
    Tags map[string]string `json:"tags"` = map[string]string{}
}

func Personal(name string) Account {
    return Account.Personal{Name: name}
}

func Business(company string, members []Account, tags map[string]string) Account {
    return Account.Business{Company: company, Members: members, Tags: tags}
}

func Label(account Account) string {
    match account {
    case Personal(person): return person.Name
    case Business(company): return company.Company
    }
}

func AliasLabel(account AccountAlias) string {
    match account {
    case Personal(person): return person.Name
    case Business(company): return company.Company
    }
}

func AsAny(account Account) any {
    return any(account)
}

func Counter(value int) CounterRecord {
    return CounterRecord{value: value}
}

func CounterValue(counter CounterRecord) int {
    return counter.value
}

func AnonymousPoint() struct { X int } {
    return struct { X int }{X: 1}
}

func Tag(value Tagged) uint8 {
    return value.tgoTag
}

func NoticeLabels(notice Notice) map[string]string {
    match notice {
    case Text(text): return text.Labels
    }
}

func NewRequest(id string) Request {
    return Request{ID: id, ..default}
}

func NewMessage(id string) Message {
    return Message{ID: id, ..default}
}
