}

func Personal(name string) Account {
    return Account.Personal{Name: name}
}

func ContextualTypeNames() (WhereAlias, EnumAlias) {
    return WhereAlias(1), EnumAlias(2)
}

func Business(company string, members []Account, tags map[string]string) Account {
    return Account.Business{Company: company, Members: members, Tags: tags}
}

func Label(account Account) string {
    match account {
    case Personal(person): return person.Name
    case Business(company): return company.Company
    }
}

func AliasLabel(account AccountAlias) string {
    match account {
    case Personal(person): return person.Name
    case Business(company): return company.Company
    }
}

func AsAny(account Account) any {
    return any(account)
}

func Counter(value int) CounterRecord {
    return CounterRecord{value: value}
}

func CounterValue(counter CounterRecord) int {
    return counter.value
}

func AnonymousPoint() struct { X int } {
    return struct { X int }{X: 1}
}

func Tag(value Tagged) uint8 {
    return value.tgoTag
}

func MatchName(account Account) string {
    __tgo_match_1 := "source"
    match account {
    case Personal(_): return __tgo_match_1
    case Business(_): return __tgo_match_1
    }
}

func __tgo_match(value int) int {
    return value
}

func MarkerSwitch(value int) string {
    switch __tgo_match(value) {
    case 1: return "one"
    default: return "other"
    }
}

func match[T any](value T) T {
    return value
}

type matcher struct{}

func (matcher) match(value string) string {
    return value
}

func OrdinaryMatchName() string {
	return matcher{}.match(match[string]("ordinary"))
}

func OrdinaryMatchStatement() {
    match("ordinary")
}

func MatchLabel(value int) int {
match:
    switch value {
    case 0:
        value++
        break match
    default:
        value++
    }
    return value
}

func FunctionMatchSubject(account Account) string {
    match func() Account { return account }() {
    case Personal(person): return person.Name
    case Business(business): return business.Company
    }
}

func LiteralMatchSubject(name string) string {
    match Account.Personal{Name: name} {
    case Personal(person): return person.Name
    case Business(business): return business.Company
    }
}

func SignalName(signal Signal) string {
    match
        signal {
    case On(_): return "on"
    case Off(_): return "off"
    }
}

func ExplicitMarker() MarkerRecord {
    return MarkerRecord{__tgo_defaults: true, Name: "set"}
}

func SelectedMarker() MarkerRecord {
    return MarkerRecord{__tgo_defaults: false, ..default}
}

func MarkerValues(value MarkerRecord) (bool, string) {
    return value.__tgo_defaults, value.Name
}

func AliasAccount(name string) Account {
    return AccountAlias.Personal{Name: name}
}

func LabeledMatch(account Account) string {
Done:
    match account {
    case Personal(_): break Done
    case Business(_): break Done
    }
    return "done"
}

func NoticeLabels(notice Notice) map[string]string {
    match notice {
    case Text(text): return text.Labels
    }
}

func NewRequest(id string) Request {
    return Request{ID: id, ..default}
}

func NewMessage(id string) Message {
    return Message{ID: id, ..default}
}
