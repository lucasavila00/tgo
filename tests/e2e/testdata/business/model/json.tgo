package model

type JSONExternal enum {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
    Large struct { Data [100]byte }
}

type JSONInternal enum `json:"internal,tag=type"` {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
}

type JSONAdjacent enum `json:"adjacent,tag=type,content=data"` {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
}

type JSONUntagged enum `json:"untagged"` {
    Number struct { Value int `json:"value"` }
    Text struct { Value string `json:"value"` }
    Other struct { Value string `json:"value"` }
}

type JSONNested enum {
    Nested struct { Value JSONExternal `json:"value"` }
}

type JSONCustom enum {
    Value struct { Value JSONField `json:"value"` }
}

type JSONPlain struct {
    ID string `json:"account_id"`
    Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
}


type JSONEscaped enum `json:"internal,tag=kind\u0001"` {
    Value struct {} `json:"name\u0001\"end"`
}

type JSONEscapedExternal enum {
    Value struct {} `json:"name\u0001\"end"`
}

type JSONEscapedAdjacent enum `json:"adjacent,tag=kind\u0001,content=data\u0002"` {
    Value struct {} `json:"name\u0001\"end"`
}

type JSONStringField enum {
    Value struct { Count int `json:"count,string"` }
}
