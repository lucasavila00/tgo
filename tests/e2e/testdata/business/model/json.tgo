package model

type JSONExternal enum {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
    Large struct { Data [100]byte }
}

type JSONInternal enum `json:"internal,tag=type"` {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
}

type JSONAdjacent enum `json:"adjacent,tag=type,content=data"` {
    Created struct {
        ID string `json:"account_id"`
        Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
    } `json:"created"`
    Empty struct {}
}

type JSONUntagged enum `json:"untagged"` {
    Number struct { Value int `json:"value"` }
    Text struct { Value string `json:"value"` }
    Other struct { Value string `json:"value"` }
}

type JSONNested enum {
    Nested struct { Value JSONExternal `json:"value"` }
}

type JSONCustom enum {
    Value struct { Value JSONField `json:"value"` }
}

type JSONPlain struct {
    ID string `json:"account_id"`
    Reason string `json:"reason,omitempty"`
        Custom JSONField `json:"custom,omitempty"`
}


type JSONEscaped enum `json:"internal,tag=kind\u0001"` {
    Value struct { ID string `json:"id,omitempty"` } `json:"name\u0001\"end"`
}

type JSONEscapedExternal enum {
    Value struct { ID string `json:"id,omitempty"` } `json:"name\u0001\"end"`
}

type JSONEscapedAdjacent enum `json:"adjacent,tag=kind\u0001,content=data\u0002"` {
    Value struct { ID string `json:"id,omitempty"` } `json:"name\u0001\"end"`
}

type JSONStringField enum {
    Value struct { Count int `json:"count,string"` }
}

type JSONInternalPayloadMethod enum `json:"internal,tag=type"` {
    Value struct { Seen string `json:"-"` } `json:"value"`
}

type JSONInternalPromotedMethod enum `json:"internal,tag=type"` {
    Value struct { JSONObject } `json:"value"`
}

type JSONNonNilTarget struct{ Name string `json:"name,omitempty"` }

type JSONNonNilAlias = %JSONNonNilTarget

type JSONNonNilCustom struct {
    Value %JSONNonNilTarget
}

type JSONNonNilExternal enum {
    Value struct {
        Direct %JSONNonNilTarget
        Alias JSONNonNilAlias
        Nested struct {
            Array [1]%JSONNonNilTarget
            Slice []%JSONNonNilTarget
            Map map[string]%JSONNonNilTarget
            Optional *struct { Value %JSONNonNilTarget }
        }
        Custom JSONNonNilCustom
    }
}

type JSONNonNilInternal enum `json:"internal,tag=type"` {
    Value struct { Required %JSONNonNilTarget } `json:"value"`
}

type JSONNonNilAdjacent enum `json:"adjacent,tag=type,content=data"` {
    Value struct { Required %JSONNonNilTarget } `json:"value"`
}

type JSONNonNilUntagged enum `json:"untagged"` {
    First struct { Required %JSONNonNilTarget }
    Second struct { Count int }
}

type JSONNonNilRecursive struct {
    Next *JSONNonNilRecursive
    Required %JSONNonNilTarget
}

type JSONNonNilRequired struct { Item %JSONNonNilTarget }

type JSONNonNilBox[T any] struct { Value T }

type JSONNonNilAdvanced enum {
    Value struct {
        Recursive JSONNonNilRecursive
        Generic JSONNonNilBox[JSONNonNilRequired]
    }
}
