package app

import (
	"errors"
	"fmt"
)

var errPropagationMissing = errors.New("missing account")

func propagationLoad(events %[]string, found bool) (int, error) {
	*events = append(*events, "load")
	if !found {
		return 0, errPropagationMissing
	}
	return 7, nil
}

func propagationPair(found bool) (string, int, error) {
	if !found {
		return "", 0, errPropagationMissing
	}
	return "account", 7, nil
}

func propagationFlush(found bool) error {
	if !found {
		return errPropagationMissing
	}
	return nil
}

func propagationMark(events %[]string, name string) string {
	*events = append(*events, name)
	return name
}

func propagationTarget(events %[]string, values []int) []int {
	*events = append(*events, "target")
	return values
}

func propagationTargetLoad(events %[]string, values []int, found bool) ([]int, error) {
	*events = append(*events, "target")
	if !found {
		return nil, errPropagationMissing
	}
	return values, nil
}

func propagationIndex(events %[]string) int {
	*events = append(*events, "index")
	return 0
}

func propagationArrayBound(values %[1]int, found bool) (int, error) {
	values[0] = 2
	if !found {
		return 0, errPropagationMissing
	}
	return 0, nil
}

func propagationFormat(before string, value int, after string) string {
	return fmt.Sprint(before, after)
}

func propagationBool(events %[]string, name string, value bool) (bool, error) {
	*events = append(*events, name)
	return value, nil
}

func propagationLoopCondition(attempt %int, failAt int) (bool, error) {
	*attempt++
	if *attempt == failAt {
		return false, errPropagationMissing
	}
	return *attempt <= 2, nil
}

func propagationForValue(events %[]string, name string, value int, found bool) (int, error) {
	*events = append(*events, name)
	if !found {
		return 0, errPropagationMissing
	}
	return value, nil
}

func propagationForCondition(events %[]string, value bool) bool {
	*events = append(*events, "condition")
	return value
}

func propagationForPost(events %[]string, value %int) {
	*events = append(*events, "post")
	*value++
}

func propagationRecord(events %[]string, value int) {
	*events = append(*events, "defer")
}

func propagationValues(found bool) ([]int, error) {
	if !found {
		return nil, errPropagationMissing
	}
	return []int{1, 2, 3}, nil
}

func propagationCode(found bool) (int, error) {
	if !found {
		return 0, errPropagationMissing
	}
	return 2, nil
}

func propagationAny(events %[]string, found bool) (any, error) {
	return propagationNamedAny(events, "guard", found)
}

func propagationNamedAny(events %[]string, name string, found bool) (any, error) {
	*events = append(*events, name)
	if !found {
		return nil, errPropagationMissing
	}
	return "ready", nil
}

type propagationTypedError struct{}

func (*propagationTypedError) Error() string { return "typed nil" }

func propagationTypedNil() (int, error) {
	var err *propagationTypedError = nil
	return 0, err
}

func PropagationValue(events %[]string, found bool) (int, error) {
	value := propagationLoad(events, found)!
	return value, nil
}

func PropagationOuter(events %[]string, found bool) (int, error) {
	value := PropagationValue(events, found)!
	return value, nil
}

func PropagationTransparent(events %[]string, found bool) (int, error) {
	value := propagationLoad(events, found)!!
	return value, nil
}

func PropagationTransparentFunction(events %[]string, found bool) (int, error) {
	load := propagationLoad
	value := load(events, found)!!
	return value, nil
}

func PropagationTransparentNested(events %[]string, found bool) (string, error) {
	return propagationFormat(
		propagationMark(events, "before"),
		(propagationLoad(events, found))!!,
		propagationMark(events, "after"),
	), nil
}

func PropagationNested(events %[]string, found bool) (string, error) {
	return propagationFormat(
		propagationMark(events, "before"),
		(propagationLoad(events, found))!,
		propagationMark(events, "after"),
	), nil
}

func PropagationAssignment(events %[]string, found bool) ([]int, error) {
	values := []int{0}
	propagationTarget(events, values)[propagationIndex(events)] =
		propagationLoad(events, found)!
	return values, nil
}

func PropagationIncrement(events %[]string, found bool) (int, error) {
	values := []int{0}
	propagationTargetLoad(events, values, found)![propagationIndex(events)]++
	return values[0], nil
}

func PropagationArrayIndex(found bool) (int, error) {
	values := [1]int{1}
	return values[propagationArrayBound(&values, found)!], nil
}

func PropagationArraySlice(found bool) (bool, error) {
	values := [1]int{1}
	slice := values[propagationArrayBound(&values, found)!:]
	return &slice[0] == &values[0] && slice[0] == 2, nil
}

func PropagationGenericArraySlice[T ~[1]int](values %T, found bool) (bool, error) {
	slice := (*values)[propagationGenericArrayBound(values, found)!:]
	return &slice[0] == &(*values)[0] && slice[0] == 2, nil
}

func propagationGenericArrayBound[T ~[1]int](values %T, found bool) (int, error) {
	(*values)[0] = 2
	if !found {
		return 0, errPropagationMissing
	}
	return 0, nil
}

func PropagationMany(found bool) (string, int, error) {
	name, value := propagationPair(found)!
	return name, value, nil
}

func PropagationManyDeclaration(found bool) (string, int, error) {
	var name, value = propagationPair(found)!
	return name, value, nil
}

func PropagationErrorOnly(found bool) error {
	propagationFlush(found)!
	return nil
}

func PropagationAnd(events %[]string, left bool, right bool) (bool, error) {
	return left && propagationBool(events, "right", right)!, nil
}

func PropagationOr(events %[]string, left bool, right bool) (bool, error) {
	return left || propagationBool(events, "right", right)!, nil
}

func PropagationLoop(failAt int) (int, error) {
	attempt := 0
	count := 0
	for propagationLoopCondition(&attempt, failAt)! {
		count++
	}
	return count, nil
}

func PropagationForInitializer(events %[]string, firstFound bool, secondFound bool) (int, error) {
	count := 0
	for first, second := propagationForValue(events, "first", 1, firstFound)!!,
		propagationForValue(events, "second", 2, secondFound)!!; propagationForCondition(events, count < first+second); propagationForPost(events, &count) {
		*events = append(*events, "body")
		if count == 0 {
			continue
		}
		if count == 2 {
			break
		}
	}
	return count, nil
}

func PropagationForInitializerWrapped(events %[]string, found bool) (int, error) {
	for value := propagationForValue(events, "wrapped", 1, found)!; value < 2; value++ {
		return value, nil
	}
	return 0, nil
}

func PropagationForInitializerLabels(events %[]string, enterWithGoto bool) (int, error) {
	count := 0
	if enterWithGoto {
		goto outer
	}
outer:
	for limit := propagationForValue(events, "label", 2, true)!!; count < limit; count++ {
		if count == 0 {
			continue outer
		}
		break outer
	}
	return count, nil
}

func PropagationDeferredArgument(events %[]string, found bool) (int, error) {
	defer propagationRecord(events, propagationLoad(events, found)!)
	*events = append(*events, "body")
	return 7, nil
}

func PropagationExistingDefer(events %[]string, found bool) (int, error) {
	defer func() { *events = append(*events, "exit") }()
	value := propagationLoad(events, found)!
	return value, nil
}

func PropagationIf(events %[]string, value bool) (bool, error) {
	if propagationBool(events, "if", value)! {
		return true, nil
	}
	return false, nil
}

func PropagationIfInitializer(events %[]string, value bool) (string, error) {
	if prefix := propagationMark(events, "init"); propagationBool(events, "if", value)! {
		return prefix, nil
	}
	return "", nil
}

func PropagationRange(found bool) (int, error) {
	total := 0
	for _, value := range propagationValues(found)! {
		total += value
	}
	return total, nil
}

func PropagationLabeledRange(found bool) (int, error) {
	total := 0
outer:
	for _, value := range propagationValues(found)! {
		for {
			total += value
			continue outer
		}
	}
	return total, nil
}

func PropagationSwitch(found bool) (string, error) {
	switch propagationCode(found)! {
	case 1:
		return "one", nil
	case 2:
		return "two", nil
	default:
		return "other", nil
	}
}

func PropagationSwitchInitializer(events %[]string, found bool) (string, error) {
	switch prefix := propagationMark(events, "init"); propagationCode(found)! {
	case 2:
		return prefix, nil
	default:
		return "", nil
	}
}

func PropagationLabeledSwitch(found bool) (string, error) {
	result := "before"
outer:
	switch propagationCode(found)! {
	case 2:
		result = "two"
		break outer
	default:
		result = "other"
	}
	return result, nil
}

func PropagationGotoLabeledSwitch(found bool) (string, error) {
	result := "before"
	goto outer
outer:
	switch propagationCode(found)! {
	case 2:
		result = "two"
		break outer
	default:
		result = "other"
	}
	return result, nil
}

func PropagationTypeSwitch(events %[]string, found bool) (string, error) {
	result := "other"
	switch prefix := propagationMark(events, "init"); value := (propagationAny(events, found)!!).(type) {
	case string:
		result = prefix + ":" + value
	case int:
		result = fmt.Sprint(prefix, ":", value+1)
	}
	return result, nil
}

func PropagationTypeSwitchInitializer(events %[]string, found bool) (string, error) {
	switch prefix := propagationLoad(events, found)!!; value := any("ready").(type) {
	case string:
		return fmt.Sprint(prefix, ":", value), nil
	}
	return "other", nil
}

func PropagationTypeSwitchBoth(events %[]string, initFound bool, guardFound bool) (string, error) {
	switch prefix := propagationNamedAny(events, "init", initFound)!!;
	value := (propagationNamedAny(events, "guard", guardFound)!!).(type) {
	case string:
		return prefix.(string) + ":" + value, nil
	}
	return "other", nil
}

func PropagationBareTypeSwitch(events %[]string, found bool) (string, error) {
	switch (propagationAny(events, found)!!).(type) {
	case string:
		return "string", nil
	}
	return "other", nil
}

func PropagationLabeledTypeSwitch(events %[]string, found bool) (string, error) {
	result := "before"
outer:
	switch value := (propagationAny(events, found)!!).(type) {
	case string:
		result = value
		break outer
	default:
		result = "other"
	}
	return result, nil
}

func PropagationLabeledTypeSwitchScope() (string, error) {
	events := []string{}
	prefix := "outer"
outer:
	switch prefix := propagationLoad(&events, true)!!; value := any("ready").(type) {
	case string:
		_, _ = prefix, value
		break outer
	}
	return prefix, nil
}

func PropagationGotoLabeledTypeSwitch(events %[]string, found bool) (string, error) {
	result := "before"
	goto outer
outer:
	switch value := (propagationAny(events, found)!!).(type) {
	case string:
		result = value
		break outer
	default:
		result = "other"
	}
	return result, nil
}

func PropagationTypedNil() (int, error) {
	value := propagationTypedNil()!
	return value, nil
}

func PropagationFunctionValue(events %[]string, found bool) (int, error) {
	load := propagationLoad
	value := load(events, found)!
	return value, nil
}

func PropagationNamed(events %[]string, found bool) (value int, err error) {
	value = 99
	loaded := propagationLoad(events, found)!
	return loaded, nil
}

func PropagationGeneric[T any](value T, found bool) (T, error) {
	loaded := propagationGenericLoad(value, found)!
	return loaded, nil
}

func propagationGenericLoad[T any](value T, found bool) (T, error) {
	if !found {
		var zero T = value
		return zero, errPropagationMissing
	}
	return value, nil
}
