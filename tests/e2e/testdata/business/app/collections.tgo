package app

import "example.com/business/model"

func Lookup(accounts map[string]model.Account, key string) string {
    if account, ok := accounts[key]; ok {
        return model.Label(account)
    }
    return "missing"
}

func Receive(accounts <-chan model.Account) string {
    if account, ok := <-accounts; ok {
        return model.Label(account)
    }
    return "closed"
}

func Assert(value any) string {
    if account, ok := value.(model.Account); ok {
        return model.Label(account)
    }
    return "other"
}

func ReadInt(values <-chan int) (int, bool) {
    value, ok := <-values
    return value, ok
}

func Nested(account model.Account) string {
    match account {
    case Personal(person): return person.Name
    case Business(company):
        if len(company.Members) == 0 {
            return company.Company
        }
        match company.Members[0] {
        case Personal(person): return person.Name
        case Business(child): return child.Company
        }
    }
}

func Shorten(accounts []model.Account, length int) []model.Account {
    if length >= 0 && length <= len(accounts) {
        return accounts[:length]
    }
    return accounts[:0]
}

func Overlap(accounts []model.Account) {
    copy(accounts[1:], accounts)
}

func ClearMap(accounts map[string]model.Account) {
    clear(accounts)
}
