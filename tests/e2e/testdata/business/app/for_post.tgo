package app

import "errors"

var errForPost = errors.New("for post failure")

func forPostStep(events %[]string, name string, value int, failAt int) (int, error) {
	*events = append(*events, name)
	if value == failAt {
		return 0, errForPost
	}
	return value + 1, nil
}

func PropagationForPostOrder(events %[]string, failLeft int, failRight int) error {
	for left, right := 0, 0; left < 2;
		left, right = forPostStep(events, "left", left, failLeft)!!,
			forPostStep(events, "right", right, failRight)!! {
	}
	return nil
}

func PropagationForPostWrapped() error {
	events := []string{}
	for value := 0; value < 1; value = forPostStep(&events, "wrapped", value, 0)! {
	}
	return nil
}

func forPostCondition(events %[]string, value int) bool {
	*events = append(*events, "condition")
	return value < 1
}

func PropagationForPostFailureSkipsCondition(events %[]string) error {
	for value := 0; forPostCondition(events, value);
		value = forPostStep(events, "post", value, 0)!! {
	}
	return nil
}

func PropagationForPostContinues() ([]string, error) {
	events := []string{}
outer:
	for outerValue := 0; outerValue < 2;
		outerValue = forPostStep(&events, "outer", outerValue, -1)!! {
		for innerValue := 0; innerValue < 2;
			innerValue = forPostStep(&events, "inner", innerValue, -1)!! {
			if innerValue == 0 {
				continue
			}
			continue outer
		}
	}
	return events, nil
}

func PropagationForPostSkipsAbrupt(mode string) ([]string, error) {
	events := []string{}
	if mode == "return" {
		for value := 0; value < 1; value = forPostStep(&events, "return", value, -1)!! {
			return events, nil
		}
	}
	if mode == "goto" {
		for value := 0; value < 1; value = forPostStep(&events, "goto", value, -1)!! {
			goto done
		}
	}
loop:
	for value := 0; value < 1; value = forPostStep(&events, "break", value, -1)!! {
		break loop
	}
done:
	return events, nil
}

func PropagationForPostGotoContinue() ([]string, error) {
	events := []string{}
	goto outer
outer:
	for value := 0; value < 2; value = forPostStep(&events, "outer", value, -1)!! {
		continue outer
	}
	return events, nil
}

func forPostCapture(functions %[]func() int, pointers %[]%int, value %int) (int, error) {
	*functions = append(*functions, func() int { return *value })
	*pointers = append(*pointers, value)
	return *value + 1, nil
}

func PropagationForPostIterationIdentity() (bool, error) {
	bodyFunctions := []func() int{}
	postFunctions := []func() int{}
	bodyPointers := []%int{}
	postPointers := []%int{}
	for value := 0; value < 3;
		value = forPostCapture(&postFunctions, &postPointers, &value)!! {
		bodyFunctions = append(bodyFunctions, func() int { return value })
		bodyPointers = append(bodyPointers, &value)
	}
	return bodyFunctions[0]() == 0 && bodyFunctions[1]() == 1 && bodyFunctions[2]() == 2 &&
		postFunctions[0]() == 1 && postFunctions[1]() == 2 && postFunctions[2]() == 3 &&
		bodyPointers[0] != postPointers[0] && postPointers[0] == bodyPointers[1] &&
		postPointers[1] == bodyPointers[2] && postPointers[2] != bodyPointers[2], nil
}

func PropagationForPostNamedDefer(events %[]string) (value int, err error) {
	defer func() {
		*events = append(*events, "defer")
		value++
	}()
	for index := 0; index < 1; index = forPostStep(events, "post", index, 0)!! {
	}
	return 9, nil
}
