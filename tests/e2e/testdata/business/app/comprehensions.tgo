package app

import "errors"

type comprehensionAccount struct {
    ID string
    Active bool
    Sales []int
}

type comprehensionNames []string
type comprehensionByID map[string]comprehensionAccount

var errComprehension = errors.New("comprehension failure")

func ComprehensionNames(accounts []comprehensionAccount) comprehensionNames {
    return comprehensionNames{for _, account := range accounts {
        if account.Active { account.ID }
    }}
}

func ComprehensionPairs(accounts []comprehensionAccount) [][2]int {
    return [][2]int{for _, account := range accounts {
        for _, sale := range account.Sales { [2]int{len(account.ID), sale} }
    }}
}

func ComprehensionByID(accounts []comprehensionAccount) comprehensionByID {
    return comprehensionByID{for _, account := range accounts {
        account.ID: account
    }}
}

func ComprehensionEmpty() []string {
    return []string{for _, value := range []string{} { value }}
}

func ComprehensionCopy(values []int) []int {
    return []int{for _, value := range values { value }}
}

func ComprehensionIndexes(count int) []int {
    return []int{for index := range count { index }}
}

func comprehensionMapValue(value string) string { return "value:" + value }

func ComprehensionMapCall(values []string) map[string]string {
    return map[string]string{for _, value := range values {
        value: comprehensionMapValue(value)
    }}
}

func comprehensionRecord(events *[]string, name string) string {
    *events = append(*events, name)
    return name
}

func comprehensionSource(events *[]string, values []int) []int {
    *events = append(*events, "source")
    return values
}

func comprehensionLoad(events *[]string, name string, fail bool) (string, error) {
    *events = append(*events, name)
    if fail {
        return "", errComprehension
    }
    return name, nil
}

func ComprehensionOrder(events *[]string) []string {
    return []string{for _, value := range comprehensionSource(events, []int{1, 2}) {
        comprehensionRecord(events, "value") + string(rune('0' + value))
    }}
}

func ComprehensionSourceError(events *[]string, fail bool) ([]string, error) {
    return []string{for _, value := range []string{comprehensionLoad(events, "source", fail)!} {
        value
    }}, nil
}

func ComprehensionFilterError(events *[]string, fail bool) ([]string, error) {
    return []string{for _, value := range []string{"value"} {
        if comprehensionLoad(events, "filter", fail)! != "" { value }
    }}, nil
}

func ComprehensionResultError(events *[]string, fail bool) ([]string, error) {
    return []string{for _, value := range []string{"value"} {
        value + comprehensionLoad(events, "result", fail)!
    }}, nil
}

func ComprehensionMapError(
    events *[]string,
    failKey bool,
    failValue bool,
) (map[string]string, error) {
    return map[string]string{for _, value := range []string{"value"} {
        comprehensionLoad(events, "key", failKey)!:
            value + comprehensionLoad(events, "value", failValue)!
    }}, nil
}

func ComprehensionForInitializer(input []int) int {
	for items := []int{for _, item := range input { item }}; len(items) > 0; items = nil {
		return items[0]
	}
	return 0
}
