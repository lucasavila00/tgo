{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TGo",
  "scopeName": "source.tgo",
  "patterns": [
    {
      "include": "#tgo"
    },
    {
      "include": "source.go"
    }
  ],
  "repository": {
    "tgo": {
      "patterns": [
        {
          "begin": "(?=\\btype\\s+[A-Za-z_]\\w*\\s+enum\\b\\s*(?:`[^`\\n]*`\\s*)?\\{)",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "name": "keyword.declaration.enum.tgo",
              "match": "\\benum\\b"
            },
            {
              "include": "source.go"
            }
          ]
        },
        {
          "begin": "(?=\\btype\\s+[A-Za-z_]\\w*\\s+(?:(?:struct|interface)[ \\t]*\\{[^\\r\\n]*\\}|[^{}=\\r\\n]+?)[ \\t]+\\bwhere\\b)",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "name": "keyword.control.where.tgo",
              "match": "\\bwhere\\b"
            },
            {
              "include": "source.go"
            }
          ]
        },
        {
          "name": "keyword.other.default.tgo",
          "match": "(?<!\\.)\\.\\.default\\b"
        },
        {
          "begin": "(?<=\\))(?=[ \\t]*(?:/\\*[^\\r\\n]*\\*/[ \\t]*)*!!?(?!=))",
          "end": "(!!?)(?!=)",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.propagation.tgo"
            }
          },
          "patterns": [
            {
              "include": "source.go"
            }
          ]
        }
      ]
    }
  }
}
