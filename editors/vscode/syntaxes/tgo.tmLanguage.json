{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TGo",
  "scopeName": "source.tgo",
  "patterns": [
    {
      "include": "#tgo"
    },
    {
      "include": "source.go"
    }
  ],
  "injections": {
    "L:source.tgo -comment -string": {
      "patterns": [
        {
          "match": "(?<=^\\s*func\\b[^{\\r\\n]*)(\\b[A-Za-z_]\\w*)([ \\t]+)(%)(?=[A-Za-z_(\\[])",
          "captures": {
            "1": {
              "name": "variable.parameter.go"
            },
            "3": {
              "name": "storage.modifier.non-nil.tgo"
            }
          }
        }
      ]
    }
  },
  "repository": {
    "tgo": {
      "patterns": [
        {
          "begin": "(?=\\btype\\s+[A-Za-z_]\\w*\\s+enum\\b\\s*(?:`[^`\\n]*`\\s*)?\\{)",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "name": "keyword.declaration.enum.tgo",
              "match": "\\benum\\b"
            },
            {
              "include": "source.go"
            }
          ]
        },
        {
          "begin": "(?=\\btype\\s+[A-Za-z_]\\w*\\s+struct[ \\t]*\\{[^\\r\\n]*\\}[ \\t]+\\bchecked\\b)",
          "end": "(?=\\r?$)",
          "patterns": [
            {
              "name": "keyword.declaration.checked.tgo",
              "match": "\\bchecked\\b"
            },
            {
              "include": "source.go"
            }
          ]
        },
        {
          "name": "keyword.other.default.tgo",
          "match": "(?<!\\.)\\.\\.default\\b"
        },
        {
          "begin": "(?<=\\))(?=[ \\t]*(?:/\\*[^\\r\\n]*\\*/[ \\t]*)*!!?(?!=))",
          "end": "(!!?)(?!=)",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.propagation.tgo"
            }
          },
          "patterns": [
            {
              "include": "source.go"
            }
          ]
        }
      ]
    }
  }
}
