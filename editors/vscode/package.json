{
  "name": "tgo-navigation",
  "displayName": "TGo Navigation",
  "publisher": "tgo",
  "description": "Read and navigate TGo source.",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasavila00/go2.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/lucasavila00/go2/blob/main/docs/guide/VSCODE.md",
  "bugs": {
    "url": "https://github.com/lucasavila00/go2/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tgo"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tgo",
        "aliases": [
          "TGo",
          "tgo"
        ],
        "extensions": [
          ".tgo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tgo",
        "scopeName": "source.tgo",
        "path": "./syntaxes/tgo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TGo Navigation",
      "properties": {
        "tgo.navigation.helperPath": {
          "type": "string",
          "default": "tgonav",
          "scope": "resource",
          "description": "Path to the tgonav helper."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --skip-license --out tgo-navigation.vsix",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/run-integration.js",
    "test:all": "npm test && npm run package && npm run test:integration"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.1"
  }
}
