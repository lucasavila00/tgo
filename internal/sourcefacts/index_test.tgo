package sourcefacts

import (
	"go/importer"
	"go/token"
	"go/types"
	"strings"
	"testing"

	"tgo/internal/compiler"
	"tgo/pkg/syntax"
)

type objectFact struct {
	position token.Pos
	name     string
	object   types.Object
}

type projectionStub struct {
	definitions []objectFact
	uses        []objectFact
}

func (*projectionStub) RangeTypes(
	func(token.Pos, token.Pos, types.TypeAndValue, bool),
) {
}

func (p *projectionStub) RangeDefinitions(
	yield func(token.Pos, string, types.Object, bool),
) {
	for _, fact := range p.definitions {
		yield(fact.position, fact.name, fact.object, false)
	}
}

func (p *projectionStub) RangeUses(
	yield func(token.Pos, string, types.Object, bool),
) {
	for _, fact := range p.uses {
		yield(fact.position, fact.name, fact.object, false)
	}
}

func (*projectionStub) RangeSelections(
	func(token.Pos, token.Pos, *types.Selection, bool),
) {
}

func (*projectionStub) RangeInstances(
	func(token.Pos, types.Instance, bool),
) {
}

func (*projectionStub) RangeImplicits(
	func(token.Pos, token.Pos, types.Object, bool),
) {
}

func TestProjectionFindsShiftedDefinition(t *testing.T) {
	t.Parallel()
	projected := []byte("package sample\ntype value struct {\n      field int\n}\n")
	source := []byte("package sample\ntype value struct {\n\tfield int\n}\n")
	files := token.NewFileSet()
	projectedFile := files.AddFile("sample.tgo", -1, len(projected))
	projectedFile.SetLinesForContent(projected)
	position := projectedFile.Pos(strings.Index(string(projected), "field"))
	object := types.NewVar(position, nil, "field", types.Typ[types.Int])
	parsed := parseSource(t, files, source)
	index := NewProjection(parsed, &projectionStub{definitions: []objectFact{{
		position: position, name: "field", object: object,
	}}, uses: nil}, files)
	declaration := syntax.GeneralDeclarationOf(parsed.Declarations[0])
	specification := syntax.TypeSpecificationOf(declaration.Specs[0])
	structure := syntax.StructTypeExpressionOf(specification.Type)
	name := structure.Fields.List[0].Names[0]
	if got := index.DefinitionName(name); got != object {
		t.Fatalf("shifted field definition = %v, want %v", got, object)
	}
}

func TestProjectionDoesNotClassifySameLineUseAsDefinition(t *testing.T) {
	t.Parallel()
	projected := []byte("package sample\nvar      value = 1; var copy = value\n")
	source := []byte("package sample\nvar value = 1; var copy = value\n")
	files := token.NewFileSet()
	projectedFile := files.AddFile("sample.tgo", -1, len(projected))
	projectedFile.SetLinesForContent(projected)
	definitionPosition := projectedFile.Pos(strings.Index(string(projected), "value"))
	usePosition := projectedFile.Pos(strings.LastIndex(string(projected), "value"))
	object := types.NewVar(definitionPosition, nil, "value", types.Typ[types.Int])
	parsed := parseSource(t, files, source)
	index := NewProjection(parsed, &projectionStub{
		definitions: []objectFact{{
			position: definitionPosition, name: "value", object: object,
		}},
		uses: []objectFact{{position: usePosition, name: "", object: object}},
	}, files)
	definition, use := sourceIdentifiers(t, parsed)
	if definition == nil || use == nil {
		t.Fatal("identifier node is absent")
		return
	}
	definitionObject, definitionFact := index.IdentifierFact(parsed, definition)
	useObject, useFact := index.IdentifierFact(parsed, use)
	if definitionObject != object || useObject != object {
		t.Fatalf("objects = %v, %v, want %v", definitionObject, useObject, object)
	}
	if !definitionFact {
		t.Fatal("declaration is not classified as a definition")
	}
	if useFact {
		t.Fatal("same-line use is classified as a definition")
	}
}

func TestProjectionMatchesNamesAtSharedAdjustedPosition(t *testing.T) {
	t.Parallel()
	source := []byte("package sample\n" +
		"//line sample.tgo:10:5\nvar alpha int\n" +
		"//line sample.tgo:10:5\nvar gamma int\n" +
		"//line sample.tgo:11:1\nvar beta int\n" +
		"//line sample.tgo:10:1\nvar _ = beta\n")
	files := token.NewFileSet()
	parsed := parseSource(t, files, source)
	alpha := declarationName(parsed, 0)
	gamma := declarationName(parsed, 1)
	beta := declarationName(parsed, 2)
	use := declarationUse(parsed, 3)
	position := files.Position(alpha.Start)
	position.Offset = 0
	gammaPosition := files.Position(gamma.Start)
	gammaPosition.Offset = 0
	usePosition := files.Position(use.Start)
	usePosition.Offset = 0
	if gammaPosition != position || usePosition != position {
		t.Fatal("test identifiers do not share an adjusted position")
	}
	alphaObject := types.NewVar(alpha.Start, nil, alpha.Name, types.Typ[types.Int])
	gammaObject := types.NewVar(gamma.Start, nil, gamma.Name, types.Typ[types.Int])
	betaObject := types.NewVar(beta.Start, nil, beta.Name, types.Typ[types.Int])
	orders := [][]objectFact{
		{
			{position: alpha.Start, name: alpha.Name, object: alphaObject},
			{position: gamma.Start, name: gamma.Name, object: gammaObject},
			{position: beta.Start, name: beta.Name, object: betaObject},
		},
		{
			{position: gamma.Start, name: gamma.Name, object: gammaObject},
			{position: alpha.Start, name: alpha.Name, object: alphaObject},
			{position: beta.Start, name: beta.Name, object: betaObject},
		},
	}
	for order, definitions := range orders {
		index := NewProjection(parsed, &projectionStub{
			definitions: definitions,
			uses: []objectFact{{
				position: use.Start, name: use.Name, object: betaObject,
			}},
		}, files)
		for _, item := range []struct {
			name   %syntax.Identifier
			object types.Object
		}{
			{name: alpha, object: alphaObject},
			{name: gamma, object: gammaObject},
		} {
			if got := index.DefinitionName(item.name); got != item.object {
				t.Fatalf("order %d: definition %s = %v, want %v",
					order, item.name.Name, got, item.object)
			}
			if got := index.Object(item.name); got != item.object {
				t.Fatalf("order %d: object %s = %v, want %v",
					order, item.name.Name, got, item.object)
			}
			node := identifierNode(parsed, item.name)
			if node == nil {
				t.Fatalf("order %d: identifier node %s is absent", order, item.name.Name)
				return
			}
			got, definition := index.IdentifierFact(parsed, node)
			if got != item.object || !definition {
				t.Fatalf("order %d: identifier %s = %v, %t, want %v, true",
					order, item.name.Name, got, definition, item.object)
			}
		}
		if got := index.Object(use); got != betaObject {
			t.Fatalf("order %d: use object = %v, want %v", order, got, betaObject)
		}
		useNode := identifierNode(parsed, use)
		if useNode == nil {
			t.Fatalf("order %d: use node is absent", order)
			return
		}
		got, definition := index.IdentifierFact(parsed, useNode)
		if got != betaObject || definition {
			t.Fatalf("order %d: use = %v, %t, want %v, false",
				order, got, definition, betaObject)
		}
	}
}

func TestProjectionKeepsLoweredReceiverUse(t *testing.T) {
	t.Parallel()
	files := token.NewFileSet()
	data := []byte("package sample\n" +
		"type Event enum { Ready struct{} }\n" +
		"func load() Event { return Event.Ready{} }\n" +
		"func use() { switch load().Tag() {\n" +
		"case EventTagReady: return\n" +
		"exhaustive:\n" +
		"} }\n")
	input := new(compiler.PackageInput)
	input.Path = "sample"
	input.Sources = []compiler.File{{Name: "sample.tgo", Data: data}}
	input.FileSet = files
	input.Importer = importer.Default()
	compiled, errors := compiler.Compile(*input)
	if len(errors) != 0 {
		t.Fatal(errors)
		return
	}
	if compiled == nil {
		t.Fatal("compiled package is absent")
		return
	}
	if len(compiled.Sources) != 1 {
		t.Fatalf("compiled source count = %d, want 1", len(compiled.Sources))
		return
	}
	parsed := compiled.Sources[0].Syntax
	projection := compiled.Facts
	if projection == nil {
		t.Fatal("compiled projection facts are absent")
		return
	}
	receiver := sourceIdentifier(t, files, parsed, "load", 4)
	wantPosition := files.Position(receiver.Start)
	wantPosition.Offset = 0
	uses := make(map[string]objectFact)
	projection.RangeUses(func(
		position token.Pos,
		name string,
		object types.Object,
		synthetic bool,
	) {
		adjusted := files.Position(position)
		adjusted.Offset = 0
		if !synthetic && adjusted == wantPosition {
			uses[name] = objectFact{position: position, name: name, object: object}
		}
	})
	sourceUse, sourceOK := uses["load"]
	generatedUse, generatedOK := uses["enumValue"]
	if !sourceOK || !generatedOK {
		t.Fatalf("receiver uses = %v, want load and enumValue", uses)
	}
	node := requiredIdentifierNode(t, parsed, receiver)
	orders := [][]objectFact{
		{sourceUse, generatedUse},
		{generatedUse, sourceUse},
	}
	for order, facts := range orders {
		index := NewProjection(parsed, &projectionStub{definitions: nil, uses: facts}, files)
		if got := index.Object(receiver); got != sourceUse.object {
			t.Fatalf("order %d: receiver object = %v, want %v",
				order, got, sourceUse.object)
		}
		got, definition := index.IdentifierFact(parsed, node)
		if got != sourceUse.object || definition {
			t.Fatalf("order %d: receiver fact = %v, %t, want %v, false",
				order, got, definition, sourceUse.object)
		}
	}
}

func requiredIdentifierNode(
	t *testing.T,
	file %syntax.File,
	identifier %syntax.Identifier,
) %syntax.Node {
	t.Helper()
	result := identifierNode(file, identifier)
	if result == nil {
		t.Fatal("identifier node is absent")
		panic("identifier node is absent")
	}
	return result
}

func sourceIdentifier(
	t *testing.T,
	files *token.FileSet,
	file %syntax.File,
	name string,
	line int,
) %syntax.Identifier {
	t.Helper()
	var result *syntax.Identifier = nil
	syntax.Inspect(file, func(node *syntax.Node) bool {
		identifier, ok := syntax.IdentifierOf(node)
		if ok && identifier.Name == name &&
			files.Position(identifier.Start).Line == line {
			result = identifier
		}
		return result == nil
	})
	if result == nil {
		t.Fatalf("source identifier %s on line %d is absent", name, line)
		panic("source identifier is absent")
	}
	return result
}

func declarationName(file %syntax.File, index int) %syntax.Identifier {
	declaration := syntax.GeneralDeclarationOf(file.Declarations[index])
	value := syntax.ValueSpecificationOf(declaration.Specs[0])
	return value.Names[0]
}

func declarationUse(file %syntax.File, index int) %syntax.Identifier {
	declaration := syntax.GeneralDeclarationOf(file.Declarations[index])
	value := syntax.ValueSpecificationOf(declaration.Specs[0])
	result := syntax.IdentifierExpressionOf(value.Values[0])
	if result == nil {
		panic("test use identifier is absent")
	}
	return result
}

func parseSource(t *testing.T, files *token.FileSet, source []byte) *syntax.File {
	t.Helper()
	parsed, err := syntax.ParseGoFile(
		files, "sample.tgo", source, syntax.AllErrors,
	)
	if err != nil {
		t.Fatalf("parse source syntax: %v", err)
	}
	if parsed == nil {
		t.Fatal("parse source syntax returned nil")
	}
	return parsed
}

func sourceIdentifiers(
	t *testing.T,
	file *syntax.File,
) (*syntax.Node, *syntax.Node) {
	t.Helper()
	first := syntax.GeneralDeclarationOf(file.Declarations[0])
	firstValue := syntax.ValueSpecificationOf(first.Specs[0])
	definition := identifierNode(file, firstValue.Names[0])
	second := syntax.GeneralDeclarationOf(file.Declarations[1])
	secondValue := syntax.ValueSpecificationOf(second.Specs[0])
	useName := syntax.IdentifierExpressionOf(secondValue.Values[0])
	use := identifierNode(file, useName)
	if definition == nil || use == nil {
		t.Fatal("identifier node is absent")
	}
	return definition, use
}

func identifierNode(file *syntax.File, identifier *syntax.Identifier) *syntax.Node {
	var result *syntax.Node = nil
	syntax.Inspect(file, func(node *syntax.Node) bool {
		value, ok := syntax.IdentifierOf(node)
		if ok && value.Start == identifier.Start && value.Stop == identifier.Stop {
			result = node
			return false
		}
		return result == nil
	})
	return result
}
