package genericmembers

type Box[T any] struct {
	Value T
}

func (box Box[T]) Get() T {
	return box.Value
}

func readGeneric[T any](box Box[T]) T {
	return box.Get()
}

func readInt(box Box[int]) int {
	return box.Value + box.Get()
}

func readString(box Box[string]) string {
	return box.Value + box.Get()
}

type Wrapper[T any] struct {
	Box[T]
}

func readPromotedInt(wrapper Wrapper[int]) int {
	return wrapper.Value + wrapper.Get()
}

func readPromotedString(wrapper Wrapper[string]) string {
	return wrapper.Value + wrapper.Get()
}
