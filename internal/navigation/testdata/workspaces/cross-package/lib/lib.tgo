package lib

const Limit = 10

var DefaultName = "default"

type Record struct {
	Name string
}

type Printer interface {
	Print() string
}

func (value Record) Text() string {
	return value.Name
}

func Target(value Record) string {
	return value.Text()
}

type Account enum {
	Personal struct {
		Name string
	}
	Business struct {
		Company string
	}
}

func AccountName(value Account) string {
	switch value.Tag() {
	case AccountTagPersonal:
		return value.PersonalPayload().Name
	case AccountTagBusiness:
		return value.BusinessPayload().Company
	exhaustive:
	}
}

func PersonalName(value Account) string {
	switch value.Tag() {
	case AccountTagPersonal:
		return value.PersonalPayload().Name
	case AccountTagBusiness:
		return ""
	exhaustive:
	}
}

func MakeAccount() Account {
	return Account.Personal{Name: "person"}
}

type UserID struct { value int } checked

type userIDError struct{}

func (userIDError) Error() string { return "invalid UserID" }

func (value UserID) check() (UserID, error) {
	if value.value < 1 { return UserID{}, userIDError{} }
	return value, nil
}

func NewUserID(value int) (UserID, error) { return UserID{value: value} }

func (value UserID) Value() int { return value.value }

func ReadID(value UserID) int {
	return value.Value()
}

func MakeID() (UserID, error) {
	return NewUserID(1)
}
