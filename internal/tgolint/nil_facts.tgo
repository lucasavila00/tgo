package tgolint

import (
	"go/ast"
	"go/token"
	"go/types"
	"strconv"
	"strings"
	"golang.org/x/tools/go/cfg"
)

func (e %nilEnvironment) blockNilFacts(
	block *cfg.Block,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	if len(block.Nodes) == 0 {
		return nil, nil
	}
	condition, ok := block.Nodes[len(block.Nodes)-1].(ast.Expr)
	if !ok {
		return nil, nil
	}
	if clause, ok := e.parents[condition].(*ast.CaseClause); ok {
		body, bodyOK := e.parents[clause].(*ast.BlockStmt)
		switchStatement, switchOK := e.parents[body].(*ast.SwitchStmt)
		if bodyOK && switchOK && switchStatement.Tag != nil {
			return e.comparisonNilFacts(
				switchStatement.Tag, condition, token.EQL, state,
			)
		}
	}
	return e.conditionNilFacts(condition, state)
}

// conditionNilFacts returns facts for the true and false condition paths.
func (e %nilEnvironment) conditionNilFacts(
	expression ast.Expr,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	switch expression := expression.(type) {
	case *ast.ParenExpr:
		return e.conditionNilFacts(expression.X, state)
	case *ast.UnaryExpr:
		if expression.Op == token.NOT {
			trueFacts, falseFacts := e.conditionNilFacts(expression.X, state)
			return falseFacts, trueFacts
		}
	case *ast.Ident:
		guard, ok := state.guards[e.info.ObjectOf(expression)]
		if ok {
			return cloneNilFacts(guard.trueFacts), cloneNilFacts(guard.falseFacts)
		}
		if presence, ok := state.presence[e.info.ObjectOf(expression)]; ok {
			if presence.nonNil {
				return nilFacts{presence.value: nonNilValue()}, nil
			}
		}
	case *ast.BinaryExpr:
		switch expression.Op {
		case token.EQL, token.NEQ:
			return e.comparisonNilFacts(
				expression.X, expression.Y, expression.Op, state,
			)
		case token.LAND:
			leftTrue, leftFalse := e.conditionNilFacts(expression.X, state)
			trueState := cloneNilState(state)
			e.applyNilFacts(trueState, leftTrue)
			rightTrue, rightFalse := e.conditionNilFacts(expression.Y, trueState)
			return unionNilFacts(leftTrue, rightTrue), intersectNilFacts(
				leftFalse, unionNilFacts(leftTrue, rightFalse),
			)
		case token.LOR:
			leftTrue, leftFalse := e.conditionNilFacts(expression.X, state)
			falseState := cloneNilState(state)
			e.applyNilFacts(falseState, leftFalse)
			rightTrue, rightFalse := e.conditionNilFacts(expression.Y, falseState)
			return intersectNilFacts(
				leftTrue, unionNilFacts(leftFalse, rightTrue),
			), unionNilFacts(leftFalse, rightFalse)
		}
	}
	return nil, nil
}

func (e %nilEnvironment) comparisonNilFacts(
	left ast.Expr,
	right ast.Expr,
	operator token.Token,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	place, ok := e.nilPlace(left)
	if !ok || !e.isNil(right) {
		place, ok = e.nilPlace(right)
		if !ok || !e.isNil(left) {
			return nil, nil
		}
	}
	nonNil := nilFacts{place: nonNilValue()}
	nilFact := nilFacts{place: provenNilValue()}
	if operator == token.NEQ {
		return nonNil, nilFact
	}
	return nilFact, nonNil
}

func unionNilFacts(left, right nilFacts) nilFacts {
	result := cloneNilFacts(left)
	if result == nil {
		result = make(nilFacts)
	}
	for place, value := range right {
		result[place] = value
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func intersectNilFacts(left, right nilFacts) nilFacts {
	result := make(nilFacts)
	for place, value := range left {
		if other, found := right[place]; found {
			if equalNilValue(other, value) {
				result[place] = value
			}
		}
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func (e %nilEnvironment) applyNilFacts(state *nilFlowState, facts nilFacts) {
	for place, value := range facts {
		e.setNilValue(state, place, value)
	}
}

func (e %nilEnvironment) setNilValue(
	state *nilFlowState,
	place nilPlace,
	value nilValue,
) {
	state.values[place] = value
	for other := range state.aliases {
		if nilAliased(state, place, other) {
			state.values[other] = value
		}
	}
}

func nilPlaceID(place nilPlace) string {
	if place.object == nil {
		return place.path
	}
	pkg := ""
	if place.object.Pkg() != nil {
		pkg = place.object.Pkg().Path()
	}
	return pkg + ":" + place.object.Name() + ":" +
		strconv.Itoa(int(place.object.Pos())) + ":" + place.path
}

func nilRepresentative(state *nilFlowState, place nilPlace) nilPlace {
	if representative, ok := state.aliases[place]; ok {
		return representative
	}
	return place
}

func nilAliased(state *nilFlowState, left, right nilPlace) bool {
	return nilRepresentative(state, left) == nilRepresentative(state, right)
}

func addNilAlias(state *nilFlowState, left, right nilPlace) {
	leftRepresentative := nilRepresentative(state, left)
	rightRepresentative := nilRepresentative(state, right)
	if leftRepresentative == rightRepresentative {
		return
	}
	representative := leftRepresentative
	replaced := rightRepresentative
	if nilPlaceID(rightRepresentative) < nilPlaceID(leftRepresentative) {
		representative = rightRepresentative
		replaced = leftRepresentative
	}
	state.aliases[left] = representative
	state.aliases[right] = representative
	for place, current := range state.aliases {
		if current == replaced {
			state.aliases[place] = representative
		}
	}
}

func breakNilAlias(state *nilFlowState, target nilPlace) {
	group := make([]nilPlace, 0)
	for place := range state.aliases {
		if nilAliased(state, target, place) && place != target {
			group = append(group, place)
		}
	}
	for place := range state.aliases {
		if nilAliased(state, target, place) {
			delete(state.aliases, place)
		}
	}
	for index := 1; index < len(group); index++ {
		addNilAlias(state, group[0], group[index])
	}
}

// nilPlace identifies a stable local, field, index, or dereference.
func (e %nilEnvironment) nilPlace(expression ast.Expr) (nilPlace, bool) {
	switch expression := expression.(type) {
	case *ast.ParenExpr:
		return e.nilPlace(expression.X)
	case *ast.Ident:
		object := e.info.ObjectOf(expression)
		if object == nil || object == types.Universe.Lookup("nil") {
			return nilPlace{object: nil, path: ""}, false
		}
		return nilPlace{object: object, path: ""}, true
	case *ast.SelectorExpr:
		base, ok := e.nilPlace(expression.X)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		selection := e.info.Selections[expression]
		if selection == nil || selection.Kind() != types.FieldVal {
			return nilPlace{object: nil, path: ""}, false
		}
		parts := make([]string, 0, len(selection.Index()))
		for _, index := range selection.Index() {
			parts = append(parts, strconv.Itoa(index))
		}
		base.path += "/f" + strings.Join(parts, ".")
		return base, true
	case *ast.IndexExpr:
		base, ok := e.nilPlace(expression.X)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		key, ok := e.stableIndex(expression.Index)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		base.path += "/i" + key
		return base, true
	case *ast.StarExpr:
		base, ok := e.nilPlace(expression.X)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		base.path += "/d"
		return base, true
	}
	return nilPlace{object: nil, path: ""}, false
}

func (e %nilEnvironment) stableIndex(expression ast.Expr) (string, bool) {
	if name, ok := expression.(*ast.Ident); ok {
		object := e.info.ObjectOf(name)
		if object != nil {
			return "o" + nilPlaceID(nilPlace{object: object, path: ""}), true
		}
	}
	value := e.info.Types[expression].Value
	if value != nil {
		return "c" + value.ExactString(), true
	}
	return "", false
}

func (e %nilEnvironment) isNil(expression ast.Expr) bool {
	name, ok := expression.(*ast.Ident)
	return ok && e.info.ObjectOf(name) == types.Universe.Lookup("nil")
}

// prepareNilBlock sets the range value contract at a range body entry.
func (e %nilEnvironment) prepareNilBlock(
	state *nilFlowState,
	block *cfg.Block,
) {
	if block.Kind != cfg.KindRangeBody {
		return
	}
	statement, ok := block.Stmt.(*ast.RangeStmt)
	if !ok {
		return
	}
	source := e.contractForExpression(statement.X)
	valueContract := nilChild(source, "e")
	if _, mapping := coreType(e.info.TypeOf(statement.X)).(*types.Map); mapping {
		valueContract = nilChild(source, "v")
	}
	if statement.Value != nil {
		e.assignNilTarget(state, statement.Value, nil)
		if place, ok := e.nilPlace(statement.Value); ok && valueContract[""] {
			e.setNilValue(state, place, nonNilValue())
		}
	}
}
