package tgolint

import (
	"go/token"
	"go/types"

	"tgo/internal/sourcefacts"
	"tgo/pkg/syntax"
)

// sourceStatementList gets a statement list that exists in TGo source.
func sourceStatementList(node *syntax.Node) ([]*syntax.Statement, bool) {
	if node == nil {
		return nil, false
	}
	match *node {
	case Statement(value): return statementList(value.Value)
	case MatchCase(value): return value.Value.Body, true
	case File(_): return nil, false
	case Declaration(_): return nil, false
	case Specification(_): return nil, false
	case Expression(_): return nil, false
	case Field(_): return nil, false
	case FieldList(_): return nil, false
	case TGoField(_): return nil, false
	case EnumVariant(_): return nil, false
	case Identifier(_): return nil, false
	case Comment(_): return nil, false
	case CommentGroup(_): return nil, false
	}
}

// statementList gets the child list from one source statement container.
func statementList(statement *syntax.Statement) ([]*syntax.Statement, bool) {
	if statement == nil {
		return nil, false
	}
	match *statement {
	case Block(value): return value.Value.List, true
	case Case(value): return value.Value.Body, true
	case Communication(value): return value.Value.Body, true
	case Bad(_): return nil, false
	case Declaration(_): return nil, false
	case Empty(_): return nil, false
	case Labeled(_): return nil, false
	case Expression(_): return nil, false
	case Send(_): return nil, false
	case Increment(_): return nil, false
	case Assignment(_): return nil, false
	case Go(_): return nil, false
	case Defer(_): return nil, false
	case Return(_): return nil, false
	case Branch(_): return nil, false
	case If(_): return nil, false
	case Switch(_): return nil, false
	case TypeSwitch(_): return nil, false
	case Select(_): return nil, false
	case For(_): return nil, false
	case Range(_): return nil, false
	case Match(_): return nil, false
	}
}

