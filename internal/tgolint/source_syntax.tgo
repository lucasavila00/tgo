// sourceUnparenthesized removes all outer source parentheses.
func sourceUnparenthesized(expression *syntax.Expression) *syntax.Expression {
	for expression != nil {
		match *expression {
		case Parenthesized(value): expression = value.Value.Expression
		case Bad(_): return expression
		case Identifier(_): return expression
		case Ellipsis(_): return expression
		case BasicLiteral(_): return expression
		case FunctionLiteral(_): return expression
		case CompositeLiteral(_): return expression
		case Selector(_): return expression
		case Index(_): return expression
		case IndexList(_): return expression
		case Slice(_): return expression
		case TypeAssertion(_): return expression
		case Call(_): return expression
		case Star(_): return expression
		case NonNilPointer(_): return expression
		case Unary(_): return expression
		case Binary(_): return expression
		case KeyValue(_): return expression
		case ArrayType(_): return expression
		case StructType(_): return expression
		case FunctionType(_): return expression
		case InterfaceType(_): return expression
		case MapType(_): return expression
		case ChannelType(_): return expression
		case Default(_): return expression
		case Propagation(_): return expression
		}
	}
	return nil
}

// sourceFunctionSignature finds the nearest source function around a node.
func sourceFunctionSignature(
	file *syntax.File,
	node *syntax.Node,
	index *sourcefacts.Index,
) *types.Signature {
	for current := node; current != nil; current = syntax.Parent(file, current) {
		position, ok := sourceFunctionPosition(current)
		if ok {
			return index.FunctionSignature(position)
		}
	}
	return nil
}

// sourceFunctionPosition gets a declaration or literal function position.
func sourceFunctionPosition(node *syntax.Node) (token.Pos, bool) {
	if node == nil {
		return token.NoPos, false
	}
	match *node {
	case Declaration(value): return declarationFunctionPosition(value.Value)
	case Expression(value): return expressionFunctionPosition(value.Value)
	case File(_): return token.NoPos, false
	case Specification(_): return token.NoPos, false
	case Statement(_): return token.NoPos, false
	case Field(_): return token.NoPos, false
	case FieldList(_): return token.NoPos, false
	case TGoField(_): return token.NoPos, false
	case EnumVariant(_): return token.NoPos, false
	case MatchCase(_): return token.NoPos, false
	case Identifier(_): return token.NoPos, false
	case Comment(_): return token.NoPos, false
	case CommentGroup(_): return token.NoPos, false
	}
}

// declarationFunctionPosition gets a named function position.
func declarationFunctionPosition(value *syntax.Declaration) (token.Pos, bool) {
	match *value {
	case Function(function): return function.Value.Start, true
	case Bad(_): return token.NoPos, false
	case General(_): return token.NoPos, false
	case Enum(_): return token.NoPos, false
	case Struct(_): return token.NoPos, false
	case Checked(_): return token.NoPos, false
	}
}

// expressionFunctionPosition gets a function literal position.
func expressionFunctionPosition(value *syntax.Expression) (token.Pos, bool) {
	match *value {
	case FunctionLiteral(function): return function.Value.Start, true
	case Bad(_): return token.NoPos, false
	case Identifier(_): return token.NoPos, false
	case Ellipsis(_): return token.NoPos, false
	case BasicLiteral(_): return token.NoPos, false
	case CompositeLiteral(_): return token.NoPos, false
	case Parenthesized(_): return token.NoPos, false
	case Selector(_): return token.NoPos, false
	case Index(_): return token.NoPos, false
	case IndexList(_): return token.NoPos, false
	case Slice(_): return token.NoPos, false
	case TypeAssertion(_): return token.NoPos, false
	case Call(_): return token.NoPos, false
	case Star(_): return token.NoPos, false
	case NonNilPointer(_): return token.NoPos, false
	case Unary(_): return token.NoPos, false
	case Binary(_): return token.NoPos, false
	case KeyValue(_): return token.NoPos, false
	case ArrayType(_): return token.NoPos, false
	case StructType(_): return token.NoPos, false
	case FunctionType(_): return token.NoPos, false
	case InterfaceType(_): return token.NoPos, false
	case MapType(_): return token.NoPos, false
	case ChannelType(_): return token.NoPos, false
	case Default(_): return token.NoPos, false
	case Propagation(_): return token.NoPos, false
	}
}

// sourceGeneralDeclaration gets one Go-style source declaration.
func sourceGeneralDeclaration(
	value *syntax.Declaration,
) (*syntax.GeneralDeclaration, bool) {
	match *value {
	case General(declaration): return declaration.Value, true
	case Bad(_): return nil, false
	case Function(_): return nil, false
	case Enum(_): return nil, false
	case Struct(_): return nil, false
	case Checked(_): return nil, false
	}
}

// sourceValueSpecification gets one const or variable source specification.
func sourceValueSpecification(
	value *syntax.Specification,
) (*syntax.ValueSpecification, bool) {
	match *value {
	case Value(specification): return specification.Value, true
	case Import(_): return nil, false
	case Type(_): return nil, false
	}
}
