package tgolint

import (
	"go/ast"
	"go/token"
	"go/types"
	"sort"
	"strconv"
	"strings"

	"golang.org/x/tools/go/analysis"
)

const nilContractVersion = 1

// nilContractWireFact carries non-nil pointer paths across packages.
type nilContractWireFact struct {
	Version int
	Paths   []string
}

// AFact marks nilContractWireFact as a Go analysis fact.
func (%nilContractWireFact) AFact() {}

type nilContract map[string]bool

func cloneNilContract(value nilContract) nilContract {
	if len(value) == 0 {
		return nil
	}
	result := make(nilContract, len(value))
	for path := range value {
		result[path] = true
	}
	return result
}

func addNilPath(target nilContract, prefix string, source nilContract) {
	for path := range source {
		if path == "" {
			target[prefix] = true
		} else {
			target[prefix+"/"+path] = true
		}
	}
}

func nilChild(source nilContract, prefix string) nilContract {
	result := make(nilContract)
	for path := range source {
		if path == prefix {
			result[""] = true
			continue
		}
		if rest, ok := strings.CutPrefix(path, prefix+"/"); ok {
			result[rest] = true
		}
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func nilWithoutChild(source nilContract, prefix string) nilContract {
	result := cloneNilContract(source)
	delete(result, prefix)
	for path := range result {
		if strings.HasPrefix(path, prefix+"/") {
			delete(result, path)
		}
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func nilContractFact(value nilContract) *nilContractWireFact {
	if len(value) == 0 {
		return nil
	}
	paths := make([]string, 0, len(value))
	for path := range value {
		paths = append(paths, path)
	}
	sort.Strings(paths)
	return &nilContractWireFact{Version: nilContractVersion, Paths: paths}
}

func decodeNilContract(fact *nilContractWireFact) nilContract {
	if fact == nil || fact.Version != nilContractVersion || len(fact.Paths) == 0 {
		return nil
	}
	result := make(nilContract, len(fact.Paths))
	previous := ""
	for index, path := range fact.Paths {
		if index > 0 && path <= previous {
			return nil
		}
		result[path] = true
		previous = path
	}
	return result
}

type nilEnvironment struct {
	pass      *analysis.Pass
	files     []*ast.File
	info      *types.Info
	pkg       *types.Package
	markers   map[token.Pos]bool
	contracts map[types.Object]nilContract
	parents   map[ast.Node]ast.Node
	reported  map[diagnosticKey]bool
}

func newNilEnvironment(
	pass *analysis.Pass,
	files []*ast.File,
	info *types.Info,
	pkg *types.Package,
	markers map[token.Pos]bool,
) %nilEnvironment {
	return &nilEnvironment{
		pass: pass, files: files, info: info, pkg: pkg, markers: markers,
		contracts: make(map[types.Object]nilContract),
		parents: make(map[ast.Node]ast.Node),
		reported: make(map[diagnosticKey]bool),
	}
}

// collectNilContracts records every declared `%T` contract in this package.
func (e %nilEnvironment) collectNilContracts() {
	for _, file := range e.files {
		e.addParents(file)
		ast.Inspect(file, func(node ast.Node) bool {
			specification, ok := node.(*ast.TypeSpec)
			if ok {
				e.setContract(
					e.info.Defs[specification.Name],
					e.declaredContract(specification.Type),
				)
			}
			return true
		})
	}
	for _, file := range e.files {
		ast.Inspect(file, func(node ast.Node) bool {
			switch node := node.(type) {
			case *ast.Field:
				e.collectFieldContract(node)
			case *ast.ValueSpec:
				e.collectValueContract(node)
			case *ast.FuncDecl:
				contract := e.functionContract(node.Type)
				if node.Recv != nil && len(node.Recv.List) == 1 {
					if contract == nil {
						contract = make(nilContract)
					}
					addNilPath(
						contract, "v",
						e.valueContract(node.Recv.List[0].Type),
					)
				}
				e.setContract(e.info.Defs[node.Name], contract)
			}
			return true
		})
	}
}

// valueContract adds contracts supplied by a named value type.
func (e %nilEnvironment) valueContract(expression ast.Expr) nilContract {
	result := cloneNilContract(e.declaredContract(expression))
	if result == nil {
		result = make(nilContract)
	}
	for path := range e.contractForType(e.info.TypeOf(expression)) {
		result[path] = true
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func (e %nilEnvironment) addParents(file *ast.File) {
	stack := []ast.Node(nil)
	ast.Inspect(file, func(node ast.Node) bool {
		if node == nil {
			stack = stack[:len(stack)-1]
			return false
		}
		if len(stack) != 0 {
			e.parents[node] = stack[len(stack)-1]
		}
		stack = append(stack, node)
		return true
	})
}

func (e %nilEnvironment) setContract(object types.Object, contract nilContract) {
	if object != nil && len(contract) != 0 {
		e.contracts[object] = contract
	}
}

func (e %nilEnvironment) collectFieldContract(field *ast.Field) {
	contract := e.valueContract(field.Type)
	for _, name := range field.Names {
		e.setContract(e.info.Defs[name], contract)
	}
	if len(field.Names) == 0 {
		e.setContract(e.info.Implicits[field], contract)
	}
}

func (e %nilEnvironment) collectValueContract(specification *ast.ValueSpec) {
	contract := e.valueContract(specification.Type)
	for _, name := range specification.Names {
		e.setContract(e.info.Defs[name], contract)
	}
}

func (e %nilEnvironment) functionContract(function *ast.FuncType) nilContract {
	if function == nil {
		return nil
	}
	result := make(nilContract)
	e.addFieldListContract(result, "p", function.Params)
	e.addFieldListContract(result, "r", function.Results)
	if len(result) == 0 {
		return nil
	}
	return result
}

func (e %nilEnvironment) addFieldListContract(
	target nilContract,
	prefix string,
	fields *ast.FieldList,
) {
	if fields == nil {
		return
	}
	index := 0
	for _, field := range fields.List {
		contract := e.valueContract(field.Type)
		count := len(field.Names)
		if count == 0 {
			count = 1
		}
		for range count {
			addNilPath(target, prefix+strconv.Itoa(index), contract)
			index++
		}
	}
}

func (e %nilEnvironment) declaredContract(expression ast.Expr) nilContract {
	if expression == nil {
		return nil
	}
	result := make(nilContract)
	switch expression := expression.(type) {
	case *ast.ParenExpr:
		return e.declaredContract(expression.X)
	case *ast.StarExpr:
		if e.markers[expression.Star] {
			result[""] = true
		}
		addNilPath(result, "e", e.declaredContract(expression.X))
	case *ast.ArrayType:
		addNilPath(result, "e", e.declaredContract(expression.Elt))
	case *ast.MapType:
		addNilPath(result, "k", e.declaredContract(expression.Key))
		addNilPath(result, "v", e.declaredContract(expression.Value))
	case *ast.ChanType:
		addNilPath(result, "e", e.declaredContract(expression.Value))
	case *ast.StructType:
		for index, field := range expression.Fields.List {
			addNilPath(
				result, "f"+strconv.Itoa(index), e.declaredContract(field.Type),
			)
		}
	case *ast.FuncType:
		return e.functionContract(expression)
	case *ast.Ellipsis:
		addNilPath(result, "e", e.declaredContract(expression.Elt))
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func (e %nilEnvironment) contractForObject(object types.Object) nilContract {
	if object == nil {
		return nil
	}
	if contract := e.contracts[object]; len(contract) != 0 {
		return contract
	}
	fact := new(nilContractWireFact)
	if object.Pkg() != nil && object.Pkg() != e.pkg && e.pass.ImportObjectFact(object, fact) {
		contract := decodeNilContract(fact)
		if len(contract) != 0 {
			e.contracts[object] = contract
			return contract
		}
	}
	if _, typeName := object.(*types.TypeName); typeName {
		return nil
	}
	return e.contractForType(object.Type())
}

func (e %nilEnvironment) contractForType(typ types.Type) nilContract {
	if typ == nil {
		return nil
	}
	if alias, ok := typ.(*types.Alias); ok {
		if contract := e.contractForObject(alias.Obj()); len(contract) != 0 {
			return contract
		}
		typ = alias.Rhs()
	}
	if named, ok := typ.(*types.Named); ok {
		return e.contractForObject(named.Obj())
	}
	result := make(nilContract)
	switch typ := typ.(type) {
	case *types.Pointer:
		addNilPath(result, "e", e.contractForType(typ.Elem()))
	case *types.Array:
		addNilPath(result, "e", e.contractForType(typ.Elem()))
	case *types.Slice:
		addNilPath(result, "e", e.contractForType(typ.Elem()))
	case *types.Map:
		addNilPath(result, "k", e.contractForType(typ.Key()))
		addNilPath(result, "v", e.contractForType(typ.Elem()))
	case *types.Chan:
		addNilPath(result, "e", e.contractForType(typ.Elem()))
	case *types.Struct:
		for index := range typ.NumFields() {
			field := typ.Field(index)
			contract := e.contractForObject(field)
			if len(contract) == 0 {
				contract = e.contractForType(field.Type())
			}
			addNilPath(result, "f"+strconv.Itoa(index), contract)
		}
	case *types.Signature:
		if typ.Recv() != nil {
			addNilPath(result, "v", e.contractForObject(typ.Recv()))
		}
		e.addTupleTypeContract(result, "p", typ.Params())
		e.addTupleTypeContract(result, "r", typ.Results())
	}
	if len(result) == 0 {
		return nil
	}
	return result
}

func (e %nilEnvironment) addTupleTypeContract(
	target nilContract,
	prefix string,
	tuple *types.Tuple,
) {
	if tuple == nil {
		return
	}
	for index := range tuple.Len() {
		item := tuple.At(index)
		contract := e.contractForObject(item)
		if len(contract) == 0 {
			contract = e.contractForType(item.Type())
		}
		addNilPath(target, prefix+strconv.Itoa(index), contract)
	}
}

func (e %nilEnvironment) exportContracts(target *analysis.Pass) {
	for object, contract := range e.contracts {
		mapped := mapNilObject(object, e.pkg, target.Pkg)
		fact := nilContractFact(contract)
		if mapped == nil || fact == nil || !mapped.Exported() {
			continue
		}
		target.ExportObjectFact(mapped, fact)
	}
}

func mapNilObject(
	object types.Object,
	from *types.Package,
	to *types.Package,
) types.Object {
	if object == nil || from == nil || to == nil || object.Pkg() != from {
		return nil
	}
	if object.Parent() == from.Scope() {
		return to.Scope().Lookup(object.Name())
	}
	function, ok := object.(*types.Func)
	if !ok {
		return nil
	}
	signature, ok := function.Type().(*types.Signature)
	if !ok || signature.Recv() == nil {
		return nil
	}
	receiver := signature.Recv().Type()
	if pointer, ok := receiver.(*types.Pointer); ok {
		receiver = pointer.Elem()
	}
	named, ok := receiver.(*types.Named)
	if !ok {
		return nil
	}
	targetName := to.Scope().Lookup(named.Obj().Name())
	if targetName == nil {
		return nil
	}
	targetType := targetName.Type()
	if _, pointer := signature.Recv().Type().(*types.Pointer); pointer {
		targetType = types.NewPointer(targetType)
	}
	mapped, _, _ := types.LookupFieldOrMethod(targetType, true, to, object.Name())
	return mapped
}
