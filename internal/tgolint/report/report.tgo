// Package report applies source directives to tgolint diagnostics.
package report

import (
	"fmt"
	"go/token"
	"os"
	"path/filepath"
	"strings"

	"tgo/pkg/syntax"

	"golang.org/x/tools/go/analysis"
)

const ignoreLineDirective = "tgolint:ignore"
const ignoreFileDirective = "tgolint:ignore-file"

type diagnosticSuppressions struct {
	files map[string]bool
	lines map[string]map[int]bool
}

type diagnosticKey struct {
	position token.Pos
	message  string
}

// Reporter collects diagnostics and emits each position and message once.
type Reporter struct {
	pass     %analysis.Pass
	reported map[diagnosticKey]bool
}

// New creates a diagnostic reporter for one analysis pass.
func New(pass *analysis.Pass) %Reporter {
	if pass == nil {
		panic("diagnostic reporter received a nil analysis pass")
	}
	return &Reporter{
		pass: pass,
		reported: make(map[diagnosticKey]bool),
	}
}

// Reportf emits one diagnostic once at its source position.
func (r *Reporter) Reportf(
	position token.Pos,
	format string,
	arguments ...any,
) {
	message := fmt.Sprintf(format, arguments...)
	key := diagnosticKey{position: position, message: message}
	if r.reported[key] {
		return
	}
	r.reported[key] = true
	r.pass.Reportf(position, "%s", message)
}

// Filter returns a pass that filters diagnostics with source directives.
func Filter(pass *analysis.Pass) *analysis.Pass {
	if pass == nil {
		return nil
	}
	suppressions := collectDiagnosticSuppressions(pass)
	originalReport := pass.Report
	pass.Report = func(diagnostic analysis.Diagnostic) {
		if !suppressions.contains(pass, diagnostic.Pos) {
			originalReport(diagnostic)
		}
	}
	return pass
}

// collectDiagnosticSuppressions reads fixed line and file directives.
func collectDiagnosticSuppressions(pass %analysis.Pass) diagnosticSuppressions {
	result := diagnosticSuppressions{
		files: make(map[string]bool),
		lines: make(map[string]map[int]bool),
	}
	for _, file := range pass.Files {
		filename := pass.Fset.Position(file.Package).Filename
		for _, group := range file.Comments {
			for _, comment := range group.List {
				if !strings.HasPrefix(comment.Text, "//") {
					continue
				}
				directive := strings.TrimSpace(strings.TrimPrefix(comment.Text, "//"))
				switch directive {
				case ignoreFileDirective:
					result.files[filename] = true
				case ignoreLineDirective:
					line := pass.Fset.Position(comment.Slash).Line
					result.addLine(filename, line)
					result.addLine(filename, line+1)
				}
			}
		}
	}
	result.addTGoFiles(pass)
	return result
}

// addTGoFiles reads directives from TGo source beside the loaded Go files.
func (s diagnosticSuppressions) addTGoFiles(pass %analysis.Pass) {
	directories := make(map[string]bool)
	for _, file := range pass.Files {
		filename := pass.Fset.Position(file.Package).Filename
		directories[filepath.Dir(filename)] = true
	}
	for directory := range directories {
		paths, err := filepath.Glob(filepath.Join(directory, "*.tgo"))
		if err != nil {
			continue
		}
		for _, path := range paths {
			data, err := os.ReadFile(path)
			if err == nil {
				s.addSource(path, data)
			}
		}
	}
}

// addSource reads directives from the TGo syntax tree.
func (s diagnosticSuppressions) addSource(filename string, data []byte) {
	files := token.NewFileSet()
	file, _ := syntax.ParseFile(files, filename, data, syntax.ParseComments)
	if file == nil {
		return
	}
	for _, group := range file.Comments {
		for _, comment := range group.List {
			if !strings.HasPrefix(comment.Text, "//") {
				continue
			}
			directive := strings.TrimSpace(strings.TrimPrefix(comment.Text, "//"))
			switch directive {
			case ignoreFileDirective:
				s.files[filename] = true
			case ignoreLineDirective:
				line := files.Position(comment.Start).Line
				s.addLine(filename, line)
				s.addLine(filename, line+1)
			}
		}
	}
}

// addLine records one source line with a suppressed diagnostic.
func (s diagnosticSuppressions) addLine(filename string, line int) {
	if s.lines[filename] == nil {
		s.lines[filename] = make(map[int]bool)
	}
	s.lines[filename][line] = true
}

// contains reports whether a source position has an active directive.
func (s diagnosticSuppressions) contains(pass %analysis.Pass, position token.Pos) bool {
	source := pass.Fset.Position(position)
	return s.files[source.Filename] || s.lines[source.Filename][source.Line]
}
