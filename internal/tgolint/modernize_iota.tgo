package tgolint

import (
	"go/ast"
	"go/constant"
	"go/token"
	"go/types"

	"tgo/internal/compiler"
)

type iotaCandidate struct {
	name      string
	values    []constant.Value
	position  token.Pos
	allIota   bool
	bitSet    bool
}

// checkIotaModernization reports open integer sets in handwritten TGo source.
func (c %checker) checkIotaModernization(analysis *compiler.AnalysisPackage) {
	if analysis == nil {
		return
	}
	for _, file := range analysis.Files {
		for _, declaration := range file.Decls {
			group, ok := declaration.(*ast.GenDecl)
			if ok && group.Tok == token.CONST {
				c.checkIotaGroup(group, analysis.Info)
			}
		}
	}
}

// checkIotaGroup reports each defined integer type that forms one closed list.
func (c %checker) checkIotaGroup(group *ast.GenDecl, info *types.Info) {
	candidates := make(map[*types.Named]%iotaCandidate)
	ordered := make([]%iotaCandidate, 0)
	values := []ast.Expr(nil)
	for _, specification := range group.Specs {
		item, ok := specification.(*ast.ValueSpec)
		if !ok {
			continue
		}
		if len(item.Values) != 0 {
			values = item.Values
		}
		for index, identifier := range item.Names {
			if identifier.Name == "_" || index >= len(values) {
				continue
			}
			object, ok := info.Defs[identifier].(*types.Const)
			if !ok {
				continue
			}
			typ, ok := object.Type().(*types.Named)
			if !ok || !integerNamedType(typ) {
				continue
			}
			candidate, created := iotaCandidateFor(candidates, typ)
			if created {
				ordered = append(ordered, candidate)
			}
			position, usesIota := iotaPosition(values[index], info)
			candidate.values = append(candidate.values, object.Val())
			candidate.allIota = candidate.allIota && usesIota
			candidate.bitSet = candidate.bitSet ||
				(usesIota && hasBitSetOperator(values[index]))
			if candidate.position == token.NoPos && usesIota {
				candidate.position = position
			}
		}
	}
	for _, candidate := range ordered {
		if iotaEnumCandidate(candidate) {
			c.pass.Reportf(
				candidate.position,
				"%s is an iota enum; use a TGo enum to close its variants",
				candidate.name,
			)
		}
	}
}

// iotaCandidateFor returns the one candidate for a defined type.
func iotaCandidateFor(
	candidates map[*types.Named]%iotaCandidate,
	typ *types.Named,
) (%iotaCandidate, bool) {
	if candidate, found := candidates[typ]; found {
		return candidate, false
	}
	candidate := &iotaCandidate{
		name: typ.Obj().Name(), values: nil, position: token.NoPos,
		allIota: true, bitSet: false,
	}
	candidates[typ] = candidate
	return candidate, true
}

// integerNamedType reports whether a type is a defined integer type.
func integerNamedType(typ *types.Named) bool {
	basic, ok := typ.Underlying().(*types.Basic)
	return ok && basic.Info()&types.IsInteger != 0
}

// iotaPosition finds the predeclared iota in one constant expression.
func iotaPosition(expression ast.Expr, info *types.Info) (token.Pos, bool) {
	position := token.NoPos
	ast.Inspect(expression, func(node ast.Node) bool {
		identifier, ok := node.(*ast.Ident)
		if ok && info.Uses[identifier] == types.Universe.Lookup("iota") {
			position = identifier.Pos()
			return false
		}
		return position == token.NoPos
	})
	return position, position != token.NoPos
}

// hasBitSetOperator excludes constant expressions that build bit masks.
func hasBitSetOperator(expression ast.Expr) bool {
	found := false
	ast.Inspect(expression, func(node ast.Node) bool {
		switch item := node.(type) {
		case *ast.BinaryExpr:
			switch item.Op {
			case token.SHL, token.SHR, token.OR, token.AND, token.XOR, token.AND_NOT:
				found = true
			}
		case *ast.UnaryExpr:
			if item.Op == token.XOR {
				found = true
			}
		}
		return !found
	})
	return found
}

// iotaEnumCandidate checks the typed values and the expression source.
func iotaEnumCandidate(candidate %iotaCandidate) bool {
	if len(candidate.values) < 2 || candidate.position == token.NoPos ||
		!candidate.allIota || candidate.bitSet {
		return false
	}
	for index, value := range candidate.values {
		if value.Kind() != constant.Int {
			return false
		}
		if index == 0 {
			continue
		}
		expected := constant.BinaryOp(
			candidate.values[index-1], token.ADD, constant.MakeInt64(1),
		)
		if constant.Compare(value, token.NEQ, expected) {
			return false
		}
	}
	return true
}
