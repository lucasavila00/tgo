package tgolint

type model enum {
	Checked struct { Package string; Name string }
	Enum struct { Package string; Name string; Variants []string }
	Mixed struct{}
	Parameter struct{}
}

// modelWireFact is the stable fact format used by go/analysis.
// The checker decodes it before it uses the model.
type modelWireFact struct {
	Kind     uint8
	Package  string
	Name     string
	Variants []string
}

// AFact marks modelWireFact as a Go analysis fact.
func (%modelWireFact) AFact() {}

const (
	checkedModelWire uint8 = 1
	enumModelWire    uint8 = 2
)

func checkedModel(packagePath string, name string) %model {
	value := model.Checked{Package: packagePath, Name: name}
	return &value
}

func enumModel(packagePath string, name string, variants []string) %model {
	value := model.Enum{
		Package: packagePath, Name: name, Variants: variants,
	}
	return &value
}

func mixedModel() %model {
	value := model.Mixed{}
	return &value
}

func parameterModel() %model {
	value := model.Parameter{}
	return &value
}

func modelDescription(value *model) (string, string) {
	if value == nil {
		return "", ""
	}
	switch enumValue13 := *value; enumValue13.TgoTag() {
	case 1:
		checked := enumValue13.TgoChecked()
		return "checked", checked.Name
	case 2:
		enum := enumValue13.TgoEnum()
		return "enum", enum.Name
	case 3:
		return "", ""
	case 4:
		return "generic", "type argument"
	default:
		panic("invalid model variant")
	}
}

func modelKind(value *model) string {
	kind, _ := modelDescription(value)
	return kind
}

func modelName(value *model) string {
	_, name := modelDescription(value)
	return name
}

func modelPackage(value *model) string {
	if value == nil {
		return ""
	}
	switch enumValue14 := *value; enumValue14.TgoTag() {
	case 1:
		checked := enumValue14.TgoChecked()
		return checked.Package
	case 2:
		enum := enumValue14.TgoEnum()
		return enum.Package
	case 3:
		return ""
	case 4:
		return ""
	default:
		panic("invalid model variant")
	}
}

func modelVariants(value *model) []string {
	if value == nil {
		return nil
	}
	switch enumValue15 := *value; enumValue15.TgoTag() {
	case 1:
		return nil
	case 2:
		enum := enumValue15.TgoEnum()
		return enum.Variants
	case 3:
		return nil
	case 4:
		return nil
	default:
		panic("invalid model variant")
	}
}

func modelIsChecked(value *model) bool {
	if value == nil {
		return false
	}
	switch enumValue16 := *value; enumValue16.TgoTag() {
	case 1:
		return true
	case 2:
		return false
	case 3:
		return false
	case 4:
		return false
	default:
		panic("invalid model variant")
	}
}

func modelIsEnum(value *model) bool {
	if value == nil {
		return false
	}
	switch enumValue17 := *value; enumValue17.TgoTag() {
	case 1:
		return false
	case 2:
		return true
	case 3:
		return false
	case 4:
		return false
	default:
		panic("invalid model variant")
	}
}

func modelIsMixed(value *model) bool {
	if value == nil {
		return false
	}
	switch enumValue18 := *value; enumValue18.TgoTag() {
	case 1:
		return false
	case 2:
		return false
	case 3:
		return true
	case 4:
		return false
	default:
		panic("invalid model variant")
	}
}

func sameModel(left *model, right *model) bool {
	if left == nil || right == nil {
		return left == right
	}
	if modelIsChecked(left) {
		return modelIsChecked(right) && modelPackage(left) == modelPackage(right) &&
			modelName(left) == modelName(right)
	}
	if modelIsEnum(left) {
		return modelIsEnum(right) && modelPackage(left) == modelPackage(right) &&
			modelName(left) == modelName(right)
	}
	if modelIsMixed(left) {
		return modelIsMixed(right)
	}
	return modelIsParameter(right)
}

func modelIsParameter(value *model) bool {
	if value == nil {
		return false
	}
	switch enumValue19 := *value; enumValue19.TgoTag() {
	case 1:
		return false
	case 2:
		return false
	case 3:
		return false
	case 4:
		return true
	default:
		panic("invalid model variant")
	}
}

// encodeModelFact converts the internal ADT to its package fact form.
func encodeModelFact(value *model) *modelWireFact {
	if value == nil {
		return nil
	}
	switch enumValue20 := *value; enumValue20.TgoTag() {
	case 1:
		checked := enumValue20.TgoChecked()
		return &modelWireFact{
			Kind: checkedModelWire, Package: checked.Package,
			Name: checked.Name, Variants: nil,
		}
	case 2:
		enum := enumValue20.TgoEnum()
		return &modelWireFact{
			Kind: enumModelWire, Package: enum.Package, Name: enum.Name,
			Variants: append([]string(nil), enum.Variants...),
		}
	case 3:
		return nil
	case 4:
		return nil
	default:
		panic("invalid model variant")
	}
}

// decodeModelFact validates a wire fact before it enters the checker.
func decodeModelFact(fact *modelWireFact, expectedPackage string) *model {
	if fact == nil || fact.Package != expectedPackage || fact.Name == "" {
		return nil
	}
	switch fact.Kind {
	case checkedModelWire:
		if len(fact.Variants) == 0 {
			return checkedModel(fact.Package, fact.Name)
		}
	case enumModelWire:
		if len(fact.Variants) != 0 {
			return enumModel(
				fact.Package, fact.Name, append([]string(nil), fact.Variants...),
			)
		}
	}
	return nil
}
