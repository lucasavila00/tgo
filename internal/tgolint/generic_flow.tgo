package tgolint

import (
	"go/ast"
	"go/constant"
	"go/token"
	"go/types"
	"sort"

	"golang.org/x/tools/go/cfg"
)

type effectOutcome enum {
	Unknown struct{}
	Never struct{}
	Always struct{}
	Conditional struct{}
}

func unknownEffectOutcome() effectOutcome { return effectOutcome.Unknown{} }
func neverEffectOutcome() effectOutcome { return effectOutcome.Never{} }
func alwaysEffectOutcome() effectOutcome { return effectOutcome.Always{} }
func conditionalEffectOutcome() effectOutcome { return effectOutcome.Conditional{} }

// reachableNodes returns AST nodes from live CFG blocks.
func (c %checker) reachableNodes(body *ast.BlockStmt) map[ast.Node]bool {
	reachable := make(map[ast.Node]bool)
	graph := cfg.New(body, c.callMayReturn)
	for _, block := range graph.Blocks {
		if !block.Live {
			continue
		}
		for _, node := range block.Nodes {
			reachable[node] = true
		}
	}
	return reachable
}

func (c %checker) markGenericZeroAt(
	summary %genericEffectSummary,
	node ast.Node,
	typ types.Type,
) {
	c.markGenericZeroWith(summary, node, typ, nil, false)
}

// markGenericZeroWith adds one zero effect with its path conditions.
func (c %checker) markGenericZeroWith(
	summary %genericEffectSummary,
	node ast.Node,
	typ types.Type,
	extra *genericEffectCondition,
	unknown bool,
) {
	conditions, maySkip, reachable := c.genericEffectPath(summary, node)
	if !reachable {
		return
	}
	if extra != nil {
		conditions = append(conditions, *extra)
	}
	effect := genericEffect{
		Receiver: false, TypeParameter: 0,
		Conditions: conditions, MaySkip: maySkip || unknown,
	}
	for parameter := range zeroTypeParameters(typ, summary.parameters, make(map[types.Type]bool)) {
		c.addGenericEffect(summary, true, parameter, effect)
	}
}

func (c %checker) markConditionalGenericZero(
	summary %genericEffectSummary,
	node ast.Node,
	typ types.Type,
	kind effectKind,
	value ast.Expr,
	other ast.Expr,
) {
	valueIndex, valueOK := c.expressionParameter(summary, value)
	otherIndex, otherOK := -1, true
	if other != nil {
		otherIndex, otherOK = c.expressionParameter(summary, other)
	}
	if !valueOK || !otherOK ||
		!c.parameterStableBefore(summary, valueIndex, node.Pos()) ||
		(otherIndex >= 0 && !c.parameterStableBefore(summary, otherIndex, node.Pos())) {
		c.markGenericZeroWith(summary, node, typ, nil, true)
		return
	}
	condition := genericEffectCondition{
		ValueParameter: valueIndex,
		OtherParameter: otherIndex,
		Kind:           kind,
		Expected:       true,
	}
	c.markGenericZeroWith(summary, node, typ, &condition, false)
}

func (c %checker) expressionParameter(
	summary %genericEffectSummary,
	expression ast.Expr,
) (int, bool) {
	name, ok := expression.(*ast.Ident)
	if !ok {
		return 0, false
	}
	return c.valueParameter(summary, c.pass.TypesInfo.ObjectOf(name))
}

// parameterStableBefore rejects a condition after mutation or escape.
func (c %checker) parameterStableBefore(
	summary %genericEffectSummary,
	index int,
	before token.Pos,
) bool {
	if _, returned := summary.root.(*ast.FuncLit); returned {
		return false
	}
	signature := summary.function.Type().(*types.Signature)
	if index < 0 || index >= signature.Params().Len() {
		return false
	}
	object := signature.Params().At(index)
	stable := true
	ast.Inspect(summary.body, func(node ast.Node) bool {
		if node == nil || node.Pos() >= before || !stable {
			return false
		}
		changed, descend := parameterChangedAt(c.pass.TypesInfo, node, object)
		stable = !changed
		return stable && descend
	})
	return stable
}

func parameterChangedAt(
	info *types.Info,
	node ast.Node,
	object types.Object,
) (bool, bool) {
	switch node := node.(type) {
	case *ast.FuncLit:
		return astCapturesObject(info, node.Body, object), false
	case *ast.AssignStmt:
		for _, target := range node.Lhs {
			if expressionUsesObject(info, target, object) {
				return true, false
			}
		}
	case *ast.IncDecStmt:
		return expressionUsesObject(info, node.X, object), true
	case *ast.RangeStmt:
		return expressionUsesObject(info, node.Key, object) ||
			expressionUsesObject(info, node.Value, object), true
	case *ast.UnaryExpr:
		return node.Op == token.AND && expressionUsesObject(info, node.X, object), true
	case *ast.CallExpr:
		return callUsesObject(info, node, object), true
	}
	return false, true
}

func expressionUsesObject(info *types.Info, expression ast.Expr, object types.Object) bool {
	used := false
	ast.Inspect(expression, func(node ast.Node) bool {
		name, ok := node.(*ast.Ident)
		if ok && info.ObjectOf(name) == object {
			used = true
			return false
		}
		return !used
	})
	return used
}

func callUsesObject(info *types.Info, call *ast.CallExpr, object types.Object) bool {
	if name, ok := call.Fun.(*ast.Ident); ok && (name.Name == "len" || name.Name == "cap") {
		if _, builtin := info.Uses[name].(*types.Builtin); builtin {
			return false
		}
	}
	if scalarEscapesInExpression(info, call.Fun, object) {
		return true
	}
	for _, argument := range call.Args {
		if expressionUsesObject(info, argument, object) {
			if variable, ok := object.(*types.Var); ok &&
				(isBoolean(variable.Type()) || isInteger(variable.Type())) &&
				!scalarEscapesInExpression(info, argument, object) {
				continue
			}
			return true
		}
	}
	return false
}

// scalarEscapesInExpression finds address and pointer-receiver escapes.
func scalarEscapesInExpression(
	info *types.Info,
	expression ast.Expr,
	object types.Object,
) bool {
	escapes := false
	ast.Inspect(expression, func(node ast.Node) bool {
		switch node := node.(type) {
		case *ast.UnaryExpr:
			if node.Op == token.AND && expressionUsesObject(info, node.X, object) {
				escapes = true
				return false
			}
		case *ast.FuncLit:
			if astCapturesObject(info, node.Body, object) {
				escapes = true
				return false
			}
		case *ast.SelectorExpr:
			if pointerMethodSelection(info, node) &&
				expressionUsesObject(info, node.X, object) {
				escapes = true
				return false
			}
		}
		return !escapes
	})
	return escapes
}

func pointerMethodSelection(info *types.Info, selector *ast.SelectorExpr) bool {
	selection := info.Selections[selector]
	if selection == nil || selection.Kind() == types.FieldVal {
		return false
	}
	function, ok := selection.Obj().(*types.Func)
	if !ok {
		return false
	}
	signature, ok := function.Type().(*types.Signature)
	if !ok || signature.Recv() == nil {
		return false
	}
	_, pointer := types.Unalias(signature.Recv().Type()).(*types.Pointer)
	return pointer
}

func (c %checker) markGenericAccessAt(
	summary %genericEffectSummary,
	node ast.Node,
	typ types.Type,
) {
	conditions, maySkip, reachable := c.genericEffectPath(summary, node)
	if !reachable {
		return
	}
	effect := genericEffect{
		Receiver: false, TypeParameter: 0, Conditions: conditions, MaySkip: maySkip,
	}
	for parameter := range containedTypeParameters(
		typ,
		summary.parameters,
		make(map[types.Type]bool),
	) {
		c.addGenericEffect(summary, false, parameter, effect)
	}
}

// addGenericEffect normalizes and deduplicates one summary effect.
func (c %checker) addGenericEffect(
	summary %genericEffectSummary,
	zero bool,
	parameter zeroParameter,
	effect genericEffect,
) bool {
	effect.Receiver = parameter.receiver
	effect.TypeParameter = parameter.index
	normalized, possible := normalizeGenericEffect(effect)
	if !possible {
		return false
	}
	effect = normalized
	target := &summary.accessEffects
	if zero {
		target = &summary.zeroEffects
	}
	for _, current := range *target {
		if equalGenericEffect(current, effect) {
			return false
		}
	}
	*target = append(*target, effect)
	return true
}

// normalizeGenericEffect sorts conditions and rejects contradictions.
func normalizeGenericEffect(effect genericEffect) (genericEffect, bool) {
	sort.Slice(effect.Conditions, func(left, right int) bool {
		if effect.Conditions[left].ValueParameter !=
			effect.Conditions[right].ValueParameter {
			return effect.Conditions[left].ValueParameter <
				effect.Conditions[right].ValueParameter
		}
		leftKind := effectConditionCode(effect.Conditions[left].Kind)
		rightKind := effectConditionCode(effect.Conditions[right].Kind)
		if leftKind != rightKind {
			return leftKind < rightKind
		}
		if effect.Conditions[left].OtherParameter !=
			effect.Conditions[right].OtherParameter {
			return effect.Conditions[left].OtherParameter <
				effect.Conditions[right].OtherParameter
		}
		return !effect.Conditions[left].Expected && effect.Conditions[right].Expected
	})
	output := effect.Conditions[:0]
	for _, condition := range effect.Conditions {
		if len(output) == 0 {
			output = append(output, condition)
			continue
		}
		previous := output[len(output)-1]
		if previous.ValueParameter != condition.ValueParameter ||
			previous.OtherParameter != condition.OtherParameter ||
			effectConditionCode(previous.Kind) != effectConditionCode(condition.Kind) {
			output = append(output, condition)
			continue
		}
		if previous.Expected != condition.Expected {
			return noGenericEffect(), false
		}
	}
	effect.Conditions = output
	return effect, true
}

func equalGenericEffect(left, right genericEffect) bool {
	if left.Receiver != right.Receiver || left.TypeParameter != right.TypeParameter ||
		left.MaySkip != right.MaySkip || len(left.Conditions) != len(right.Conditions) {
		return false
	}
	for index := range left.Conditions {
		if left.Conditions[index] != right.Conditions[index] {
			return false
		}
	}
	return true
}

// genericEffectPath gets conditions that guard one operation.
func (c %checker) genericEffectPath(
	summary %genericEffectSummary,
	node ast.Node,
) ([]genericEffectCondition, bool, bool) {
	reachable := false
	var conditions []genericEffectCondition = nil
	maySkip := false
	current := node
	for current != nil && current != summary.root {
		if summary.reachable[current] {
			reachable = true
		}
		if c.parents[current] == summary.root {
			current = summary.root
			continue
		}
		path, unknown, possible := c.parentEffectConditions(
			summary,
			c.parents[current],
			current,
		)
		if !possible {
			return nil, false, false
		}
		conditions = append(conditions, path...)
		maySkip = maySkip || unknown
		current = c.parents[current]
	}
	return conditions, maySkip, reachable
}

func (c %checker) parentEffectConditions(
	summary %genericEffectSummary,
	parent ast.Node,
	node ast.Node,
) ([]genericEffectCondition, bool, bool) {
	switch parent := parent.(type) {
	case *ast.FuncLit:
		return nil, false, false
	case *ast.BlockStmt:
		return c.blockEffectConditions(summary, parent, node)
	case *ast.IfStmt:
		condition, outcome := c.ifEffectCondition(parent, node)
		if outcome == neverEffectOutcome() {
			return nil, false, false
		}
		if outcome == conditionalEffectOutcome() {
			return []genericEffectCondition{*condition}, false, true
		}
		return nil, outcome == unknownEffectOutcome(), true
	case *ast.RangeStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.SelectStmt:
		return nil, true, true
	case *ast.ForStmt:
		if parent.Cond == nil {
			return nil, false, true
		}
		value := c.pass.TypesInfo.Types[parent.Cond].Value
		unknown := value == nil || value.Kind() != constant.Bool || !constant.BoolVal(value)
		return nil, unknown, true
	default:
		return nil, false, true
	}
}

func (c %checker) blockEffectConditions(
	summary %genericEffectSummary,
	block *ast.BlockStmt,
	node ast.Node,
) ([]genericEffectCondition, bool, bool) {
	var conditions []genericEffectCondition = nil
	unknown := false
	for _, statement := range block.List {
		if statement.Pos() >= node.Pos() {
			break
		}
		conditional, ok := statement.(*ast.IfStmt)
		if !ok {
			switch statement.(type) {
			case *ast.ForStmt, *ast.RangeStmt, *ast.SwitchStmt,
				*ast.TypeSwitchStmt, *ast.SelectStmt, *ast.BranchStmt,
				*ast.LabeledStmt, *ast.BlockStmt:
				unknown = true
			}
			continue
		}
		trueStops := c.astStatementsTerminate(conditional.Body.List)
		falseStops := conditional.Else != nil &&
			c.astStatementsTerminate([]ast.Stmt{conditional.Else})
		if trueStops == falseStops {
			continue
		}
		condition, outcome := c.booleanEffectCondition(conditional.Cond, falseStops)
		switch enumValue3 := outcome; enumValue3.Tag() {
		case effectOutcomeTagNever:
			return nil, false, false
		case effectOutcomeTagConditional:
			conditions = append(conditions, *condition)
		case effectOutcomeTagUnknown:
			unknown = true
		case effectOutcomeTagAlways:
		exhaustive:
		}
	}
	return conditions, unknown, true
}

func (c %checker) ifEffectCondition(
	statement *ast.IfStmt,
	node ast.Node,
) (*genericEffectCondition, effectOutcome) {
	inBody := node.Pos() >= statement.Body.Pos() && node.End() <= statement.Body.End()
	inElse := statement.Else != nil && node.Pos() >= statement.Else.Pos() &&
		node.End() <= statement.Else.End()
	if !inBody && !inElse {
		return nil, alwaysEffectOutcome()
	}
	return c.booleanEffectCondition(statement.Cond, inBody)
}

func (c %checker) booleanEffectCondition(
	expression ast.Expr,
	wantTrue bool,
) (*genericEffectCondition, effectOutcome) {
	if value, known := c.scalarValueAt(expression, expression); known {
		if boolean, constantValue := scalarBoolean(value); constantValue {
			if boolean == wantTrue {
				return nil, alwaysEffectOutcome()
			}
			return nil, neverEffectOutcome()
		}
		index, negated, parameter := scalarParameter(value)
		if parameter {
			return &genericEffectCondition{
				ValueParameter: index, OtherParameter: -1,
				Kind: booleanEffectCondition(), Expected: wantTrue != negated,
			}, conditionalEffectOutcome()
		}
	}
	if value := c.pass.TypesInfo.Types[expression].Value; value != nil &&
		value.Kind() == constant.Bool {
		if constant.BoolVal(value) == wantTrue {
			return nil, alwaysEffectOutcome()
		}
		return nil, neverEffectOutcome()
	}
	return nil, unknownEffectOutcome()
}

func (c %checker) nonzeroEffectCondition(
	expression ast.Expr,
) (*genericEffectCondition, effectOutcome) {
	if value, known := c.scalarValueAt(expression, expression); known {
		if integer, constantValue := scalarInteger(value); constantValue {
			if integer == 0 {
				return nil, neverEffectOutcome()
			}
			return nil, alwaysEffectOutcome()
		}
		index, _, parameter := scalarParameter(value)
		if parameter {
			return &genericEffectCondition{
				ValueParameter: index, OtherParameter: -1,
				Kind: nonzeroEffectConditionKind(), Expected: true,
			}, conditionalEffectOutcome()
		}
	}
	if value := c.pass.TypesInfo.Types[expression].Value; value != nil &&
		value.Kind() == constant.Int {
		if constant.Sign(value) == 0 {
			return nil, neverEffectOutcome()
		}
		return nil, alwaysEffectOutcome()
	}
	return nil, unknownEffectOutcome()
}

func (c %checker) valueParameter(
	summary %genericEffectSummary,
	object types.Object,
) (int, bool) {
	signature := summary.function.Type().(*types.Signature)
	for index := 0; index < signature.Params().Len(); index++ {
		if signature.Params().At(index) == object {
			return index, true
		}
	}
	return 0, false
}

func zeroTypeParameters(
	typ types.Type,
	parameters map[*types.TypeParam]zeroParameter,
	seen map[types.Type]bool,
) map[zeroParameter]bool {
	result := make(map[zeroParameter]bool)
	if typ == nil {
		return result
	}
	typ = types.Unalias(typ)
	if seen[typ] {
		return result
	}
	seen[typ] = true
	switch typ := typ.(type) {
	case *types.TypeParam:
		if parameter, ok := parameters[typ]; ok {
			result[parameter] = true
		}
	case *types.Named:
		mergeZeroParameters(result, zeroTypeParameters(typ.Underlying(), parameters, seen))
	case *types.Struct:
		for index := 0; index < typ.NumFields(); index++ {
			mergeZeroParameters(
				result,
				zeroTypeParameters(typ.Field(index).Type(), parameters, seen),
			)
		}
	case *types.Array:
		if typ.Len() > 0 {
			mergeZeroParameters(result, zeroTypeParameters(typ.Elem(), parameters, seen))
		}
	}
	return result
}

func mergeZeroParameters(target, source map[zeroParameter]bool) {
	for parameter := range source {
		target[parameter] = true
	}
}
