package tgolint

import (
	"go/token"
	"go/types"

	"tgo/pkg/syntax"
)

type enumActivationID int
type enumCellID int
type enumRegionID int
type enumSavedValueID int
type enumEventBlockID int
type enumEventClosureID int

type enumActivationKey struct {
	function token.Pos
	caller   enumActivationID
	summary  bool
}

// enumCellKey identifies one variable or field cell in one activation.
type enumCellKey struct {
	activation enumActivationID
	object     types.Object
	owner      enumRegionID
	parent     enumCellID
	field      *types.Var
}

type enumRegionKey struct {
	activation enumActivationID
	owner      enumRegionID
	input      types.Object
	site       token.Pos
	typ        types.Type
	summary    bool
}

type enumIdentityTable struct {
	activations map[enumActivationKey]enumActivationID
	cells       map[enumCellKey]enumCellID
	regions     map[enumRegionKey]enumRegionID
	fields      map[enumRegionFieldKey]enumRegionID
	closures    map[enumEventClosureKey]enumEventClosureID

	activationKeys []enumActivationKey
	cellKeys       []enumCellKey
	regionKeys     []enumRegionKey
	closureKeys    []enumEventClosureKey
}

type enumRegionFieldKey struct {
	owner enumRegionID
	field *types.Var
}

func newEnumIdentityTable() *enumIdentityTable {
	return &enumIdentityTable{
		activations: make(map[enumActivationKey]enumActivationID),
		cells:       make(map[enumCellKey]enumCellID),
		regions:     make(map[enumRegionKey]enumRegionID),
		fields:      make(map[enumRegionFieldKey]enumRegionID),
		closures:    make(map[enumEventClosureKey]enumEventClosureID),
	}
}

// fieldRegion reuses one owner-field region and terminates pointer cycles.
func (table *enumIdentityTable) fieldRegion(
	owner enumRegionID,
	field *types.Var,
	activation enumActivationID,
) enumRegionID {
	key := enumRegionFieldKey{owner: owner, field: field}
	if region, found := table.fields[key]; found {
		return region
	}
	for current := owner; current != 0; {
		index := int(current) - 1
		if index < 0 || index >= len(table.regionKeys) {
			break
		}
		ancestor := table.regionKeys[index]
		if ancestor.typ != nil && types.Identical(ancestor.typ, field.Type()) {
			region := table.region(enumRegionKey{
				activation: activation,
				site:       field.Pos(),
				typ:        field.Type(),
				summary:    true,
			})
			table.fields[key] = region
			return region
		}
		current = ancestor.owner
	}
	region := table.region(enumRegionKey{
		activation: activation,
		owner:      owner,
		site:       field.Pos(),
		typ:        field.Type(),
		summary:    table.regionSummary(owner),
	})
	table.fields[key] = region
	return region
}

func (table *enumIdentityTable) regionSummary(region enumRegionID) bool {
	index := int(region) - 1
	return index < 0 || index >= len(table.regionKeys) ||
		table.regionKeys[index].summary
}

func (table *enumIdentityTable) uniqueRegion(region enumRegionID) bool {
	return region != 0 && !table.regionSummary(region)
}

func (table *enumIdentityTable) activation(
	key enumActivationKey,
) enumActivationID {
	if id, found := table.activations[key]; found {
		return id
	}
	id := enumActivationID(len(table.activationKeys) + 1)
	table.activations[key] = id
	table.activationKeys = append(table.activationKeys, key)
	return id
}

func (table *enumIdentityTable) cell(key enumCellKey) enumCellID {
	if id, found := table.cells[key]; found {
		return id
	}
	id := enumCellID(len(table.cellKeys) + 1)
	table.cells[key] = id
	table.cellKeys = append(table.cellKeys, key)
	return id
}

func (table *enumIdentityTable) region(key enumRegionKey) enumRegionID {
	if id, found := table.regions[key]; found {
		return id
	}
	id := enumRegionID(len(table.regionKeys) + 1)
	table.regions[key] = id
	table.regionKeys = append(table.regionKeys, key)
	return id
}

type enumRegionSet map[enumRegionID]bool
type enumCellSet map[enumCellID]bool

type enumAbstractValue struct {
	regions       enumRegionSet
	places        enumCellSet
	relations     enumCellSet
	relationKnown bool
	readCells     enumCellSet
	closures      enumEventClosureSet
	dependencies  enumCellSet
	observation   *enumTagObservation
	unknown       bool
}

type enumEventClosureSet map[enumEventClosureID]bool

type enumEventClosureKey struct {
	literal    *syntax.FunctionLiteral
	activation enumActivationID
}

type enumWriteSet map[int]bool

type enumTagObservation struct {
	regions map[enumRegionID]enumWriteSet
	cells   map[enumCellID]enumWriteSet
	stale   bool
}

func cloneEnumAbstractValue(value enumAbstractValue) enumAbstractValue {
	result := enumAbstractValue{
		regions:       make(enumRegionSet, len(value.regions)),
		closures:      make(enumEventClosureSet, len(value.closures)),
		relationKnown: value.relationKnown,
		unknown:       value.unknown,
	}
	for closure := range value.closures {
		result.closures[closure] = true
	}
	for region := range value.regions {
		result.regions[region] = true
	}
	result.places = cloneEnumCellSet(value.places)
	result.relations = cloneEnumCellSet(value.relations)
	result.readCells = cloneEnumCellSet(value.readCells)
	result.dependencies = make(enumCellSet, len(value.dependencies))
	for cell := range value.dependencies {
		result.dependencies[cell] = true
	}
	result.observation = cloneEnumTagObservation(value.observation)
	return result
}

func cloneEnumWriteSet(source enumWriteSet) enumWriteSet {
	result := make(enumWriteSet, len(source))
	for write := range source {
		result[write] = true
	}
	return result
}

func cloneEnumTagObservation(source *enumTagObservation) *enumTagObservation {
	if source == nil {
		return nil
	}
	result := &enumTagObservation{
		regions: make(map[enumRegionID]enumWriteSet, len(source.regions)),
		cells:   make(map[enumCellID]enumWriteSet, len(source.cells)),
		stale:   source.stale,
	}
	for region, writes := range source.regions {
		result.regions[region] = cloneEnumWriteSet(writes)
	}
	for cell, writes := range source.cells {
		result.cells[cell] = cloneEnumWriteSet(writes)
	}
	return result
}

type enumEventKind uint8

const (
	enumEventInvalid enumEventKind = iota
	enumEventResolvePlace
	enumEventLoad
	enumEventTagRead
	enumEventSave
	enumEventCall
	enumEventStore
	enumEventReturn
	enumEventTagTest
	enumEventPayloadCheck
)

// enumEvent is one ordered abstract operation. Values are immutable snapshots.
type enumEvent struct {
	kind       enumEventKind
	expression *syntax.Expression
	cells      enumCellSet
	regions    enumRegionSet
	value      enumSavedValueID
	source     enumSavedValueID
	values     []enumSavedValueID
	arguments  []enumSavedValueID
	results    []enumSavedValueID
	result     int
	tag        int
	serial     int
	field      *types.Var
	method     bool
}

type enumEventBlock struct {
	events       []enumEvent
	successors   []enumEventEdge
	alternatives [][]enumEventBlockID
}

type enumEventEdge struct {
	target enumEventBlockID
	tests  []enumEvent
}

// enumEventGraph adds expression microblocks to one syntax CFG.
type enumEventGraph struct {
	checker           %checker
	identities        *enumIdentityTable
	activation        enumActivationID
	call              enumEventCallID
	blocks            []enumEventBlock
	entry             enumEventBlockID
	initial           *enumEventState
	access            map[*syntax.Expression]enumEventLocation
	expressions       map[*syntax.Expression]enumSavedValueID
	expressionResults map[*syntax.Expression][]enumSavedValueID
	values            []enumAbstractValue
	calls             *enumEventCallWorklist
}

type enumEventLocation struct {
	block enumEventBlockID
	index int
}

func newEnumEventGraph() *enumEventGraph {
	return &enumEventGraph{
		identities:        newEnumIdentityTable(),
		access:            make(map[*syntax.Expression]enumEventLocation),
		expressions:       make(map[*syntax.Expression]enumSavedValueID),
		expressionResults: make(map[*syntax.Expression][]enumSavedValueID),
	}
}

func (graph *enumEventGraph) closure(key enumEventClosureKey) enumEventClosureID {
	if id, found := graph.identities.closures[key]; found {
		return id
	}
	id := enumEventClosureID(len(graph.identities.closureKeys) + 1)
	graph.identities.closures[key] = id
	graph.identities.closureKeys = append(graph.identities.closureKeys, key)
	return id
}

func (graph *enumEventGraph) save(value enumAbstractValue) enumSavedValueID {
	graph.values = append(graph.values, cloneEnumAbstractValue(value))
	return enumSavedValueID(len(graph.values))
}

func (graph *enumEventGraph) newSavedValue() enumSavedValueID {
	graph.values = append(graph.values, enumAbstractValue{unknown: true})
	return enumSavedValueID(len(graph.values))
}

func (graph *enumEventGraph) saved(id enumSavedValueID) enumAbstractValue {
	if id <= 0 || int(id) > len(graph.values) {
		return enumAbstractValue{unknown: true}
	}
	return cloneEnumAbstractValue(graph.values[id-1])
}

func (graph *enumEventGraph) addBlock() enumEventBlockID {
	graph.blocks = append(graph.blocks, enumEventBlock{})
	return enumEventBlockID(len(graph.blocks))
}

func (graph *enumEventGraph) addEvent(
	block enumEventBlockID,
	event enumEvent,
) enumEventLocation {
	index := int(block) - 1
	if index < 0 || index >= len(graph.blocks) {
		return enumEventLocation{}
	}
	location := enumEventLocation{block: block, index: len(graph.blocks[index].events)}
	event.serial = 1
	for _, current := range graph.blocks {
		event.serial += len(current.events)
	}
	graph.blocks[index].events = append(graph.blocks[index].events, event)
	if event.kind == enumEventPayloadCheck && event.expression != nil {
		graph.access[event.expression] = location
	}
	return location
}
