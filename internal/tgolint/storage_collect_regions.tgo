package tgolint

import (
	"go/types"

	"tgo/pkg/syntax"
)

func containsStorageObject(objects []types.Object, want types.Object) bool {
	for _, object := range objects {
		if object == want {
			return true
		}
	}
	return false
}

func (b %storageGraphBuilder) expressionRegion(
	expression %syntax.Expression,
) (StorageEffectRegion, bool) {
	if name := syntax.IdentifierExpressionOf(expression); name != nil {
		object := b.checker.facts.Object(name)
		if object == nil {
			return StorageEffectRegion{}, false
		}
		if region, ok := b.regions[object]; ok {
			return region, true
		}
		region := StorageEffectRegion{Root: storageRootAllocation, ID: b.nextSite}
		b.nextSite++
		b.regions[object] = region
		return region, true
	}
	if selector := syntax.SelectorExpressionOf(expression); selector != nil {
		region, ok := b.expressionRegion(selector.Expression)
		if ok {
			region.Path = append(region.Path, StorageEffectPath{
				Kind: storagePathField, Field: selector.Selector.Name,
			})
		}
		return region, ok
	}
	if index := syntax.IndexExpressionOf(expression); index != nil {
		region, ok := b.expressionRegion(index.Expression)
		if ok {
			region.Path = append(region.Path, StorageEffectPath{Kind: storagePathAnyIndex})
		}
		return region, ok
	}
	return StorageEffectRegion{}, false
}

func (b %storageGraphBuilder) newTemp() int {
	result := b.nextTemp
	b.nextTemp++
	return result
}

func (b %storageGraphBuilder) functionID(function *types.Func) int {
	if function == nil {
		return -1
	}
	if function == b.root {
		return 0
	}
	id := -int(function.Pos()) - 2
	b.calls[id] = function
	return id
}
