// Package passes registers and runs the independent tgolint pass families.
package passes

import (
	"fmt"

	"tgo/internal/tgolint/passes/modeluse"
	"tgo/internal/tgolint/passes/modernize"
	"tgo/internal/tgolint/passes/nilsafety"
	"tgo/internal/tgolint/report"
	"tgo/pkg/syntax"

	"golang.org/x/tools/go/analysis"
)

type stack struct {
	pass       %analysis.Pass
	files      []%syntax.File
	reporter   %report.Reporter
	model      %modeluse.Context
	modernizer %modernize.Runner
}

type registeredPass struct {
	id   passID
	name string
}

type passID enum {
	SourcePolicy struct{}
	ValidationDiscovery struct{}
	NilSafety struct{}
	IotaModernization struct{}
	ErrorReturnModernization struct{}
	SuccessReturnModernization struct{}
	GoModelUse struct{}
	GenericZeroSafety struct{}
}

// FactTypes returns all facts that pass families exchange across packages.
func FactTypes() []analysis.Fact {
	facts := modeluse.FactTypes()
	return append(facts, nilsafety.FactTypes()...)
}

// PassNames returns all lint passes in execution order.
func PassNames() []string {
	registered := registeredPasses()
	names := make([]string, 0, len(registered))
	for _, item := range registered {
		names = append(names, item.name)
	}
	return names
}

func registeredPasses() []registeredPass {
	return []registeredPass{
		{id: passID.SourcePolicy{}, name: "TGo source policy"},
		{id: passID.ValidationDiscovery{}, name: "validation model discovery"},
		{id: passID.NilSafety{}, name: "nil safety"},
		{id: passID.IotaModernization{}, name: "iota modernization"},
		{id: passID.ErrorReturnModernization{}, name: "error return modernization"},
		{id: passID.SuccessReturnModernization{}, name: "success return modernization"},
		{id: passID.GoModelUse{}, name: "Go model use"},
		{id: passID.GenericZeroSafety{}, name: "generic zero safety"},
	}
}

// Run prepares shared facts and runs each pass in the registered order.
func Run(
	pass *analysis.Pass,
	files []%syntax.File,
	reporter %report.Reporter,
) (any, error) {
	if pass == nil {
		return , fmt.Errorf("tgolint pass stack received a nil analysis pass")
	}
	model, err := modeluse.New(pass, files, reporter)
	if err != nil { return , err }
	if model.Stopped() { return nil, }
	state := &stack{
		pass: pass,
		files: files,
		reporter: reporter,
		model: model,
		modernizer: modernize.New(reporter),
	}
	for _, item := range registeredPasses() {
		runRegisteredPass(state, item.id)
	}
	return nil,
}

func runRegisteredPass(state %stack, id passID) {
	switch id.Tag() {
	case passIDTagSourcePolicy:
		runSourcePolicy(state)
	case passIDTagValidationDiscovery:
		runValidationDiscovery(state)
	case passIDTagNilSafety:
		runNilSafety(state)
	case passIDTagIotaModernization:
		runIotaModernization(state)
	case passIDTagErrorReturnModernization:
		runErrorReturnModernization(state)
	case passIDTagSuccessReturnModernization:
		runSuccessReturnModernization(state)
	case passIDTagGoModelUse:
		runGoModelUse(state)
	case passIDTagGenericZeroSafety:
		runGenericZeroSafety(state)
	exhaustive:
	}
}

func runSourcePolicy(state %stack) {
	state.model.CheckSourcePolicy()
}

func runValidationDiscovery(state %stack) {
	state.model.DiscoverValidationModels()
}

func runNilSafety(state %stack) {
	nilsafety.Run(
		state.pass,
		state.files,
		state.model.Facts(),
		state.model.Analysis(),
		state.reporter,
	)
}

func runIotaModernization(state %stack) {
	state.modernizer.CheckIota(state.model.Analysis())
}

func runErrorReturnModernization(state %stack) {
	state.modernizer.CheckErrorReturns(state.model.Analysis())
}

func runSuccessReturnModernization(state %stack) {
	state.modernizer.CheckSuccessReturns(state.model.Analysis())
}

func runGoModelUse(state %stack) {
	state.model.CheckGoModelUse()
}

func runGenericZeroSafety(state %stack) {
	state.model.CheckGenericZeroSafety()
}
