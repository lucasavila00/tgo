package nilsafety

import (
	"go/token"
	"go/types"
	"strconv"
	"strings"

	"tgo/pkg/syntax"
	"tgo/pkg/syntax/cfg"
)

func (e %nilEnvironment) blockNilFacts(
	block *cfg.Block,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	if block == nil || state == nil || len(block.Nodes) == 0 {
		return nil,
	}
	condition, ok := syntax.ExpressionOf(&block.Nodes[len(block.Nodes)-1])
	if !ok || condition == nil {
		return nil,
	}
	conditionNode := syntax.ExpressionNode(condition)
	if clauseNode := e.parents[conditionNode]; clauseNode != nil {
		clauseStatement, clauseOK := syntax.StatementOf(clauseNode)
		clause := syntax.CaseClauseOf(clauseStatement)
		bodyNode := e.parents[*clauseNode]
		bodyStatement, bodyOK := syntax.StatementOf(bodyNode)
		body := syntax.BlockStatementOf(bodyStatement)
		var switchNode *syntax.Node = nil
		if bodyNode != nil { switchNode = e.parents[*bodyNode] }
		switchStatementNode, switchOK := syntax.StatementOf(switchNode)
		switchStatement := syntax.SwitchStatementOf(switchStatementNode)
		if clauseOK && clause != nil && bodyOK && body != nil && switchOK &&
			switchStatement != nil && switchStatement.Tag != nil {
			return e.comparisonNilFacts(
				switchStatement.Tag, condition, token.EQL, state,
			)
		}
	}
	return e.conditionNilFacts(condition, state)
}

// conditionNilFacts returns facts that hold on every branch alternative.
func (e %nilEnvironment) conditionNilFacts(
	expression *syntax.Expression,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	trueBranches, falseBranches := e.conditionNilBranches(expression, state)
	return commonNilBranchFacts(trueBranches), commonNilBranchFacts(falseBranches)
}

func (e %nilEnvironment) comparisonNilFacts(
	left %syntax.Expression,
	right %syntax.Expression,
	operator token.Token,
	state *nilFlowState,
) (nilFacts, nilFacts) {
	trueBranches, falseBranches := e.comparisonNilBranches(
		left, right, operator, state,
	)
	return commonNilBranchFacts(trueBranches), commonNilBranchFacts(falseBranches)
}

func nilFactsImpossible(facts nilFacts) bool {
	for _, value := range facts {
		if isNeverNilType(value) { return true }
	}
	return false
}

func impossibleNilFacts() nilFacts {
	return nilFacts{{object: nil, path: "$never"}: neverNilType()}
}

func (e %nilEnvironment) applyNilFacts(state *nilFlowState, facts nilFacts) {
	if state == nil || !state.reachable { return }
	for place, value := range facts {
		current := optionalNilType()
		if known, found := state.values[place]; found { current = known }
		narrowed := intersectNilTypes(current, value)
		if isNeverNilType(narrowed) {
			state.reachable = false
			return
		}
		e.setNilType(state, place, narrowed)
	}
}

func (e %nilEnvironment) setNilType(
	state *nilFlowState,
	place nilPlace,
	value nilType,
) {
	state.values[place] = value
	for other := range state.aliases {
		if nilAliased(state, place, other) {
			state.values[other] = value
		}
	}
}

func nilPlaceID(place nilPlace) string {
	if place.object == nil {
		return place.path
	}
	pkg := ""
	if place.object.Pkg() != nil {
		pkg = place.object.Pkg().Path()
	}
	return pkg + ":" + place.object.Name() + ":" +
		strconv.Itoa(int(place.object.Pos())) + ":" + place.path
}

func nilRepresentative(state *nilFlowState, place nilPlace) nilPlace {
	if representative, ok := state.aliases[place]; ok {
		return representative
	}
	return place
}

func nilAliased(state *nilFlowState, left, right nilPlace) bool {
	return nilRepresentative(state, left) == nilRepresentative(state, right)
}

func addNilAlias(state *nilFlowState, left, right nilPlace) {
	leftRepresentative := nilRepresentative(state, left)
	rightRepresentative := nilRepresentative(state, right)
	if leftRepresentative == rightRepresentative {
		return
	}
	representative := leftRepresentative
	replaced := rightRepresentative
	if nilPlaceID(rightRepresentative) < nilPlaceID(leftRepresentative) {
		representative = rightRepresentative
		replaced = leftRepresentative
	}
	state.aliases[left] = representative
	state.aliases[right] = representative
	for place, current := range state.aliases {
		if current == replaced {
			state.aliases[place] = representative
		}
	}
}

func breakNilAlias(state *nilFlowState, target nilPlace) {
	representative := nilRepresentative(state, target)
	group := make([]nilPlace, 0)
	members := make([]nilPlace, 0)
	for place := range state.aliases {
		if nilRepresentative(state, place) != representative {
			continue
		}
		members = append(members, place)
		if place != target {
			group = append(group, place)
		}
	}
	for _, place := range members {
		delete(state.aliases, place)
	}
	delete(state.aliases, target)
	for index := 1; index < len(group); index++ {
		addNilAlias(state, group[0], group[index])
	}
}

// nilPlace identifies a stable local, field, index, or dereference.
func (e %nilEnvironment) nilPlace(expression *syntax.Expression) (nilPlace, bool) {
	if parenthesized := syntax.ParenthesizedExpressionOf(expression); parenthesized != nil {
		return e.nilPlace(parenthesized.Expression)
	}
	if identifier := syntax.IdentifierExpressionOf(expression); identifier != nil {
		object := e.facts.Object(identifier)
		if object == nil || object == types.Universe.Lookup("nil") {
			return nilPlace{object: nil, path: ""}, false
		}
		return nilPlace{object: object, path: ""}, true
	}
	if selector := syntax.SelectorExpressionOf(expression); selector != nil {
		base, ok := e.nilPlace(selector.Expression)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		selection := e.facts.Selection(expression)
		if selection == nil || selection.Kind() != types.FieldVal {
			return nilPlace{object: nil, path: ""}, false
		}
		parts := make([]string, 0, len(selection.Index()))
		for _, index := range selection.Index() {
			parts = append(parts, strconv.Itoa(index))
		}
		base.path += "/f" + strings.Join(parts, ".")
		return base, true
	}
	if index := syntax.IndexExpressionOf(expression); index != nil {
		base, ok := e.nilPlace(index.Expression)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		key, ok := e.stableIndex(index.Index)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		base.path += "/i" + key
		return base, true
	}
	if star := syntax.StarExpressionOf(expression); star != nil {
		base, ok := e.nilPlace(star.Expression)
		if !ok {
			return nilPlace{object: nil, path: ""}, false
		}
		base.path += "/d"
		return base, true
	}
	return nilPlace{object: nil, path: ""}, false
}

func (e %nilEnvironment) stableIndex(expression %syntax.Expression) (string, bool) {
	if name := syntax.IdentifierExpressionOf(expression); name != nil {
		object := e.facts.Object(name)
		if object != nil {
			return "o" + nilPlaceID(nilPlace{object: object, path: ""}), true
		}
	}
	value := e.facts.Constant(expression)
	if value != nil {
		return "c" + value.ExactString(), true
	}
	return "", false
}

func (e %nilEnvironment) isNil(expression %syntax.Expression) bool {
	name := syntax.IdentifierExpressionOf(expression)
	if name == nil { return false }
	return e.facts.Object(name) == types.Universe.Lookup("nil")
}

// prepareNilBlock sets the range value contract at a range body entry.
func (e %nilEnvironment) prepareNilBlock(
	state *nilFlowState,
	block *cfg.Block,
) {
	if state == nil || block == nil || block.Kind != cfg.KindRangeBody {
		return
	}
	statement := syntax.RangeStatementOf(block.Stmt)
	if statement == nil {
		return
	}
	source := e.contractForExpression(statement.Source)
	valueContract := nilChild(source, "e")
	if _, mapping := coreType(e.facts.Type(statement.Source)).(*types.Map); mapping {
		valueContract = nilChild(source, "v")
	}
	if statement.Value != nil {
		e.assignNilTarget(state, statement.Value, nil)
		if place, ok := e.nilPlace(statement.Value); ok && valueContract[""] {
			e.setNilType(state, place, nonNilType())
		}
	}
}
