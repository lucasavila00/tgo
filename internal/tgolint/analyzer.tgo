// Package tgolint registers the TGo source analyzer.
package tgolint

import (
	"tgo/internal/tgolint/passes"
	"tgo/internal/tgolint/report"
	"tgo/internal/tgolint/source"

	"golang.org/x/tools/go/analysis"
)

// Analyzer checks TGo source and Go callers of generated TGo types.
var Analyzer = newAnalyzer()

// newAnalyzer assembles the source, report, and pass packages.
func newAnalyzer() %analysis.Analyzer {
	analyzer := new(analysis.Analyzer)
	analyzer.Name = "tgolint"
	analyzer.Doc = "check TGo source and Go use of generated TGo types"
	analyzer.Run = run
	analyzer.FactTypes = passes.FactTypes()
	return analyzer
}

func run(pass *analysis.Pass) (any, error) {
	if pass == nil {
		return passes.Run(nil, nil, nil)
	}
	filtered := report.Filter(pass)
	files := source.Parse(filtered)!!
	return passes.Run(filtered, files, report.New(filtered))
}
