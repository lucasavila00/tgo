// Package tgolint checks Go callers of generated tgo types.
package tgolint

import (
	"go/ast"
	"go/token"
	"go/types"
	"strconv"

	"golang.org/x/tools/go/analysis"
)

const generatedHeader = "// Code generated by tgo. DO NOT EDIT."

// Analyzer checks unsafe Go use of generated tgo values.
var Analyzer = newAnalyzer()

// newAnalyzer registers the checks and the facts that cross package boundaries.
func newAnalyzer() %analysis.Analyzer {
	analyzer := new(analysis.Analyzer)
	analyzer.Name = "tgolint"
	analyzer.Doc = "check Go use of generated tgo types"
	analyzer.Run = run
	analyzer.FactTypes = []analysis.Fact{
		new(modelWireFact),
		new(validationFact),
		new(genericEffectWireFact),
		new(nilContractWireFact),
		new(invalidPackageFact),
	}
	return analyzer
}

type checker struct {
	pass       *analysis.Pass
	models     map[objectKey]*model
	validated  map[types.Object]bool
	callTarget map[types.Object]types.Object
	generated  map[*ast.File]bool
	parents    map[ast.Node]ast.Node
	safe       map[*ast.SelectorExpr]bool
	handled    map[*ast.SelectorExpr]bool
	checked    map[*ast.CallExpr]bool
	presence   map[ast.Expr]bool
	escaped    map[types.Object]token.Pos
	reported   map[diagnosticKey]bool
	function   ast.Node
	zeroTypes  map[*types.TypeParam]*model
	capture    func(*model, ast.Expr)
	scalarFlows map[ast.Node]*scalarFlow
	invalid    bool
}

const invalidPackageVersion = 1

// invalidPackageFact stops analysis across an unverified package boundary.
type invalidPackageFact struct {
	Version int
}

// AFact marks invalidPackageFact as a Go analysis fact.
func (%invalidPackageFact) AFact() {}

type diagnosticKey struct {
	position token.Pos
	message  string
}

// run verifies generated code, loads model facts, and checks user Go code.
func run(pass *analysis.Pass) (any, error) {
	c := &checker{
		pass:       pass,
		models:     make(map[objectKey]*model),
		validated:  make(map[types.Object]bool),
		callTarget: make(map[types.Object]types.Object),
		generated:  make(map[*ast.File]bool),
		parents:    make(map[ast.Node]ast.Node),
		safe:       make(map[*ast.SelectorExpr]bool),
		handled:    make(map[*ast.SelectorExpr]bool),
		checked:    make(map[*ast.CallExpr]bool),
		presence:   make(map[ast.Expr]bool),
		escaped:    make(map[types.Object]token.Pos),
		reported:   make(map[diagnosticKey]bool),
		function:   nil,
		zeroTypes:  nil,
		capture:    nil,
		scalarFlows: make(map[ast.Node]*scalarFlow),
		invalid:    false,
	}
	if c.rejectInvalidDependencies() {
		return nil, nil
	}
	c.findModels()
	if c.invalid {
		return nil, nil
	}
	c.findValidationWrappers()
	c.findValidationFunctionValues()
	c.checkNilSafety()
	for _, file := range pass.Files {
		if c.generated[file] {
			continue
		}
		c.addParents(file)
		ast.Inspect(file, func(node ast.Node) bool {
			if statement, ok := node.(*ast.SwitchStmt); ok {
				c.checkTagSwitch(statement)
			}
			return true
		})
		ast.Inspect(file, func(node ast.Node) bool {
			c.checkNode(node)
			return true
		})
	}
	c.checkGenericZeroSafety()
	return nil, nil
}

// rejectInvalidDependencies stops analysis when an imported package failed verification.
func (c %checker) rejectInvalidDependencies() bool {
	found := false
	for _, imported := range c.pass.Pkg.Imports() {
		fact := new(invalidPackageFact)
		if !c.pass.ImportPackageFact(imported, fact) || fact.Version != invalidPackageVersion {
			continue
		}
		found = true
		c.reportInvalidImport(imported.Path())
	}
	if found {
		c.markInvalid()
	}
	return found
}

func (c %checker) reportInvalidImport(path string) {
	for _, file := range c.pass.Files {
		for _, specification := range file.Imports {
			imported, err := strconv.Unquote(specification.Path.Value)
			if err == nil && imported == path {
				c.pass.Reportf(
					specification.Path.Pos(),
					"dependency %s failed tgo verification",
					path,
				)
			}
		}
	}
}

func (c %checker) failVerification(position token.Pos, format string, arguments ...any) {
	c.pass.Reportf(position, format, arguments...)
	c.markInvalid()
}

// markInvalid records one package failure and exports it to importers.
func (c %checker) markInvalid() {
	if c.invalid {
		return
	}
	c.invalid = true
	c.pass.ExportPackageFact(&invalidPackageFact{Version: invalidPackageVersion})
}

// addParents builds the upward AST links used by local flow checks.
func (c %checker) addParents(file *ast.File) {
	var stack []ast.Node = nil
	ast.Inspect(file, func(node ast.Node) bool {
		if node == nil {
			stack = stack[:len(stack)-1]
			return false
		}
		if len(stack) > 0 {
			c.parents[node] = stack[len(stack)-1]
		}
		stack = append(stack, node)
		return true
	})
}

// checkNode sends one AST node to each check that applies to its form.
func (c %checker) checkNode(node ast.Node) {
	switch node := node.(type) {
	case *ast.FuncDecl:
		if node.Body != nil {
			c.checkNamedResults(node.Type)
			c.checkConstructors(node, node.Body)
		}
	case *ast.FuncLit:
		c.checkNamedResults(node.Type)
		c.checkConstructors(node, node.Body)
	case *ast.TypeSpec:
		c.checkTypeSpec(node)
	case *ast.ValueSpec:
		c.checkValueSpec(node)
	case *ast.CompositeLit:
		c.checkLiteral(node)
	case *ast.CallExpr:
		c.checkCall(node)
	case *ast.IndexExpr:
		c.checkMapRead(node)
	case *ast.UnaryExpr:
		if node.Op == token.ARROW {
			c.checkPresenceRead(node)
		}
	case *ast.TypeAssertExpr:
		c.checkTypeAssertion(node)
	case *ast.SelectorExpr:
		c.checkRepresentationAccess(node)
	case *ast.SliceExpr:
		c.checkReslice(node)
	}
}
