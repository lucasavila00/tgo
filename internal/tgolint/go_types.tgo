package tgolint

import "go/types"

// goType closes the go/types.Type implementations used by tgolint.
// goTypeOf is the only open Go type switch in this package.
type goType enum {
	Nil struct{}
	Basic struct { Value *types.Basic }
	Array struct { Value *types.Array }
	Slice struct { Value *types.Slice }
	Struct struct { Value *types.Struct }
	Pointer struct { Value *types.Pointer }
	Tuple struct { Value *types.Tuple }
	Signature struct { Value *types.Signature }
	Map struct { Value *types.Map }
	Channel struct { Value *types.Chan }
	Interface struct { Value *types.Interface }
	Named struct { Value *types.Named }
	TypeParameter struct { Value *types.TypeParam }
	Union struct { Value *types.Union }
	Other struct{}
}

func goTypeOf(typ types.Type) goType {
	switch value := typ.(type) {
	case nil:
		return goType.Nil{}
	case *types.Basic:
		return goType.Basic{Value: value}
	case *types.Array:
		return goType.Array{Value: value}
	case *types.Slice:
		return goType.Slice{Value: value}
	case *types.Struct:
		return goType.Struct{Value: value}
	case *types.Pointer:
		return goType.Pointer{Value: value}
	case *types.Tuple:
		return goType.Tuple{Value: value}
	case *types.Signature:
		return goType.Signature{Value: value}
	case *types.Map:
		return goType.Map{Value: value}
	case *types.Chan:
		return goType.Channel{Value: value}
	case *types.Interface:
		return goType.Interface{Value: value}
	case *types.Named:
		return goType.Named{Value: value}
	case *types.TypeParam:
		return goType.TypeParameter{Value: value}
	case *types.Union:
		return goType.Union{Value: value}
	default:
		return goType.Other{}
	}
}
