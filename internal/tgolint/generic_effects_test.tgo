package tgolint

import (
	"bytes"
	"encoding/gob"
	"testing"
)

func TestGenericEffectFactGobRoundTrip(t *testing.T) {
	t.Parallel()
	want := &GenericEffectFact{
		ZeroEffects: []GenericEffect{{
			Receiver:      false,
			TypeParameter: 1,
			Conditions: []GenericEffectCondition{{
				ValueParameter: 2,
				OtherParameter: -1,
				Kind:           EffectKind.Boolean{},
				Expected:       true,
			}},
			MaySkip: false,
		}},
		AccessEffects:         nil,
		ReturnedZeroEffects:   nil,
		ReturnedAccessEffects: nil,
		ReturnedZeroEffectsAtDepth: []GenericEffectAtDepth{{
			CallDepth: 2,
			Effect: GenericEffect{
				Receiver: false, TypeParameter: 0,
				Conditions: nil, MaySkip: true,
			},
		}},
		ReturnedAccessEffectsAtDepth: nil,
	}
	data := *new(bytes.Buffer)
	if err := gob.NewEncoder(&data).Encode(want); err != nil {
		t.Fatal(err)
	}
	got := new(GenericEffectFact)
	if err := gob.NewDecoder(&data).Decode(got); err != nil {
		t.Fatal(err)
	}
	if len(got.ZeroEffects) != 1 || len(got.ZeroEffects[0].Conditions) != 1 {
		t.Fatalf("decoded fact = %#v", got)
	}
	if len(got.ReturnedZeroEffectsAtDepth) != 1 ||
		got.ReturnedZeroEffectsAtDepth[0].CallDepth != 2 ||
		!got.ReturnedZeroEffectsAtDepth[0].Effect.MaySkip {
		t.Fatalf("decoded returned fact = %#v", got.ReturnedZeroEffectsAtDepth)
	}
	condition := got.ZeroEffects[0].Conditions[0]
	if condition.Kind.Tag() != EffectKindTagBoolean || !condition.Expected ||
		condition.ValueParameter != 2 || condition.OtherParameter != -1 {
		t.Fatalf("decoded condition = %#v", condition)
	}
}
