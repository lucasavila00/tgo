package tgolint

import (
	"go/token"
	"go/types"

	"tgo/pkg/syntax"
)

type returnedHelperResolution struct {
	parameter int
	uses      []returnedHelperUse
	resolved  bool
}

type returnedHelperUse struct {
	parameter  int
	call       bool
	returned   bool
	conditions []GenericEffectCondition
	maySkip    bool
}

func (c %checker) addReturnedContainerSource(
	bindings map[types.Object]%returnedClosureBinding,
	target %syntax.Expression,
	source returnedClosureSource,
) {
	object, slot, ok := c.returnedContainerTarget(target)
	if !ok || object == nil {
		return
	}
	binding := bindings[object]
	if binding == nil {
		binding = &returnedClosureBinding{
			sources: nil, unstable: true, opaque: false,
		}
		bindings[object] = binding
	} else {
		binding.unstable = true
	}
	if source.slot != "" && slot != "" {
		source.slot = slot + "/" + source.slot
	} else if slot != "" {
		source.slot = slot
	}
	if source.slot != "" && len(source.conditions) == 0 && !source.maySkip {
		kept := binding.sources[:0]
		for _, current := range binding.sources {
			if current.slot != source.slot {
				kept = append(kept, current)
			}
		}
		binding.sources = kept
	}
	binding.sources = append(binding.sources, source)
}

func (c %checker) returnedContainerTarget(
	expression %syntax.Expression,
) (types.Object, string, bool) {
	expression = unparenthesized(expression)
	if name := syntax.IdentifierExpressionOf(expression); name != nil {
		object := c.facts.Object(name)
		return object, "", object != nil
	}
	if index := syntax.IndexExpressionOf(expression); index != nil {
		object, parent, ok := c.returnedContainerTarget(index.Expression)
		if !ok {
			return nil, "", false
		}
		slot := c.containerSlot(index.Index)
		if slot == "" {
			return object, "", true
		}
		if parent != "" {
			slot = parent + "/" + slot
		}
		return object, slot, true
	}
	selector := syntax.SelectorExpressionOf(expression)
	if selector == nil {
		return nil, "", false
	}
	object, parent, ok := c.returnedContainerTarget(selector.Expression)
	if !ok {
		return nil, "", false
	}
	slot := "." + selector.Selector.Name
	if parent != "" {
		slot = parent + "/" + slot
	}
	return object, slot, true
}

func (c %checker) markAddressedReturnedClosureBindings(
	body %syntax.BlockStatement,
	bindings map[types.Object]%returnedClosureBinding,
) {
	inspectGenericBlock(body, func(node %syntax.Node) bool {
		expression, ok := syntax.ExpressionOf(node)
		if !ok {
			return true
		}
		unary := syntax.UnaryExpressionOf(expression)
		if unary == nil || unary.Operator != token.AND {
			return true
		}
		name := syntax.IdentifierExpressionOf(unparenthesized(unary.Expression))
		if name != nil {
			if binding := bindings[c.facts.Object(name)]; binding != nil {
				binding.unstable = true
				binding.opaque = true
			}
		}
		return true
	})
}

func (c %checker) collectReturnedExpression(
	summary %genericEffectSummary,
	expression %syntax.Expression,
	bindings map[types.Object]%returnedClosureBinding,
	summaries map[*types.Func]%genericEffectSummary,
	declarations map[*types.Func]%syntax.FunctionDeclaration,
	allowHelper bool,
	maySkip bool,
	seen map[types.Object]bool,
) bool {
	value := unparenthesized(expression)
	if literal := syntax.FunctionLiteralExpressionOf(value); literal != nil {
		return c.collectReturnedLiteral(
			summary, value, literal, summaries, declarations, maySkip,
		)
	}
	if name := syntax.IdentifierExpressionOf(value); name != nil {
		object := c.facts.Object(name)
		binding := bindings[object]
		if binding == nil || seen[object] {
			return false
		}
		uncertain := maySkip || binding.unstable || len(binding.sources) != 1
		for _, source := range binding.sources {
			path := source.expression
			if c.expressionInsideFunctionLiteral(source.expression) {
				path = value
			}
			summary.returnedValues = append(summary.returnedValues, returnedGenericValue{
				expression: source.expression, path: path,
				conditions: source.conditions,
				maySkip:    uncertain || source.maySkip,
			})
		}
		if binding.opaque {
			c.addUnknownReturnedEffects(summary)
		}
		return true
	}
	call := syntax.CallExpressionOf(value)
	if call == nil {
		c.addUnknownReturnedEffects(summary)
		return true
	}
	function, _ := c.genericCallObject(call.Callee).(*types.Func)
	unresolvedGenericHelper := false
	if allowHelper && function != nil {
		declaration := declarations[function.Origin()]
		if declaration != nil {
			resolution := c.returnedHelper(function.Origin(), declaration, summary.file)
			generic := genericSignature(function)
			if !generic ||
				resolution.resolved && resolution.parameter >= 0 {
				return c.collectReturnedHelperCall(
					summary, value, call, resolution, bindings, summaries,
					declarations, maySkip, seen,
				)
			}
			unresolvedGenericHelper = generic && !resolution.resolved
		}
	}
	if function != nil && c.genericZeroFact(function.Origin(), summaries) != nil {
		if unresolvedGenericHelper {
			c.collectReturnedArguments(
				summary, call.Args, bindings, summaries, declarations, seen,
			)
		}
		summary.returnedValues = append(summary.returnedValues, returnedGenericValue{
			expression: value, path: value, conditions: nil, maySkip: maySkip,
		})
		return true
	}
	recorded := function == nil
	if recorded {
		summary.returnedValues = append(summary.returnedValues, returnedGenericValue{
			expression: value, path: value, conditions: nil, maySkip: maySkip,
		})
	}
	return c.collectReturnedArguments(
		summary, call.Args, bindings, summaries, declarations, seen,
	) || recorded
}

func (c %checker) collectReturnedArguments(
	summary %genericEffectSummary,
	arguments []%syntax.Expression,
	bindings map[types.Object]%returnedClosureBinding,
	summaries map[*types.Func]%genericEffectSummary,
	declarations map[*types.Func]%syntax.FunctionDeclaration,
	seen map[types.Object]bool,
) bool {
	found := false
	for _, argument := range arguments {
		found = c.collectReturnedExpression(
			summary, argument, bindings, summaries, declarations,
			false, true, seen,
		) || found
	}
	return found
}

func (c %checker) collectReturnedHelperCall(
	summary %genericEffectSummary,
	expression %syntax.Expression,
	call %syntax.CallExpression,
	resolution returnedHelperResolution,
	bindings map[types.Object]%returnedClosureBinding,
	summaries map[*types.Func]%genericEffectSummary,
	declarations map[*types.Func]%syntax.FunctionDeclaration,
	maySkip bool,
	seen map[types.Object]bool,
) bool {
	if !resolution.resolved {
		return c.collectReturnedArguments(
			summary, call.Args, bindings, summaries, declarations, seen,
		)
	}
	found := false
	if resolution.parameter >= 0 && resolution.parameter < len(call.Args) {
		found = c.collectReturnedExpression(
			summary, call.Args[resolution.parameter], bindings, summaries,
			declarations, false, maySkip, seen,
		)
	}
	for _, use := range resolution.uses {
		if use.parameter < 0 || use.parameter >= len(call.Args) {
			continue
		}
		summary.addConditionalGenericValueUse(
			call.Args[use.parameter], use.call, use.returned,
			maySkip || use.maySkip, expression, use.conditions,
		)
		found = true
	}
	return found
}

func (c %checker) collectReturnedLiteral(
	summary %genericEffectSummary,
	expression %syntax.Expression,
	literal %syntax.FunctionLiteral,
	summaries map[*types.Func]%genericEffectSummary,
	declarations map[*types.Func]%syntax.FunctionDeclaration,
	maySkip bool,
) bool {
	root := syntax.ExpressionNode(expression)
	returned := &genericEffectSummary{
		function: summary.function, file: summary.file,
		declaration: summary.declaration,
		parameters:  summary.parameters, zeroEffects: nil,
		accessEffects: nil, returnedZeroEffects: nil,
		returnedAccessEffects:        nil,
		returnedZeroEffectsAtDepth:   nil,
		returnedAccessEffectsAtDepth: nil,
		calls:                        nil, returnedValues: nil, returnedBodies: nil, valueUses: nil,
		declarations: summary.declarations,
		reachable:    c.reachableNodes(literal.Body), root: &root,
		body: literal.Body,
	}
	c.collectGenericNodes(returned)
	signature, _ := types.Unalias(c.facts.Type(expression)).Underlying().(*types.Signature)
	c.collectReturnedGenericEffects(
		returned, signature, literal.Type, summaries, declarations,
	)
	summary.returnedBodies = append(summary.returnedBodies, returnedGenericBody{
		summary: returned,
		maySkip: maySkip,
	})
	found := len(returned.zeroEffects) > 0 || len(returned.accessEffects) > 0 ||
		len(returned.calls) > 0 || len(returned.returnedValues) > 0 ||
		len(returned.returnedBodies) > 0
	return found
}

func (c %checker) addUnknownReturnedEffects(summary %genericEffectSummary) bool {
	changed := false
	for _, parameter := range summary.parameters {
		effect := noGenericEffect()
		effect.Receiver = parameter.receiver
		effect.TypeParameter = parameter.index
		effect.MaySkip = true
		changed = c.addReturnedGenericEffect(summary, true, effect) || changed
	}
	return changed
}

// returnedHelper resolves a local helper's returned function and parameter uses.
func (c %checker) returnedHelper(
	function *types.Func,
	declaration %syntax.FunctionDeclaration,
	file %syntax.File,
) returnedHelperResolution {
	signature, ok := function.Type().(*types.Signature)
	body := declaration.Body
	if !ok || body == nil || signature.Results().Len() != 1 {
		return noReturnedHelperResolution()
	}
	parameter := -2
	var allowed map[token.Pos]bool = make(map[token.Pos]bool)
	found := false
	valid := true
	inspectGenericBlock(body, func(node %syntax.Node) bool {
		if _, nested := syntax.FunctionLiteralOf(node); nested {
			return false
		}
		statement, ok := syntax.StatementOf(node)
		if !ok {
			return true
		}
		returned := syntax.ReturnStatementOf(statement)
		if returned == nil {
			return true
		}
		if len(returned.Results) != 1 {
			valid = false
			return false
		}
		value := unparenthesized(returned.Results[0])
		candidate := -1
		if name := syntax.IdentifierExpressionOf(value); name != nil {
			candidate = helperParameterIndex(signature, c.facts.Object(name))
			if candidate < 0 {
				valid = false
				return false
			}
			allowed[name.Start] = true
		} else if syntax.FunctionLiteralExpressionOf(value) == nil {
			valid = false
			return false
		}
		if found && candidate != parameter {
			valid = false
			return false
		}
		parameter = candidate
		found = true
		return false
	})
	if !valid || !found {
		return noReturnedHelperResolution()
	}
	c.allowDiscardedHelperParameters(body, signature, allowed)
	rootStatement := syntax.Statement.Block{Value: body}
	root := syntax.StatementNode(&rootStatement)
	helperSummary := &genericEffectSummary{
		function: function, file: file, declaration: declaration,
		parameters: nil, zeroEffects: nil, accessEffects: nil,
		returnedZeroEffects: nil, returnedAccessEffects: nil,
		returnedZeroEffectsAtDepth: nil, returnedAccessEffectsAtDepth: nil,
		calls: nil, returnedValues: nil, returnedBodies: nil, valueUses: nil,
		declarations: nil, reachable: c.reachableNodes(body), root: &root,
		body: body,
	}
	uses := c.usedHelperParameters(helperSummary, signature, allowed)
	return returnedHelperResolution{
		parameter: parameter,
		uses:      uses,
		resolved:  true,
	}
}

func noReturnedHelperResolution() returnedHelperResolution {
	return returnedHelperResolution{
		parameter: -1, uses: nil, resolved: false,
	}
}

func helperParameterIndex(signature *types.Signature, object types.Object) int {
	for index := 0; index < signature.Params().Len(); index++ {
		if signature.Params().At(index) == object {
			return index
		}
	}
	return -1
}

func (c %checker) allowDiscardedHelperParameters(
	body %syntax.BlockStatement,
	signature *types.Signature,
	allowed map[token.Pos]bool,
) {
	inspectGenericBlock(body, func(node %syntax.Node) bool {
		statement, ok := syntax.StatementOf(node)
		if !ok {
			return true
		}
		assignment := syntax.AssignmentStatementOf(statement)
		if assignment == nil || len(assignment.Left) != len(assignment.Right) {
			return true
		}
		for index, target := range assignment.Left {
			blank := syntax.IdentifierExpressionOf(target)
			name := syntax.IdentifierExpressionOf(
				unparenthesized(assignment.Right[index]),
			)
			if blank != nil && blank.Name == "_" && name != nil &&
				helperParameterIndex(signature, c.facts.Object(name)) >= 0 {
				allowed[name.Start] = true
			}
		}
		return true
	})
}

func (c %checker) usedHelperParameters(
	summary %genericEffectSummary,
	signature *types.Signature,
	allowed map[token.Pos]bool,
) []returnedHelperUse {
	var uses []returnedHelperUse = nil
	inspectGenericBlock(summary.body, func(node %syntax.Node) bool {
		expression, ok := syntax.ExpressionOf(node)
		if !ok {
			return true
		}
		name := syntax.IdentifierExpressionOf(expression)
		if name == nil || allowed[name.Start] {
			return true
		}
		index := helperParameterIndex(signature, c.facts.Object(name))
		if index < 0 {
			return true
		}
		use, found := c.helperParameterUse(summary, expression, index)
		if found {
			uses = append(uses, use)
		}
		return true
	})
	return uses
}

func (c %checker) helperParameterUse(
	summary %genericEffectSummary,
	expression %syntax.Expression,
	parameter int,
) (returnedHelperUse, bool) {
	call := c.directCallOf(expression) != nil
	returned := false
	maySkip := false
	var conditions []GenericEffectCondition = nil
	pathNode := syntaxNode(expression)
	for current := c.parents[syntax.ExpressionNode(expression)]; current != nil; current = c.parents[*current] {
		literal, ok := syntax.FunctionLiteralOf(current)
		if !ok || literal == nil {
			continue
		}
		literalExpression, expressionOK := syntax.ExpressionOf(current)
		if !expressionOK || literalExpression == nil {
			return noReturnedHelperUse(), false
		}
		innerConditions, innerMaySkip, reachable := c.helperLiteralUsePath(
			summary, pathNode, literalExpression, literal,
		)
		if !reachable {
			return noReturnedHelperUse(), false
		}
		conditions = append(conditions, innerConditions...)
		maySkip = maySkip || innerMaySkip
		if c.directCallOf(literalExpression) != nil {
			pathNode = syntaxNode(literalExpression)
			continue
		}
		if c.discardedValue(literalExpression) {
			return noReturnedHelperUse(), false
		}
		returned = c.returnedExpression(literalExpression)
		outerConditions, outerMaySkip, outerReachable := c.genericEffectPath(
			summary, syntaxNode(literalExpression),
		)
		if outerReachable {
			conditions = append(conditions, outerConditions...)
			maySkip = maySkip || outerMaySkip
		} else {
			maySkip = true
		}
		return returnedHelperUse{
			parameter: parameter, call: call, returned: returned,
			conditions: conditions, maySkip: maySkip || !returned,
		}, true
	}
	outerConditions, pathMaySkip, reachable := c.genericEffectPath(summary, pathNode)
	if !reachable {
		return noReturnedHelperUse(), false
	}
	return returnedHelperUse{
		parameter: parameter, call: call, returned: returned,
		conditions: append(conditions, outerConditions...),
		maySkip:    maySkip || pathMaySkip,
	}, true
}

func noReturnedHelperUse() returnedHelperUse {
	return returnedHelperUse{
		parameter: -1, call: false, returned: false,
		conditions: nil, maySkip: false,
	}
}

func (c %checker) helperLiteralUsePath(
	summary %genericEffectSummary,
	node %syntax.Node,
	expression %syntax.Expression,
	literal %syntax.FunctionLiteral,
) ([]GenericEffectCondition, bool, bool) {
	root := syntax.ExpressionNode(expression)
	nested := &genericEffectSummary{
		function: summary.function, file: summary.file,
		declaration: summary.declaration, parameters: nil,
		zeroEffects: nil, accessEffects: nil,
		returnedZeroEffects: nil, returnedAccessEffects: nil,
		returnedZeroEffectsAtDepth: nil, returnedAccessEffectsAtDepth: nil,
		calls: nil, returnedValues: nil, returnedBodies: nil, valueUses: nil,
		declarations: nil, reachable: c.reachableNodes(literal.Body), root: &root,
		body: literal.Body,
	}
	return c.genericEffectPath(nested, node)
}

func (c %checker) returnedExpression(expression %syntax.Expression) bool {
	current := expression
	for {
		parent := c.parents[syntax.ExpressionNode(current)]
		if parent == nil {
			return false
		}
		outer, ok := syntax.ExpressionOf(parent)
		if !ok || outer == nil {
			statement, statementOK := syntax.StatementOf(parent)
			if !statementOK || statement == nil {
				return false
			}
			returned := syntax.ReturnStatementOf(statement)
			if returned == nil {
				return false
			}
			for _, result := range returned.Results {
				if result == current {
					return true
				}
			}
			return false
		}
		parentheses := syntax.ParenthesizedExpressionOf(outer)
		if parentheses == nil || parentheses.Expression != current {
			return false
		}
		current = outer
	}
}

func genericSignature(function *types.Func) bool {
	signature, ok := function.Origin().Type().(*types.Signature)
	return ok && (signature.TypeParams().Len() > 0 ||
		signature.RecvTypeParams().Len() > 0)
}
