package tgolint

import (
	"go/constant"
	"go/token"
	"go/types"

	"tgo/internal/compiler"
	"tgo/internal/sourcefacts"
	"tgo/pkg/syntax"
)

// checkErrorReturnModernization finds manual branches that propagation replaces exactly.
func (c %checker) checkErrorReturnModernization(analysis *compiler.AnalysisPackage) {
	if analysis == nil {
		return
	}
	info := analysis.Info
	files := analysis.FileSet
	if info == nil || files == nil {
		return
	}
	for _, source := range analysis.Sources {
		file := source.Syntax
		if file == nil {
			continue
		}
		index := sourcefacts.New(
			file, info, files,
		)
		syntax.Inspect(file, func(node *syntax.Node) bool {
			statements, ok := sourceStatementList(node)
			if !ok || len(statements) < 2 {
				return true
			}
			signature := sourceFunctionSignature(file, node, index)
			for position := 0; position+1 < len(statements); position++ {
				c.checkErrorReturnPair(
					statements[position], statements[position+1],
					signature, index,
				)
			}
			return true
		})
	}
}

// unnamedErrorResults requires unnamed results that end in the Go error type.
func unnamedErrorResults(signature *types.Signature) bool {
	if signature == nil || signature.Results().Len() == 0 {
		return false
	}
	results := signature.Results()
	for index := range results.Len() {
		if results.At(index).Name() != "" {
			return false
		}
	}
	return predeclaredError(results.At(results.Len() - 1).Type())
}

// checkErrorReturnPair reports one exact manual propagation expansion.
func (c %checker) checkErrorReturnPair(
	first %syntax.Statement,
	second %syntax.Statement,
	function *types.Signature,
	index %sourcefacts.Index,
) {
	if !unnamedErrorResults(function) {
		return
	}
	assignment, ok := sourceAssignment(first)
	if !ok || assignment == nil || assignment.Operator != token.DEFINE ||
		len(assignment.Right) != 1 {
		return
	}
	call, ok := sourceCall(assignment.Right[0])
	if !ok || call == nil {
		return
	}
	errorObject, ok := errorReturnAssignment(assignment, call, index)
	if !ok || index.UseCount(errorObject) != 2 {
		return
	}
	branch, ok := sourceIf(second)
	if !ok || branch == nil {
		return
	}
	if !errorReturnBranch(branch, errorObject, function, index) {
		return
	}
	name, ok := syntax.StaticCallName(call.Callee)
	if !ok {
		return
	}
	if errorReturnIdentity(branch, errorObject, index) {
		c.reportResult(
			assignment.Start,
			"manual %s error return matches postfix !!; use postfix !!",
			name,
		)
		return
	}
	if !errorReturnFormat(branch, errorObject, name, index) {
		return
	}
	c.reportResult(
		assignment.Start,
		"manual %s error wrapper matches postfix !; use postfix !",
		name,
	)
}

// errorReturnIdentity proves that the final return is the original error.
func errorReturnIdentity(
	branch %syntax.IfStatement,
	errorObject types.Object,
	index %sourcefacts.Index,
) bool {
	result, ok := sourceReturn(branch.Body.List[0])
	if !ok || result == nil || len(result.Results) == 0 {
		return false
	}
	last := sourceUnparenthesized(result.Results[len(result.Results)-1])
	_, sourceName := sourceIdentifier(last)
	return sourceName && index.IdentifierObject(last) == errorObject
}

// errorReturnAssignment proves the short declaration and its static call.
func errorReturnAssignment(
	assignment %syntax.AssignmentStatement,
	call %syntax.CallExpression,
	index %sourcefacts.Index,
) (types.Object, bool) {
	if index.CalledFunction(call.Callee) == nil {
		return nil, false
	}
	signature, ok := types.Unalias(index.Type(call.Callee)).(*types.Signature)
	if !ok || signature.Results().Len() != len(assignment.Left) ||
		signature.Results().Len() == 0 {
		return nil, false
	}
	last := signature.Results().Len() - 1
	if !predeclaredError(signature.Results().At(last).Type()) {
		return nil, false
	}
	for _, expression := range assignment.Left {
		sourceName, ok := sourceIdentifier(expression)
		if !ok || sourceName.Name != "_" && index.Definition(expression) == nil {
			return nil, false
		}
	}
	sourceName, ok := sourceIdentifier(assignment.Left[last])
	errorObject := index.Definition(assignment.Left[last])
	if !ok || sourceName.Name == "_" || errorObject == nil {
		return nil, false
	}
	return errorObject, true
}

// errorReturnBranch proves the condition, body, and zero return values.
func errorReturnBranch(
	branch %syntax.IfStatement,
	errorObject types.Object,
	function *types.Signature,
	index %sourcefacts.Index,
) bool {
	if branch.Init != nil || branch.Else != nil || len(branch.Body.List) != 1 {
		return false
	}
	if !sameErrorCondition(branch.Condition, errorObject, index) {
		return false
	}
	result, ok := sourceReturn(branch.Body.List[0])
	if !ok || result == nil || len(result.Results) != function.Results().Len() {
		return false
	}
	for position, expression := range result.Results[:len(result.Results)-1] {
		if !exactZeroValue(
			expression, function.Results().At(position).Type(), index,
		) {
			return false
		}
	}
	return true
}

// sameErrorCondition requires the exact err != nil condition.
func sameErrorCondition(
	expression %syntax.Expression,
	errorObject types.Object,
	index %sourcefacts.Index,
) bool {
	comparison, ok := sourceBinary(expression)
	if !ok || comparison == nil || comparison.Operator != token.NEQ {
		return false
	}
	_, leftSource := sourceIdentifier(comparison.Left)
	if !leftSource || index.IdentifierObject(comparison.Left) != errorObject {
		return false
	}
	_, rightSource := sourceIdentifier(comparison.Right)
	return rightSource &&
		index.IdentifierObject(comparison.Right) == types.Universe.Lookup("nil")
}

// errorReturnFormat proves the final return is the wrapper generated by !.
func errorReturnFormat(
	branch %syntax.IfStatement,
	errorObject types.Object,
	name string,
	index %sourcefacts.Index,
) bool {
	result, ok := sourceReturn(branch.Body.List[0])
	if !ok || result == nil || len(result.Results) == 0 {
		return false
	}
	last := result.Results[len(result.Results)-1]
	wrapper, ok := sourceCall(last)
	if !ok || wrapper == nil || wrapper.Ellipsis != token.NoPos ||
		len(wrapper.Args) != 2 {
		return false
	}
	function := index.CalledFunction(wrapper.Callee)
	if function == nil || function.Name() != "Errorf" || function.Pkg() == nil ||
		function.Pkg().Path() != "fmt" {
		return false
	}
	format := index.Constant(wrapper.Args[0])
	if format == nil || format.Kind() != constant.String ||
		constant.StringVal(format) != name+": %w" {
		return false
	}
	argument := sourceUnparenthesized(wrapper.Args[1])
	_, sourceName := sourceIdentifier(argument)
	return sourceName && index.IdentifierObject(argument) == errorObject
}

// exactZeroValue proves that an expression has the result type's zero value.
func exactZeroValue(
	expression %syntax.Expression,
	resultType types.Type,
	index %sourcefacts.Index,
) bool {
	expression = sourceUnparenthesized(expression)
	if _, ok := sourceIdentifier(expression); ok {
		if index.IdentifierObject(expression) == types.Universe.Lookup("nil") {
			return types.AssignableTo(types.Typ[types.UntypedNil], resultType)
		}
	}
	if value := index.Constant(expression); value != nil {
		return zeroConstant(value)
	}
	literal, ok := sourceCompositeLiteral(expression)
	if !ok || len(literal.Elements) != 0 ||
		!types.Identical(index.Type(expression), resultType) {
		return false
	}
	switch coreType(resultType).(type) {
	case *types.Array, *types.Struct:
		return true
	}
	return false
}

// zeroConstant reports whether a compile-time value is its type's zero value.
func zeroConstant(value constant.Value) bool {
	switch value.Kind() {
	case constant.Bool:
		return !constant.BoolVal(value)
	case constant.String:
		return constant.StringVal(value) == ""
	case constant.Int, constant.Float, constant.Complex:
		return constant.Compare(value, token.EQL, constant.MakeInt64(0))
	}
	return false
}

// predeclaredError reports whether a type is the Go error interface.
func predeclaredError(typ types.Type) bool {
	object := types.Universe.Lookup("error")
	return object != nil && types.Identical(typ, object.Type())
}
