package tgolint

import (
	"go/token"
	"go/types"
)

func applyStorageOperation(
	state %storageExecutionState,
	call storageGraphCall,
	operation StorageEffectOperation,
	context %storageExecutionContext,
) {
	state.effects.zero = appendGenericEffects(
		state.effects.zero, operation.ZeroEffects,
	)
	state.effects.access = appendGenericEffects(
		state.effects.access, operation.AccessEffects,
	)
	switch operation.Kind {
	case storageEffectRead:
		value := readStorageRegion(state.storage, call, operation.Source)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectWrite:
		value := storageInput(state.temps, operation.Inputs, 0)
		writeStorageRegion(state.storage, call, operation.Target, value)
	case storageEffectFunction:
		var captures []storagePath = nil
		for _, region := range operation.Regions {
			captures = append(captures, resolveStoragePaths(call, region)...)
		}
		value := storageValue{functions: []storageFunction{{
			graph: operation.Function, fact: call.fact, captures: captures,
			receiverArguments: append([]types.Type(nil), call.receiverArguments...),
			typeArguments:     append([]types.Type(nil), call.typeArguments...),
		}}}
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectCall:
		arguments := storageInputs(state.temps, operation.Inputs)
		var functions []storageFunction = nil
		if operation.Function >= 0 {
			if len(arguments) != 0 {
				arguments = arguments[1:]
			}
			functions = append(functions, storageFunction{
				graph: operation.Function, fact: call.fact,
				receiverArguments: projectStorageTypeArguments(
					call.receiverArguments, call.typeArguments,
					operation.ReceiverArguments,
				),
				typeArguments: projectStorageTypeArguments(
					call.receiverArguments, call.typeArguments,
					operation.TypeArguments,
				),
			})
		} else if len(arguments) != 0 {
			functions = append(functions, arguments[0].functions...)
			arguments = arguments[1:]
		}
		var results []storageValue = nil
		before := cloneStorageState(state.storage)
		var transferred storageState
		firstTransfer := true
		for _, function := range functions {
			caller := call.fact
			callerGraph := call.function
			callSite := operation.Position
			if call.caller != nil {
				caller = call.caller
				callerGraph = call.callerGraph
				callSite = call.callSite
			}
			nested := storageGraphCall{
				fact: function.fact, function: function.graph,
				arguments: arguments, captures: function.captures,
				receiverArguments: function.receiverArguments,
				typeArguments:     function.typeArguments,
				caller:            caller, callerGraph: callerGraph, callSite: callSite,
				summary: call.summary || storageCallOperationRepeated(
					call.fact.Storage, call.function, operation.Position,
				),
			}
			input := storageCallInputState(before, arguments, function.captures)
			updated, returned, effects := executeStorageFunction(nested, input, context)
			if operation.Function >= 0 && len(operation.TypeArguments) != 0 {
				effects.zero = projectStorageEffects(
					effects.zero, operation.ReceiverArguments,
					operation.TypeArguments, operation.CalledParameters,
				)
				effects.access = projectStorageEffects(
					effects.access, operation.ReceiverArguments,
					operation.TypeArguments, operation.CalledParameters,
				)
			}
			state.effects.zero = appendGenericEffects(
				state.effects.zero, effects.zero,
			)
			state.effects.access = appendGenericEffects(
				state.effects.access, effects.access,
			)
			if !effects.completed {
				continue
			}
			updated = projectStorageCallerState(before, updated, returned)
			if firstTransfer {
				transferred = updated
				firstTransfer = false
			} else {
				transferred = joinStorageState(transferred, updated)
			}
			for index, value := range returned {
				for len(results) <= index {
					results = append(results, storageValue{})
				}
				results[index] = joinStorageValue(results[index], value)
			}
		}
		if !firstTransfer {
			state.storage = transferred
		} else if len(functions) != 0 {
			state.live = false
		}
		setStorageResults(state.temps, operation.Results, results)
	case storageEffectAllocate:
		location := storageLocation{
			owner: call.fact, graph: call.function, site: operation.Target.ID,
			kind:   storageRootAllocation,
			caller: call.caller, callerGraph: call.callerGraph,
			callSite: call.callSite,
			merged: call.summary || storageAllocationRepeated(
				call.fact.Storage, call.function, operation.Target.ID,
			),
		}
		value := storageValue{regions: []storagePath{{
			location: location,
		}}}
		value.slices = []storageSlice{{
			backing: location,
			length:  operation.Length, capacity: operation.Capacity,
			knownOffset:   true,
			knownLength:   operation.KnownLength,
			knownCapacity: operation.KnownCapacity,
		}}
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectAppend:
		applyStorageAppend(state, call, operation)
	case storageEffectCopy:
		applyStorageCopy(state, operation)
	case storageEffectSlice:
		value := storageInput(state.temps, operation.Inputs, 0)
		operation = storageSliceOperation(state.temps, operation)
		value = resliceStorageValue(value, operation)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectReturn:
		state.returns = storageInputs(state.temps, operation.Inputs)
	case storageEffectIndexRead:
		base := storageInput(state.temps, operation.Inputs, 0)
		operation = storageIndexOperation(state.temps, operation)
		value := readStorageIndex(state.storage, base, operation)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectIndexWrite:
		base := storageInput(state.temps, operation.Inputs, 0)
		operation = storageIndexOperation(state.temps, operation)
		value := storageInput(state.temps, operation.Inputs, 2)
		writeStorageIndex(state.storage, base, operation, value)
	case storageEffectFieldRead:
		base := storageInput(state.temps, operation.Inputs, 0)
		value := readStorageField(state.storage, base, operation.Field)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectFieldWrite:
		base := storageInput(state.temps, operation.Inputs, 0)
		value := storageInput(state.temps, operation.Inputs, 1)
		writeStorageField(state.storage, base, operation.Field, value)
	case storageEffectBoolean:
		value := storageValue{trueValue: operation.Boolean, falseValue: !operation.Boolean}
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectInteger:
		value := storageValue{integer: operation.Length, integerKnown: operation.KnownLength}
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectUnary:
		value := storageUnaryValue(
			token.Token(operation.Operator), storageInput(state.temps, operation.Inputs, 0),
		)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	case storageEffectBinary:
		value := storageBinaryValue(
			token.Token(operation.Operator),
			storageInput(state.temps, operation.Inputs, 0),
			storageInput(state.temps, operation.Inputs, 1),
		)
		setStorageResults(state.temps, operation.Results, []storageValue{value})
	}
}

func storageIndexOperation(
	temps map[int]storageValue,
	operation StorageEffectOperation,
) StorageEffectOperation {
	if len(operation.Inputs) < 2 {
		return operation
	}
	index := storageInput(temps, operation.Inputs, 1)
	operation.Length = index.integer
	operation.KnownLength = index.integerKnown
	return operation
}

func storageSliceOperation(
	temps map[int]storageValue,
	operation StorageEffectOperation,
) StorageEffectOperation {
	if len(operation.Inputs) < 4 {
		return operation
	}
	if operation.Inputs[1] >= 0 {
		low := storageInput(temps, operation.Inputs, 1)
		operation.Offset = low.integer
		operation.KnownOffset = low.integerKnown
	}
	if operation.Inputs[2] >= 0 {
		high := storageInput(temps, operation.Inputs, 2)
		operation.Length = high.integer
		operation.KnownLength = high.integerKnown
	}
	if operation.Inputs[3] >= 0 {
		maximum := storageInput(temps, operation.Inputs, 3)
		operation.Capacity = maximum.integer
		operation.KnownCapacity = maximum.integerKnown
	}
	return operation
}

func projectStorageCallerState(
	before storageState,
	updated storageState,
	returned []storageValue,
) storageState {
	locations := make(map[storageLocation]bool)
	for path := range before.memory {
		locations[path.location] = true
	}
	for _, value := range before.cells {
		addStorageValueLocations(locations, value)
	}
	for _, value := range returned {
		addStorageValueLocations(locations, value)
	}
	expandStorageLocations(updated, locations)
	result := cloneStorageState(before)
	for path, value := range updated.memory {
		if locations[path.location] {
			result.memory[path] = cloneStorageValue(value)
		}
	}
	return result
}

func storageCallInputState(
	state storageState,
	arguments []storageValue,
	captures []storagePath,
) storageState {
	locations := make(map[storageLocation]bool)
	for _, argument := range arguments {
		addStorageValueLocations(locations, argument)
	}
	for _, capture := range captures {
		locations[capture.location] = true
	}
	expandStorageLocations(state, locations)
	result := newStorageState()
	for path, value := range state.memory {
		if locations[path.location] {
			result.memory[path] = cloneStorageValue(value)
		}
	}
	return result
}

func expandStorageLocations(
	state storageState,
	locations map[storageLocation]bool,
) {
	values := make(map[storageLocation][]storageValue)
	for path, value := range state.memory {
		values[path.location] = append(values[path.location], value)
	}
	queue := make([]storageLocation, 0, len(locations))
	for location := range locations {
		queue = append(queue, location)
	}
	processed := make(map[storageLocation]bool)
	for len(queue) != 0 {
		location := queue[0]
		queue = queue[1:]
		if processed[location] {
			continue
		}
		processed[location] = true
		beforeCount := len(locations)
		for _, value := range values[location] {
			addStorageValueLocations(locations, value)
		}
		if len(locations) == beforeCount {
			continue
		}
		for found := range locations {
			if !processed[found] {
				queue = append(queue, found)
			}
		}
	}
}

func addStorageValueLocations(
	locations map[storageLocation]bool,
	value storageValue,
) {
	for _, region := range value.regions {
		locations[region.location] = true
	}
	for _, slice := range value.slices {
		locations[slice.backing] = true
	}
	for _, function := range value.functions {
		for _, capture := range function.captures {
			locations[capture.location] = true
		}
	}
}

func projectStorageTypeArguments(
	receiverArguments []types.Type,
	typeArguments []types.Type,
	projection []int,
) []types.Type {
	result := make([]types.Type, len(projection))
	for index, source := range projection {
		if source >= 0 && source < len(typeArguments) {
			result[index] = typeArguments[source]
		} else if source <= -2 {
			receiver := -source - 2
			if receiver < len(receiverArguments) {
				result[index] = receiverArguments[receiver]
			}
		}
	}
	return result
}

func storageUnaryValue(operator token.Token, value storageValue) storageValue {
	if operator == token.NOT && value.trueValue != value.falseValue {
		return storageValue{trueValue: value.falseValue, falseValue: value.trueValue}
	}
	return storageValue{unknown: true}
}

func storageBinaryValue(
	operator token.Token,
	left storageValue,
	right storageValue,
) storageValue {
	leftBoolean, leftKnown := storageBoolean(left)
	rightBoolean, rightKnown := storageBoolean(right)
	if operator == token.LAND {
		if leftKnown && !leftBoolean || rightKnown && !rightBoolean {
			return storageValue{falseValue: true}
		}
		if leftKnown && leftBoolean {
			return right
		}
		if rightKnown && rightBoolean {
			return left
		}
	}
	if operator == token.LOR {
		if leftKnown && leftBoolean || rightKnown && rightBoolean {
			return storageValue{trueValue: true}
		}
		if leftKnown && !leftBoolean {
			return right
		}
		if rightKnown && !rightBoolean {
			return left
		}
	}
	if operator == token.EQL || operator == token.NEQ {
		equal, known := storageScalarEqual(left, right)
		if known {
			if operator == token.NEQ {
				equal = !equal
			}
			return storageValue{trueValue: equal, falseValue: !equal}
		}
	}
	return storageValue{unknown: true}
}

func storageBoolean(value storageValue) (bool, bool) {
	if value.trueValue == value.falseValue {
		return false, false
	}
	return value.trueValue, true
}

func storageScalarEqual(left storageValue, right storageValue) (bool, bool) {
	if leftBoolean, leftKnown := storageBoolean(left); leftKnown {
		rightBoolean, rightKnown := storageBoolean(right)
		return leftBoolean == rightBoolean, rightKnown
	}
	if left.integerKnown && right.integerKnown {
		return left.integer == right.integer, true
	}
	return false, false
}

func projectStorageEffects(
	effects []GenericEffect,
	receiverProjection []int,
	projection []int,
	parameters []int,
) []GenericEffect {
	var result []GenericEffect = nil
	for _, effect := range effects {
		targetProjection := projection
		if effect.Receiver {
			targetProjection = receiverProjection
		}
		if effect.TypeParameter < 0 || effect.TypeParameter >= len(targetProjection) {
			continue
		}
		target := targetProjection[effect.TypeParameter]
		if target == -1 {
			continue
		}
		effect.Receiver = target <= -2
		if effect.Receiver {
			effect.TypeParameter = -target - 2
		} else {
			effect.TypeParameter = target
		}
		for index := range effect.Conditions {
			condition := &effect.Conditions[index]
			if condition.ValueParameter < 0 ||
				condition.ValueParameter >= len(parameters) ||
				parameters[condition.ValueParameter] < 0 {
				effect.MaySkip = true
				effect.Conditions = nil
				break
			}
			condition.ValueParameter = parameters[condition.ValueParameter]
			if condition.OtherParameter >= 0 {
				if condition.OtherParameter >= len(parameters) ||
					parameters[condition.OtherParameter] < 0 {
					effect.MaySkip = true
					effect.Conditions = nil
					break
				}
				condition.OtherParameter = parameters[condition.OtherParameter]
			}
		}
		result = appendGenericEffects(result, []GenericEffect{effect})
	}
	return result
}

func resliceStorageValue(
	value storageValue,
	operation StorageEffectOperation,
) storageValue {
	for index, slice := range value.slices {
		low := operation.Offset
		if !operation.KnownOffset {
			slice.knownOffset = false
			slice.knownLength = false
			slice.knownCapacity = false
			value.slices[index] = slice
			continue
		}
		slice.offset += low
		slice.knownOffset = slice.knownOffset || low == 0
		if operation.KnownLength {
			slice.length = operation.Length - low
			slice.knownLength = true
		} else if slice.knownLength {
			slice.length -= low
		}
		if operation.KnownCapacity {
			slice.capacity = operation.Capacity - low
			slice.knownCapacity = true
		} else if slice.knownCapacity {
			slice.capacity -= low
		}
		value.slices[index] = slice
	}
	return value
}

func readStorageIndex(
	state storageState,
	base storageValue,
	operation StorageEffectOperation,
) storageValue {
	step := StorageEffectPath{Kind: storagePathAnyIndex}
	if operation.KnownLength {
		step = StorageEffectPath{Kind: storagePathIndex, Index: operation.Length}
	}
	var value storageValue
	for _, slice := range base.slices {
		current := step
		if operation.KnownLength && slice.knownOffset {
			current.Index += slice.offset
		} else {
			current = StorageEffectPath{Kind: storagePathAnyIndex}
		}
		path := storagePath{location: slice.backing, steps: []StorageEffectPath{current}}
		value = joinStorageValue(value, readStorageMemory(state, storageMemoryKey(path)))
	}
	for _, region := range base.regions {
		region.steps = append(region.steps, step)
		value = joinStorageValue(value, readStorageMemory(state, storageMemoryKey(region)))
	}
	return value
}

func writeStorageIndex(
	state storageState,
	base storageValue,
	operation StorageEffectOperation,
	value storageValue,
) {
	step := StorageEffectPath{Kind: storagePathAnyIndex}
	if operation.KnownLength {
		step = StorageEffectPath{Kind: storagePathIndex, Index: operation.Length}
	}
	targetCount := len(base.slices) + len(base.regions)
	exact := operation.KnownLength && targetCount == 1
	for _, slice := range base.slices {
		current := step
		if operation.KnownLength && slice.knownOffset {
			current.Index += slice.offset
		} else {
			current = StorageEffectPath{Kind: storagePathAnyIndex}
			exact = false
		}
		path := storagePath{location: slice.backing, steps: []StorageEffectPath{current}}
		writeStorageMemory(state, storageMemoryKey(path), value, exact)
	}
	for _, region := range base.regions {
		region.steps = append(region.steps, step)
		writeStorageMemory(state, storageMemoryKey(region), value, exact)
	}
}

func readStorageField(
	state storageState,
	base storageValue,
	field string,
) storageValue {
	var value storageValue
	for _, region := range base.regions {
		region.steps = append(region.steps, StorageEffectPath{
			Kind: storagePathField, Field: field,
		})
		value = joinStorageValue(value, readStorageMemory(state, storageMemoryKey(region)))
	}
	return value
}

func writeStorageField(
	state storageState,
	base storageValue,
	field string,
	value storageValue,
) {
	for _, region := range base.regions {
		region.steps = append(region.steps, StorageEffectPath{
			Kind: storagePathField, Field: field,
		})
		writeStorageMemory(state, storageMemoryKey(region), value, len(base.regions) == 1)
	}
}

func storageInputs(values map[int]storageValue, inputs []int) []storageValue {
	result := make([]storageValue, 0, len(inputs))
	for _, input := range inputs {
		result = append(result, cloneStorageValue(values[input]))
	}
	return result
}

func storageInput(values map[int]storageValue, inputs []int, index int) storageValue {
	if index < 0 || index >= len(inputs) {
		return storageValue{unknown: true}
	}
	return cloneStorageValue(values[inputs[index]])
}

func setStorageResults(
	target map[int]storageValue,
	results []int,
	values []storageValue,
) {
	for index, result := range results {
		if index < len(values) {
			target[result] = cloneStorageValue(values[index])
		} else {
			target[result] = storageValue{unknown: true}
		}
	}
}

func readStorageRegion(
	state storageState,
	call storageGraphCall,
	region StorageEffectRegion,
) storageValue {
	if region.Root == storageRootParameter && len(region.Path) == 0 &&
		region.ID >= 0 && region.ID < len(call.parameterCells) {
		return readStorageMemory(
			state, storageMemoryKey(call.parameterCells[region.ID]),
		)
	}
	paths := resolveStoragePaths(call, region)
	var value storageValue
	for _, path := range paths {
		value = joinStorageValue(value, readStorageMemory(state, storageMemoryKey(path)))
	}
	if len(paths) == 0 {
		value.unknown = true
	}
	return value
}

func writeStorageRegion(
	state storageState,
	call storageGraphCall,
	region StorageEffectRegion,
	value storageValue,
) {
	paths := resolveStoragePaths(call, region)
	exact := len(paths) == 1 && !paths[0].location.merged &&
		storageWirePathExact(region.Path)
	for _, path := range paths {
		writeStorageMemory(state, storageMemoryKey(path), value, exact)
	}
}

func resolveStoragePaths(
	call storageGraphCall,
	region StorageEffectRegion,
) []storagePath {
	var paths []storagePath = nil
	if region.Root == storageRootParameter &&
		region.ID >= 0 && region.ID < len(call.parameterCells) {
		paths = append(paths, call.parameterCells[region.ID])
	}
	if region.Root == storageRootCapture &&
		region.ID >= 0 && region.ID < len(call.captures) {
		paths = append(paths, call.captures[region.ID])
	}
	if region.Root == storageRootAllocation || region.Root == storageRootResult {
		paths = append(paths, storagePath{location: storageLocation{
			owner: call.fact, graph: call.function, site: region.ID, kind: region.Root,
			caller: call.caller, callerGraph: call.callerGraph,
			callSite: call.callSite,
		}})
	}
	for index := range paths {
		paths[index].steps = append(paths[index].steps, region.Path...)
	}
	return paths
}

func storageWirePathExact(path []StorageEffectPath) bool {
	for _, step := range path {
		if step.Kind == storagePathAnyIndex {
			return false
		}
	}
	return true
}

func applyStorageAppend(
	state %storageExecutionState,
	call storageGraphCall,
	operation StorageEffectOperation,
) {
	base := storageInput(state.temps, operation.Inputs, 0)
	values := storageInputs(state.temps, operation.Inputs[1:])
	base = appendStorageValue(
		state.storage, base, values, operation.Variadic,
		storageLocation{
			owner: call.fact, graph: call.function, site: operation.Target.ID,
			kind: storageRootAllocation,
		},
	)
	setStorageResults(state.temps, operation.Results, []storageValue{base})
}

func appendStorageValue(
	state storageState,
	base storageValue,
	values []storageValue,
	variadic bool,
	freshLocation storageLocation,
) storageValue {
	var slices []storageSlice = nil
	for _, slice := range base.slices {
		if variadic && len(values) == 1 {
			for _, source := range values[0].slices {
				slices = append(slices, appendStorageSlice(
					state, slice, nil, &source, freshLocation,
				)...)
			}
			if len(values[0].slices) == 0 {
				source := storageSlice{backing: freshLocation}
				slices = append(slices, appendStorageSlice(
					state, slice, nil, &source, freshLocation,
				)...)
			}
			continue
		}
		slices = append(slices, appendStorageSlice(
			state, slice, values, nil, freshLocation,
		)...)
	}
	base.regions = nil
	base.slices = slices
	return base
}

func appendStorageSlice(
	state storageState,
	slice storageSlice,
	values []storageValue,
	variadic *storageSlice,
	freshLocation storageLocation,
) []storageSlice {
	added := int64(len(values))
	addedKnown := true
	if variadic != nil {
		added = variadic.length
		addedKnown = variadic.knownLength
	}
	var slices []storageSlice = nil
	forceFresh := slice.knownCapacity && addedKnown && slice.length+added > slice.capacity
	reuse := !forceFresh
	if reuse {
		reused := slice
		if variadic != nil {
			target := reused
			target.offset += reused.length
			target.length = added
			target.knownLength = addedKnown
			copyStorageSliceElements(state, target, *variadic, false)
		} else {
			for index, value := range values {
				writeStorageSliceIndex(state, reused, reused.length+int64(index), value, false)
			}
		}
		reused.length += added
		reused.knownLength = reused.knownLength && addedKnown
		slices = append(slices, reused)
	}
	if !slice.knownCapacity || !addedKnown || forceFresh {
		fresh := storageSlice{
			backing: freshLocation, knownOffset: true,
			length:      slice.length + added,
			knownLength: slice.knownLength && addedKnown,
		}
		copyStorageSliceElements(state, fresh, slice, false)
		if variadic != nil {
			target := fresh
			target.offset = slice.length
			target.length = added
			target.knownLength = addedKnown
			copyStorageSliceElements(state, target, *variadic, false)
		} else {
			for index, value := range values {
				writeStorageSliceIndex(state, fresh, slice.length+int64(index), value, false)
			}
		}
		slices = append(slices, fresh)
	}
	return slices
}

func writeStorageSliceIndex(
	state storageState,
	slice storageSlice,
	index int64,
	value storageValue,
	exact bool,
) {
	path := storagePath{location: slice.backing, steps: []StorageEffectPath{{
		Kind: storagePathIndex, Index: slice.offset + index,
	}}}
	writeStorageMemory(state, storageMemoryKey(path), value, exact)
}

func applyStorageCopy(
	state %storageExecutionState,
	operation StorageEffectOperation,
) {
	if len(operation.Inputs) < 2 {
		return
	}
	count := copyStorageSlices(
		state.storage,
		state.temps[operation.Inputs[0]],
		state.temps[operation.Inputs[1]],
	)
	setStorageResults(state.temps, operation.Results, []storageValue{count})
}
