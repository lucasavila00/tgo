package tgolint

import (
	"go/ast"
	"go/token"
	"go/types"
	"path/filepath"

	"tgo/internal/compiler"

	"golang.org/x/tools/go/cfg"
)

type nilValue enum {
	Unknown struct{}
	NonNil struct{}
	Nil struct{}
}

func unknownNilValue() nilValue { return nilValue.Unknown{} }
func nonNilValue() nilValue { return nilValue.NonNil{} }
func provenNilValue() nilValue { return nilValue.Nil{} }

func isUnknownNilValue(value nilValue) bool {
	switch enumValue21 := value; enumValue21.Tag() {
	case nilValueTagUnknown:
		return true
	case nilValueTagNonNil:
		return false
	case nilValueTagNil:
		return false
	default:
		panic(enumValue21.UnknownTag()) // unreachable: tgolint requires a case per tag
	}
}

func isNonNilValue(value nilValue) bool {
	switch enumValue22 := value; enumValue22.Tag() {
	case nilValueTagUnknown:
		return false
	case nilValueTagNonNil:
		return true
	case nilValueTagNil:
		return false
	default:
		panic(enumValue22.UnknownTag()) // unreachable: tgolint requires a case per tag
	}
}

func isProvenNilValue(value nilValue) bool {
	switch enumValue23 := value; enumValue23.Tag() {
	case nilValueTagUnknown:
		return false
	case nilValueTagNonNil:
		return false
	case nilValueTagNil:
		return true
	default:
		panic(enumValue23.UnknownTag()) // unreachable: tgolint requires a case per tag
	}
}

func equalNilValue(left nilValue, right nilValue) bool {
	switch enumValue24 := left; enumValue24.Tag() {
	case nilValueTagUnknown:
		return isUnknownNilValue(right)
	case nilValueTagNonNil:
		return isNonNilValue(right)
	case nilValueTagNil:
		return isProvenNilValue(right)
	default:
		panic(enumValue24.UnknownTag()) // unreachable: tgolint requires a case per tag
	}
}

type nilPlace struct {
	object types.Object
	path   string
}

type nilFacts map[nilPlace]nilValue

type nilGuard struct {
	trueFacts  nilFacts
	falseFacts nilFacts
}

type nilPresence struct {
	value    nilPlace
	nonNil  bool
}

type nilFlowState struct {
	values    map[nilPlace]nilValue
	aliases   map[nilPlace]nilPlace
	guards    map[types.Object]nilGuard
	presence  map[types.Object]nilPresence
}

type nilFlow struct {
	before map[ast.Node]*nilFlowState
}

// checkTGoSource runs checks that need the typed TGo source package.
func (c %checker) checkTGoSource(analysis *compiler.AnalysisPackage) {
	c.checkNilSafety(analysis)
	c.checkIotaModernization(analysis)
	c.checkErrorReturnModernization(analysis)
}

// setGeneratedOutputs records the current compiler output for integrity checks.
func (c %checker) setGeneratedOutputs(analysis *compiler.AnalysisPackage) {
	if analysis == nil {
		return
	}
	for _, source := range analysis.Sources {
		c.outputs[source.Name] = source.Output
	}
}

// analyzeTGoPackage loads TGo source once for all source checks.
func (c %checker) analyzeTGoPackage() *compiler.AnalysisPackage {
	directory := c.packageDirectory()
	if directory == "" {
		return nil
	}
	analysis, err := compiler.AnalyzePackage(
		directory, c.pass.Pkg.Path(), c.pass.Fset,
	)
	if err != nil {
		c.reportResult(c.pass.Files[0].Package, "analyze TGo source: %v", err)
		return nil
	}
	return analysis
}

// checkNilSafety checks `%T` contracts in TGo and Go source.
func (c %checker) checkNilSafety(analysis *compiler.AnalysisPackage) {
	goFiles := make([]*ast.File, 0, len(c.pass.Files))
	for _, file := range c.pass.Files {
		if !c.generated[file] {
			goFiles = append(goFiles, file)
		}
	}
	goEnvironment := newNilEnvironment(
		c.pass, goFiles, c.pass.TypesInfo, c.pass.Pkg, nil,
	)
	goEnvironment.collectNilContracts()

	if analysis != nil {
		projected := make([]*ast.File, 0, len(analysis.Sources))
		for _, source := range analysis.Sources {
			projected = append(projected, source.Projected)
		}
		sourceEnvironment := newNilEnvironment(
			c.pass, projected, analysis.Info, analysis.Package,
			analysis.NonNil,
		)
		sourceEnvironment.collectNilContracts()
		sourceEnvironment.files = userSourceFiles(analysis)
		sourceEnvironment.copyPackageContracts(goEnvironment)
		sourceEnvironment.exportContracts(c.pass)
		sourceEnvironment.checkNilFiles()
	}
	goEnvironment.checkNilFiles()
}

// userSourceFiles removes generated declarations from source checks.
func userSourceFiles(analysis %compiler.AnalysisPackage) []*ast.File {
	result := make([]*ast.File, 0, len(analysis.Sources))
	for _, source := range analysis.Sources {
		file := *source.Projected
		file.Decls = make([]ast.Decl, 0, len(source.Projected.Decls))
		for _, declaration := range source.Projected.Decls {
			if !source.Generated[declaration] {
				file.Decls = append(file.Decls, declaration)
			}
		}
		result = append(result, &file)
	}
	return result
}

// packageDirectory returns the directory that owns the loaded package.
func (c %checker) packageDirectory() string {
	for _, file := range c.pass.Files {
		name := c.pass.Fset.Position(file.Package).Filename
		if name == "" {
			continue
		}
		directory := filepath.Dir(name)
		sources, err := filepath.Glob(filepath.Join(directory, "*.tgo"))
		if err == nil && len(sources) != 0 {
			return directory
		}
	}
	return ""
}

// copyPackageContracts maps source objects to their generated Go objects.
func (e %nilEnvironment) copyPackageContracts(target %nilEnvironment) {
	for object, contract := range e.contracts {
		mapped := mapNilObject(object, e.pkg, target.pkg)
		if mapped != nil {
			target.contracts[mapped] = cloneNilContract(contract)
		}
	}
}

// checkNilFiles checks global values and each function body.
func (e %nilEnvironment) checkNilFiles() {
	e.checkNilGlobals()
	for _, file := range e.files {
		ast.Inspect(file, func(node ast.Node) bool {
			switch node := node.(type) {
			case *ast.FuncDecl:
				if node.Body != nil {
					e.checkNilFunction(node, node.Type, node.Body)
				}
				return false
			case *ast.FuncLit:
				e.checkNilFunction(node, node.Type, node.Body)
				return false
			}
			return true
		})
	}
}

// checkNilGlobals checks package variable initializers in source order.
func (e %nilEnvironment) checkNilGlobals() {
	state := newNilState()
	for _, file := range e.files {
		for _, declaration := range file.Decls {
			general, ok := declaration.(*ast.GenDecl)
			if !ok || general.Tok != token.VAR {
				continue
			}
			for _, item := range general.Specs {
				values, ok := item.(*ast.ValueSpec)
				if !ok {
					continue
				}
				e.checkNilValues(state, values)
				e.transferNilValues(state, values.Names, values.Values)
				if values.Type == nil {
					e.inferNilContracts(values.Names, values.Values)
				}
			}
		}
	}
}

// checkNilFunction solves and checks one function control-flow graph.
func (e %nilEnvironment) checkNilFunction(
	root ast.Node,
	typ *ast.FuncType,
	body *ast.BlockStmt,
) {
	graph := cfg.New(body, e.nilCallMayReturn)
	entries := e.solveNilEntries(graph, e.nilEntryState(root, typ))
	flow := &nilFlow{before: make(map[ast.Node]*nilFlowState)}
	e.recordNilEntries(flow, graph, entries)
	for _, block := range graph.Blocks {
		entry := entries[block.Index]
		if entry == nil {
			continue
		}
		state := cloneNilState(entry)
		e.prepareNilBlock(state, block)
		for _, node := range block.Nodes {
			e.transferNilNode(state, node, root, true)
		}
	}
}

func (e %nilEnvironment) nilCallMayReturn(call *ast.CallExpr) bool {
	name, ok := call.Fun.(*ast.Ident)
	if !ok {
		return true
	}
	builtin, ok := e.info.Uses[name].(*types.Builtin)
	return !ok || builtin.Name() != "panic"
}

func (e %nilEnvironment) nilEntryState(
	root ast.Node,
	function *ast.FuncType,
) *nilFlowState {
	state := newNilState()
	if declaration, ok := root.(*ast.FuncDecl); ok && declaration.Recv != nil {
		for _, field := range declaration.Recv.List {
			for _, name := range field.Names {
				object := e.info.Defs[name]
				if e.contractForObject(object)[""] {
					e.setNilValue(state, nilPlace{object: object, path: ""}, nonNilValue())
				}
			}
		}
	}
	if function == nil || function.Params == nil {
		return state
	}
	for _, field := range function.Params.List {
		for _, name := range field.Names {
			object := e.info.Defs[name]
			if len(e.contractForObject(object)) != 0 {
				e.setNilValue(state, nilPlace{object: object, path: ""}, nonNilValue())
			}
		}
	}
	return state
}

func newNilState() %nilFlowState {
	return &nilFlowState{
		values: make(map[nilPlace]nilValue),
		aliases: make(map[nilPlace]nilPlace),
		guards: make(map[types.Object]nilGuard),
		presence: make(map[types.Object]nilPresence),
	}
}

func cloneNilState(source *nilFlowState) *nilFlowState {
	if source == nil {
		return nil
	}
	result := newNilState()
	for place, value := range source.values {
		result.values[place] = value
	}
	for place, representative := range source.aliases {
		result.aliases[place] = representative
	}
	for object, guard := range source.guards {
		result.guards[object] = cloneNilGuard(guard)
	}
	for object, presence := range source.presence {
		result.presence[object] = presence
	}
	return result
}

func cloneNilGuard(guard nilGuard) nilGuard {
	return nilGuard{
		trueFacts: cloneNilFacts(guard.trueFacts),
		falseFacts: cloneNilFacts(guard.falseFacts),
	}
}

func cloneNilFacts(source nilFacts) nilFacts {
	if len(source) == 0 {
		return nil
	}
	result := make(nilFacts, len(source))
	for place, value := range source {
		result[place] = value
	}
	return result
}

// solveNilEntries computes stable facts at each control-flow block entry.
func (e %nilEnvironment) solveNilEntries(
	graph *cfg.CFG,
	entry *nilFlowState,
) []*nilFlowState {
	entries := make([]*nilFlowState, len(graph.Blocks))
	entries[0] = entry
	queued := make([]bool, len(graph.Blocks))
	queue := []*cfg.Block{graph.Blocks[0]}
	queued[0] = true
	for len(queue) != 0 {
		block := queue[0]
		queue = queue[1:]
		queued[block.Index] = false
		state := cloneNilState(entries[block.Index])
		e.prepareNilBlock(state, block)
		for _, node := range block.Nodes {
			e.transferNilNode(state, node, nil, false)
		}
		for index, successor := range block.Succs {
			next := cloneNilState(state)
			if len(block.Succs) == 2 {
				trueFacts, falseFacts := e.blockNilFacts(block, state)
				if index == 0 {
					e.applyNilFacts(next, trueFacts)
				} else {
					e.applyNilFacts(next, falseFacts)
				}
			}
			joined, changed := joinNilStates(entries[successor.Index], next)
			if !changed {
				continue
			}
			entries[successor.Index] = joined
			if !queued[successor.Index] {
				queue = append(queue, successor)
				queued[successor.Index] = true
			}
		}
	}
	return entries
}

func (e %nilEnvironment) recordNilEntries(
	flow %nilFlow,
	graph *cfg.CFG,
	entries []*nilFlowState,
) {
	for _, block := range graph.Blocks {
		if entries[block.Index] == nil {
			continue
		}
		state := cloneNilState(entries[block.Index])
		e.prepareNilBlock(state, block)
		for _, node := range block.Nodes {
			flow.before[node] = cloneNilState(state)
			e.transferNilNode(state, node, nil, false)
		}
	}
}

// joinNilStates keeps facts that agree on all incoming paths.
func joinNilStates(
	current *nilFlowState,
	incoming *nilFlowState,
) (*nilFlowState, bool) {
	if current == nil {
		return cloneNilState(incoming), true
	}
	joined := newNilState()
	for place, value := range current.values {
		if incomingValue, exists := incoming.values[place]; exists {
			if equalNilValue(incomingValue, value) {
				joined.values[place] = value
			}
		}
	}
	places := make(map[nilPlace]bool)
	for place := range current.aliases {
		places[place] = true
	}
	for place := range incoming.aliases {
		places[place] = true
	}
	for left := range places {
		for right := range places {
			if nilPlaceID(left) >= nilPlaceID(right) {
				continue
			}
			if nilAliased(current, left, right) && nilAliased(incoming, left, right) {
				addNilAlias(joined, left, right)
			}
		}
	}
	for object, guard := range current.guards {
		other, ok := incoming.guards[object]
		if ok && equalNilGuard(guard, other) {
			joined.guards[object] = cloneNilGuard(guard)
		}
	}
	for object, presence := range current.presence {
		if incoming.presence[object] == presence {
			joined.presence[object] = presence
		}
	}
	if equalNilStates(current, joined) {
		return current, false
	}
	return joined, true
}

func equalNilStates(left, right %nilFlowState) bool {
	if len(left.values) != len(right.values) || len(left.aliases) != len(right.aliases) ||
		len(left.guards) != len(right.guards) || len(left.presence) != len(right.presence) {
		return false
	}
	for place, value := range left.values {
		if other, found := right.values[place]; found {
			if !equalNilValue(other, value) {
				return false
			}
		} else {
			return false
		}
	}
	for place, representative := range left.aliases {
		if right.aliases[place] != representative {
			return false
		}
	}
	for object, guard := range left.guards {
		if !equalNilGuard(guard, right.guards[object]) {
			return false
		}
	}
	for object, presence := range left.presence {
		if right.presence[object] != presence {
			return false
		}
	}
	return true
}

func equalNilGuard(left, right nilGuard) bool {
	return equalNilFacts(left.trueFacts, right.trueFacts) &&
		equalNilFacts(left.falseFacts, right.falseFacts)
}

func equalNilFacts(left, right nilFacts) bool {
	if len(left) != len(right) {
		return false
	}
	for place, value := range left {
		if other, found := right[place]; found {
			if !equalNilValue(other, value) {
				return false
			}
		} else {
			return false
		}
	}
	return true
}
