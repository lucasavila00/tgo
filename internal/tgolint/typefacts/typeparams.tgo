package typefacts

import "go/types"

// Core returns the shared underlying type of a concrete or constrained type.
// It returns nil if no type fact or common underlying type is available.
func Core(typ types.Type) types.Type {
	if typ == nil {
		return nil
	}
	typ = types.Unalias(typ)
	if parameter, ok := typ.(*types.TypeParam); ok {
		terms, supported := Terms(parameter.Constraint())
		if !supported || len(terms) == 0 {
			return nil
		}
		core := terms[0].Type().Underlying()
		for _, term := range terms[1:] {
			candidate := term.Type().Underlying()
			if !types.Identical(core, candidate) {
				core = commonChannel(core, candidate)
				if core == nil {
					return nil
				}
			}
		}
		return core
	}
	return typ.Underlying()
}

// commonChannel combines channel directions when their element types match.
func commonChannel(left, right types.Type) types.Type {
	leftChannel, leftOK := left.(*types.Chan)
	rightChannel, rightOK := right.(*types.Chan)
	if !leftOK || !rightOK || !types.Identical(leftChannel.Elem(), rightChannel.Elem()) {
		return nil
	}
	if leftChannel.Dir() == types.SendRecv {
		return rightChannel
	}
	if rightChannel.Dir() == types.SendRecv || leftChannel.Dir() == rightChannel.Dir() {
		return leftChannel
	}
	return nil
}

// Terms gets the normalized structural terms of a constraint.
// Terms expands a constraint into a finite set of type terms.
func Terms(typ types.Type) ([]*types.Term, bool) {
	typ = types.Unalias(typ)
	classified := Of(typ)
	switch classified.Tag() {
	case TypeTagTypeParameter:
		return Terms(classified.TypeParameterPayload().Value.Constraint())
	case TypeTagNamed:
		named := classified.NamedPayload().Value
		if Of(named.Underlying()).Tag() == TypeTagInterface {
			return Terms(named.Underlying())
		}
		return []*types.Term{types.NewTerm(false, named)}, true
	case TypeTagUnion:
		union := classified.UnionPayload().Value
		terms := make([]*types.Term, union.Len())
		for index := range terms {
			terms[index] = union.Term(index)
		}
		return terms, true
	case TypeTagInterface:
		value := classified.InterfacePayload().Value
		var restriction []*types.Term = nil
		for index := 0; index < value.NumEmbeddeds(); index++ {
			terms, supported := Terms(value.EmbeddedType(index))
			if !supported {
				return nil, false
			}
			if terms == nil {
				continue
			}
			if restriction == nil {
				restriction = terms
				continue
			}
			restriction = intersectTerms(restriction, terms)
		}
		return restriction, true
	case TypeTagNil, TypeTagBasic, TypeTagArray, TypeTagSlice,
		TypeTagStruct, TypeTagPointer, TypeTagTuple, TypeTagSignature,
		TypeTagMap, TypeTagChannel, TypeTagOther:
		return []*types.Term{types.NewTerm(false, typ)}, true
	exhaustive:
	}
}

// intersectTerms returns the terms that are present in both unions.
// intersectTerms computes the shared terms from two constraint sets.
func intersectTerms(left, right []*types.Term) []*types.Term {
	intersection := make([]*types.Term, 0)
	for _, leftTerm := range left {
		for _, rightTerm := range right {
			term := intersectTerm(leftTerm, rightTerm)
			if term != nil && !containsTerm(intersection, term) {
				intersection = append(intersection, term)
			}
		}
	}
	return intersection
}

// intersectTerm returns the overlap of two exact or approximate terms.
// intersectTerm returns the narrower compatible term.
func intersectTerm(left, right *types.Term) *types.Term {
	leftType := types.Unalias(left.Type())
	rightType := types.Unalias(right.Type())
	if !left.Tilde() && !right.Tilde() {
		if types.Identical(leftType, rightType) {
			return types.NewTerm(false, leftType)
		}
		return nil
	}
	if !types.Identical(leftType.Underlying(), rightType.Underlying()) {
		return nil
	}
	if !left.Tilde() {
		return types.NewTerm(false, leftType)
	}
	if !right.Tilde() {
		return types.NewTerm(false, rightType)
	}
	return types.NewTerm(true, leftType)
}

// containsTerm reports whether terms already contains the same term.
func containsTerm(terms []*types.Term, target *types.Term) bool {
	for _, term := range terms {
		if term.Tilde() == target.Tilde() && types.Identical(term.Type(), target.Type()) {
			return true
		}
	}
	return false
}
