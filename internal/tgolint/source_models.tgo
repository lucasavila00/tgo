package tgolint

import (
	"bytes"
	"go/ast"
	"go/format"
	"go/parser"
	"go/token"
	"go/types"
	"path/filepath"
	"reflect"
	"strconv"
	"strings"

	"tgo/internal/compiler"
	"tgo/internal/outputname"
	"tgo/pkg/syntax"

	"golang.org/x/tools/go/analysis"
)

const metadataPrefix = "//tgo:v2 "

type generatedMetadata struct {
	source string
	body   []byte
}

type verifiedSource struct {
	generated *ast.File
	file      *syntax.File
	tokenFile *token.File
	data      []byte
}

// verifySourceModels checks generated declarations against their canonical source.
func (c %checker) verifySourceModels(generated *ast.File) *verifiedSource {
	generatedPath := c.pass.Fset.Position(generated.Package).Filename
	generatedData, readErr := c.pass.ReadFile(generatedPath)
	metadata := parseGeneratedMetadata(generatedData)
	if readErr != nil || metadata == nil {
		c.failVerification(generated.Package, "generated tgo model metadata is invalid")
		return nil
	}
	sourceName := metadata.source
	if !sourceMatchesGenerated(sourceName, generatedPath) {
		c.failVerification(generated.Package, "generated tgo model metadata is invalid")
		return nil
	}
	sourcePath := filepath.Join(filepath.Dir(generatedPath), sourceName)
	data, err := readTGoSource(c.pass, sourcePath)
	if err != nil {
		c.failVerification(
			generated.Package,
			"cannot read tgo source %s: %v",
			sourceName,
			err,
		)
		return nil
	}
	if !bytes.Equal(generatedData, c.outputs[sourceName]) {
		c.failVerification(generated.Package, "generated tgo output integrity check failed")
		return nil
	}
	if err := compiler.VerifyGeneratedModels(sourceName, data, metadata.body, c.pass.Pkg); err != nil {
		c.failVerification(
			generated.Package,
			"generated tgo output does not match the current compiler emitter: %v",
			err,
		)
		return nil
	}
	sourceFiles := token.NewFileSet()
	file, err := syntax.ParseFile(
		sourceFiles,
		sourcePath,
		data,
		syntax.ParseComments|syntax.AllErrors,
	)
	if err != nil {
		c.failVerification(
			generated.Package,
			"cannot parse tgo source %s: %v",
			sourceName,
			err,
		)
		return nil
	}
	sourceNames := make(map[string]bool)
	sourceToken := sourceFiles.File(file.Package)
	for _, declaration := range file.Declarations {
		if source := sourceDeclaration(
			declaration, c.packagePath(), file, sourceToken, data,
		); source != nil {
			sourceNames[source.name] = true
		}
		c.checkSourceDeclaration(
			generated, sourceName, file, declaration, sourceToken, data,
		)
	}
	c.reportExtraGeneratedModels(generated, sourceName, sourceNames)
	if c.invalid {
		return nil
	}
	return &verifiedSource{
		generated: generated, file: file, tokenFile: sourceToken, data: data,
	}
}

// exportSourceModels publishes facts only after every generated file verifies.
func (c %checker) exportSourceModels(source *verifiedSource) {
	for _, declaration := range source.file.Declarations {
		c.exportSourceDeclaration(
			source.generated, source.file, declaration, source.tokenFile, source.data,
		)
	}
}

// parseGeneratedMetadata reads the source name and generated body.
func parseGeneratedMetadata(data []byte) *generatedMetadata {
	parts := bytes.SplitN(data, []byte("\n"), 4)
	if len(parts) != 4 || string(parts[0]) != generatedHeader || len(parts[2]) != 0 {
		return nil
	}
	line := string(parts[1])
	if !strings.HasPrefix(line, metadataPrefix) {
		return nil
	}
	quotedSource := strings.TrimPrefix(line, metadataPrefix)
	source, err := strconv.Unquote(quotedSource)
	if err != nil || strconv.Quote(source) != quotedSource || filepath.Base(source) != source {
		return nil
	}
	return &generatedMetadata{source: source, body: parts[3]}
}

func sourceMatchesGenerated(source string, generatedPath string) bool {
	return outputname.Matches(source, generatedPath)
}

func (c %checker) hasModelAPIs(object *types.TypeName) bool {
	return method(object.Type(), "TgoTag") != nil ||
		method(object.Type(), "Value") != nil
}

// reportExtraGeneratedModels rejects model APIs with no matching TGo declaration.
func (c %checker) reportExtraGeneratedModels(
	file *ast.File,
	sourceName string,
	sourceNames map[string]bool,
) {
	for _, declaration := range file.Decls {
		general, ok := declaration.(*ast.GenDecl)
		if !ok {
			continue
		}
		for _, item := range general.Specs {
			specification, ok := item.(*ast.TypeSpec)
			if !ok || sourceNames[specification.Name.Name] {
				continue
			}
			object, objectOK := c.pass.TypesInfo.Defs[specification.Name].(*types.TypeName)
			if !objectOK {
				continue
			}
			if c.hasModelAPIs(object) {
				c.failVerification(
					specification.Pos(),
					"generated tgo output for %s does not match %s",
					specification.Name.Name,
					sourceName,
				)
			}
		}
	}
}

// checkSourceDeclaration compares one TGo model with its generated Go API.
func (c %checker) checkSourceDeclaration(
	generated *ast.File,
	sourceName string,
	file *syntax.File,
	declaration *syntax.Declaration,
	sourceFile *token.File,
	data []byte,
) {
	source := sourceDeclaration(
		declaration, c.packagePath(), file, sourceFile, data,
	)
	if source == nil {
		return
	}
	name := source.name
	specification := generatedTypeSpec(generated, name)
	if specification == nil {
		c.failVerification(
			generated.Package,
			"generated tgo output for %s does not match %s",
			name,
			sourceName,
		)
		return
	}
	object, objectOK := c.pass.TypesInfo.Defs[specification.Name].(*types.TypeName)
	if !objectOK || !sourceShapeMatches(
			generated, specification.Type, object.Type(), source.fact,
			source.fields, source.base, source.variants,
		) {
		c.failVerification(
			specification.Pos(),
			"generated tgo output for %s does not match %s",
			name,
			sourceName,
		)
		return
	}
}

// exportSourceDeclaration records one verified model and its constructors.
func (c %checker) exportSourceDeclaration(
	generated *ast.File,
	file *syntax.File,
	declaration *syntax.Declaration,
	sourceFile *token.File,
	data []byte,
) {
	source := sourceDeclaration(
		declaration, c.packagePath(), file, sourceFile, data,
	)
	if source == nil {
		return
	}
	specification := generatedTypeSpec(generated, source.name)
	if specification == nil {
		return
	}
	object, ok := c.pass.TypesInfo.Defs[specification.Name].(*types.TypeName)
	if !ok {
		return
	}
	if source.fact != nil {
		key := objectKey{pkg: object.Pkg(), name: object.Name()}
		c.models[key] = source.fact
		c.pass.ExportObjectFact(object, encodeModelFact(source.fact))
		c.exportValidationFacts(object, source.fact)
	}
}

func (c %checker) packagePath() string {
	if c.pass.Pkg == nil {
		return ""
	}
	return c.pass.Pkg.Path()
}

type sourceModel struct {
	name     string
	fact     *model
	fields   []sourceField
	base     string
	variants []sourceVariant
}

// sourceDeclaration converts one syntax declaration to verified model metadata.
func sourceDeclaration(
	declaration *syntax.Declaration,
	packagePath string,
	file *syntax.File,
	sourceFile *token.File,
	data []byte,
) *sourceModel {
	if node, ok := syntax.CheckedDeclarationOf(declaration); ok {
		return &sourceModel{
			name: node.Name.Name,
			fact: checkedModel(packagePath, node.Name.Name),
			fields: nil,
			base: sourceExpression(file, sourceFile, data, node.Base),
			variants: nil,
		}
	}
	if node, ok := syntax.EnumDeclarationOf(declaration); ok {
		variants := make([]string, 0, len(node.Variants))
		sourceVariants := make([]sourceVariant, 0, len(node.Variants))
		for _, variant := range node.Variants {
			variants = append(variants, variant.Name.Name)
			sourceVariants = append(sourceVariants, sourceVariant{
				name: variant.Name.Name,
				fields: sourceFields(file, sourceFile, data, variant.Fields),
			})
		}
		return &sourceModel{
			name: node.Name.Name,
			fact: enumModel(packagePath, node.Name.Name, variants),
			fields: nil, base: "", variants: sourceVariants,
		}
	}
	if node, ok := syntax.StructDeclarationOf(declaration); ok {
		return &sourceModel{
			name: node.Name.Name, fact: nil,
			fields: sourceFields(file, sourceFile, data, node.Fields),
			base: "", variants: nil,
		}
	}
	return nil
}

func readTGoSource(pass *analysis.Pass, path string) ([]byte, error) {
	found := false
	for _, other := range pass.OtherFiles {
		if filepath.Clean(other) == filepath.Clean(path) {
			found = true
			break
		}
	}
	if !found {
		pass.OtherFiles = append(pass.OtherFiles, path)
	}
	data := pass.ReadFile(path)!
	return data, nil
}

func generatedTypeSpec(file *ast.File, name string) *ast.TypeSpec {
	for _, declaration := range file.Decls {
		general, ok := declaration.(*ast.GenDecl)
		if !ok {
			continue
		}
		for _, item := range general.Specs {
			specification, ok := item.(*ast.TypeSpec)
			if ok && specification.Name.Name == name {
				return specification
			}
		}
	}
	return nil
}

// sourceShapeMatches checks source fields and the public generated model API.
func sourceShapeMatches(
	generated *ast.File,
	representation ast.Expr,
	typ types.Type,
	fact *model,
	fields []sourceField,
	base string,
	variants []sourceVariant,
) bool {
	if fact == nil {
		structure, ok := representation.(*ast.StructType)
		if !ok {
			return false
		}
		return sameFields(fields, structure.Fields)
	}
	_, name := modelDescription(fact)
	if modelIsChecked(fact) {
		structure, ok := representation.(*ast.StructType)
		if !ok {
			return false
		}
		return sameModelFact(fact, emittedCheckedModel(name, structure, typ)) &&
			len(structure.Fields.List) == 1 &&
			sameExpressionText(base, structure.Fields.List[0].Type)
	}
	if !generatedEnumShape(typ, name, variants) {
		return false
	}
	for _, variant := range variants {
		payloadSpec := generatedTypeSpec(generated, name+variant.name)
		if payloadSpec == nil {
			return false
		}
		payload, ok := payloadSpec.Type.(*ast.StructType)
		if !ok || !sameFields(variant.fields, payload.Fields) {
			return false
		}
	}
	return true
}

// generatedEnumShape checks source variants against the public ABI.
// generatedEnumShape checks enum operations without reading private storage.
func generatedEnumShape(
	typ types.Type,
	name string,
	variants []sourceVariant,
) bool {
	if !validGeneratedTagMethod(typ) {
		return false
	}
	for _, variant := range variants {
		payloadName := name + variant.name
		payload, ok := typeInPackage(typ, payloadName)
		if !ok || !validEnumAPI(
			typ, payload, "Tgo"+variant.name, "New"+payloadName,
		) {
			return false
		}
	}
	return true
}

func validGeneratedTagMethod(typ types.Type) bool {
	tag := method(typ, "TgoTag")
	if tag == nil || tag.Params().Len() != 0 || tag.Results().Len() != 1 {
		return false
	}
	basic, ok := coreType(tag.Results().At(0).Type()).(*types.Basic)
	return ok && basic.Info()&types.IsUnsigned != 0
}

func typeInPackage(typ types.Type, name string) (types.Type, bool) {
	named, ok := types.Unalias(typ).(*types.Named)
	if !ok || named.Obj().Pkg() == nil {
		return nil, false
	}
	object, ok := named.Obj().Pkg().Scope().Lookup(name).(*types.TypeName)
	if !ok {
		return nil, false
	}
	return object.Type(), true
}

// sameModelFact compares model identity and the ordered enum variants.
func sameModelFact(left *model, right *model) bool {
	if left == nil || right == nil || !sameModel(left, right) {
		return false
	}
	leftVariants := modelVariants(left)
	rightVariants := modelVariants(right)
	if len(leftVariants) != len(rightVariants) {
		return false
	}
	for index := range leftVariants {
		if leftVariants[index] != rightVariants[index] {
			return false
		}
	}
	return true
}

type sourceField struct {
	name           string
	typeExpression string
	tag            string
}

type sourceVariant struct {
	name   string
	fields []sourceField
}

func sourceFields(
	file *syntax.File,
	sourceFile *token.File,
	data []byte,
	fields []*syntax.TGoField,
) []sourceField {
	result := []sourceField(nil)
	for _, declaration := range fields {
		typeText := sourceExpression(file, sourceFile, data, declaration.Field.Type)
		tagText := ""
		if declaration.Field.Tag != nil {
			tagText = sourceRange(
				sourceFile, data, declaration.Field.Tag.Start,
				declaration.Field.Tag.Stop,
			)
		}
		if len(declaration.Field.Names) == 0 {
			result = append(result, sourceField{
				name: "", typeExpression: typeText, tag: tagText,
			})
			continue
		}
		for _, name := range declaration.Field.Names {
			result = append(result, sourceField{
				name: name.Name, typeExpression: typeText, tag: tagText,
			})
		}
	}
	return result
}

func sourceExpression(
	file *syntax.File,
	sourceFile *token.File,
	data []byte,
	expression *syntax.Expression,
) string {
	if expression == nil {
		return ""
	}
	start := syntax.ExpressionPosition(expression)
	end := syntax.ExpressionEnd(expression)
	result := []byte(sourceRange(
		sourceFile, data, syntax.ExpressionPosition(expression),
		syntax.ExpressionEnd(expression),
	))
	if file == nil {
		return string(result)
	}
	for _, extension := range syntax.Extensions(file) {
		node, ok := syntax.NonNilPointerTypeOf(extension)
		if !ok || node.Percent < start || node.Percent >= end {
			continue
		}
		result[sourceFile.Offset(node.Percent)-sourceFile.Offset(start)] = '*'
	}
	return string(result)
}

func sourceRange(
	sourceFile *token.File,
	data []byte,
	start token.Pos,
	end token.Pos,
) string {
	return string(data[sourceFile.Offset(start):sourceFile.Offset(end)])
}

func sameFields(source []sourceField, generated *ast.FieldList) bool {
	flat := source
	if generated == nil || len(flat) != len(generated.List) {
		return false
	}
	for index, field := range flat {
		other := generated.List[index]
		if !sameExpressionText(field.typeExpression, other.Type) ||
			!sameExpressionText(field.tag, other.Tag) {
			return false
		}
		if field.name == "" && len(other.Names) == 0 {
			continue
		}
		if len(other.Names) != 1 || other.Names[0].Name != field.name {
			return false
		}
	}
	return true
}

func sameExpressionText(left string, right ast.Expr) bool {
	if left == "" || expressionNil(right) {
		return left == "" && expressionNil(right)
	}
	leftExpression, err := parser.ParseExpr(left)
	if err != nil {
		return false
	}
	leftText := new(bytes.Buffer)
	rightText := new(bytes.Buffer)
	if format.Node(leftText, token.NewFileSet(), leftExpression) != nil ||
		format.Node(rightText, token.NewFileSet(), right) != nil {
		return false
	}
	return leftText.String() == rightText.String()
}

func expressionNil(expression ast.Expr) bool {
	if expression == nil {
		return true
	}
	value := reflect.ValueOf(expression)
	return value.Kind() == reflect.Pointer && value.IsNil()
}
