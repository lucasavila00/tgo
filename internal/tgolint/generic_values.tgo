package tgolint

import (
	"go/token"
	"go/types"

	"tgo/pkg/syntax"
)

type genericValue struct {
	function          *types.Func
	fact              *GenericEffectFact
	receiverArguments []types.Type
	typeArguments     []types.Type
	conditionCall     *syntax.Expression
	callDepth         int
	conditions        []GenericEffectCondition
	maySkip           bool
}

type genericValueBinding struct {
	value         genericValue
	source        *syntax.Expression
	initialTarget token.Pos
	dependency    *genericValueBinding
	ambiguous     bool
}

// collectGenericValueBindings finds stable local generic function values.
func (c %checker) collectGenericValueBindings(
	summaries map[*types.Func]%genericEffectSummary,
) (map[types.Object]%genericValueBinding, map[*syntax.Expression]bool) {
	bindings := make(map[types.Object]%genericValueBinding)
	sources := make(map[*syntax.Expression]bool)
	for {
		changed := false
		for _, file := range c.files {
			if c.generated[file] {
				continue
			}
			changed = c.collectFileGenericValueBindings(
				file, summaries, bindings, sources,
			) || changed
		}
		if !changed {
			break
		}
	}
	for _, file := range c.files {
		c.markAmbiguousGenericValueBindings(file, bindings)
	}
	for changed := true; changed; {
		changed = false
		for _, binding := range bindings {
			if !binding.ambiguous && binding.dependency != nil &&
				binding.dependency.ambiguous {
				binding.ambiguous = true
				changed = true
			}
		}
	}
	return bindings, sources
}

func (c %checker) collectFileGenericValueBindings(
	file %syntax.File,
	summaries map[*types.Func]%genericEffectSummary,
	bindings map[types.Object]%genericValueBinding,
	sources map[*syntax.Expression]bool,
) bool {
	changed := false
	inspectGenericFile(file, func(node %syntax.Node) bool {
		if !c.localGenericValueNode(node) {
			return true
		}
		if statement, ok := syntax.StatementOf(node); ok {
			if assignment := syntax.AssignmentStatementOf(statement); assignment != nil &&
				(assignment.Operator == token.DEFINE || assignment.Operator == token.ASSIGN) {
				changed = c.collectAssignedGenericValues(
					assignment.Left, assignment.Right, summaries, bindings, sources,
				) || changed
			}
		}
		if specification, ok := syntax.SpecificationOf(node); ok {
			if value := syntax.ValueSpecificationOf(specification); value != nil {
				left := make([]%syntax.Expression, len(value.Names))
				for index := range value.Names {
					item := syntax.Expression.Identifier{Value: value.Names[index]}
					left[index] = &item
				}
				changed = c.collectAssignedGenericValues(
					left, value.Values, summaries, bindings, sources,
				) || changed
			}
		}
		return true
	})
	return changed
}

func (c %checker) localGenericValueNode(node %syntax.Node) bool {
	if _, ok := syntax.FunctionDeclarationOf(node); ok {
		return true
	}
	if _, ok := syntax.FunctionLiteralOf(node); ok {
		return true
	}
	for current := c.parents[*node]; current != nil; current = c.parents[*current] {
		if _, ok := syntax.FunctionDeclarationOf(current); ok {
			return true
		}
		if _, ok := syntax.FunctionLiteralOf(current); ok {
			return true
		}
	}
	return false
}

// markAmbiguousGenericValueBindings rejects values changed after their first binding.
func (c %checker) markAmbiguousGenericValueBindings(
	file %syntax.File,
	bindings map[types.Object]%genericValueBinding,
) {
	inspectGenericFile(file, func(node %syntax.Node) bool {
		if specification, ok := syntax.SpecificationOf(node); ok {
			if value := syntax.ValueSpecificationOf(specification); value != nil &&
				len(value.Values) != 0 {
				for index := range value.Names {
					object := c.facts.Object(value.Names[index])
					binding, found := bindings[object]
					if !found || len(value.Values) == len(value.Names) &&
						binding.source == value.Values[index] {
						continue
					}
					binding.ambiguous = true
				}
			}
		}
		statement, ok := syntax.StatementOf(node)
		if !ok {
			return true
		}
		if assignment := syntax.AssignmentStatementOf(statement); assignment != nil {
			c.markAmbiguousGenericTargets(
				assignment.Left, assignment.Operator, bindings,
			)
		}
		if rangeStatement := syntax.RangeStatementOf(statement); rangeStatement != nil {
			c.markAmbiguousGenericTargets(
				[]*syntax.Expression{rangeStatement.Key, rangeStatement.Value},
				rangeStatement.Operator, bindings,
			)
		}
		return true
	})
}

func (c %checker) markAmbiguousGenericTargets(
	targets []*syntax.Expression,
	operator token.Token,
	bindings map[types.Object]%genericValueBinding,
) {
	for _, target := range targets {
		if target == nil {
			continue
		}
		name := syntax.IdentifierExpressionOf(unparenthesized(target))
		if name == nil {
			continue
		}
		if operator == token.DEFINE && c.facts.DefinitionName(name) != nil {
			continue
		}
		if binding, found := bindings[c.facts.Object(name)]; found {
			if binding.initialTarget == name.Start {
				continue
			}
			binding.ambiguous = true
		}
	}
}

func (c %checker) collectAssignedGenericValues(
	left []%syntax.Expression,
	right []%syntax.Expression,
	summaries map[*types.Func]%genericEffectSummary,
	bindings map[types.Object]%genericValueBinding,
	sources map[*syntax.Expression]bool,
) bool {
	if len(left) != len(right) {
		return false
	}
	changed := false
	for index, expression := range right {
		value, dependency, ok := c.assignedGenericValue(
			expression, summaries, bindings,
		)
		name := syntax.IdentifierExpressionOf(unparenthesized(left[index]))
		if !ok || name == nil || name.Name == "_" {
			continue
		}
		object := c.facts.Object(name)
		if object == nil {
			continue
		}
		if current, found := bindings[object]; found {
			if current.source == expression {
				continue
			}
			current.ambiguous = true
			continue
		}
		bindings[object] = &genericValueBinding{
			value: value, source: expression, initialTarget: name.Start,
			dependency: dependency, ambiguous: false,
		}
		sources[expression] = true
		changed = true
	}
	return changed
}

// assignedGenericValue resolves a direct value or a partial call through a binding.
func (c %checker) assignedGenericValue(
	expression %syntax.Expression,
	summaries map[*types.Func]%genericEffectSummary,
	bindings map[types.Object]%genericValueBinding,
) (genericValue, *genericValueBinding, bool) {
	expression = unparenthesized(expression)
	if value, ok := c.genericValue(expression, summaries); ok {
		return value, nil, true
	}
	if call := syntax.CallExpressionOf(expression); call != nil {
		value, dependency, ok := c.assignedGenericValue(
			call.Callee, summaries, bindings,
		)
		if !ok {
			return noGenericValue(), nil, false
		}
		if value.callDepth == 0 {
			value.conditionCall = expression
		}
		value.callDepth++
		if !genericFactHasEffectsAtOrAfter(value.fact, value.callDepth) {
			return noGenericValue(), nil, false
		}
		return value, dependency, true
	}
	source := syntax.IdentifierExpressionOf(expression)
	if source == nil {
		return noGenericValue(), nil, false
	}
	dependency := bindings[c.facts.Object(source)]
	if dependency == nil {
		return noGenericValue(), nil, false
	}
	return dependency.value, dependency, true
}

// genericValue resolves the effects carried by a function value expression.
func (c %checker) genericValue(
	expression %syntax.Expression,
	summaries map[*types.Func]%genericEffectSummary,
) (genericValue, bool) {
	callExpression := unparenthesized(expression)
	if call := syntax.CallExpressionOf(callExpression); call != nil {
		function, receiverArguments, typeArguments := c.genericCall(callExpression)
		if function != nil {
			fact := c.genericZeroFact(function, summaries)
			if genericFactHasEffectsAtOrAfter(fact, 1) {
				return genericValue{
					function: function, fact: fact,
					receiverArguments: receiverArguments,
					typeArguments:     typeArguments, conditionCall: callExpression,
					callDepth: 1, conditions: nil, maySkip: false,
				}, true
			}
			return noGenericValue(), false
		}
		value, found := c.genericValue(call.Callee, summaries)
		if !found {
			return noGenericValue(), false
		}
		value.callDepth++
		if genericFactHasEffectsAtOrAfter(value.fact, value.callDepth) {
			return value, true
		}
		return noGenericValue(), false
	}
	identifier := genericCallIdentifier(expression)
	if identifier == nil {
		return noGenericValue(), false
	}
	function, ok := c.genericCallObject(expression).(*types.Func)
	if !ok {
		return noGenericValue(), false
	}
	fact := c.genericZeroFact(function.Origin(), summaries)
	if fact == nil {
		return noGenericValue(), false
	}
	var typeArguments []types.Type = nil
	if instance, ok := c.facts.Instance(identifier); ok {
		typeArguments = typeList(instance.TypeArgs)
	}
	return genericValue{
		function: function.Origin(), fact: fact,
		receiverArguments: c.receiverTypeArguments(expression),
		typeArguments:     typeArguments,
		conditionCall:     nil,
		callDepth:         0,
		conditions:        nil,
		maySkip:           false,
	}, true
}

// reportDirectGenericValueEscape rejects an effectful value with no checked call site.
func (c %checker) reportDirectGenericValueEscape(
	expression %syntax.Expression,
	summaries map[*types.Func]%genericEffectSummary,
	sources map[*syntax.Expression]bool,
) {
	if c.boundGenericValueSource(expression, sources) ||
		c.calledDirectly(expression) || c.discardedValue(expression) ||
		c.genericInstantiationPart(expression) {
		return
	}
	value, ok := c.genericValue(expression, summaries)
	if ok && value.callDepth == 0 {
		c.reportGenericValueEscape(expression, value)
	}
}

func (c %checker) genericInstantiationPart(expression %syntax.Expression) bool {
	parentNode := c.parents[syntax.ExpressionNode(expression)]
	if parentNode == nil {
		return false
	}
	parent, ok := syntax.ExpressionOf(parentNode)
	if !ok || parent == nil {
		return false
	}
	if index := syntax.IndexExpressionOf(parent); index != nil {
		return index.Expression == expression
	}
	index := syntax.IndexListExpressionOf(parent)
	return index != nil && index.Expression == expression
}

func (c %checker) reportReturnedGenericCall(
	expression %syntax.Expression,
	summaries map[*types.Func]%genericEffectSummary,
	sources map[*syntax.Expression]bool,
) {
	value, ok := c.genericValue(expression, summaries)
	if !ok || value.callDepth == 0 ||
		c.boundGenericValueSource(expression, sources) {
		return
	}
	if invocation := c.directCallOf(expression); invocation != nil {
		c.reportGenericValueCall(invocation, value)
		return
	}
	if c.discardedValue(expression) || c.expressionStatement(expression) {
		return
	}
	c.reportGenericValueEscape(expression, value)
}

func (c %checker) directCallOf(expression %syntax.Expression) *syntax.Expression {
	var current *syntax.Expression = expression
	for {
		parentNode := c.parents[syntax.ExpressionNode(current)]
		if parentNode == nil {
			return nil
		}
		parent, ok := syntax.ExpressionOf(parentNode)
		if !ok || parent == nil {
			return nil
		}
		parentheses := syntax.ParenthesizedExpressionOf(parent)
		if parentheses == nil || parentheses.Expression != current {
			break
		}
		current = parent
	}
	parentNode := c.parents[syntax.ExpressionNode(current)]
	if parentNode == nil {
		return nil
	}
	parent, ok := syntax.ExpressionOf(parentNode)
	if !ok || parent == nil {
		return nil
	}
	call := syntax.CallExpressionOf(parent)
	if call != nil && call.Callee == current {
		return parent
	}
	return nil
}

func (c %checker) discardedValue(expression %syntax.Expression) bool {
	var current *syntax.Expression = expression
	for {
		parentNode := c.parents[syntax.ExpressionNode(current)]
		if parentNode == nil {
			break
		}
		parent, ok := syntax.ExpressionOf(parentNode)
		if !ok || parent == nil {
			break
		}
		parentheses := syntax.ParenthesizedExpressionOf(parent)
		if parentheses == nil || parentheses.Expression != current {
			break
		}
		current = parent
	}
	parentNode := c.parents[syntax.ExpressionNode(current)]
	if parentNode == nil {
		return false
	}
	statement, ok := syntax.StatementOf(parentNode)
	if !ok || statement == nil {
		return false
	}
	assignment := syntax.AssignmentStatementOf(statement)
	if assignment == nil || len(assignment.Left) != len(assignment.Right) {
		return false
	}
	for index, right := range assignment.Right {
		if right != current {
			continue
		}
		name := syntax.IdentifierExpressionOf(assignment.Left[index])
		return name != nil && name.Name == "_"
	}
	return false
}

func (c %checker) expressionStatement(expression %syntax.Expression) bool {
	var current *syntax.Expression = expression
	for {
		parentNode := c.parents[syntax.ExpressionNode(current)]
		if parentNode == nil {
			break
		}
		parent, ok := syntax.ExpressionOf(parentNode)
		if !ok || parent == nil {
			break
		}
		parentheses := syntax.ParenthesizedExpressionOf(parent)
		if parentheses == nil || parentheses.Expression != current {
			break
		}
		current = parent
	}
	parentNode := c.parents[syntax.ExpressionNode(current)]
	if parentNode == nil {
		return false
	}
	statement, ok := syntax.StatementOf(parentNode)
	if !ok || statement == nil {
		return false
	}
	expressionStatement := syntax.ExpressionStatementOf(statement)
	return expressionStatement != nil && expressionStatement.Expression == current
}

func (c %checker) reportBoundGenericValueUse(
	expression %syntax.Expression,
	bindings map[types.Object]%genericValueBinding,
	sources map[*syntax.Expression]bool,
) {
	source := c.boundGenericValueSource(expression, sources)
	name := syntax.IdentifierExpressionOf(expression)
	if name == nil {
		return
	}
	if c.facts.DefinitionName(name) != nil {
		return
	}
	binding, found := bindings[c.facts.Object(name)]
	if !found || binding.initialTarget == syntax.ExpressionPosition(expression) ||
		c.discardedValue(expression) {
		return
	}
	if binding.ambiguous {
		c.reportGenericValueEscape(expression, binding.value)
		return
	}
	value := binding.value
	current := expression
	called := false
	for {
		call := c.directCallOf(current)
		if call == nil {
			break
		}
		called = true
		c.reportGenericValueCall(call, value)
		if value.callDepth == 0 {
			value.conditionCall = call
		}
		value.callDepth++
		current = call
	}
	if !called {
		if source {
			return
		}
		c.reportGenericValueEscape(expression, value)
		return
	}
	if !genericFactHasEffectsAtOrAfter(value.fact, value.callDepth) ||
		source || c.discardedValue(current) || c.expressionStatement(current) {
		return
	}
	c.reportGenericValueEscape(current, value)
}

func (c %checker) boundGenericValueSource(
	expression %syntax.Expression,
	sources map[*syntax.Expression]bool,
) bool {
	current := expression
	for {
		if sources[current] {
			return true
		}
		parentNode := c.parents[syntax.ExpressionNode(current)]
		if parentNode == nil {
			return false
		}
		parent, ok := syntax.ExpressionOf(parentNode)
		if !ok || parent == nil {
			return false
		}
		parentheses := syntax.ParenthesizedExpressionOf(parent)
		if parentheses != nil && parentheses.Expression == current {
			current = parent
			continue
		}
		call := syntax.CallExpressionOf(parent)
		if call == nil || call.Callee != current {
			return false
		}
		current = parent
	}
}

// reportGenericValueCall checks saved effects with the current call arguments.
func (c %checker) reportGenericValueCall(
	expression %syntax.Expression,
	value genericValue,
) {
	if syntax.CallExpressionOf(expression) == nil {
		return
	}
	conditionCall := expression
	effectsZero := genericFactEffectsAtDepth(value.fact, value.callDepth, true)
	effectsAccess := genericFactEffectsAtDepth(value.fact, value.callDepth, false)
	description := "call to " + value.function.Name()
	if value.callDepth > 0 {
		if value.conditionCall == nil {
			return
		}
		conditionCall = value.conditionCall
		description = "call to function returned by " + value.function.Name()
	}
	c.reportGenericEffects(expression, conditionCall, effectsZero,
		value.receiverArguments, value.typeArguments, true, description)
	c.reportGenericEffects(expression, conditionCall, effectsAccess,
		value.receiverArguments, value.typeArguments, false, description)
}

// reportGenericValueEscape reports effects that escape local call analysis.
func (c %checker) reportGenericValueEscape(position *syntax.Expression, value genericValue) {
	if !c.genericValueAffectsModel(value) {
		return
	}
	description := "generic tgo function value " + value.function.Name()
	if value.callDepth > 0 {
		description = "function returned by " + value.function.Name()
	}
	c.reportResult(
		syntax.ExpressionPosition(position),
		"%s escapes; its effects cannot be checked at a call site",
		description,
	)
}

func (c %checker) genericValueAffectsModel(value genericValue) bool {
	zeroEffects := genericFactEffectsAtOrAfter(value.fact, value.callDepth, true)
	accessEffects := genericFactEffectsAtOrAfter(value.fact, value.callDepth, false)
	for _, effect := range zeroEffects {
		if c.genericEffectModel(effect, value.receiverArguments, value.typeArguments, true) != nil {
			return true
		}
	}
	for _, effect := range accessEffects {
		if c.genericEffectModel(
			effect, value.receiverArguments, value.typeArguments, false,
		) != nil {
			return true
		}
	}
	return false
}

func (c %checker) calledDirectly(expression %syntax.Expression) bool {
	var current *syntax.Expression = expression
	for {
		parentNode := c.parents[syntax.ExpressionNode(current)]
		if parentNode == nil {
			return false
		}
		parent, ok := syntax.ExpressionOf(parentNode)
		if !ok || parent == nil {
			return false
		}
		parentheses := syntax.ParenthesizedExpressionOf(parent)
		if parentheses == nil || parentheses.Expression != current {
			call := syntax.CallExpressionOf(parent)
			return call != nil && call.Callee == current
		}
		current = parent
	}
}
