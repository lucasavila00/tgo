package tgolint

import (
	"fmt"

	"tgo/pkg/syntax"

	"golang.org/x/tools/go/analysis"
)

// parseAnalysisFiles converts each active Go file to the public syntax ADT.
func parseAnalysisFiles(pass *analysis.Pass) ([]%syntax.File, error) {
	result := make([]%syntax.File, 0, len(pass.Files))
	for _, file := range pass.Files {
		filename := pass.Fset.Position(file.Pos()).Filename
		data, err := pass.ReadFile(filename)
		if err != nil {
			return nil, err
		}
		parsed, err := syntax.ParseGoFile(
			pass.Fset, filename, data, syntax.ParseComments|syntax.AllErrors,
		)
		if err != nil {
			return nil, fmt.Errorf("parse analysis file %s: %w", filename, err)
		}
		result = append(result, parsed)
	}
	return result, nil
}

func syntaxFileGenerated(file *syntax.File) bool {
	for _, group := range file.Comments {
		for _, comment := range group.List {
			if comment.Start < file.Package && comment.Text == generatedHeader {
				return true
			}
		}
	}
	return false
}
